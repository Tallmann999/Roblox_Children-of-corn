158, 176, 150)\n\t\t)\n\t\tspawn\046CFrame *= CFrame\046Angles(0, math\046pi, 0)\n\t\tspawn\046CanCollide = false\n\t\tspawn\046CanTouch = false\n\t\tspawn\046CanQuery = false\n\t\tspawn:SetAttribute(\"spawn_id\", \"solo_start\")\n\t\tCollectionService:AddTag(spawn, \"corn_spawn\")\n\t\tnoCorn(zones, \"StartClearing\", Vector3\046new(20, 10, 20), Vector3\046new(0, 85, -500))\n\t\tlocal allSlots: { Part } = {}\n\t\tfor row = 1, 5 do\n\t\t\tfor column = 1, 3 do\n\t\t\t\tlocal id = string\046format(\"solo_slot_%02d\", #allSlots + 1)\n\t\t\t\tlocal slot = part(\n\t\t\t\t\tslots,\n\t\t\t\t\tid,\n\t\t\t\t\tVector3\046new(6, 0\04612, 6),\n\t\t\t\t\tVector3\046new((column - 2) * 360, 80\04606, (row - 3) * 180),\n\t\t\t\t\tColor3\046fromRGB(119, 123, 87)\n\t\t\t\t)\n\t\t\t\tslot\046CanCollide = false\n\t\t\t\tslot\046CanTouch = false\n\t\t\t\tslot\046CanQuery = false\n\t\t\t\tslot:SetAttribute(\"slot_id\", id)\n\t\t\t\tCollectionService:AddTag(slot, \"corn_key_slot\")\n\t\t\t\ttable\046insert(allSlots, slot)\n\t\t\tend\n\t\tend\n\t\tfor _, index in { 3, 8, 13 } do\n\t\t\tlocal barrel = part(\n\t\t\t\tprops,\n\t\t\t\t\"LookoutBarrel\",\n\t\t\t\tVector3\046new(4, 3\0462, 3\0462),\n\t\t\t\tallSlots[index]\046Position + Vector3\046new(4, 1\04694, 0),\n\t\t\t\tColor3\046fromRGB(111, 78, 48)\n\t\t\t)\n\t\t\tbarrel\046CFrame *= CFrame\046Angles(0, 0, math\046pi / 2)\n\t\t\tbarrel\046Shape = Enum\046PartType\046Cylinder\n\t\t\tbarrel\046Material = Enum\046Material\046Wood\n\t\t\tCollectionService:AddTag(barrel, \"corn_barrel\")\n\t\tend\n\t\thouse(props, \"HouseWest\", Vector3\046new(-180, 80, -190))\n\t\thouse(props, \"HouseEast\", Vector3\046new(210, 80, 120))\n\t\thouse(props, \"HouseNorthWest\", Vector3\046new(-420, 80, 240))\n\t\tlocal scarecrow = Instance\046new(\"Model\")\n\t\tscarecrow\046Name = \"ScarecrowMarker\"\n\t\tscarecrow:SetAttribute(\"role\", \"visual_scarecrow_placeholder\")\n\t\tscarecrow\046Parent = props\n\t\tpart(\n\t\t\tscarecrow,\n\t\t\t\"Pole\",\n\t\t\tVect