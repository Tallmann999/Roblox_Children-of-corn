6_elapsed = math\046huge\n\tself\046_connection = nil\n\tself\046_beacon = nil\n\tself\046_beaconRefused = nil\n\tlocal gui = Instance\046new(\"ScreenGui\")\n\tgui\046Name = \"CornGateHint\"\n\tgui\046ResetOnSpawn = false\n\tgui\046DisplayOrder = 18\n\tgui\046Enabled = false\n\tgui\046Parent = player:WaitForChild(\"PlayerGui\")\n\tself\046_gui = gui\n\tlocal panel = Instance\046new(\"Frame\")\n\tpanel\046Name = \"NeedKey\"\n\tpanel\046Size = UDim2\046fromOffset(PANEL_WIDTH, 92)\n\tpanel\046Position = UDim2\046new(0\0465, 0, 1, -124)\n\tpanel\046AnchorPoint = Vector2\046new(0\0465, 1)\n\tpanel\046BackgroundColor3 = Color3\046fromRGB(27, 32, 28)\n\tpanel\046BackgroundTransparency = 0\04608\n\tpanel\046BorderSizePixel = 0\n\tpanel\046Visible = false\n\tpanel\046Active = false\n\tpanel\046Parent = gui\n\tself\046_panel = panel\n\tlocal corner = Instance\046new(\"UICorner\")\n\tcorner\046CornerRadius = UDim\046new(0, 8)\n\tcorner\046Parent = panel\n\tlocal border = Instance\046new(\"UIStroke\")\n\tborder\046Color = Color3\046fromRGB(219, 73, 63)\n\tborder\046Transparency = 0\04625\n\tborder\046Thickness = 1\n\tborder\046Parent = panel\n\tlocal icon = Instance\046new(\"Frame\")\n\ticon\046Name = \"StopSign\"\n\ticon\046Position = UDim2\046fromOffset(14, 14)\n\ticon\046Size = UDim2\046fromOffset(64, 64)\n\ticon\046BackgroundTransparency = 1\n\ticon\046Active = false\n\ticon\046Parent = panel\n\tfor row, width in { 44, 54, 60, 64, 64, 60, 54, 44 } do\n\t\tlocal slice = Instance\046new(\"Frame\")\n\t\tslice\046Name = \"Slice\" \046\046 row\n\t\tslice\046Size = UDim2\046fromOffset(width, 8)\n\t\tslice\046Position = UDim2\046new(0\0465, 0, 0, (row - 1) * 8)\n\t\tslice\046AnchorPoint = Vector2\046new(0\0465, 0)\n\t\tslice\046BackgroundColor3 = Color3\046fromRGB(219, 73, 63)\n\t\tslice\046BorderSizePixel = 0\n\t\tslice\046Active = false\n\t\tslice\046Parent = icon\n\tend\n\tlocal stop = label(\n\t\ticon,\n\t\t\"StopText\",\n\t\tUDim2\046fromOffset(0, 0),\n\t\tUDim2\046fromScale(1, 1),\n\t\t\"STOP\",\n\t\tEnum\046Font\046GothamBold,\n\t\t17\n\t)\n\tstop\046TextXAlignment = Enum\046TextXAlignment\046Center\n\tstop\046ZIndex = 2\n\tlabel(\n\t\tpanel,\n\t\t\"Headline\",\n\t\tUDim2\046fromOffset(92, 17),\n\t\tUDim2\046fromOffset(328, 27),\n\t\t\"Нужно найти ключ\",\n\t\tEnum\046Font\046GothamBold,\n\t\t19\n\t)\n\tlocal helper = label(\n\t\tpanel,\n\t\t\"Helper\",\n\t\tUDim2\046fromOffset(92, 46),\n\t\tUDim2\046fromOffset(328, 25),\n\t\t\"Найди ключ в одном из просветов\",\n\t\tEnum\046Font\046Gotham,\n\t\t13\n\t)\n\thelper\046TextColor3 = Color3\046fromRGB(190, 199, 186)\n\tlocal scale = Instance\046new(\"UIScale\")\n\tscale\046Parent = panel\n\tself\046_scale = scale\nend\n\nfunction GateHintController:_show(visible: boolean)\n\tif self\046_shown == visible then\n\t\treturn\n\tend\n\tself\046_shown = visible\n\tself\046_panel\046Visible = visible\n\tself\046_gui\046Enabled = visible\nend\n\nfunction GateHintController:SetSnapshot(snapshot: any)\n\tself\046_snapshot = snapshot\n\tif not eligible(snapshot) then\n\t\tself:_show(false)\n\tend\n\tif not snapshot or (snapshot\046phase ~= \"active\" and snapshot\046phase ~= \"caught\") then\n\t\tself:_restoreBeacon()\n\t\tself\046_beaconRefused = nil\n\tend\nend\n\nlocal function roadExitOwned(item: Instance, role: string): boolean\n\treturn item:GetAttribute(\"CornRoadExitOwned\") == true\n\t\tand item:GetAttribute(\"corn_project_id\") == PROJECT\n\t\tand item:GetAttribute(\"RoadExitVersion\") == 1\n\t\tand item:GetAttribute(\"RoadExitRole\") == role\nend\n\nlocal function beaconOwned(state: any): boolean\n\treturn workspace:FindFirstChild(\"CornMap\") == state\046map\n\t\tand state\046map:GetAttribute(\"corn_project_id\") == PROJECT\n\t\tand state\046map:FindFirstChild(\"Props\") == state\046props\n\t\tand state\046props:FindFirstChild(\"VillageRoad\") == state\046road\n\t\tand state\046road:FindFirstChild(\"ExitSign\") == state\046sign\n\t\tand state\046sign:FindFirstChild(\"ExitTextSurface\") == state\046surface\n\t\tand state\046surface:FindFirstChild(\"ExitText\") == state\046text\n\t\tand state\046props\046Parent == state\046map\n\t\tand state\046road\046Parent == state\046props\n\t\tand state\046sign\046Parent == state\046road\n\t\tand state\046surface\046Parent == state\046sign\n\t\tand state\046text\046Parent == state\046surface\n\t\tand roadExitOwned(state\046road, \"Road\")\n\t\tand roadExitOwned(state\046sign, \"ExitSign\")\n\t\tand roadExitOwned(state\046surface, \"ExitTextSurface\")\n\t\tand roadExitOwned(state\046text, \"ExitText\")\n\t\tand state\046text\046Text == \"ВЫХОД\"\nend\n\nlocal function sameBeacon(a: any, b: any): boolean\n\treturn a\046sign == b\046sign and a\046surface == b\046surface and a\046text == b\046text\nend\n\nfunction GateHintController:_restoreBeacon()\n\tlocal state = self\046_beacon\n\tself\046_beacon = nil\n\tif not state or not beaconOwned(state) then\n\t\treturn\n\tend\n\tif state\046sign\046Color == state\046lastColor then\n\t\tstate\046sign\046Color = state\046color\n\tend\n\tif state\046text\046TextColor3 == state\046lastTextColor then\n\t\tstate\046text\046TextColor3 = state\046textColor\n\tend\nend\n\nlocal function neonBright(elapsed: number): boolean\n\tlocal phase = math\046max(0, elapsed) % 14\0463\n\tfor _, segment in NEON_CYCLE do\n\t\tif phase < segment[1] then\n\t\t\treturn segment[2]\n\t\tend\n\t\tphase -= segment[1]\n\tend\n\treturn true\nend\n\nfunction GateHintController:_blinkBeacon(now: number)\n\tlocal character = player\046Character\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\tlocal capture = self\046_snapshot and self\046_snapshot\046capture\n\tif\n\t\tnot self\046_snapshot\n\t\tor (self\046_snapshot\046phase ~= \"active\" and self\046_snapshot\046phase ~= \"caught\")\n\t\tor not humanoid\n\t\tor humanoid\046Health <= 0\n\t\tor not root\n\t\tor not root:IsA(\"BasePart\")\n\t\tor (type(capture) == \"table\" and type(capture\046remaining) == \"number\" and capture\046remaining > 0)\n\t\tor GuiService\046MenuIsOpen\n\tthen\n\t\tself:_restoreBeacon()\n\t\treturn\n\tend\n\tlocal map = workspace:FindFirstChild(\"CornMap\")\n\tlocal props = if map then map:FindFirstChild(\"Props\") else nil\n\tlocal road = if props then props:FindFirstChild(\"VillageRoad\") else nil\n\tlocal sign = if road then road:FindFirstChild(\"ExitSign\") else nil\n\tlocal surface = if sign then sign:FindFirstChild(\"ExitTextSurface\") else nil\n\tlocal text = if surface then surface:FindFirstChild(\"ExitText\") else nil\n\tlocal candidate =\n\t\t{ map = map, props = props, road = road, sign = sign, surface = surface, text = text }\n\tlocal state = self\046_beacon\n\tif state and not beaconOwned(state) then\n\t\tself:_restoreBeacon()\n\t\tself\046_beaconRefused = state\n\t\tstate = nil\n\tend\n\tif self\046_beaconRefused and sameBeacon(self\046_beaconRefused, candidate) then\n\t\treturn\n\tend\n\tif\n\t\tnot map\n\t\tor not map:IsA(\"Model\")\n\t\tor not props\n\t\tor not road\n\t\tor not road:IsA(\"Model\")\n\t\tor not sign\n\t\tor not sign:IsA(\"BasePart\")\n\t\tor not surface\n\t\tor not surface:IsA(\"SurfaceGui\")\n\t\tor not text\n\t\tor not text:IsA(\"TextLabel\")\n\t\tor not beaconOwned(candidate)\n\tthen\n\t\tself:_restoreBeacon()\n\t\treturn\n\tend\n\tself\046_beaconRefused = nil\n\tif state and not sameBeacon(state, candidate) then\n\t\tself:_restoreBeacon()\n\t\tstate = nil\n\tend\n\tif not state then\n\t\tif sign\046Material ~= Enum\046Material\046Neon then\n\t\t\treturn\n\t\tend\n\t\tstate = candidate\n\t\tstate\046startedAt = now\n\t\tstate\046color, state\046textColor = sign\046Color, text\046TextColor3\n\t\tstate\046lastColor, state\046lastTextColor = sign\046Color, text\046TextColor3\n\t\tstate\046material, state\046ltm, state\046enabled =\n\t\t\tsign\046Material, sign\046LocalTransparencyModifier, surface\046Enabled\n\t\tstate\046visible, state\046transparency = text\046Visible, text\046TextTransparency\n\t\tself\046_beacon = state\n\tend\n\t-- Foreign changes release this exact pair until ready or a streamed replacement\046\n\tif\n\t\tsign\046Color ~= state\046lastColor\n\t\tor text\046TextColor3 ~= state\046lastTextColor\n\t\tor sign\046Material ~= state\046material\n\t\tor sign\046LocalTransparencyModifier ~= state\046ltm\n\t\tor surface\046Enabled ~= state\046enabled\n\t\tor text\046Visible ~= state\046visible\n\t\tor text\046TextTransparency ~= state\046transparency\n\tthen\n\t\tself:_restoreBeacon()\n\t\tself\046_beaconRefused = state\n\t\treturn\n\tend\n\tif not state\046enabled or not state\046visible then\n\t\treturn\n\tend\n\tlocal bright = neonBright(now - state\046startedAt)\n\tlocal color = if bright then state\046color else state\046color:Lerp(Color3\046new(0, 0, 0), 0\04694)\n\tlocal textColor = if bright\n\t\tthen state\046textColor\n\t\telse state\046textColor:Lerp(Color3\046new(0, 0, 0), 0\0469)\n\tif sign\046Color ~= color then\n\t\tsign\046Color = color\n\tend\n\tif text\046TextColor3 ~= textColor then\n\t\ttext\046TextColor3 = textColor\n\tend\n\t-- BasePart\046Color is stored at engine precision\046 Guard the value actually\n\t-- written so rounding cannot be mistaken for an external edit next tick\046\n\tstate\046lastColor, state\046lastTextColor = sign\046Color, text\046TextColor3\nend\nfunction GateHintController:_gatePosition(): Vector3?\n\tlocal map = workspace:FindFirstChild(\"CornMap\")\n\tif\n\t\tnot map\n\t\tor not map:IsA(\"Model\")\n\t\tor map:GetAttribute(\"corn_project_id\") ~= \"children_of_corn\"\n\tthen\n\t\treturn nil\n\tend\n\tlocal gate = map:FindFirstChild(\"EscapeGate\")\n\tif not gate or not gate:IsA(\"Model\") or not gate:HasTag(\"corn_gate\") then\n\t\treturn nil\n\tend\n\tlocal anchor = gate:FindFirstChild(\"InteractionAnchor\")\n\treturn if anchor and anchor:IsA(\"BasePart\") then anchor\046Position else nil\nend\n\nfunction GateHintController:_canShow(position: Vector3?, anchor: Vector3?, alive: boolean): boolean\n\tif not eligible(self\046_snapshot) or not alive or not position or not anchor then\n\t\treturn false\n\tend\n\tlocal delta = position - anchor\n\tlocal radius = if self\046_shown then EXIT_RADIUS else ENTER_RADIUS\n\treturn math\046abs(delta\046Y) <= HEIGHT_TOLERANCE\n\t\tand delta\046X * delta\046X + delta\046Z * delta\046Z <= radius * radius\nend\n\nfunction GateHintController:_update()\n\tself:_blinkBeacon(os\046clock())\n\tlocal position = nil\n\tlocal alive = false\n\tlocal character = player\046Character\n\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tif root and root:IsA(\"BasePart\") and humanoid and humanoid\046Health > 0 then\n\t\tposition = root\046Position\n\t\talive = true\n\tend\n\tself:_show(self:_canShow(position, self:_gatePosition(), alive))\n\tlocal camera = workspace\046CurrentCamera\n\tif camera then\n\t\tlocal topLeft, bottomRight = GuiService:GetGuiInset()\n\t\tlocal viewport = camera\046ViewportSize - topLeft - bottomRight\n\t\tself\046_scale\046Scale = math\046min(1, math\046max(0\0461, (viewport\046X - 24) / PANEL_WIDTH))\n\tend\nend\n\nfunction GateHintController:Start(_context: any)\n\tif self\046_connection then\n\t\treturn\n\tend\n\tself\046_connection = RunService\046RenderStepped:Connect(function(dt: number)\n\t\tself\046_elapsed += dt\n\t\tif self\046_elapsed >= UPDATE_INTERVAL then\n\t\t\tself\046_elapsed = 0\n\t\t\tself:_update()\n\t\tend\n\tend)\nend\n\nfunction GateHintController:Destroy()\n\tself:_restoreBeacon()\n\tself\046_beaconRefused = nil\n\tif self\046_connection then\n\t\tself\046_connection:Disconnect()\n\t\tself\046_connection = nil\n\tend\n\tself:_show(false)\n\tif self\046_gui then\n\t\tself\046_gui:Destroy()\n\t\tself\046_gui = nil\n\tend\n\tself\046_snapshot = nil\nend\n\nreturn GateHintController\n"},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/HandheldController",class="ModuleScript",hash="7429e3ffa954cb6df04f816a7eb4fcf639f5c0686b0bc7eddedc7f4fc5550e9e",history={"aae36a2f2a7a5729dc2d966d121d530efd9bfd285677792a202a16d82c0fe214","be4034561bf2869128bf13c107442372b3d1e309d2c7b2731ea6f973d0198cde"},source="--!strict\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\")\nlocal Inventory = require(Shared:WaitForChild(\"Inventory\"))\nlocal Presentation = require(Shared:WaitForChild(\"HandheldPresentation\"))\nlocal player = Players\046LocalPlayer\nlocal MODEL_NAME = \"CornHandheld\"\nlocal PROJECT = \"children_of_corn\"\nlocal BINDING = \"CornHandheldPresentation\"\nlocal Controller = { Name = \"HandheldController\", Order = 97 }\n\nfunction Controller:Init(_context: any)\n\tself\046_snapshot = nil\n\tself\046_roundId = -1\n\tself\046_useId = 0\n\tself\046_endedRound = nil\n\tself\046_gesture = nil\n\tself\046_visual = nil\n\tself\046_camera = nil\n\tself\046_character = nil\n\tself\046_kind = nil\n\tself\046_minimap = nil\n\tself\046_capture = nil\n\tself\046_connections = {}\n\tself\046_bound = false\n\tself\046_generation = 0\n\tself\046_refused = nil\nend\n\nfunction Controller:_clearVisual()\n\tlocal model = self\046_visual\n\tself\046_visual = nil\n\tself\046_kind = nil\n\tself\046_character = nil\n\tself\046_camera = nil\n\tif model then\n\t\tif\n\t\t\tmodel:GetAttribute(\"CornHandheldOwned\") == true\n\t\t\tand model:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\tand model:GetAttribute(\"HandheldVersion\") == 1\n\t\tthen\n\t\t\tmodel:Destroy()\n\t\telse\n\t\t\twarn(\"[HandheldController] Changed held model preserved\")\n\t\tend\n\tend\nend\n\nfunction Controller:_cancelGesture()\n\tself\046_gesture = nil\n\tself\046_generation += 1\nend\n\nfunction Controller:Clear(_reason: string?)\n\tself\046_snapshot = nil\n\tself:_cancelGesture()\n\tself:_clearVisual()\nend\n\nfunction Controller:_livingCharacter(): (Model?, Humanoid?)\n\tlocal character = player\046Character\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\tif character and humanoid and humanoid\046Health > 0 and root and root:IsA(\"BasePart\") then\n\t\treturn character, humanoid\n\tend\n\treturn nil, nil\nend\n\nfunction Controller:_canShow(camera: Camera?, humanoid: Humanoid?): boolean\n\treturn self\046_snapshot ~= nil\n\t\tand self\046_snapshot\046phase == \"active\"\n\t\tand camera ~= nil\n\t\tand humanoid ~= nil\n\t\tand camera\046CameraType == Enum\046CameraType\046Custom\n\t\tand camera\046CameraSubject == humanoid\n\t\tand camera:GetAttribute(\"CornCaptureCameraOwner\") == nil\n\t\tand player\046CameraMode == Enum\046CameraMode\046LockFirstPerson\n\t\tand not GuiService\046MenuIsOpen\n\t\tand not (self\046_minimap and self\046_minimap\046_expanded)\n\t\tand not (self\046_capture and self\046_capture\046_state\046active)\nend\n\nlocal function skin(character: Model, side: string): Color3\n\tfor _, name in { side \046\046 \"Hand\", side \046\046 \" Arm\", side \046\046 \"LowerArm\" } do\n\t\tlocal part = character:FindFirstChild(name)\n\t\tif part and part:IsA(\"BasePart\") then\n\t\t\treturn part\046Color\n\t\tend\n\tend\n\treturn Color3\046fromRGB(191, 145, 110)\nend\n\nfunction Controller:_buildVisual(kind: string, camera: Camera, character: Model): boolean\n\tlocal existing = camera:FindFirstChild(MODEL_NAME)\n\tif existing then\n\t\tif self\046_refused ~= existing then\n\t\t\tself\046_refused = existing\n\t\t\twarn(\"[HandheldController] Existing held model refused; unknown ownership/state\")\n\t\tend\n\t\treturn false\n\tend\n\tlocal definitions = Presentation\046Definitions(kind)\n\tif #definitions == 0 then\n\t\treturn false\n\tend\n\tassert(#definitions + #Presentation\046Hands + 1 <= 24, \"Held geometry exceeds24parts\")\n\tlocal model = Instance\046new(\"Model\")\n\tmodel\046Name = MODEL_NAME\n\tmodel:SetAttribute(\"CornHandheldOwned\", true)\n\tmodel:SetAttribute(\"corn_project_id\", PROJECT)\n\tmodel:SetAttribute(\"HandheldVersion\", 1)\n\tmodel:SetAttribute(\"ItemKind\", kind)\n\tlocal function part(\n\t\tname: string,\n\t\tsize: Vector3,\n\t\tframe: CFrame,\n\t\tcolor: Color3,\n\t\tmaterial: Enum\046Material,\n\t\tshape: Enum\046PartType?\n\t): Part\n\t\tlocal item = Instance\046new(\"Part\")\n\t\titem\046Name = name\n\t\titem\046Size = size\n\t\titem\046CFrame = frame\n\t\titem\046Color = color\n\t\titem\046Material = material\n\t\tif shape then\n\t\t\titem\046Shape = shape\n\t\tend\n\t\titem\046Anchored = true\n\t\titem\046CanCollide = false\n\t\titem\046CanTouch = false\n\t\titem\046CanQuery = false\n\t\titem\046CastShadow = false\n\t\titem\046Parent = model\n\t\treturn item\n\tend\n\tlocal anchor = part(\n\t\t\"Anchor\",\n\t\tVector3\046new(0\04608, 0\04608, 0\04608),\n\t\tCFrame\046identity,\n\t\tColor3\046new(),\n\t\tEnum\046Material\046SmoothPlastic,\n\t\tnil\n\t)\n\tanchor\046Transparency = 1\n\tmodel\046PrimaryPart = anchor\n\tfor _, definition in definitions do\n\t\tlocal item = part(\n\t\t\tdefinition\046name,\n\t\t\tdefinition\046size,\n\t\t\tdefinition\046localFrame,\n\t\t\tdefinition\046color,\n\t\t\tdefinition\046material,\n\t\t\tdefinition\046shape\n\t\t)\n\t\tif kind == \"energy\" and definition\046name == \"Can\" then\n\t\t\tlocal label = Instance\046new(\"SurfaceGui\")\n\t\t\tlabel\046Name = \"EnergyLabel\"\n\t\t\tlabel\046Face = Enum\046NormalId\046Back\n\t\t\tlabel\046AlwaysOnTop = false\n\t\t\tlabel\046LightInfluence = 0\n\t\t\tlabel\046Active = false\n\t\t\tlabel\046SizingMode = Enum\046SurfaceGuiSizingMode\046FixedSize\n\t\t\tlabel\046CanvasSize = Vector2\046new(256, 256)\n\t\t\tlabel\046Parent = item\n\t\t\tlocal paper = Instance\046new(\"Frame\")\n\t\t\tpaper\046Name = \"Paper\"\n\t\t\tpaper\046AnchorPoint = Vector2\046new(0\0465, 0\0465)\n\t\t\tpaper\046Position = UDim2\046fromScale(0\0465, 0\0465)\n\t\t\tpaper\046Size = UDim2\046fromScale(0\0468, 0\0468)\n\t\t\tpaper\046Rotation = 90\n\t\t\tpaper\046BackgroundColor3 = Color3\046fromRGB(33, 135, 69)\n\t\t\tpaper\046BorderSizePixel = 0\n\t\t\tpaper\046Parent = label\n\t\t\tlocal corner = Instance\046new(\"UICorner\")\n\t\t\tcorner\046CornerRadius = UDim\046new(0, 12)\n\t\t\tcorner\046Parent = paper\n\t\t\tlocal logo = Instance\046new(\"TextLabel\")\n\t\t\tlogo\046Name = \"Logo\"\n\t\t\tlogo\046Size = UDim2\046fromScale(1, 0\0466)\n\t\t\tlogo\046Position = UDim2\046fromScale(0, 0\04604)\n\t\t\tlogo\046BackgroundTransparency = 1\n\t\t\tlogo\046Font = Enum\046Font\046GothamBold\n\t\t\tlogo\046TextSize = 100\n\t\t\tlogo\046TextColor3 = Color3\046new(1, 1, 1)\n\t\t\tlogo\046Text = \"+\"\n\t\t\tlogo\046Parent = paper\n\t\t\tlocal name = logo:Clone()\n\t\t\tname\046Name = \"Name\"\n\t\t\tname\046Size = UDim2\046fromScale(1, 0\04622)\n\t\t\tname\046Position = UDim2\046fromScale(0, 0\04668)\n\t\t\tname\046TextSize = 30\n\t\t\tname\046Text = \"ENERGY\"\n\t\t\tname\046Parent = paper\n\t\tend\n\tend\n\tfor _, hand in Presentation\046Hands do\n\t\tpart(\n\t\t\thand\046name,\n\t\t\thand\046size,\n\t\t\thand\046localFrame,\n\t\t\tskin(character, if string\046find(hand\046name, \"Left\", 1, true) then \"Left\" else \"Right\"),\n\t\t\tEnum\046Material\046SmoothPlastic,\n\t\t\tnil\n\t\t)\n\tend\n\tself\046_visual, self\046_camera, self\046_character, self\046_kind = model, camera, character, kind\n\tself\046_refused = nil\n\tmodel\046Parent = camera\n\treturn true\nend\n\nfunction Controller:_step(now: number)\n\tlocal camera = workspace\046CurrentCamera\n\tlocal character, humanoid = self:_livingCharacter()\n\tif not self:_canShow(camera, humanoid) then\n\t\tself:_cancelGesture()\n\t\tself:_clearVisual(