dy = true,\n\tpreparing = true,\n\tactive = true,\n\tescaped = true,\n\taborted = true,\n\tcaught = true,\n\tcaught_out = true,\n}\nlocal ACTIONS: { [string]: boolean } = {\n\tstart = true,\n\tretry = true,\n\tabort = true,\n\tmenu = true,\n\trevive = true,\n}\nlocal DEBOUNCE_SEC = 0\04655\nlocal REMOTE_WAIT_SEC = 10\n\nlocal function nonnegativeNumber(value: any): boolean\n\treturn typeof(value) == \"number\" and value == value and value >= 0 and value < math\046huge\nend\n\nlocal function validSnapshot(value: any): boolean\n\treturn typeof(value) == \"table\"\n\t\tand LightingModes\046IsValid(value\046lighting_mode)\n\t\tand MinimapGeometry\046IsValid(value\046minimap)\n\t\tand Inventory\046IsValidSnapshot(value\046inventory)\n\t\tand Capture\046IsValidSnapshot(value\046capture)\n\t\tand typeof(value\046phase) == \"string\"\n\t\tand PHASES[value\046phase] == true\n\t\tand (value\046phase == \"caught\" or value\046capture\046remaining == 0)\n\t\tand typeof(value\046has_key) == \"boolean\"\n\t\tand typeof(value\046gate_open) == \"boolean\"\n\t\tand (value\046evacuation == nil or (typeof(value\046evacuation) == \"table\" and typeof(\n\t\t\tvalue\046evacuation\046active\n\t\t) == \"boolean\" and value\046evacuation\046duration == 120 and nonnegativeNumber(\n\t\t\tvalue\046evacuation\046remaining\n\t\t) and value\046evacuation\046remaining <= 120 and (value\046evacuation\046active or value\046evacuation\046remaining == 0)))\n\t\tand nonnegativeNumber(value\046session_diamonds)\n\t\tand nonnegativeNumber(value\046reward_diamonds)\n\t\tand nonnegativeNumber(value\046elapsed_sec)\n\t\tand typeof(value\046notice) == \"string\"\n\t\tand nonnegativeNumber(value\046stamina)\n\t\tand nonnegativeNumber(value\046stamina_capacity)\n\t\tand value\046stamina_capacity > 0\n\t\tand value\046stamina <= value\046stamina_capacity\n\t\tand typeof(value\046is_sprinting) == \"boolean\"\n\t\tand typeof(value\046sprint_exhausted) == \"boolean\"\n\t\tand nonnegativeNumber(value\046catches_rem