action == \"start\" or action == \"retry\") and not LightingModes\046IsValid(mode) then\n\t\treturn\n\tend\n\tif action == \"start\" and self\046_snapshot\046phase ~= \"ready\" then\n\t\treturn\n\tend\n\tif\n\t\taction == \"revive\"\n\t\tand (\n\t\t\tmode ~= nil\n\t\t\tor self\046_snapshot\046phase ~= \"caught\"\n\t\t\tor self\046_snapshot\046capture\046remaining ~= 0\n\t\t\tor self\046_snapshot\046catches_remaining ~= 1\n\t\t\tor hud\046_captureActive\n\t\t)\n\tthen\n\t\treturn\n\tend\n\tif\n\t\taction == \"retry\"\n\t\tand self\046_snapshot\046phase ~= \"escaped\"\n\t\tand self\046_snapshot\046phase ~= \"aborted\"\n\t\tand self\046_snapshot\046phase ~= \"caught_out\"\n\tthen\n\t\treturn\n\tend\n\tlocal now = os\046clock()\n\tif now - self\046_lastRequest < DEBOUNCE_SEC then\n\t\treturn\n\tend\n\tself\046_lastRequest = now\n\thud:SetBusy(true)\n\tremote:FireServer(action, mode)\n\t-- Only the server changes the view\046 A rejected request must not leave buttons stuck\046\n\ttask\046delay(DEBOUNCE_SEC, function()\n\t\tif self\046_hud == hud then\n\t\t\thud:SetBusy(false)\n\t\tend\n\tend)\nend\n\nfunction RoundController:Start(context: any)\n\tlocal hud = self\046_hud\n\tif not hud then\n\t\treturn\n\tend\n\tlocal folder = ReplicatedStorage:WaitForChild(\"GameRemotes\", REMOTE_WAIT_SEC)\n\tif not folder or not folder:IsA(\"Folder\") then\n\t\twarn(\"[RoundController] GameRemotes is unavailable; check RoundService startup in Output\")\n\t\thud:ShowUnavailable()\n\t\treturn\n\tend\n\tlocal requestRemote = getRemote(folder, EndpointNames\046RequestRoundAction)\n\tlocal snapshotRemote = getRemote(folder, EndpointNames\046RoundSnapshot)\n\tif not requestRemote or not snapshotRemote then\n\t\thud:ShowUnavailable()\n\t\treturn\n\tend\n\tself\046_requestRemote = requestRemote\n\tself\046_snapshotConnection = snapshotRemote\046OnClientEvent:Connect(function(payload: any)\n\t\tif not validSnapshot(payload) then\n\t\t\tself\046_snapshot = nil\n\t\t\thud:ShowUnavailable()\n\t\t\