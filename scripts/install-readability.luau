{path="ReplicatedStorage/GameShared/Game/MonsterPose",class="ModuleScript",hash="aeb74cb60e7305700cac226c29fab3252f03c40df8fed08dc230c3b98246f428",history={"af5d152200ce231fb704733ee767dd9bdf845750a4a83fb7eec9d0f7fb26836d"},source="--!strict\n\nlocal MonsterPose = {}\nlocal cf, v3 = CFrame\046new, Vector3\046new\nMonsterPose\046HeightScale = 1\0463\nMonsterPose\046FeetY = -3\nfunction MonsterPose\046ScalePosition(position: Vector3): Vector3\n\treturn v3(\n\t\tposition\046X,\n\t\t(position\046Y - MonsterPose\046FeetY) * MonsterPose\046HeightScale + MonsterPose\046FeetY,\n\t\tposition\046Z\n\t)\nend\nlocal function rest(x: number, y: number, z: number): CFrame\n\treturn cf(MonsterPose\046ScalePosition(v3(x, y, z)))\nend\nlocal cloth = Color3\046fromRGB(54, 43, 30)\nlocal head = Color3\046fromRGB(101, 76, 45)\nlocal eye = Color3\046fromRGB(235, 138, 49)\nlocal definitions = {\n\t{\n\t\tName = \"Coat\",\n\t\tSize = v3(4, 7, 2),\n\t\tColor = Color3\046fromRGB(35, 32, 28),\n\t\tMaterial = Enum\046Material\046Fabric,\n\t},\n\t{ Name = \"LeftArm\", Size = v3(4, 1\0464, 1\0464), Color = cloth, Material = Enum\046Material\046Plastic },\n\t{ Name = \"RightArm\", Size = v3(4, 1\0464, 1\0464), Color = cloth, Material = Enum\046Material\046Plastic },\n\t{\n\t\tName = \"LeftLeg\",\n\t\tSize = v3(1\0461, 3, 1\0461),\n\t\tColor = Color3\046fromRGB(32, 29, 25),\n\t\tMaterial = Enum\046Material\046Plastic,\n\t},\n\t{\n\t\tName = \"RightLeg\",\n\t\tSize = v3(1\0461, 3, 1\0461),\n\t\tColor = Color3\046fromRGB(32, 29, 25),\n\t\tMaterial = Enum\046Material\046Plastic,\n\t},\n\t{ Name = \"Head\", Size = v3(2\0465, 2\0465, 2\0465), Color = head, Material = Enum\046Material\046Plastic },\n\t{\n\t\tName = \"Hat\",\n\t\tSize = v3(5, 0\0466, 4),\n\t\tColor = Color3\046fromRGB(24, 23, 21),\n\t\tMaterial = Enum\046Material\046Plastic,\n\t},\n\t{ Name = \"LeftEye\", Size = v3(0\0463, 0\0463, 0\0461), Color = eye, Material = Enum\046Material\046Neon },\n\t{ Name = \"RightEye\", Size = v3(0\0463, 0\0463, 0\0461), Color = eye, Material = Enum\046Material\046Neon },\n}\nfor _, definition in definitions do\n\tdefinition\046Size =\n\t\tv3(definition\046Size\046X, definition\046Size\046Y * MonsterPose\046HeightScale, definition\046Size\046Z)\n\ttable\046freeze(definition)\nend\nMonsterPose\046Parts = table\046freeze(definitions)\nMonsterPose\046Rest = table\046freeze({\n\tCoat = rest(0, 1\0465, 0),\n\tLeftArm = rest(-3\0465, 3, 0),\n\tRightArm = rest(3\0465, 3, 0),\n\tLeftLeg = rest(-1, -1\0465, 0),\n\tRightLeg = rest(1, -1\0465, 0),\n\tHead = rest(0, 6, 0),\n\tHat = rest(0, 7\0465, 0),\n\tLeftEye = rest(-0\04655, 6\0462, -1\0463),\n\tRightEye = rest(0\04655, 6\0462, -1\0463),\n})\n\nlocal function around(pivot: Vector3, x: number, y: number, z: number): CFrame\n\tpivot = MonsterPose\046ScalePosition(pivot)\n\treturn cf(pivot) * CFrame\046Angles(x, y, z) * cf(-pivot)\nend\n\nfunction MonsterPose\046Get(state: string, time: number, moving: boolean): { [string]: CFrame }\n\tif time ~= time or math\046abs(time) == math\046huge then\n\t\treturn MonsterPose\046Rest\n\tend\n\tif state ~= \"patrol\" and state ~= \"chase\" and state ~= \"trapped\" and state ~= \"capturing\" then\n\t\treturn MonsterPose\046Rest\n\tend\n\tlocal pose = table\046clone(MonsterPose\046Rest)\n\tlocal step, reach, shoulder, headYaw, headPitch, roll = 0, 0, 0, 0, 0, 0\n\tif state == \"patrol\" then\n\t\tstep = if moving then math\046sin(time * 3\0462) * math\046rad(18) else 0\n\t\tshoulder = math\046rad(24)\n\t\theadYaw = math\046sin(time * 0\04685) * math\046rad(16)\n\telseif state == \"chase\" then\n\t\tstep = if moving then math\046sin(time * 5\0465) * math\046rad(28) else 0\n\t\treach, shoulder = math\046rad(66), math\046rad(8)\n\t\theadPitch = math\046rad(-6)\n\t\theadYaw = math\046sin(time * 2\0465) * math\046rad(3)\n\telseif state == \"trapped\" then\n\t\tstep = math\046sin(time * 6) * math\046rad(5)\n\t\treach = math\046rad(28) + math\046sin(time * 4\0465) * math\046rad(10)\n\t\tshoulder = math\046rad(20) + math\046sin(time * 7) * math\046rad(8)\n\t\theadYaw, roll = math\046sin(time * 5) * math\046rad(12), math\046sin(time * 6) * math\046rad(3)\n\telse\n\t\tlocal progress = math\046clamp(time / 0\0463, 0, 1)\n\t\tlocal eased = progress * progress * (3 - 2 * progress)\n\t\treach = math\046rad(78) * eased\n\t\tshoulder, headPitch = math\046rad(5) * eased, math\046rad(-9) * eased\n\tend\n\tpose\046Coat = around(v3(0, 0, 0), 0, 0, roll) * MonsterPose\046Rest\046Coat\n\tfor _, side in { -1, 1 } do\n\t\tlocal armName = if side < 0 then \"LeftArm\" else \"RightArm\"\n\t\tlocal legName = if side < 0 then \"LeftLeg\" else \"RightLeg\"\n\t\tpose[armName] = around(\n\t\t\tv3(side * 1\0465, 3, 0),\n\t\t\tstep * side * 0\0463,\n\t\t\treach * side,\n\t\t\t-shoulder * side\n\t\t) * MonsterPose\046Rest[armName]\n\t\tpose[legName] = around(v3(side, 0, 0), step * side, 0, 0) * MonsterPose\046Rest[legName]\n\tend\n\tlocal headTransform = around(v3(0, 4\04675, 0), headPitch, headYaw, roll)\n\tfor _, name in { \"Head\", \"Hat\", \"LeftEye\", \"RightEye\" } do\n\t\tpose[name] = headTransform * MonsterPose\046Rest[name]\n\tend\n\treturn pose\nend\n\nreturn table\046freeze(MonsterPose)\n"},
