local pose = Pose\046Get(\"capturing\", elapsed, false)\n\tlocal frame = self\046_state\046frame * PRESENTATION_OFFSET\n\tlocal headShake = pose\046Head * Capture\046HeadShake(elapsed) * pose\046Head:Inverse()\n\tfor name, part in self\046_parts do\n\t\tpart\046CFrame = frame * (if HEAD_PARTS[name] then headShake * pose[name] else pose[name])\n\tend\n\tlocal face = self\046_parts\046Head\046CFrame\n\tlocal opening = Capture\046MouthOpen(elapsed)\n\tlocal height = 1\0463 * opening\n\tself\046_mouthParts\046OpenMouth\046Size = Vector3\046new(1\04685, height, 0\04614)\n\tself\046_mouthParts\046OpenMouth\046CFrame = face * CFrame\046new(0, -0\04615 - height / 2, -1\04634)\n\tself\046_mouthParts\046LowerJaw\046CFrame = face * CFrame\046new(0, -0\0463 - height, -1\04634)\n\tself\046_mouthParts\046UpperTeeth\046CFrame = face * CFrame\046new(0, -0\04619, -1\04644)\n\tself\046_mouthParts\046LowerTeeth\046CFrame = face * CFrame\046new(0, -0\04608 - height, -1\04644)\n\tlocal opacity = Capture\046PaintOpacity(elapsed)\n\tfor _, drop in self\046_paintDrops do\n\t\tif\n\t\t\tself\046_paint\n\t\t\tand paintOwned(self\046_paint)\n\t\t\tand drop\046Parent == self\046_paint\n\t\t\tand paintOwned(drop)\n\t\tthen\n\t\t\tdrop\046BackgroundTransparency = 1 - opacity\n\t\tend\n\tend\n\tlocal progress = Capture\046Progress(self\046_state, now)\n\tlocal eased = progress * progress * (3 - 2 * progress)\n\tlocal head = (frame * pose\046Head)\046Position\n\tlocal distance = 8 - 5\04635 * eased\n\tlocal position = head + frame\046LookVector * distance - frame\046UpVector * (0\04625 * eased)\n\tlocal target = head + frame\046LookVector * 1\04605 - frame\046UpVector * (0\0466 * eased)\n\tcamera\046CFrame = CFrame\046lookAt(position, target, frame\046UpVector) * Capture\046CameraShake(elapsed)\n\tcamera\046Focus = CFrame\046new(target)\n\tcamera\046FieldOfView = 70 - 8 * eased\nend\n\nfunction Controller:_scheduleDeadline()\n\tlocal generation = self\046_generation\n\ttask\046delay(math\046max(0, self\046_state\046deadline - os\046clock()), function()\n\t\tif\n\t\t\tself\046_generation == generation\n\t\t\tand self\046_state\046active\n\t\t\tand os\046clock() >= self\046_state\046deadline\n\t\tthen\n\t\t\tself:Cancel(\"wall-clock deadline\")\n\t\tend\n\tend)\nend\n\nfunction Controller:_begin(): boolean\n\tlocal camera = workspace\046CurrentCamera\n\tlocal character, humanoid = self:_livingCharacter()\n\tif\n\t\tGuiService\046MenuIsOpen\n\t\tor not camera\n\t\tor not humanoid\n\t\tor camera:GetAttribute(CAMERA_OWNER) ~= nil\n\tthen\n\t\treturn false\n\tend\n\tif not self:_buildVisual(self\046_state\046frame) then\n\t\treturn false\n\tend\n\tself:_hideServerRig()\n\tself:_buildPaint()\n\tself\046_generation += 1\n\tself\046_token = HttpService:GenerateGUID(false)\n\tself\046_saved = {\n\t\tcamera = camera,\n\t\tcameraType = camera\046CameraType,\n\t\tsubject = camera\046CameraSubject,\n\t\tfieldOfView = camera\046FieldOfView,\n\t\tframe = camera\046CFrame,\n\t\tfocus = camera\046Focus,\n\t\tcharacter = character,\n\t}\n\tcamera:SetAttribute(CAMERA_OWNER, self\046_token)\n\tself:_presentation(true)\n\tcamera\046CameraType = Enum\046CameraType\046Scriptable\n\tRunService:BindToRenderStep(BINDING, Enum\046RenderPriority\046Camera\046Value + 1, function()\n\t\tself:_step(os\046clock())\n\tend)\n\tself\046_bound = true\n\tself:_step(os\046clock())\n\tself:_scheduleDeadline()\n\treturn true\nend\n\nfunction Controller:SetSnapshot(snapshot: any)\n\tlocal previousDeadline = self\046_state\046deadline\n\tlocal roundId = if type(snapshot) == \"table\" and type(snapshot\046minimap) == \"table\"\n\t\tthen snapshot\046minimap\046round_id\n\t\telse nil\n\tlocal capture = if type(snapshot) == \"table\" then snapshot\046capture else nil\n\tlocal phase = if type(snapshot) == \"table\" then snapshot\046phase else nil\n\tlocal action = Capture\046Observe(self\046_state, roundId, capture, phase, os\046clock())\n\tself\046_snapshot = if type(snapshot) == \"table\" then snapshot else nil\n\tif action == \"cancel\" then\n\t\tself:Cancel(\"snapshot\")\n\telseif action == \"begin\" then\n\t\t-- Release the previous owned effect before replacing its confirmed identity\046\n\t\tif self\046_saved then\n\t\t\tlocal confirmedState = self\046_state\n\t\t\tself\046_state = Capture\046NewState()\n\t\t\tself:Cancel(\"new capture\")\n\t\t\tself\046_state = confirmedState\n\t\tend\n\t\tif not self:_begin() then\n\t\t\tself:Cancel(\"unavailable\")\n\t\tend\n\telseif action == \"keep\" and self\046_state\046deadline < previousDeadline - 0\046001 then\n\t\tself:_scheduleDeadline()\n\tend\nend\n\nfunction Controller:_watchDeath(character: Model?)\n\tif self\046_deathConnection then\n\t\tself\046_deathConnection:Disconnect()\n\t\tself\046_deathConnection = nil\n\tend\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tif humanoid then\n\t\tself\046_deathConnection = humanoid\046Died:Connect(function()\n\t\t\tself:Cancel(\"death\")\n\t\tend)\n\tend\nend\n\nfunction Controller:Start(context: any)\n\tself\046_movement = context\046Controllers\046MovementController\n\tself\046_minimap = context\046Controllers\046MinimapController\n\tself\046_round = context\046Controllers\046RoundController\n\tself:_watchDeath(player\046Character)\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tGuiService\046MenuOpened:Connect(function()\n\t\t\tself:Cancel(\"menu\")\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tplayer\046CharacterRemoving:Connect(function()\n\t\t\tself:Cancel(\"reset\")\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tplayer\046CharacterAdded:Connect(function(character)\n\t\t\tself:Cancel(\"respawn\")\n\t\t\tself:_watchDeath(character)\n\t\tend)\n\t)\nend\n\nfunction Controller:Destroy()\n\tself:Cancel(\"destroy\")\n\tif self\046_deathConnection then\n\t\tself\046_deathConnection:Disconnect()\n\t\tself\046_deathConnection = nil\n\tend\n\tfor _, connection in self\046_connection