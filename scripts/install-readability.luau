6deathConnection then\n\t\tself\046deathConnection:Disconnect()\n\t\tself\046deathConnection = nil\n\tend\n\tif\n\t\tself\046phase == \"active\"\n\t\tor self\046phase == \"caught\"\n\t\tor (self\046phase == \"preparing\" and self\046roundCharacter ~= nil)\n\tthen\n\t\tself:_recordCharacterDeath(self\046roundCharacter)\n\t\tself:_finish(\"aborted\", \"corn_loop_result_aborted\")\n\tend\n\ttask\046spawn(function()\n\t\tlocal humanoid = character:WaitForChild(\"Humanoid\", 10)\n\t\tlocal root = character:WaitForChild(\"HumanoidRootPart\", 10)\n\t\tlocal player = self\046player\n\t\tif not player or player\046Character ~= character or self\046boundCharacter ~= character then\n\t\t\treturn\n\t\tend\n\t\tif not humanoid or not humanoid:IsA(\"Humanoid\") or not root or not root:IsA(\"BasePart\") then\n\t\t\tself:_finish(\"aborted\", \"corn_loop_setup_error\")\n\t\t\treturn\n\t\tend\n\t\tself\046deathConnection = humanoid\046Died:Connect(function()\n\t\t\tif self\046player and self\046player\046Character == character then\n\t\t\t\tself:_recordCharacterDeath(character)\n\t\t\t\tself:_finish(\"aborted\", \"corn_loop_result_aborted\")\n\t\t\tend\n\t\tend)\n\t\tif self\046phase ~= \"active\" and self\046phase ~= \"preparing\" then\n\t\t\tself:_moveToStart(character)\n\t\tend\n\t\tself:_controls(self\046phase == \"active\" and self\046roundCharacter == character)\n\t\tself:_send()\n\tend)\nend\n\nfunction SoloRound:_addPlayer(player: Player)\n\tif self\046player then\n\t\treturn -- One owner, no multiplayer matchmaking in this prototype\046\n\tend\n\tself\046player = player\n\tself:_setRespawnLocation()\n\tself\046requestTokens = 2\n\tself\046requestAt = os\046clock()\n\tself\046characterConnection = player\046CharacterAdded:Connect(function(character: Model)\n\t\tself:_bindCharacter(character)\n\tend)\n\tself\046characterRemovingConnection = player\046CharacterRemoving:Connect(function(character: Model)\n\t\tif\n\t\t\tplayer == self\046player\n\t\t\tand (character == self\046boundCharacter or character == player\046Character)\n\t\tthen\n\t\t\tself:_recordCharacterDeath(character)\n\t\t\tself:_finish(\"aborted\", \"corn_loop_result_aborted\")\n\t\tend\n\tend)\n\tif player\046Character then\n\t\tself:_bindCharacter(player\046Character)\n\tend\n\tself:_send()\nend\n\nfunction SoloRound:_removePlayer(player: Player)\n\tif player ~= self\046player then\n\t\treturn\n\tend\n\tself\046epoch += 1\n\tself\046evacuationActive, self\046evacuationDeadline = false, nil\n\tself:_clearKey()\n\tself:_clearInventory()\n\tif self\046characterConnection then\n\t\tself\046characterConnection:Disconnect()\n\t\tself\046characterConnection = nil\n\tend\n\tif self\046deathConnection then\n\t\tself\046deathConnection:Disconnect()\n\t\tself\046deathConnection = nil\n\tend\n\tif self\046characterRemovingConnection then\n\t\tself\046characterRemovingConnection:Disconnect()\n\t\tself\046characterRemovingConnection = nil\n\tend\n\tself\046player = nil\n\tself\046minimap:ClearHistory()\n\tself:_restoreLighting()\n\tself\046lightingMode = LightingModes\046Default\n\tself:_stopHunt()\n\tself\046catches = 0\n\tself\046captureUntil = 0\n\tself\046captureFrame = CFrame\046identity\n\tself\046protectedUntil = 0\n\tself\046stamina = Stamina\046new(self\046balance\046stamina_capacity, os\046clock())\n\tself\046phase = \"ready\"\n\tself\046hasKey = false\n\tself\046gateOpen = false\n\tself\046diamonds = 0\n\tself\046reward = 0\n\tself\046startedAt = nil\n\tself\046elapsed = 0\n\tself\046notice = \"\"\n\tself\046roundCharacter = nil\n\tself\046boundCharacter = nil\n\tself\046controlledCharacter = nil\n\tif self\046world then\n\t\tself\046world:SetGateOpen(false)\n\t\tself\046world:SetInteractionEnabled(false, false)\n\tend\nend\n\nfunction SoloRound:_poll(now: number)\n\tif self:_expireEvacuation(now) then\n\t\treturn\n\tend\n\tif self\046phase ~= \"active\" then\n\t\tif self\046phase == \"caught\" and self\046audio then\n\t\t\tself\046audio:Step(now, self\046phase, self\046lightingMode, self\046hunt, self:_hunts())\n\t\tend\n\t\tif self\046phase == \"caught\" and self\046evacuationActive and now - self\046snapshotAt >= 0\04625 then\n\t\t\tself\046snapshotAt = now\n\t\t\tself:_send()\n\t\tend\n\t\treturn\n\tend\n\tlocal character, _, root = self:_livingCharacter()\n\tif not character or character ~= self\046roundCharacter or not root then\n\t\tlocal roundCharacter = self\046roundCharacter\n\t\tlocal humanoid = if roundCharacter\n\t\t\tthen roundCharacter:FindFirstChildOfClass(\"Humanoid\")\n\t\t\telse nil\n\t\tif humanoid and humanoid\046Health <= 0 then\n\t\t\tself:_recordCharacterDeath(roundCharacter)\n\t\tend\n\t\tself:_finish(\"aborted\", \"corn_loop_result_aborted\")\n\t\treturn\n\tend\n\tif\n\t\tnot self\046world\n\t\tor not self\046world:IsValid()\n\t\tor not self\046world:IsOnPlayground(root\046Position)\n\tthen\n\t\tself:_finish(\"aborted\", \"corn_loop_setup_error\")\n\t\treturn\n\tend\n\t-- A visit and capture in the same tick both belong to this pre-teleport position\046\n\tself\046minimap:Poll(self\046world, root\046Position)\n\tfor _, hunt in self:_hunts() do\n\t\tlocal previous = hunt:GetPosition()\n\t\tif self\046items then\n\t\t\tself\046items:CheckTraps(hunt, previous, now)\n\t\tend\n\t\tlocal caught, awakened = hunt:Step(now - self\046huntAt, now, root, now < self\046protectedUntil)\n\t\tif self\046items and self\046items:CheckTraps(hunt, previous, now) then\n\t\t\tcaught = false\n\t\tend\n\t\tif awakened then\n\t\t\tself\046notice = \"corn_hunt_awakened\"\n\t\tend\n\t\tif caught then\n\t\t\tself:_caught(root, hunt)\n\t\t\treturn\n\t\tend\n\tend\n\tself\046huntAt = now\n\tif self\046audio then\n\t\tself\046audio:Step(now, self\046phase, self\046lightingMode, self:_audioLeader(root), self:_hunts())\n\tend\n\tif self\046gateOpen and self\046world:IsInExit(root\046Position) then\n\t\tself:_finish(\"escaped\", \"\")\n\t\treturn\n\tend\n\tif now - self\046snapshotAt >= 0\04625 then\n\t\tself\046snapshotAt = now\n\t\tself:_send()\n\tend\nend\n\nfunction SoloRound:_sprintRequest(player: Player, value: any)\n\tif player ~= self\046player then\n\t\treturn\n\tend\n\tlocal character = self:_livingCharacter()\n\tStamina\046Request(\n\t\tself\046stamina,\n\t\tvalue,\n\t\tos\046clock(),\n\t\tself\046phase == \"active\" and character ~= nil and character == self\046roundCharacter\n\t)\nend\n\nfunction SoloRound:_movement(dt: number)\n\tlocal character, humanoid, root = self:_livingCharacter()\n\tlocal active = self\046phase == \"active\" and character ~= nil and character == self\046roundCharacter\n\tlocal velocity = if root then root\046AssemblyLinearVelocity else Vector3\046zero\n\tlocal moving = Vector3\046new(velocity\046X, 0, velocity\046Z)\046Magnitude > 0\0465\n\tStamina\046Step(self\046stamina, dt, moving, active, self\046balance)\n\tif humanoid then\n\t\thumanoid\046WalkSpeed = if not active\n\t\t\tthen 0\n\t\t\telseif self\046stamina\046sprinting then self\046balance\046sprint_speed * Inventory\046Multiplier(\n\t\t\t\tself\046inventory,\n\t\t\t\tos\046clock()\n\t\t\t)\n\t\t\telse self\046balance\046walk_speed * Inventory\046Multiplier(self\046inventory, os\046clock())\n\t\thumanoid:SetAttribute(\n\t\t\t\"corn_energy_remaining\",\n\t\t\tInventory\046Snapshot(self\046inventory, os\046clock())\046energy_remaining\n\t\t)\n\t\thumanoid:SetAttribute(\"corn_stamina\", self\046stamina\046value)\n\t\thumanoid:SetAttribute(\"corn_sprinting\", self\046stamina\046sprinting)\n\t\thumanoid:SetAttribute(\"corn_sprint_exhausted\", self\046stamina\046exhausted)\n\tend\nend\n\nfunction SoloRound:Start()\n\tself:_ensureWorld()\n\tself:_chooseSpawn()\n\ttable\046insert(\n\t\tself\046connections,\n\t\tself\046inventoryAction\046OnServerEvent:Connect(function(player: Player, action: any, slot: any)\n\t\t\tself:_inventoryRequest(player, action, slot)\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tself\046connections,\n\t\tself\046sprintIntent\046OnServerEvent:Connect(function(player: Player, value: any)\n\t\t\tself:_