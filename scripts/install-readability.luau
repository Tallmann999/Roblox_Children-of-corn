roller:_valid(): boolean\n\tlocal model, root, runtime, map = self\046_model, self\046_root, self\046_runtime, self\046_map\n\tif\n\t\tnot map\n\t\tor map\046Parent ~= Workspace\n\t\tor map:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor not runtime\n\t\tor runtime\046Parent ~= map\n\t\tor runtime:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor not model\n\t\tor model\046Parent ~= runtime\n\t\tor model\046Name ~= (if self\046_monsterIndex == 1\n\t\t\tthen \"Monster\"\n\t\t\telse \"Monster\" \046\046 self\046_monsterIndex)\n\t\tor model:GetAttribute(\"MonsterIndex\") ~= self\046_monsterIndex\n\t\tor model:GetAttribute(\"CornMonsterOwned\") ~= true\n\t\tor model:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor model:GetAttribute(\"MonsterRigVersion\") ~= 1\n\t\tor not decorative(root)\n\t\tor root\046Parent ~= model\n\t\tor model\046PrimaryPart ~= root\n\tthen\n\t\treturn false\n\tend\n\tfor name, part in self\046_parts do\n\t\tif\n\t\t\tpart\046Parent ~= model\n\t\t\tor part\046Name ~= name\n\t\t\tor part\046Size ~= sizes[name]\n\t\t\tor not decorative(part)\n\t\tthen\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\nfunction Controller:_resolveMonster()\n\tlocal name = if self\046_monsterIndex == 1 then \"Monster\" else \"Monster\" \046\046 self\046_monsterIndex\n\tlocal model = self\046_runtime and self\046_runtime:FindFirstChild(name)\n\tif model == self\046_model and self:_valid() then\n\t\treturn\n\tend\n\tself:_unbindMonster()\n\tif\n\t\tnot model\n\t\tor not model:IsA(\"Model\")\n\t\tor model:GetAttribute(\"MonsterIndex\") ~= self\046_monsterIndex\n\t\tor model:GetAttribute(\"CornMonsterOwned\") ~= true\n\t\tor model:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor model:GetAttribute(\"MonsterRigVersion\") ~= 1\n\tthen\n\t\treturn\n\tend\n\tlocal root = model:FindFirstChild(\"Root\")\n\tif not decorative(root) or model\046PrimaryPart ~= root then\n\t\treturn\n\tend\n\tlocal parts, count = {}, 0\n\tfor _, item in model:GetChildren() d