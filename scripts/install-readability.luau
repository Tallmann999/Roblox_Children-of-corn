{path="StarterPlayer/StarterPlayerScripts/GameClient/Bootstrap",class="LocalScript",hash="810a97bbc415966c8840b921690896b18ca71c2cf0d011eba7a9b4af4712db39",history={"a0229dd00d931df1a02ff53147b1e6085a371bc38c8b6a940a87215db5fe06c4","1f29b6f2d422b13879f3b46406b06d1e9df4d8446180b2dd7a55d1be40d5951d"},source="--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal GameShared = ReplicatedStorage:WaitForChild(\"GameShared\")\nlocal Config = require(GameShared:WaitForChild(\"Config\"):WaitForChild(\"GameConfig\"))\nlocal Workspace = game:GetService(\"Workspace\")\nlocal map = Workspace:WaitForChild(\"CornMap\", 10)\nif\n\tnot map\n\tor map:GetAttribute(\"corn_project_id\") ~= \"children_of_corn\"\n\tor Workspace:FindFirstChild(\"Asmr_Base\")\n\tor Workspace:FindFirstChild(\"ASMR_Models\")\nthen\n\twarn(\"[ChildrenOfCorn] Inactive: editable CornMap missing or another game detected\")\n\treturn\nend\nlocal Logger = require(GameShared:WaitForChild(\"Core\"):WaitForChild(\"Logger\"))\nlocal log = Logger\046new(\"ClientBootstrap\", Config\046Debug)\n\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nif\n\tnot RunService:IsStudio()\n\tor Config\046Environment ~= \"DEV\"\n\tor Config\046Game\046SessionMode ~= \"solo_local\"\nthen\n\twarn(\"[ChildrenOfCorn] Inactive: this local prototype requires Studio DEV solo mode\")\n\treturn\nend\nlocal Endpoints = require(GameShared:WaitForChild(\"Network\"):WaitForChild(\"EndpointNames\"))\nlocal STARTUP_TIMEOUT = 60\nlocal deadline = os\046clock() + STARTUP_TIMEOUT\nlocal loading: ScreenGui? = nil\nlocal function uniqueChild(parent: Instance, name: string): Instance?\n\tlocal found: Instance? = nil\n\tfor _, child in parent:GetChildren() do\n\t\tif child\046Name == name then\n\t\t\tassert(not found, \"Duplicate server readiness binding: \" \046\046 name)\n\t\t\tfound = child\n\t\tend\n\tend\n\treturn found\nend\nlocal function ready(): (boolean, string)\n\tlocal remotes = uniqueChild(ReplicatedStorage, \"GameRemotes\")\n\tif not remotes then\n\t\treturn false, \"GameRemotes\"\n\tend\n\tassert(remotes:IsA(\"Folder\"), \"GameRemotes must be a Folder\")\n\tfor _, name in\n\t\t{\n\t\t\tEndpoints\046RequestRoundAction,\n\t\t\tEndpoints\046RoundSnapshot,\n\t\t\tEndpoints\046RequestSprintIntent,\n\t\t\tEndpoints\046RequestInventoryAction,\n\t\t}\n\tdo\n\t\tlocal endpoint = uniqueChild(remotes, name)\n\t\tif not endpoint then\n\t\t\treturn false, name\n\t\tend\n\t\tassert(endpoint:IsA(\"RemoteEvent\"), \"Server endpoint must be a RemoteEvent: \" \046\046 name)\n\tend\n\tlocal art = uniqueChild(ReplicatedStorage, \"CornRuntimeArt\")\n\tif not art then\n\t\treturn false, \"CornRuntimeArt\"\n\tend\n\tassert(art:IsA(\"Folder\"), \"CornRuntimeArt must be a Folder\")\n\tlocal owner, project =\n\t\tart:GetAttribute(\"CornRuntimeArtOwned\"), art:GetAttribute(\"corn_project_id\")\n\tassert(owner == nil or owner == true, \"CornRuntimeArt has foreign ownership\")\n\tassert(\n\t\tproject == nil or project == \"children_of_corn\",\n\t\t\"CornRuntimeArt belongs to another project\"\n\t)\n\tif owner ~= true or project ~= \"children_of_corn\" then\n\t\treturn false, \"CornRuntimeArt ownership\"\n\tend\n\tlocal template = uniqueChild(art, \"CornPlantTemplate\")\n\tif not template then\n\t\treturn false, \"CornPlantTemplate\"\n\tend\n\tassert(template:IsA(\"MeshPart\"), \"CornPlantTemplate must be a MeshPart\")\n\tlocal templateOwner = template:GetAttribute(\"CornPlantTemplateOwned\")\n\tassert(templateOwner == nil or templateOwner == true, \"CornPlantTemplate has foreign ownership\")\n\tif templateOwner ~= true then\n\t\treturn false, \"CornPlantTemplate ownership\"\n\tend\n\tlocal mesh = template :: MeshPart\n\tif\n\t\tnot mesh\046Anchored\n\t\tor not mesh\046Archivable\n\t\tor mesh\046CanCollide\n\t\tor mesh\046CanTouch\n\t\tor mesh\046CanQuery\n\t\tor mesh\046MeshId == \"\"\n\tthen\n\t\treturn false, \"CornPlantTemplate static art\"\n\tend\n\tfor _, value in { mesh\046Size\046X, mesh\046Size\046Y, mesh\046Size\046Z } do\n\t\tassert(\n\t\t\tvalue == value and value > 0 and value < math\046huge,\n\t\t\t\"CornPlantTemplate has invalid Size\"\n\t\t)\n\tend\n\tfor _, child in template:GetDescendants() do\n\t\tassert(\n\t\t\tnot child:IsA(\"LuaSourceContainer\")\n\t\t\t\tand not child:IsA(\"Sound\")\n\t\t\t\tand not child:IsA(\"ParticleEmitter\")\n\t\t\t\tand not child:IsA(\"Beam\")\n\t\t\t\tand not child:IsA(\"Trail\")\n\t\t\t\tand not child:IsA(\"ProximityPrompt\")\n\t\t\t\tand not child:IsA(\"ClickDetector\")\n\t\t\t\tand not child:IsA(\"RemoteEvent\")\n\t\t\t\tand not child:IsA(\"RemoteFunction\"),\n\t\t\t\"CornPlantTemplate must contain only static art\"\n\t\t)\n\tend\n\treturn true, \"\"\nend\nlocal readinessOk, problem = pcall(function()\n\tlocal player = assert(Players\046LocalPlayer, \"Local player unavailable during startup\")\n\tlocal gui = player:FindFirstChild(\"PlayerGui\")\n\twhile not gui and os\046clock() < deadline do\n\t\ttask\046wait(math\046min(0\0461, deadline - os\046clock()))\n\t\tgui = player:FindFirstChild(\"PlayerGui\")\n\tend\n\tassert(os\046clock() <= deadline, \"Server map readiness timed out after 60 seconds: PlayerGui\")\n\tassert(gui and gui:IsA(\"PlayerGui\"), \"PlayerGui unavailable before startup deadline\")\n\tlocal screen = Instance\046new(\"ScreenGui\")\n\tloading = screen\n\tscreen\046Name = \"ChildrenOfCornLoading\"\n\tscreen:SetAttribute(\"CornLoadingOwned\", true)\n\tscreen:SetAttribute(\"corn_project_id\", \"children_of_corn\")\n\tscreen\046IgnoreGuiInset = true\n\tscreen\046ResetOnSpawn = false\n\tscreen\046DisplayOrder = 1000\n\tlocal background = Instance\046new(\"Frame\")\n\tbackground\046Size = UDim2\046fromScale(1, 1)\n\tbackground\046BackgroundColor3 = Color3\046fromRGB(15, 19, 14)\n\tbackground\046BackgroundTransparency = 0\04612\n\tbackground\046BorderSizePixel = 0\n\tbackground\046Parent = screen\n\tlocal label = Instance\046new(\"TextLabel\")\n\tlabel\046Size = UDim2\046new(1, -40, 0, 64)\n\tlabel\046AnchorPoint = Vector2\046new(0\0465, 0\0465)\n\tlabel\046Position = UDim2\046fromScale(0\0465, 0\0465)\n\tlabel\046BackgroundTransparency = 1\n\tlabel\046Font = Enum\046Font\046GothamMedium\n\tlabel\046TextSize = 24\n\tlabel\046TextColor3 = Color3\046fromRGB(244, 231, 192)\n\tlabel\046Text = \"Подготовка карты…\"\n\tlabel\046Parent = background\n\tscreen\046Parent = gui\n\tlocal available, missing = ready()\n\twhile not available do\n\t\tlocal remaining = deadline - os\046clock()\n\t\tassert(remaining > 0, \"Server map readiness timed out after 60 seconds: \" \046\046 missing)\n\t\ttask\046wait(math\046min(0\0461, remaining))\n\t\tassert(\n\t\t\tos\046clock() <= deadline,\n\t\t\t\"Server map readiness timed out after 60 seconds: \" \046\046 missing\n\t\t)\n\t\tavailable, missing = ready()\n\tend\n\tassert(\n\t\tos\046clock() <= deadline,\n\t\t\"Server map readiness timed out after 60 seconds: server bindings\"\n\t)\nend)\nif loading then\n\tloading:Destroy()\nend\nif not readinessOk then\n\terror(\"[ChildrenOfCorn] Client startup failed before controllers: \" \046\046 tostring(problem))\nend\n\nlocal controllersFolder = script\046Parent:WaitForChild(\"Controllers\")\n\ntype RuntimeModule = {\n\tName: string?,\n\tOrder: number?,\n\tInit: ((self: RuntimeModule, context: any) -> ())?,\n\tStart: ((self: RuntimeModule, context: any) -> ())?,\n}\n\nlocal loaded: { RuntimeModule } = {}\nlocal byName: { [string]: RuntimeModule } = {}\n\nfor _, child in controllersFolder:GetChildren() do\n\tif child:IsA(\"ModuleScript\") then\n\t\tlocal ok, result = pcall(require, child)\n\t\tif not ok then\n\t\t\terror(\n\t\t\t\tstring\046format(\n\t\t\t\t\t\"Failed to require controller %s: %s\",\n\t\t\t\t\tchild:GetFullName(),\n\t\t\t\t\ttostring(result)\n\t\t\t\t)\n\t\t\t)\n\t\tend\n\t\tif type(result) ~= \"table\" then\n\t\t\terror(string\046format(\"Controller %s must return a table\", child:GetFullName()))\n\t\tend\n\t\tlocal module = result :: RuntimeModule\n\t\tlocal name = module\046Name or child\046Name\n\t\tif byName[name] then\n\t\t\terror(string\046format(\"Duplicate controller name: %s\", name))\n\t\tend\n\t\tmodule\046Name = name\n\t\tbyName[name] = module\n\t\ttable\046insert(loaded, module)\n\tend\nend\n\ntable\046sort(loaded, function(a, b)\n\treturn (a\046Order or 100) < (b\046Order or 100)\nend)\n\nlocal context = {\n\tConfig = Config,\n\tControllers = byName,\n\tLog = Logger\046new(\"Client\", Config\046Debug),\n}\n\nfor _, module in loaded do\n\tif module\046Init then\n\t\tmodule:Init(context)\n\tend\nend\n\nfor _, module in loaded do\n\tif module\046Start then\n\t\tmodule:Start(context)\n\tend\nend\n\nlog:Info(string\046format(\"Started %d controllers\", #loaded))\n"},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/AudioController",class="ModuleScript",hash="c6ef8ce10e445663014edb0b4a501bbdbc30b3b7cd989ed4d7eeb1b67b72094c",history={"ec37d86c3459f2bc6a843c6f287902a9b5de2d997ffd9b23038f4e1ebc7a17c9","d18377ba9f97f93e3f49d4a4b911cf64528665576b72ee6a038835b590716ce9","c0694f88052078ef8e1f8b1918d11f4e8c2ffed2cca45655f1094e68b4ab890d","37269b3be88d3ee70b881e85cddd6c9e31ddd23ed21d46f75a48f9fc6d787881","ebc4b6cce67ddecea401ce9fc4c99b5881d17428df31f2402fea54ed721d92fe","4ab7d2f6473a09ab5628af331c355d8dc004e5021f5e0dbf398590058d4a28fd","13111ab21948aaad91df6858c510f370e2e4dd2cc5b7110e1136238716865a6f","e0d6172853e078aaf2cfb8b8ee2c83160b9479543c821b88bb3c95430b5d2fa9"},source="--!strict\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal SoundService = game:GetService(\"SoundService\")\nlocal ContentProvider = game:GetService(\"ContentProvider\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\")\nlocal Inventory = require(Shared:WaitForChild(\"Inventory\"))\nlocal Assets = require(Shared:WaitForChild(\"AudioAssets\"))\nlocal Rules = require(Shared:WaitForChild(\"AudioRules\"))\nlocal player = Players\046LocalPlayer\nlocal PROJECT = \"children_of_corn\"\nlocal FOLDER_NAME = \"CornPersonalAudio\"\nlocal RESOLVE_INTERVAL = 0\04625\nlocal PRELOAD_TIMEOUT = 8\nlocal DEFAULT_FOOTSTEPS = \"rbxasset://sounds/action_footsteps_plastic\046mp3\"\nlocal LOOP_KEY = \"COC_Corn_Continuous_02\"\nlocal FOOTSTEP_NAMES = { \"Running\", \"Climbing\" }\nlocal definitions = {\n\tBackground = { key = \"COC_Background_02\", category = \"Music\", looped = true },\n\tHunt = { key = \"COC_Hunt\", category = \"Music\", looped = true },\n\tEnergy = { key = \"COC_Energy_Open\", category = \"Effects\", looped = false },\n\tTrap = { key = \"COC_Trap_Place\", category = \"Effects\", looped = false },\n\tCornLoop = { key = LOOP_KEY, category = \"Effects\", looped = true },\n}\nlocal Controller = { Name = \"AudioController\", Order = 98 }\n\nlocal function owned(instance: Instance?): boolean\n\treturn instance ~= nil\n\t\tand instance:GetAttribute(\"CornAudioOwned\") == true\n\t\tand instance:GetAttribute(\"corn_project_id\") == PROJECT\n\t\tand instance:GetAttribute(\"AudioVersion\") == 1\nend\n\nlocal function annotate(instance: Instance, role: string)\n\tinstance:SetAttribute(\"CornAudioOwned\", true)\n\tinstance:SetAttribute(\"corn_project_id\", PROJECT)\n\tinstance:SetAttribute(\"AudioVersion\", 1)\n\tinstance:SetAttribute(\"audio_role\", role)\nend\n\nfunction Controller:Init(_context: any)\n\tself\046_snapshot = nil\n\tself\046_roundId = -1\n\tself\046_useId = 0\n\tself\046_endedRound = nil\n\tself\046_folder = nil\n\tself\046_folderName = FOLDER_NAME\n\tself\046_groups = {}\n\tself\046_sounds = {}\n\tself\046_connections = {}\n\tself\046_monster = nil\n\tself\046_monsterRoot = nil\n\tself\046_monsters = {}\n\tself\046_resolveAt = 0\n\tself\046_capture = nil\n\tself\046_background = 0\n\tself\046_hunt = 0\n\tself\046_generation = 0\n\tself\046_preload = nil\n\tself\046_refused = nil\n\tself\046_started = false\n\tself\046_footstepPlayers = {}\n\tself\046_footstepPlayerCount = 0\n\tself\046_rustles = {}\n\tself\046_rustleCount = 0\n\tself\046_rustleResolveAt = 0\n\tself\046_loopRoot = nil\n\tself\046_loopSource = nil\nend\n\nlocal function disconnect(entries: { RBXScriptConnection })\n\tfor _, connection in entries do\n\t\tconnection:Disconnect()\n\tend\n\ttable\046clear(entries)\nend\n\nlocal function serverRustle(sound: Instance?, root: BasePart): boolean\n\treturn sound ~= nil\n\t\tand sound:IsA(\"Sound\")\n\t\tand sound\046Parent == root\n\t\tand sound\046Name == \"CornAudio_corn_rustle\"\n\t\tand sound:GetAttribute(\"CornAudioOwned\") == true\n\t\tand sound:GetAttribute(\"corn_project_id\") == PROJECT\n\t\tand sound:GetAttribute(\"audio_role\") == \"corn_rustle\"\n\t\tand (sound :: Sound)\046SoundId == Assets\046Get(LOOP_KEY)\046Id\n\t\tand string\046match((sound :: Sound)\046SoundId, \"^rbxassetid://[1-9]%d*$\") ~= nil\nend\n\nlocal function spatialOwned(entry: any): boolean\n\treturn owned(entry\046sound)\n\t\tand entry\046sound\046Parent == entry\046root\n\t\tand entry\046sound\046Name == \"CornLocalRustle\"\n\t\tand entry\046sound:GetAttribute(\"audio_role\") == \"corn_loop_local\"\n\t\tand entry\046sound\046SoundId == Assets\046Get(LOOP_KEY)\046Id\n\t\tand entry\046sound\046Looped == true\n\t\tand entry\046sound\046SoundGroup == entry\046group\n\t\tand owned(entry\046group)\nend\n\nlocal function pauseSpatial(entry: any)\n\tif spatialOwned(entry) and (entry\046playing or entry\046sound\046IsPlaying) then\n\t\tentry\046sound:Pause()\n\tend\n\tentry\046playing = false\nend\n\nfunction Controller:_releaseRustle(root: BasePart)\n\tlocal entry = self\046_rustles[root]\n\tif not entry or entry\046released then\n\t\treturn\n\tend\n\tentry\046released = true\n\tpauseSpatial(entry)\n\tif spatialOwned(entry) then\n\t\tfor _, child in entry\046sound:GetChildren() do\n\t\t\tif not owned(child) then\n\t\t\t\tchild\046Parent = root\n\t\t\tend\n\t\tend\n\t\tentry\046sound:Destroy()\n\tend\n\tself\046_rustles[root] = nil\n\tself\046_rustleCount -= 1\nend\n\nfunction Controller:_clearRustles()\n\tfor root in self\046_rustles do\n\t\tself:_releaseRustle(root)\n\tend\n\tself\046_rustleResolveAt = 0\nend\n\nfunction Controller:_bindRustle(root: BasePart, source: Sound): any\n\tlocal old = self\046_rustles[root]\n\tif old and old\046source == source then\n\t\treturn old\n\tend\n\tif old then\n\t\tself:_releaseRustle(root)\n\tend\n\tif\n\t\troot == self:_livingRoot()\n\t\tor self\046_rustleCount >= Rules\046ActorLimit + 2\n\t\tor not serverRustle(source, root)\n\t\tor not owned(self\046_groups\046Effects)\n\t\tor root:FindFirstChild(\"CornLocalRustle\") ~= nil\n\tthen\n\t\treturn nil\n\tend\n\t-- One loop per remote actor\046 The owner already has its personal 2D loop\046\n\tlocal sound = Instance\046new(\"Sound\")\n\tsound\046Name = \"CornLocalRustle\"\n\tannotate(sound, \"corn_loop_local\")\n\tsound\046SoundId = Assets\046Get(LOOP_KEY)\046Id\n\tsound\046Looped = true\n\tsound\046PlaybackSpeed = 1\n\tsound\046Volume = 0\n\tsound\046RollOffMode = Enum\046RollOffMode\046InverseTapered\n\tsound\046RollOffMinDistance = Rules\046Ranges\046Rustle\046Min\n\tsound\046RollOffMaxDistance = Rules\046Ranges\046Rustle\046Max\n\tsound\046SoundGroup = self\046_groups\046Effects\n\tlocal entry = {\n\t\troot = root,\n\t\tsource = source,\n\t\tsound = sound,\n\t\tgroup = sound\046SoundGroup,\n\t\tplaying = false,\n\t\teverStarted = false,\n\t\treleased = false,\n\t}\n\t-- Register before Root\046ChildAdded reenters the footsteps binder\046\n\tself\046_rustles[root] = entry\n\tself\046_rustleCount += 1\n\tsound\046Parent = root\n\treturn entry\nend\n\nfunction Controller:_refreshRustle(root: BasePart?)\n\tif not root then\n\t\treturn\n\tend\n\tif root == self:_livingRoot() then\n\t\tself:_releaseRustle(root)\n\t\treturn\n\tend\n\tlocal source = root:FindFirstChild(\"CornAudio_corn_rustle\")\n\tif not serverRustle(source, root) then\n\t\tself:_releaseRustle(root)\n\telseif\n\t\tself\046_snapshot and (self\046_snapshot\046phase == \"active\" or self\046_snapshot\046phase == \"caught\")\n\tthen\n\t\tself:_bindRustle(root, source :: Sound)\n\tend\nend\n\nfunction Controller:_stepRustles(now: number)\n\tlocal snapshot = self\046_snapshot\n\tlocal ownRoot = self:_livingRoot()\n\tif\n\t\tnot snapshot\n\t\tor not ownRoot\n\t\tor (snapshot\046phase ~= \"active\" and snapshot\046phase ~= \"caught\")\n\tthen\n\t\tself:_clearRustles()\n\t\treturn\n\tend\n\tif now >= self\046_rustleResolveAt then\n\t\tself\046_rustleResolveAt = now + RESOLVE_INTERVAL\n\t\tlocal allowed = {}\n\t\tfor _, state in self\046_footstepPlayers do\n\t\t\tlocal humanoid = if state\046character\n\t\t\t\tthen state\046character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\telse nil\n\t\t\tif\n\t\t\t\tstate\046root\n\t\t\t\tand state\046root ~= ownRoot\n\t\t\t\tand state\046root\046Parent == state\046character\n\t\t\t\tand humanoid\n\t\t\t\tand humanoid\046Health > 0\n\t\t\tthen\n\t\t\t\tallowed[state\046root] = true\n\t\t\t\tself:_refreshRustle(state\046root)\n\t\t\tend\n\t\tend\n\t\tself:_resolveMonster(now)\n\t\tfor _, actor in self\046_monsters do\n\t\t\tallowed[actor\046root] = true\n\t\t\tself:_refreshRustle(actor\046root)\n\t\tend\n\t\tfor root in self\046_rustles do\n\t\t\tif not allowed[root] then\n\t\t\t\tself:_releaseRustle(root)\n\t\t\tend\n\t\tend\n\tend\n\tlocal audible = snapshot\046phase == \"active\"\n\t\tand not GuiService\046MenuIsOpen\n\t\tand not (self\046_capture and self\046_capture\046_state\046active)\n\tfor root, entry in self\046_rustles do\n\t\tif not root\046Parent or not serverRustle(entry\046source, root) or not spatialOwned(entry) then\n\t\t\tself:_releaseRustle(root)\n\t\telseif not audible or entry\046source:GetAttribute(\"AudioCornActive\") ~= true then\n\t\t\tpauseSpatial(entry)\n\t\telse\n\t\t\tlocal speed = entry\046source:GetAttribute(\"AudioCornSpeed\")\n\t\t\tif type(speed) ~= \"number\" or speed ~= speed or speed < 1 or speed > 2 then\n\t\t\t\tspeed = 1\n\t\t\tend\n\t\t\tlocal gain = math\046clamp(Rules\046Volume\046CornLoop * Assets\046Get(LOOP_KEY)\046Gain, 0, 1)\n\t\t\tif entry\046sound\046PlaybackSpeed ~= speed then\n\t\t\t\tentry\046sound\046PlaybackSpeed = speed\n\t\t\tend\n\t\t\tif entry\046sound\046Volume ~= gain then\n\t\t\t\tentry\046sound\046Volume = gain\n\t\t\tend\n\t\t\tif not entry\046playing then\n\t\t\t\tentry\046playing = true\n\t\t\t\tif entry\046everStarted then\n\t\t\t\t\tentry\046sound:Resume()\n\t\t\t\telse\n\t\t\t\t\tentry\046everStarted = true\n\t\t\t\t\tentry\046sound:Play()\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function defaultFootstep(entry: any): boolean\n\treturn entry\046sound\046Parent == entry\046root\n\t\tand entry\046root\046Parent == entry\046character\n\t\tand entry\046root\046Name == \"HumanoidRootPart\"\n\t\tand entry\046sound\046Name == entry\046name\n\t\tand entry\046sound\046SoundId == DEFAULT_FOOTSTEPS\nend\n\nfunction Controller:_muteFootstep(entry: any)\n\tif not entry\046released and defaultFootstep(entry) then\n\t\tif entry\046previous == nil then\n\t\t\tentry\046previous = entry\046sound\046Volume\n\t\tend\n\t\tif entry\046sound\046Volume ~= 0 then\n\t\t\tentry\046sound\046Volume = 0\n\t\tend\n\tend\nend\n\nfunction Controller:_releaseFootstep(entry: any)\n\tentry\046released = true\n\tdisconnect(entry\046connections)\n\tif entry\046previous ~= nil and defaultFootstep(entry) and entry\046sound\046Volume == 0 then\n\t\tentry\046sound\046Volume = entry\046previous\n\tend\nend\n\nfunction Controller:_refreshFootsteps(state: any)\n\tlocal root = state\046root\n\tfor _, name in FOOTSTEP_NAMES do\n\t\tlocal candidate = if root then root:FindFirstChild(name) else nil\n\t\tif candidate and not candidate:IsA(\"Sound\") then\n\t\t\tcandidate = nil\n\t\tend\n\t\tlocal old = state\046sounds[name]\n\t\tif old and old\046sound ~= candidate then\n\t\t\tself:_releaseFootstep(old)\n\t\t\tstate\046sounds[name] = nil\n\t\tend\n\t\tif candidate and not state\046sounds[name] then\n\t\t\tlocal entry = {\n\t\t\t\tsound = candidate,\n\t\t\t\troot = root,\n\t\t\t\tcharacter = state\046character,\n\t\t\t\tname = name,\n\t\t\t\treleased = false,\n\t\t\t\tconnections = {},\n\t\t\t}\n\t\t\tstate\046sounds[name] = entry\n\t\t\tfor _, property in { \"SoundId\", \"Volume\" } do\n\t\t\t\ttable\046insert(\n\t\t\t\t\tentry\046connections,\n\t\t\t\t\tcandidate:GetPropertyChangedSignal(property):Connect(function()\n\t\t\t\t\t\tself:_muteFootstep(entry)\n\t\t\t\t\tend)\n\t\t\t\t)\n\t\t\tend\n\t\t\ttable\046insert(\n\t\t\t\tentry\046connections,\n\t\t\t\tcandidate:GetPropertyChangedSignal(\"Name\"):Connect(function()\n\t\t\t\t\tself:_refreshFootsteps(state)\n\t\t\t\tend)\n\t\t\t)\n\t\tend\n\t\tif state\046sounds[name] then\n\t\t\tself:_muteFootstep(state\046sounds[name])\n\t\tend\n\tend\n\tself:_refreshRustle(root)\nend\n\nfunction Controller:_bindFootstepRoot(state: any)\n\tlocal candidate = if state\046character\n\t\tthen state\046character:FindFirstChild(\"HumanoidRootPart\")\n\t\telse nil\n\tif candidate and not candidate:IsA(\"BasePart\") then\n\t\tcandidate = nil\n\tend\n\tif candidate == state\046root then\n\t\treturn\n\tend\n\tdisconnect(state\046rootConnections)\n\tif state\046root then\n\t\tself:_releaseRustle(state\046root)\n\tend\n\tfor _, entry in state\046sounds do\n\t\tself:_releaseFootstep(entry)\n\tend\n\ttable\046clear(state\046sounds)\n\tstate\046root = candidate\n\tif candidate then\n\t\tfor _, event in { candidate\046ChildAdded, candidate\046ChildRemoved } do\n\t\t\ttable\046insert(\n\t\t\t\tstate\046rootConnections,\n\t\t\t\tevent:Connect(function()\n\t\t\t\t\tself:_refreshFootsteps(state)\n\t\t\t\tend)\n\t\t\t)\n\t\tend\n\t\ttable\046insert(\n\t\t\tstate\046rootConnections,\n\t\t\tcandidate:GetPropertyChangedSignal(\"Name\"):Connect(function()\n\t\t\t\tself:_bindFootstepRoot(state)\n\t\t\tend)\n\t\t)\n\t\tself:_refreshFootsteps(state)\n\tend\nend\n\nfunction Controller:_bindFootstepCharacter(state: any, character: Model?)\n\tif state\046root then\n\t\tself:_releaseRustle(state\046root)\n\tend\n\tdisconnect(state\046characterConnections)\n\tdisconnect(state\046rootConnections)\n\tfor _, entry in state\046sounds do\n\t\tself:_releaseFootstep(entry)\n\tend\n\ttable\046clear(state\046sounds)\n\tstate\046character, state\046root = character, nil\n\tif character then\n\t\tfor _, event in { character\046ChildAdded, character\046ChildRemoved } do\n\t\t\ttable\046insert(\n\t\t\t\tstate\046characterConnections,\n\t\t\t\tevent:Connect(function()\n\t\t\t\t\tself:_bindFootstepRoot(state)\n\t\t\t\tend)\n\t\t\t)\n\t\tend\n\t\tself:_bindFootstepRoot(state)\n\tend\nend\n\nfunction Controller:_watchFootstepPlayer(target: Player)\n\tif self\046_footstepPlayers[target] or self\046_footstepPlayerCount >= 8 then\n\t\treturn\n\tend\n\tlocal state = { connections = {}, characterConnections = {}, rootConnections = {}, sounds = {} }\n\tself\046_footstepPlayers[target] = state\n\tself\046_footstepPlayerCount += 1\n\ttable\046insert(\n\t\tstate\046connections,\n\t\ttarget\046CharacterAdded:Connect(function(character: Model)\n\t\t\tif self\046_footstepPlayers[target] ~= state then\n\t\t\t\treturn\n\t\t\tend\n\t\t\tif target == player then\n\t\t\t\tself:Clear(\"character changed\")\n\t\t\tend\n\t\t\tself:_bindFootstepCharacter(state, character)\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tstate\046connections,\n\t\ttarget\046CharacterRemoving:Connect(function(character: Model)\n\t\t\tif self\046_footstepPlayers[target] ~= state then\n\t\t\t\treturn\n\t\t\tend\n\t\t\tif target == player then\n\t\t\t\tself:Clear(\"character changed\")\n\t\t\tend\n\t\t\tif state\046character == character then\n\t\t\t\tself:_bindFootstepCharacter(state, nil)\n\t\t\tend\n\t\tend)\n\t)\n\tself:_bindFootstepCharacter(state, target\046Character)\nend\n\nfunction Controller:_releaseFootstepPlayer(target: Player)\n\tlocal state = self\046_footstepPlayers[target]\n\tif state then\n\t\tdisconnect(state\046connections)\n\t\tself:_bindFootstepCharacter(state, nil)\n\t\tself\046_footstepPlayers[target] = nil\n\t\tself\046_footstepPlayerCount -= 1\n\tend\nend\n\nfunction Controller:_startFootsteps()\n\tfor _, target in Players:GetPlayers() do\n\t\tself:_watchFootstepPlayer(target)\n\tend\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tPlayers\046PlayerAdded:Connect(function(target: Player)\n\t\t\tif self\046_started then\n\t\t\t\tself:_watchFootstepPlayer(target)\n\t\t\tend\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tPlayers\046PlayerRemoving:Connect(function(target: Player)\n\t\t\tself:_releaseFootstepPlayer(target)\n\t\tend)\n\t)\nend\n\nfunction Controller:_soundValid(entry: any): boolean\n\treturn entry ~= nil\n\t\tand owned(self\046_folder)\n\t\tand self\046_folder\046Parent == SoundService\n\t\tand owned(entry\046sound)\n\t\tand entry\046sound\046Parent == self\046_folder\n\t\tand owned(entry\046group)\n\t\tand entry\046group\046Parent == self\046_folder\n\t\tand entry\046sound\046SoundGroup == entry\046group\nend\n\nfunction Controller:_stop(entry: any)\n\tif entry and entry == self\046_sounds\046CornLoop then\n\t\tself:_pauseLoop()\n\t\treturn\n\tend\n\tif self:_soundValid(entry) then\n\t\tentry\046sound:Stop()\n\t\tentry\046sound\046Volume = 0\n\tend\n\tif entry then\n\t\tentry\046playing = false\n\t\tentry\046deadline = nil\n\tend\nend\n\nfunction Controller:_stopAll()\n\tself\046_background, self\046_hunt = 0, 0\n\tfor _, entry in self\046_sounds do\n\t\tself:_stop(entry)\n\tend\nend\n\nfunction Controller:Clear(_reason: string?)\n\tself\046_snapshot = nil\n\tself:_clearRustles()\n\tself\046_monster, self\046_monsterRoot = nil, nil\n\tself\046_monsters = {}\n\tself\046_resolveAt = 0\n\tself:_stopAll()\n\tself\046_loopRoot, self\046_loopSource = nil, nil\nend\n\nfunction Controller:_build(): boolean\n\tif self\046_folder then\n\t\treturn owned(self\046_folder) and self\046_folder\046Parent == SoundService\n\tend\n\tlocal existing = SoundService:FindFirstChild(self\046_folderName)\n\tif existing then\n\t\tif self\046_refused ~= existing then\n\t\t\tself\046_refused = existing\n\t\t\twarn(\"[AudioController] Existing personal audio folder preserved; ownership refused\")\n\t\tend\n\t\treturn false\n\tend\n\tlocal folder = Instance\046new(\"Folder\")\n\tfolder\046Name = self\046_folderName\n\tannotate(folder, \"personal\")\n\tself\046_folder = folder\n\tfor _, category in { \"Music\", \"Effects\" } do\n\t\tlocal group = Instance\046new(\"SoundGroup\")\n\t\tgroup\046Name = category\n\t\tgroup\046Volume = math\046clamp(Rules\046Mix\046Master * Rules\046Mix[category], 0, 1)\n\t\tannotate(group, string\046lower(category))\n\t\tgroup\046Parent = folder\n\t\tself\046_groups[category] = group\n\tend\n\tfor role, definition in definitions do\n\t\tlocal asset = Assets\046Get(definition\046key)\n\t\tif\n\t\t\tasset\n\t\t\tand type(asset\046Id) == \"string\"\n\t\t\tand string\046match(asset\046Id, \"^rbxassetid://[1-9]%d*$\")\n\t\tthen\n\t\t\tlocal sound = Instance\046new(\"Sound\")\n\t\t\tsound\046Name = role\n\t\t\tsound\046SoundId = asset\046Id\n\t\t\tsound\046Volume = 0\n\t\t\tsound\046Looped = definition\046looped\n\t\t\tsound\046SoundGroup = self\046_groups[definition\046category]\n\t\t\tannotate(sound, string\046lower(role))\n\t\t\tsound\046Parent = folder\n\t\t\tlocal entry = {\n\t\t\t\tsound = sound,\n\t\t\t\tgroup = sound\046SoundGroup,\n\t\t\t\tgain = math\046clamp(asset\046Gain * Rules\046Volume[role], 0, 1),\n\t\t\t\tduration = asset\046Duration,\n\t\t\t\tplaying = false,\n\t\t\t\tfailed = false,\n\t\t\t}\n\t\t\tself\046_sounds[role] = entry\n\t\t\tif not definition\046looped then\n\t\t\t\ttable\046insert(\n\t\t\t\t\tself\046_connections,\n\t\t\t\t\tsound\046Ended:Connect(function()\n\t\t\t\t\t\tself:_stop(entry)\n\t\t\t\t\tend)\n\t\t\t\t)\n\t\t\tend\n\t\tend\n\tend\n\tfolder\046Parent = SoundService\n\treturn true\nend\n\nfunction Controller:_preloadAssets()\n\tlocal ids = {}\n\tlocal seen = {}\n\tlocal byId = {}\n\tfor _, entry in self\046_sounds do\n\t\tbyId[entry\046sound\046SoundId] = entry\n\tend\n\t-- Archived short corn clips remain documented, but are no longer fetched\046\n\tfor key, asset in Assets\046List() do\n\t\tlocal id = asset\046Id\n\t\tif\n\t\t\tnot table\046find(Rules\046CornKeys, key)\n\t\t\tand type(id) == \"string\"\n\t\t\tand string\046match(id, \"^rbxassetid://[1-9]%d*$\")\n\t\t\tand not seen[id]\n\t\tthen\n\t\t\tseen[id] = true\n\t\t\ttable\046insert(ids, id)\n\t\t\tif #ids >= 16 then\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend\n\tif #ids == 0 then\n\t\treturn\n\tend\n\tlocal generation = self\046_generation\n\tlocal pending = { thread = nil, active = true }\n\tself\046_preload = pending\n\tpending\046thread = task\046spawn(function()\n\t\tlocal ok, message = pcall(function()\n\t\t\tContentProvider:PreloadAsync(ids, function(id: string, status: Enum\046AssetFetchStatus)\n\t\t\t\tlocal entry = byId[id]\n\t\t\t\tif self\046_generation == generation and status ~= Enum\046AssetFetchStatus\046Success then\n\t\t\t\t\tif entry then\n\t\t\t\t\t\t-- A transient preload failure may arrive after the Sound itself loaded\046\n\t\t\t\t\t\tentry\046failed = not entry\046sound\046IsLoaded\n\t\t\t\t\t\tif not entry\046failed then\n\t\t\t\t\t\t\treturn\n\t\t\t\t\t\tend\n\t\t\t\t\t\tself:_stop(entry)\n\t\t\t\t\tend\n\t\t\t\t\twarn(\"[AudioController] Audio asset unavailable: \" \046\046 id)\n\t\t\t\tend\n\t\t\tend)\n\t\tend)\n\t\tif self\046_generation == generation then\n\t\t\tpending\046active = false\n\t\t\tself\046_preload = nil\n\t\t\tif not ok then\n\t\t\t\twarn(\"[AudioController] Audio preload failed: \" \046\046 tostring(message))\n\t\t\tend\n\t\tend\n\tend)\n\ttask\046delay(PRELOAD_TIMEOUT, function()\n\t\tif self\046_generation == generation and self\046_preload == pending and pending\046active then\n\t\t\tif pending\046thread then\n\t\t\t\tpcall(task\046cancel, pending\046thread)\n\t\t\tend\n\t\t\tpending\046active = false\n\t\t\tself\046_preload = nil\n\t\t\twarn(\"[AudioController] Audio preload timed out; gameplay continues\")\n\t\tend\n\tend)\nend\n\nfunction Controller:_livingRoot(): BasePart?\n\tlocal character = player\046Character\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\treturn if humanoid and humanoid\046Health > 0 and root and root:IsA(\"BasePart\") then root else nil\nend\n\nfunction Controller:_resolveMonster(now: number)\n\tif now < self\046_resolveAt then\n\t\treturn\n\tend\n\tself\046_resolveAt = now + RESOLVE_INTERVAL\n\tself\046_monster, self\046_monsterRoot = nil, nil\n\tself\046_monsters = {}\n\tlocal map = workspace:FindFirstChild(\"CornMap\")\n\tlocal runtime = if map and map:GetAttribute(\"corn_project_id\") == PROJECT\n\t\tthen map:FindFirstChild(\"CornRoundRuntime\")\n\t\telse nil\n\tif\n\t\tnot runtime\n\t\tor not runtime:IsA(\"Folder\")\n\t\tor runtime:GetAttribute(\"corn_project_id\") ~= PROJECT\n\tthen\n\t\treturn\n\tend\n\tfor index = 1, 3 do\n\t\tlocal name = if index == 1 then \"Monster\" else \"Monster\" \046\046 index\n\t\tlocal monster = runtime:FindFirstChild(name)\n\t\tlocal root = if monster then monster:FindFirstChild(\"Root\") else nil\n\t\tif\n\t\t\tmonster\n\t\t\tand monster:IsA(\"Model\")\n\t\t\tand monster:GetAttribute(\"CornMonsterOwned\") == true\n\t\t\tand monster:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\tand monster:GetAttribute(\"MonsterRigVersion\") == 1\n\t\t\tand monster:GetAttribute(\"MonsterIndex\") == index\n\t\t\tand root\n\t\t\tand root:IsA(\"BasePart\")\n\t\tthen\n\t\t\ttable\046insert(\n\t\t\t\tself\046_monsters,\n\t\t\t\t{ model = monster, root = root, runtime = runtime, index = index }\n\t\t\t)\n\t\t\tif index == 1 then\n\t\t\t\tself\046_monster, self\046_monsterRoot = monster, root\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction Controller:_huntGoal(root: BasePart, now: number): number\n\tlocal snapshot = self\046_snapshot\n\tif\n\t\tnot snapshot\n\t\tor snapshot\046phase ~= \"active\"\n\t\tor snapshot\046monster_state ~= \"chase\"\n\t\tor (self\046_capture and self\046_capture\046_state\046active)\n\tthen\n\t\treturn 0\n\tend\n\tself:_resolveMonster(now)\n\tlocal nearest, distance = nil, math\046huge\n\tfor _, actor in self\046_monsters do\n\t\tlocal monster, enemy = actor\046model, actor\046root\n\t\tif\n\t\t\tenemy\046Parent == monster\n\t\t\tand monster\046Parent == actor\046runtime\n\t\t\tand actor\046runtime\046Parent ~= nil\n\t\t\tand actor\046runtime:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\tand monster\046Name == (if actor\046index == 1 then \"Monster\" else \"Monster\" \046\046 actor\046index)\n\t\t\tand monster:GetAttribute(\"MonsterIndex\") == actor\046index\n\t\t\tand monster:GetAttribute(\"CornMonsterOwned\") == true\n\t\t\tand monster:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\tand monster:GetAttribute(\"MonsterRigVersion\") == 1\n\t\t\tand monster:GetAttribute(\"HuntState\") == \"chase\"\n\t\t\tand monster:GetAttribute(\"ChaseTargetUserId\") == player\046UserId\n\t\tthen\n\t\t\tlocal candidate = (enemy\046Position - root\046Position)\046Magnitude\n\t\t\tif candidate < distance then\n\t\t\t\tnearest, distance = actor, candidate\n\t\t\tend\n\t\tend\n\tend\n\tif nearest then\n\t\tself\046_monster, self\046_monsterRoot = nearest\046model, nearest\046root\n\tend\n\treturn if distance <= (Rules\046HuntMaxDistance or 60) then Rules\046ChaseIntensity(distance) else 0\nend\n\nfunction Controller:_canPlay(entry: any): boolean\n\tif not self:_soundValid(entry) then\n\t\treturn false\n\tend\n\tif entry\046failed and entry\046sound\046IsLoaded then\n\t\tentry\046failed = false\n\tend\n\treturn not entry\046failed\nend\n\nfunction Controller:_loopValid(): boolean\n\tlocal entry = self\046_sounds\046CornLoop\n\tlocal asset = Assets\046Get(LOOP_KEY)\n\treturn self:_soundValid(entry)\n\t\tand asset ~= nil\n\t\tand entry\046sound\046Name == \"CornLoop\"\n\t\tand entry\046sound:GetAttribute(\"audio_role\") == \"cornloop\"\n\t\tand string\046match(asset\046Id, \"^rbxassetid://[1-9]%d*$\") ~= nil\n\t\tand entry\046sound\046SoundId == asset\046Id\n\t\tand entry\046sound\046Looped == true\n\t\tand entry\046group == self\046_groups\046Effects\nend\n\nfunction Controller:_loopAvailable(): boolean\n\treturn self:_loopValid() and self:_canPlay(self\046_sounds\046CornLoop)\nend\n\nfunction Controller:_pauseLoop()\n\tlocal entry = self\046_sounds\046CornLoop\n\tif not entry then\n\t\treturn\n\tend\n\tif self:_loopValid() and (entry\046playing or entry\046sound\046IsPlaying) then\n\t\t-- Pause preserves the engine cursor, including a pending cold-load Play\046\n\t\tentry\046sound:Pause()\n\tend\n\tentry\046playing = false\nend\n\nfunction Controller:_stepLoop()\n\tlocal snapshot = self\046_snapshot\n\tlocal root = self:_livingRoot()\n\tlocal source = if root then root:FindFirstChild(\"CornAudio_corn_rustle\") else nil\n\tif root ~= self\046_loopRoot or source ~= self\046_loopSource then\n\t\tself:_pauseLoop()\n\t\tself\046_loopRoot, self\046_loopSource = root, source\n\tend\n\tif\n\t\tnot self:_loopAvailable()\n\t\tor not snapshot\n\t\tor snapshot\046phase ~= \"active\"\n\t\tor not root\n\t\tor GuiService\046MenuIsOpen\n\t\tor (self\046_capture and self\046_capture\046_state\046active)\n\t\tor not serverRustle(source, root)\n\t\tor source:GetAttribute(\"AudioCornActive\") ~= true\n\tthen\n\t\tself:_pauseLoop()\n\t\treturn\n\tend\n\tlocal entry = self\046_sounds\046CornLoop\n\tlocal speed = if snapshot\046is_sprinting == true\n\t\tthen Rules\046CornLoopSprintSpeed\n\t\telse Rules\046CornLoopSpeed\n\tif entry\046sound\046PlaybackSpeed ~= speed then\n\t\tentry\046sound\046PlaybackSpeed = speed\n\tend\n\tif entry\046sound\046Volume ~= entry\046gain then\n\t\tentry\046sound\046Volume = entry\046gain\n\tend\n\tif not entry\046playing then\n\t\tentry\046playing = true\n\t\tif entry\046everStarted then\n\t\t\tentry\046sound:Resume()\n\t\telse\n\t\t\tentry\046everStarted = true\n\t\t\tentry\046sound:Play()\n\t\tend\n\tend\nend\n\nfunction Controller:_music(role: string, alpha: number)\n\tlocal entry = self\046_sounds[role]\n\tif not self:_canPlay(entry) then\n\t\treturn\n\tend\n\tif alpha <= 0 then\n\t\tif entry\046playing then\n\t\t\tself:_stop(entry)\n\t\tend\n\t\treturn\n\tend\n\tentry\046sound\046Volume = entry\046gain * alpha\n\tif not entry\046playing then\n\t\tentry\046playing = true\n\t\tentry\046sound:Play()\n\tend\nend\n\nfunction Controller:_playEffect(kind: string, now: number)\n\tlocal entry = self\046_sounds[if kind == \"energy\" then \"Energy\" else \"Trap\"]\n\tif not self:_canPlay(entry) then\n\t\treturn\n\tend\n\tself:_stop(entry)\n\tentry\046sound\046Volume = entry\046gain\n\tentry\046playing = true\n\tentry\046deadline = now + math\046max(entry\046duration, entry\046sound\046TimeLength) + 0\0465\n\tentry\046sound:Play()\nend\n\nfunction Controller:_step(dt: number, now: number)\n\tself:_stepRustles(now)\n\tself:_stepLoop()\n\tlocal snapshot = self\046_snapshot\n\tlocal root = self:_livingRoot()\n\tif\n\t\tnot snapshot\n\t\tor not root\n\t\tor GuiService\046MenuIsOpen\n\t\tor (snapshot\046phase ~= \"active\" and snapshot\046phase ~= \"caught\")\n\tthen\n\t\tself:_stopAll()\n\t\treturn\n\tend\n\tself\046_background = Rules\046Fade(self\046_background, 1, dt, Rules\046BackgroundFade)\n\tself:_music(\"Background\", self\046_background)\n\tif snapshot\046phase == \"caught\" or (self\046_capture and self\046_capture\046_state\046active) then\n\t\tself\046_hunt = 0\n\t\tself:_stop(self\046_sounds\046Hunt)\n\t\tself:_stop(self\046_sounds\046Energy)\n\t\tself:_stop(self\046_sounds\046Trap)\n\telse\n\t\tlocal goal = self:_huntGoal(root, now)\n\t\tself\046_hunt = Rules\046Fade(\n\t\t\tself\046_hunt,\n\t\t\tgoal,\n\t\t\tdt,\n\t\t\tif goal > self\046_hunt then Rules\046HuntFadeIn else Rules\046HuntFadeOut\n\t\t)\n\t\tself:_music(\"Hunt\", self\046_hunt)\n\t\tfor _, role in { \"Energy\", \"Trap\" } do\n\t\t\tlocal entry = self\046_sounds[role]\n\t\t\tif entry and entry\046deadline and now >= entry\046deadline then\n\t\t\t\tself:_stop(entry)\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction Controller:SetSnapshot(snapshot: any)\n\tif\n\t\ttype(snapshot) ~= \"table\"\n\t\tor type(snapshot\046minimap) ~= \"table\"\n\t\tor not Inventory\046IsValidSnapshot(snapshot\046inventory)\n\tthen\n\t\tself:Clear(\"malformed snapshot\")\n\t\treturn\n\tend\n\tlocal roundId = snapshot\046minimap\046round_id\n\tlocal use = snapshot\046inventory\046use\n\tif\n\t\ttype(roundId) ~= \"number\"\n\t\tor roundId < 0\n\t\tor roundId >= math\046huge\n\t\tor roundId % 1 ~= 0\n\t\tor roundId < self\046_roundId\n\tthen\n\t\treturn\n\tend\n\tif\n\t\troundId == self\046_roundId\n\t\tand snapshot\046phase == \"active\"\n\t\tand (use\046id < self\046_useId or self\046_endedRound == roundId)\n\tthen\n\t\treturn\n\tend\n\tlocal first = roundId ~= self\046_roundId\n\tif first then\n\t\tself:_clearRustles()\n\t\tself:_stopAll()\n\t\tself\046_monster, self\046_monsterRoot = nil, nil\n\t\tself\046_monsters = {}\n\t\tself\046_resolveAt = 0\n\t\tself\046_roundId, self\046_useId = roundId, use\046id\n\t\tself\046_endedRound = nil\n\tend\n\tself\046_snapshot = snapshot\n\tif\n\t\tsnapshot\046phase == \"escaped\"\n\t\tor snapshot\046phase == \"aborted\"\n\t\tor snapshot\046phase == \"caught_out\"\n\tthen\n\t\tself\046_endedRound = roundId\n\tend\n\tif not first and use\046id > self\046_useId then\n\t\tself\046_useId = use\046id\n\t\tif\n\t\t\tsnapshot\046phase == \"active\"\n\t\t\tand self:_livingRoot()\n\t\t\tand not GuiService\046MenuIsOpen\n\t\t\tand not (self\046_capture and self\046_capture\046_state\046active)\n\t\t\tand (use\046kind == \"energy\" or use\046kind == \"trap\")\n\t\tthen\n\t\t\tself:_playEffect(use\046kind, os\046clock())\n\t\tend\n\tend\n\tself:_step(0, os\046clock())\nend\n\nfunction Controller:Start(context: any)\n\tif self\046_started then\n\t\treturn\n\tend\n\tself\046_started = true\n\tself\046_capture = context\046Controllers\046CaptureController\n\tself:_startFootsteps()\n\tif not self:_build() then\n\t\treturn\n\tend\n\tself:_preloadAssets()\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tRunService\046Heartbeat:Connect(function(dt: number)\n\t\t\tself:_step(dt, os\046clock())\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tGuiService\046MenuOpened:Connect(function()\n\t\t\tself:_stopAll()\n\t\tend)\n\t)\nend\n\nfunction Controller:Destroy()\n\tself:Clear(\"destroy\")\n\tfor target in self\046_footstepPlayers do\n\t\tself:_releaseFootstepPlayer(target)\n\tend\n\tself\046_generation += 1\n\tif self\046_preload then\n\t\tif self\046_preload\046thread then