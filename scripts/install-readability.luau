n\t\troundId = -1,\n\t\tlastId = 0,\n\t\tactive = false,\n\t\tdeadline = 0,\n\t\tstarted = 0,\n\t\tframe = CFrame\046identity,\n\t}\nend\n\nfunction Capture\046Cancel(state: any)\n\tstate\046active = false\nend\n\n-- Incoming snapshots may shorten a running deadline, but cannot extend or replay it\046\nfunction Capture\046Observe(state: any, roundId: any, value: any, phase: any, now: number): string\n\tlocal wasActive = state\046active\n\tif\n\t\tnot finite(roundId)\n\t\tor roundId < 0\n\t\tor roundId % 1 ~= 0\n\t\tor not finite(now)\n\t\tor not Capture\046IsValidSnapshot(value)\n\tthen\n\t\tCapture\046Cancel(state)\n\t\treturn if wasActive then \"cancel\" else \"none\"\n\tend\n\tif roundId < state\046roundId then\n\t\tCapture\046Cancel(state)\n\t\treturn if wasActive then \"cancel\" else \"none\"\n\tend\n\tif roundId ~= state\046roundId then\n\t\tstate\046roundId, state\046lastId, state\046active = roundId, 0, false\n\tend\n\tif phase ~= \"caught\" or value\046id == 0 or value\046remaining <= 0 then\n\t\tstate\046lastId = math\046max(state\046lastId, value\046id)\n\t\tCapture\046Cancel(state)\n\t\treturn if wasActive then \"cancel\" else \"none\"\n\tend\n\tif state\046active and value\046id == state\046lastId then\n\t\tstate\046deadline = math\046min(state\046deadline, now + value\046remaining)\n\t\tif now >= state\046deadline then\n\t\t\tCapture\046Cancel(state)\n\t\t\treturn \"cancel\"\n\t\tend\n\t\treturn \"keep\"\n\tend\n\tif value\046id <= state\046lastId then\n\t\treturn if wasActive and not state\046active then \"cancel\" else \"none\"\n\tend\n\tstate\046lastId = value\046id\n\tstate\046active = true\n\tstate\046started = now - (Capture\046Duration - value\046remaining)\n\tstate\046deadline = now + value\046remaining\n\tstate\046frame = value\046frame\n\treturn \"begin\"\nend\n\nfunction Capture\046Progress(state: any, now: number): number\n\treturn math\046clamp((now - state\046started) / Capture\046ApproachDuration, 0, 1)\nend\n\nlocal function elapsedTime(elapsed: number): number\n\treturn if finite(elapsed) then math\046clamp(elapsed, 0, Capture\046Duration) else 0\nend\n\nfunction Capture\046HeadShake(elapsed: number): CFrame\n\tlocal time = elapsedTime(elapsed)\n\tlocal strength = math\046clamp(time / 0\04613, 0, 1)\n\treturn CFrame\046Angles(\n\t\tmath\046sin(time * 2 * math\046pi * 13) * math\046rad(6) * strength,\n\t\tmath\046sin(time * 2 * math\046pi * 11) * math\046rad(14) * strength,\n\t\tmath\046sin(time * 2 * math\046pi * 9) * math\046rad(7) * strength\n\t)\nend\n\nfunction Capture\046CameraShake(elapsed: number): CFrame\n\tlocal time = elapsedTime(elapsed)\n\tlocal strength = math\046clamp(time / 0\0463, 0, 1)\n\treturn CFrame\046new(\n\t\tmath\046sin(time * 2 * math\046pi * 7) * 0\046028 * strength,\n\t\tmath\046sin(time * 2 * math\046pi * 9) * 0\046020 * strength,\n\t\t0\n\t) * CFrame\046Angles(\n\t\tmath\046sin(time * 2 * math\046pi * 6) * math\046rad(0\04635) * strength,\n\t\tmath\046sin(time * 2 * math\046pi * 8) * math\046rad(0\04645) * strength,\n\t\tmath\046sin(time * 2 * math\046pi * 5) * math\046rad(0\04665) * strength\n\t)\nend\n\nfunction Capture\046MouthOpen(elapsed: number): number\n\tlocal progress = math\046clamp(elapsedTime(elapsed) / 0\04622, 0, 1)\n\treturn 0\0463 + 0\0467 * progress * progress * (3 - 2 * progress)\nend\n\nfunction Capture\046PaintOpacity(elapsed: number): number\n\tlocal time = elapsedTime(elapsed)\n\treturn math\046clamp((time - 0\04642) / 0\04609, 0, 1)\n\t\t* (1 - math\046clamp((time - 0\0469) / 0\0461, 0, 1))\n\t\t* 0\04688\nend\n\nreturn table\046freeze(Capture)\n"},
