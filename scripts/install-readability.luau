{path="ReplicatedStorage/GameShared/Game/Inventory",class="ModuleScript",hash="a4fdb46578dc144ccd8d6ab4f4ba101f5414f16aecafb026deb042870f6409ad",history={"a8dc00f29b97f92d6008348813bfd9394d2d034b9ee23deea39a21599cbe9271"},source="--!strict\nlocal Inventory = { Capacity = 5, EnergyDuration = 30, TrapDuration = 10 }\nlocal kinds = { empty = true, key = true, energy = true, trap = true }\nfunction Inventory\046IsSlot(slot: any): boolean\n\treturn type(slot) == \"number\" and slot % 1 == 0 and slot >= 1 and slot <= Inventory\046Capacity\nend\nfunction Inventory\046IsValidSnapshot(value: any): boolean\n\tif\n\t\ttype(value) ~= \"table\"\n\t\tor type(value\046slots) ~= \"table\"\n\t\tor not Inventory\046IsSlot(value\046selected)\n\tthen\n\t\treturn false\n\tend\n\tlocal count = 0\n\tfor index, kind in value\046slots do\n\t\tif not Inventory\046IsSlot(index) or type(kind) ~= \"string\" or not kinds[kind] then\n\t\t\treturn false\n\t\tend\n\t\tcount += 1\n\tend\n\tlocal remaining = value\046energy_remaining\n\tlocal use = value\046use\n\treturn count == Inventory\046Capacity\n\t\tand type(remaining) == \"number\"\n\t\tand remaining == remaining\n\t\tand remaining >= 0\n\t\tand remaining <= Inventory\046EnergyDuration\n\t\tand type(use) == \"table\"\n\t\tand type(use\046id) == \"number\"\n\t\tand use\046id >= 0\n\t\tand use\046id < math\046huge\n\t\tand use\046id % 1 == 0\n\t\tand (use\046kind == \"none\" or use\046kind == \"energy\" or use\046kind == \"trap\")\n\t\tand ((use\046id == 0 and use\046kind == \"none\") or (use\046id > 0 and use\046kind ~= \"none\"))\nend\nfunction Inventory\046new(now: number): any\n\treturn {\n\t\tslots = table\046create(Inventory\046Capacity, \"empty\"),\n\t\tselected = 1,\n\t\tenergyUntil = 0,\n\t\ttokens = 10,\n\t\trequestAt = now,\n\t\tuseId = 0,\n\t\tuseKind = \"none\",\n\t}\nend\nfunction Inventory\046Add(state: any, kind: string): boolean\n\tif kind == \"empty\" or not kinds[kind] then\n\t\treturn false\n\tend\n\tlocal slot = table\046find(state\046slots, \"empty\")\n\tif not slot then\n\t\treturn false\n\tend\n\tstate\046slots[slot] = kind\n\tif state\046slots[state\046selected] == \"empty\" then\n\t\tstate\046selected = slot\n\tend\n\treturn true\nend\nfunction Inventory\046Remove(state: any, kind: string): boolean\n\tlocal slot = table\046find(state\046slots, kind)\n\tif not slot then\n\t\treturn false\n\tend\n\tstate\046slots[slot] = \"empty\"\n\treturn true\nend\nfunction Inventory\046Request(state: any, action: any, slot: any, now: number): boolean\n\tif not Inventory\046IsSlot(slot) or (action ~= \"select\" and action ~= \"use\") then\n\t\treturn false\n\tend\n\tstate\046tokens = math\046min(10, state\046tokens + math\046max(0, now - state\046requestAt) * 6)\n\tstate\046requestAt = now\n\tif state\046tokens < 1 then\n\t\treturn false\n\tend\n\tstate\046tokens -= 1\n\tif action == \"select\" then\n\t\tstate\046selected = slot\n\t\treturn true\n\tend\n\treturn state\046selected == slot and (state\046slots[slot] == \"energy\" or state\046slots[slot] == \"trap\")\nend\nfunction Inventory\046Snapshot(state: any, now: number): any\n\treturn {\n\t\tslots = table\046clone(state\046slots),\n\t\tselected = state\046selected,\n\t\tenergy_remaining = math\046clamp(state\046energyUntil - now, 0, Inventory\046EnergyDuration),\n\t\tuse = { id = state\046useId, kind = state\046useKind },\n\t}\nend\nfunction Inventory\046Multiplier(state: any, now: number): number\n\treturn if state\046energyUntil > now then 2 else 1\nend\nreturn table\046freeze(Inventory)\n"},
{path="ReplicatedStorage/GameShared/Game/LightingModes",class="ModuleScript",hash="8e90fb793c88701f43089e0148f75d479e116303411bcc38619942f6080ff6db",history={"ef20a04b97d7c7adc95afb416e27d98529080ee02e3851a6b1f3a838945bfaba","26c6bca92a36644d8c29d002e46b3146ecba48884d85f29b525dc8b0dcc66749"},source="--!strict\n\nlocal LightingModes = {}\nLightingModes\046Order = table\046freeze({ \"hard\" })\nLightingModes\046Default = \"hard\"\nLightingModes\046Profiles = table\046freeze({\n\thard = table\046freeze({\n\t\tClockTime = 20\0465,\n\t\tBrightness = 1,\n\t\tAmbient = Color3\046fromRGB(18, 22, 30),\n\t\tOutdoorAmbient = Color3\046fromRGB(38, 42, 53),\n\t\tFogColor = Color3\046fromRGB(20, 27, 36),\n\t\tFogStart = 55,\n\t\tFogEnd = 320,\n\t\tDensity = 0\04627,\n\t\tHaze = 0\0468,\n\t\tOffset = 0\04625,\n\t\tColor = Color3\046fromRGB(95, 110, 130),\n\t\tDecay = Color3\046fromRGB(32, 41, 56),\n\t\tTorches = true,\n\t\tSkyTop = Color3\046fromRGB(10, 16, 32),\n\t\tSkyBottom = Color3\046fromRGB(46, 59, 76),\n\t}),\n})\n\nlocal LIGHTING_PROPERTIES =\n\t{ \"ClockTime\", \"Brightness\", \"Ambient\", \"OutdoorAmbient\", \"FogColor\", \"FogStart\", \"FogEnd\" }\nlocal ATMOSPHERE_PROPERTIES = { \"Density\", \"Haze\", \"Offset\", \"Color\", \"Decay\" }\n\nfunction LightingModes\046IsValid(value: any): boolean\n\treturn value == \"hard\"\nend\n\nfunction LightingModes\046Capture(lighting: Lighting): any\n\tlocal state = { lighting = {}, atmospheres = {} }\n\tfor _, property in LIGHTING_PROPERTIES do\n\t\tstate\046lighting[property] = (lighting :: any)[property]\n\tend\n\tfor _, effect in lighting:GetChildren() do\n\t\tif effect:IsA(\"Atmosphere\") then\n\t\t\tlocal values = {}\n\t\t\tfor _, property in ATMOSPHERE_PROPERTIES do\n\t\t\t\tvalues[property] = (effect :: any)[property]\n\t\t\tend\n\t\t\ttable\046insert(state\046atmospheres, { instance = effect, values = values })\n\t\tend\n\tend\n\treturn state\nend\n\nfunction LightingModes\046Apply(lighting: Lighting, mode: string)\n\tassert(LightingModes\046IsValid(mode), \"Unknown lighting mode\")\n\tlocal profile = (LightingModes\046Profiles :: any)[mode]\n\tfor _, property in LIGHTING_PROPERTIES do\n\t\t(lighting :: any)[property] = profile[property]\n\tend\n\tfor _, effect in lighting:GetChildren() do\n\t\tif effect:IsA(\"Atmosphere\") then\n\t\t\tfor _, property in ATMOSPHERE_PROPERTIES do\n\t\t\t\t(effect :: any)[property] = profile[property]\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction LightingModes\046Restore(lighting: Lighting, state: any)\n\tfor property, value in state\046lighting do\n\t\t(lighting :: any)[property] = value\n\tend\n\tfor _, entry in state\046atmospheres do\n\t\tif entry\046instance\046Parent == lighting then\n\t\t\tfor property, value in entry\046values do\n\t\t\t\tentry\046instance[property] = value\n\t\t\tend\n\t\tend\n\tend\nend\n\nreturn table\046freeze(LightingModes)\n"},
