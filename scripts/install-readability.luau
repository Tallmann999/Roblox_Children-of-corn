{path="ServerScriptService/GameServer/Game/AuthoredWorld",class="ModuleScript",hash="3336eeccd589a8126de7ae11fbfeff68c88f5b406a0ae7533e750d9e571e7f80",history={"87a75a1c51bf70f4241a180109d1b3094a3486bccf3cb4a39716ae24b15e78e3"},source="--!strict\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal CornField = require(script\046Parent:WaitForChild(\"CornField\"))\nlocal ItemModels = require(script\046Parent:WaitForChild(\"ItemModels\"))\nlocal AuthoredWorld = {}\nAuthoredWorld\046__index = AuthoredWorld\n\nlocal function namedPart(parent: Instance, name: string): BasePart\n\tlocal item = parent:FindFirstChild(name)\n\tassert(item and item:IsA(\"BasePart\"), \"Missing map part: \" \046\046 name)\n\treturn item\nend\n\nlocal function hasTag(item: Instance, tag: string): boolean\n\treturn CollectionService:HasTag(item, tag)\nend\n\nlocal function prompt(\n\tparent: Instance,\n\tname: string,\n\taction: string,\n\tobject: string,\n\tradius: number\n): ProximityPrompt\n\tassert(not parent:FindFirstChild(name), \"Duplicate owned prompt: \" \046\046 name)\n\tlocal item = Instance\046new(\"ProximityPrompt\")\n\titem\046Name = name\n\titem\046ActionText = action\n\titem\046ObjectText = object\n\titem\046KeyboardKeyCode = Enum\046KeyCode\046E\n\titem\046MaxActivationDistance = radius\n\titem\046RequiresLineOfSight = true\n\titem\046HoldDuration = 0\n\titem\046Enabled = false\n\titem\046Parent = parent\n\treturn item\nend\n\nlocal function inBox(part: BasePart, position: Vector3): boolean\n\tlocal point = part\046CFrame:PointToObjectSpace(position)\n\tlocal half = part\046Size / 2\n\treturn math\046abs(point\046X) <= half\046X\n\t\tand math\046abs(point\046Y) <= half\046Y\n\t\tand math\046abs(point\046Z) <= half\046Z\nend\n\nlocal function validateSpawn(root: Model, spawn: BasePart, bounds: BasePart)\n\tassert(spawn:IsDescendantOf(root), \"Spawn must belong to CornMap\")\n\tassert(hasTag(spawn, \"corn_spawn\"), \"Missing corn_spawn tag: \" \046\046 spawn\046Name)\n\tlocal id = spawn:GetAttribute(\"spawn_id\")\n\tassert(type(id) == \"string\" and id ~= \"\", \"Spawn id must be a nonempty string: \" \046\046 spawn\046Name)\n\tassert(spawn\046Anchored, \"Spawn must be Anchored: \" \046\046 spawn\046Name)\n\tassert(\n\t\tspawn\046CFrame\046UpVector:Dot(Vector3\046yAxis) > 0\046999,\n\t\t\"Spawn must remain horizontal: \" \046\046 spawn\046Name\n\t)\n\tif spawn:IsA(\"SpawnLocation\") then\n\t\tassert(\n\t\t\tspawn\046Enabled and spawn\046Neutral,\n\t\t\t\"Corner spawn must be enabled and neutral: \" \046\046 spawn\046Name\n\t\t)\n\tend\n\tlocal position = (spawn\046CFrame * CFrame\046new(0, spawn\046Size\046Y / 2 + 3\0465, 0))\046Position\n\tassert(inBox(bounds, position), \"Spawn is outside PlayBounds: \" \046\046 spawn\046Name)\nend\n\nfunction AuthoredWorld\046IsSafeSpawn(root: Model, spawn: BasePart): boolean\n\tlocal bounds = root:FindFirstChild(\"PlayBounds\")\n\treturn bounds ~= nil and bounds:IsA(\"BasePart\") and pcall(validateSpawn, root, spawn, bounds)\nend\n\nfunction AuthoredWorld\046ReadSpawns(root: Model): { BasePart }\n\tlocal bounds = namedPart(root, \"PlayBounds\")\n\tlocal corners = root:FindFirstChild(\"CornerSpawns\")\n\tlocal spawns: { BasePart } = {}\n\tif corners then\n\t\tassert(\n\t\t\tcorners:IsA(\"Folder\")\n\t\t\t\tand corners:GetAttribute(\"CornCornerSpawnsOwned\") == true\n\t\t\t\tand corners:GetAttribute(\"corn_project_id\") == \"children_of_corn\",\n\t\t\t\"Unrecognized CornerSpawns\"\n\t\t)\n\t\tlocal seen: { [string]: boolean } = {}\n\t\tfor _, item in corners:GetChildren() do\n\t\t\tassert(item:IsA(\"SpawnLocation\"), \"CornerSpawns must contain only SpawnLocations\")\n\t\t\tvalidateSpawn(root, item, bounds)\n\t\t\tlocal id = item:GetAttribute(\"spawn_id\") :: string\n\t\t\tassert(not seen[id], \"Corner spawn ids must be unique\")\n\t\t\tseen[id] = true\n\t\t\ttable\046insert(spawns, item)\n\t\tend\n\t\tassert(#spawns == 4, \"CornMap must have four corner spawns\")\n\t\ttable\046sort(spawns, function(a, b)\n\t\t\treturn tostring(a:GetAttribute(\"spawn_id\")) < tostring(b:GetAttribute(\"spawn_id\"))\n\t\tend)\n\telse\n\t\tlocal legacy = namedPart(root, \"RoundSpawn\")\n\t\tvalidateSpawn(root, legacy, bounds)\n\t\ttable\046insert(spawns, legacy)\n\tend\n\treturn spawns\nend\n\n-- A broken gate or slot must not leave the menu character underneath the map\046\nfunction AuthoredWorld\046FindSafeSpawn(root: Model): BasePart?\n\tlocal bounds = root:FindFirstChild(\"PlayBounds\")\n\tif not bounds or not bounds:IsA(\"BasePart\") then\n\t\treturn nil\n\tend\n\tlocal candidates: { BasePart } = {}\n\tlocal corners = root:FindFirstChild(\"CornerSpawns\")\n\tif\n\t\tcorners\n\t\tand corners:IsA(\"Folder\")\n\t\tand corners:GetAttribute(\"CornCornerSpawnsOwned\") == true\n\t\tand corners:GetAttribute(\"corn_project_id\") == \"children_of_corn\"\n\tthen\n\t\tfor _, item in corners:GetChildren() do\n\t\t\tif item:IsA(\"SpawnLocation\") and pcall(validateSpawn, root, item, bounds) then\n\t\t\t\ttable\046insert(candidates, item)\n\t\t\tend\n\t\tend\n\tend\n\ttable\046sort(candidates, function(a, b)\n\t\treturn tostring(a:GetAttribute(\"spawn_id\")) < tostring(b:GetAttribute(\"spawn_id\"))\n\tend)\n\tif candidates[1] then\n\t\treturn candidates[1]\n\tend\n\tlocal legacy = root:FindFirstChild(\"RoundSpawn\")\n\tif legacy and legacy:IsA(\"BasePart\") and pcall(validateSpawn, root, legacy, bounds) then\n\t\treturn legacy\n\tend\n\treturn nil\nend\n\nfunction AuthoredWorld\046SpawnCFrame(spawn: BasePart): CFrame\n\treturn spawn\046CFrame * CFrame\046new(0, spawn\046Size\046Y / 2 + 3\0465, 0)\nend\n\nfunction AuthoredWorld\046new(radius: number, expectedSlots: number)\n\tlocal root = Workspace:FindFirstChild(\"CornMap\")\n\tassert(\n\t\troot and root:IsA(\"Model\") and root:GetAttribute(\"corn_project_id\") == \"children_of_corn\",\n\t\t\"Install the editable CornMap in Children_of_corn before Test\"\n\t)\n\tlocal spawns = AuthoredWorld\046ReadSpawns(root)\n\tlocal field = namedPart(root, \"FieldZone\")\n\tlocal ground = namedPart(root, \"Ground\")\n\tlocal home = root\046Props:FindFirstChild(\"ScarecrowMarker\")\n\tassert(home and home:IsA(\"Model\") and home:HasTag(\"corn_monster_home\"), \"Monster home missing\")\n\tlocal bounds = namedPart(root, \"PlayBounds\")\n\tlocal gateModel = root:FindFirstChild(\"EscapeGate\")\n\tassert(\n\t\tgateModel and gateModel:IsA(\"Model\") and hasTag(gateModel, \"corn_gate\"),\n\t\t\"Missing tagged EscapeGate\"\n\t)\n\tlocal gate = namedPart(gateModel, \"Door\")\n\tlocal anchor = namedPart(gateModel, \"InteractionAnchor\")\n\tlocal exit = namedPart(gateModel, \"ExitZone\")\n\tassert(hasTag(exit, \"corn_exit\"), \"Missing corn_exit tag\")\n\tlocal gateId = gateModel:GetAttribute(\"gate_id\")\n\tassert(type(gateId) == \"string\" and gateId ~= \"\", \"Gate id must be a nonempty string\")\n\tassert(exit:GetAttribute(\"gate_id\") == gateId, \"Gate/exit identity mismatch\")\n\tlocal slots: { BasePart } = {}\n\tlocal seen: { [string]: boolean } = {}\n\tfor _, item in root:GetDescendants() do\n\t\tif item:IsA(\"BasePart\") and hasTag(item, \"corn_key_slot\") then\n\t\t\tlocal id = item:GetAttribute(\"slot_id\")\n\t\t\tassert(\n\t\t\t\ttype(id) == \"string\" and id ~= \"\" and not seen[id],\n\t\t\t\t\"Key slot ids must be unique strings\"\n\t\t\t)\n\t\t\tseen[id] = true\n\t\t\ttable\046insert(slots, item)\n\t\tend\n\tend\n\tassert(#slots == expectedSlots, \"CornMap must have \" \046\046 tostring(expectedSlots) \046\046 \" key slots\")\n\ttable\046sort(slots, function(a, b)\n\t\treturn tostring(a:GetAttribute(\"slot_id\")) < tostring(b:GetAttribute(\"slot_id\"))\n\tend)\n\tassert(not root:FindFirstChild(\"CornRoundRuntime\"), \"CornRoundRuntime already exists\")\n\tassert(not anchor:FindFirstChild(\"CornGatePrompt\"), \"CornGatePrompt already exists\")\n\tassert(gate\046CanCollide, \"Closed Door must have CanCollide enabled\")\n\tlocal artOk, artReady = pcall(CornField\046Prepare)\n\tif not artOk or not artReady then\n\t\twarn(\"[AuthoredWorld] Corn art unavailable:\", artReady)\n\tend\n\tlocal runtime = Instance\046new(\"Folder\")\n\truntime\046Name = \"CornRoundRuntime\"\n\truntime:SetAttribute(\"corn_project_id\", \"children_of_corn\")\n\truntime\046Parent = root\n\tlocal gatePrompt = prompt(anchor, \"CornGatePrompt\", \"Открыть\", \"Ворота\", radius)\n\tlocal self = setmetatable({\n\t\tRoot = root,\n\t\tRadius = radius,\n\t\tSlots = slots,\n\t\tSpawns = spawns,\n\t\tSpawn = spawns[1],\n\t\tField = field,\n\t\tGround = ground,\n\t\tHome = home,\n\t\tBounds = bounds,\n\t\tGateModel = gateModel,\n\t\tGate = gate,\n\t\tGateAnchor = anchor,\n\t\tExit = exit,\n\t\tRuntime = runtime,\n\t\tGatePrompt = gatePrompt,\n\t\tClosedTransparency = gate\046Transparency,\n\t\tClosedCollision = gate\046CanCollide,\n\t\tClosedQuery = gate\046CanQuery,\n\t\tKey = nil :: Part?,\n\t\tKeyModel = nil :: Model?,\n\t\tKeyPrompt = nil :: ProximityPrompt?,\n\t}, AuthoredWorld)\n\treturn self\nend\n\nfunction AuthoredWorld:SelectSpawn(index: number): BasePart\n\tassert(index % 1 == 0 and index >= 1 and index <= #self\046Spawns, \"Invalid spawn index\")\n\tlocal spawn = self\046Spawns[index]\n\tvalidateSpawn(self\046Root, spawn, self\046Bounds)\n\tself\046Spawn = spawn\n\treturn spawn\nend\n\nfunction AuthoredWorld:GetSpawnCFrame(): CFrame\n\tvalidateSpawn(self\046Root, self\046Spawn, self\046Bounds)\n\treturn AuthoredWorld\046SpawnCFrame(self\046Spawn)\nend\n\nfunction AuthoredWorld:ClearKey()\n\tif self\046KeyModel then\n\t\tself\046KeyModel:Destroy()\n\telseif self\046Key then\n\t\tself\046Key:Destroy()\n\tend\n\tself\046Key = nil\n\tself\046KeyModel = nil\n\tself\046KeyPrompt = nil\nend\n\nfunction AuthoredWorld:SpawnKeyAt(frame: CFrame): ProximityPrompt\n\tself:ClearKey()\n\tlocal object, key = ItemModels\046Key(frame)\n\tkey\046Name = \"GateKey\"\n\tobject\046Parent = self\046Runtime\n\tself\046KeyModel = object\n\tself\046Key = key\n\tself\046KeyPrompt =\n\t\tprompt(key, \"CornKeyPrompt\", \"Подобрать\", \"Ключ от ворот\", self\046Radius)\n\treturn self\046KeyPrompt\nend\n\nfunction AuthoredWorld:SpawnKey(slot: BasePart): ProximityPrompt\n\tassert(slot:IsDescendantOf(self\046Root), \"Key slot must belong to CornMap\")\n\treturn self:SpawnKeyAt(slot\046CFrame * CFrame\046new(0, slot\046Size\046Y / 2 + 0\0463, 0))\nend\n\nfunction AuthoredWorld:DropKey(position: Vector3, radius: number): ProximityPrompt?\n\tlocal ray = RaycastParams\046new()\n\tray\046FilterType = Enum\046RaycastFilterType\046Exclude\n\tray\046FilterDescendantsInstances = { self\046Runtime }\n\tray\046RespectCanCollide = true\n\tlocal overlap = OverlapParams\046new()\n\toverlap\046FilterType = Enum\046RaycastFilterType\046Include\n\toverlap\046FilterDescendantsInstances = { self\046Root\046Props, self\046Root\046Boundaries, self\046Gate }\n\toverlap\046RespectCanCollide = true\n\tfor ring = 0, radius do\n\t\tfor angle = 0, if ring == 0 then 0 else 7 do\n\t\t\tlocal offset = Vector3\046new(\n\t\t\t\tmath\046cos(angle * math\046pi / 4),\n\t\t\t\t0,\n\t\t\t\tmath\046sin(angle * math\046pi / 4)\n\t\t\t) * ring\n\t\t\tlocal at = position + offset\n\t\t\tlocal hit = workspace:Raycast(at + Vector3\046new(0, 10, 0), Vector3\046new(0, -40, 0), ray)\n\t\t\tif\n\t\t\t\thit and (hit\046Instance == self\046Ground or hit\046Instance == self\046GateModel\046ExitGround)\n\t\t\tthen\n\t\t\t\tlocal place = hit\046Position + Vector3\046new(0, 0\0465, 0)\n\t\t\t\tlocal obstacles = workspace:GetPartBoundsInBox(\n\t\t\t\t\tCFrame\046new(place + Vector3\046new(0, 1, 0)),\n\t\t\t\t\tVector3\046new(3, 2, 3),\n\t\t\t\t\toverlap\n\t\t\t\t)\n\t\t\t\tif #obstacles == 0 and self:IsOnPlayground(place) then\n\t\t\t\t\treturn self:SpawnKeyAt(CFrame\046new(place))\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn nil\nend\n\nfunction AuthoredWorld:SetGateOpen(open: boolean)\n\tself\046Gate\046CanCollide = if open then false else self\046ClosedCollision\n\tself\046Gate\046CanQuery = if open then false else self\046ClosedQuery\n\tself\046Gate\046Transparency = if open then 1 else self\046ClosedTransparency\n\tself\046GatePrompt\046Enabled = false\n\tself\046Runtime:SetAttribute(\"GateOpen\", open)\nend\n\nfunction AuthoredWorld:SetInteractionEnabled(enabled: boolean, gateOpen: boolean)\n\tself\046GatePrompt\046Enabled = enabled and not gateOpen\n\tif self\046KeyPrompt then\n\t\tself\046KeyPrompt\046Enabled = enabled\n\tend\nend\n\nfunction AuthoredWorld:IsGateFront(position: Vector3): boolean\n\tlocal anchor = self\046Gate\046CFrame:PointToObjectSpace(self\046GateAnchor\046Position)\n\tlocal point = self\046Gate\046CFrame:PointToObjectSpace(position)\n\tlocal frontSign = if anchor\046Z < 0 then -1 else 1\n\treturn point\046Z * frontSign > self\046Gate\046Size\046Z / 2\nend\n\nfunction AuthoredWorld:IsInExit(position: Vector3): boolean\n\treturn inBox(self\046Exit, position)\nend\n\nfunction AuthoredWorld:IsOnPlayground(position: Vector3): boolean\n\treturn inBox(self\046Bounds, position)\nend\n\nfunction AuthoredWorld:IsValid(): boolean\n\tif\n\t\tself\046Root\046Parent ~= Workspace\n\t\tor not self\046Runtime:IsDescendantOf(self\046Root)\n\t\tor not self\046Spawn:IsDescendantOf(self\046Root)\n\t\tor not self\046Field:IsDescendantOf(self\046Root)\n\t\tor not self\046Bounds:IsDescendantOf(self\046Root)\n\t\tor not self\046Gate:IsDescendantOf(self\046Root)\n\t\tor not self\046GateAnchor:IsDescendantOf(self\046Root)\n\t\tor not self\046Exit:IsDescendantOf(self\046Root)\n\t\tor not self\046GatePrompt:IsDescendantOf(self\046GateAnchor)\n\t\tor #self\046Slots ~= 15\n\tthen\n\t\treturn false\n\tend\n\tlocal spawnIds: { [string]: boolean } = {}\n\tfor _, spawn in self\046Spawns do\n\t\tif not pcall(validateSpawn, self\046Root, spawn, self\046Bounds) then\n\t\t\treturn false\n\t\tend\n\t\tlocal id = spawn:GetAttribute(\"spawn_id\") :: string\n\t\tif spawnIds[id] then\n\t\t\treturn false\n\t\tend\n\t\tspawnIds[id] = true\n\tend\n\tlocal gateId = self\046GateModel:GetAttribute(\"gate_id\")\n\tif type(gateId) ~= \"string\" or gateId == \"\" or gateId ~= self\046Exit:GetAttribute(\"gate_id\") then\n\t\treturn false\n\tend\n\tfor _, slot in self\046Slots do\n\t\tif not slot:IsDescendantOf(self\046Root) then\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\nreturn AuthoredWorld\n"},
{path="ServerScriptService/GameServer/Game/CornField",class="ModuleScript",hash="17b7f01b8fc6a44116a91b20f64cf0be92dd05be179c48687ec8ba741e8595e5",history={"5b8847b1e414d6c8c0a5c931441836bc7deb693198d3c8a7012a5bbf1e64c9f4"},source="--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal GameShared = ReplicatedStorage:WaitForChild(\"GameShared\")\nlocal Config = require(GameShared:WaitForChild(\"Config\"):WaitForChild(\"GameConfig\"))\nlocal CornLayout = require(GameShared:WaitForChild(\"Game\"):WaitForChild(\"CornLayout\"))\nlocal CornAppearance = require(GameShared:WaitForChild(\"Game\"):WaitForChild(\"CornAppearance\"))\n\nlocal CornField = {}\nlocal PROJECT_ID = \"children_of_corn\"\nlocal OWNER_ATTRIBUTE = \"CornRuntimeArtOwned\"\n\nfunction CornField\046Prepare(): boolean\n\tif\n\t\tnot RunService:IsStudio()\n\t\tor Config\046Environment ~= \"DEV\"\n\t\tor Config\046Game\046SessionMode ~= \"solo_local\"\n\tthen\n\t\treturn false\n\tend\n\tlocal sources: { Instance } = {}\n\tfor _, item in ServerStorage:GetChildren() do\n\t\tif item\046Name == \"CornPlantTemplate\" or item\046Name == \"SM_Prop_Plant_Corn_01_L\" then\n\t\t\ttable\046insert(sources, item)\n\t\tend\n\tend\n\tif #sources ~= 1 then\n\t\twarn(\n\t\t\t\"[CornField] Expected exactly one ServerStorage CornPlantTemplate or SM_Prop_Plant_Corn_01_L art source\"\n\t\t)\n\t\treturn false\n\tend\n\tlocal prepared, problem = CornLayout\046PrepareTemplate(sources[1])\n\tif not prepared then\n\t\twarn(\"[CornField] \" \046\046 (problem or \"Could not prepare corn art\"))\n\t\treturn false\n\tend\n\tif\n\t\tnot prepared:IsA(\"MeshPart\")\n\t\tor prepared\046MeshId ~= CornAppearance\046MeshId\n\t\tor (prepared\046TextureID ~= CornAppearance\046GreenTextureId and prepared\046TextureID ~= CornAppearance\046DryTextureId)\n\t\tor prepared:FindFirstChildWhichIsA(\"SurfaceAppearance\")\n\tthen\n\t\tprepared:Destroy()\n\t\twarn(\"[CornField] Unknown corn appearance; existing prepared art was preserved\")\n\t\treturn false\n\tend\n\t-- Both renderers inherit yellow before the template can replicate or be cloned\046\n\tprepared\046TextureID = CornAppearance\046DryTextureId\n\tlocal folder: Instance? = nil\n\tfor _, item in ReplicatedStorage:GetChildren() do\n\t\tif item\046Name == \"CornRuntimeArt\" then\n\t\t\tif folder then\n\t\t\t\tprepared:Destroy()\n\t\t\t\twarn(\n\t\t\t\t\t\"[CornField] Duplicate CornRuntimeArt containers; existing contents were preserved\"\n\t\t\t\t)\n\t\t\t\treturn false\n\t\t\tend\n\t\t\tfolder = item\n\t\tend\n\tend\n\tif\n\t\tfolder\n\t\tand (\n\t\t\tnot folder:IsA(\"Folder\")\n\t\t\tor folder:GetAttribute(OWNER_ATTRIBUTE) ~= true\n\t\t\tor folder:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\t)\n\tthen\n\t\tprepared:Destroy()\n\t\twarn(\"[CornField] Refused to overwrite an unowned CornRuntimeArt container\")\n\t\treturn false\n\tend\n\tif folder then\n\t\tfor _, item in folder:GetChildren() do\n\t\t\tif\n\t\t\t\titem\046Name == \"CornPlantTemplate\"\n\t\t\t\tand item:GetAttribute(\"CornPlantTemplateOwned\") ~= true\n\t\t\tthen\n\t\t\t\tprepared:Destroy()\n\t\t\t\twarn(\"[CornField] Refused to overwrite unowned CornPlantTemplate art\")\n\t\t\t\treturn false\n\t\t\tend\n\t\tend\n\telse\n\t\tfolder = Instance\046new(\"Folder\")\n\t\tfolder\046Name = \"CornRuntimeArt\"\n\t\tfolder:SetAttribute(OWNER_ATTRIBUTE, true)\n\t\tfolder:SetAttribute(\"corn_project_id\", PROJECT_ID)\n\tend\n\tprepared\046Name = \"CornPlantTemplate\"\n\tprepared:SetAttribute(\"CornPlantTemplateOwned\", true)\n\tprepared:SetAttribute(\"CornPlantHeight\", CornLayout\046Height)\n\tfor _, item in folder:GetChildren() do\n\t\tif\n\t\t\titem\046Name == \"CornPlantTemplate\"\n\t\t\tand item:GetAttribute(\"CornPlantTemplateOwned\") == true\n\t\tthen\n\t\t\titem:Destroy()\n\t\tend\n\tend\n\tprepared\046Parent = folder\n\tfolder\046Parent = ReplicatedStorage\n\tprint(\"[CornField] Prepared a corn art clone; ServerStorage source is unchanged\")\n\treturn true\nend\n\nreturn CornField\n"},
{path="ServerScriptService/GameServer/Game/FarmGeometry",class="ModuleScript",hash="fdb508a4ff2aff045937168108f34ed568b68051f302223621829dd605feb54a",history={},source=nil},
{path="ServerScriptService/GameServer/Game/InventoryWorld",class="ModuleScript",hash="59ca89338de198c7c6ed7a296e08d227249d06b57170744681b537eb9cc845b7",history={"73d7fb267eccdaaa6759f11d1041d658ef18eea0d721753d359fac36540068e1","e77dd9d3e6f410d430535eca3144198eac9539abaea7c0c9959775f4560fe388"},source="--!strict\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Models = require(script\046Parent:WaitForChild(\"ItemModels\"))\nlocal InventoryWorld = {}\nInventoryWorld\046__index = InventoryWorld\nfunction InventoryWorld\046new(world: any, random: Random, keySlot: BasePart, onPickup: any): any\n\tlocal folder = Instance\046new(\"Folder\")\n\tfolder\046Name = \"InventoryItems\"\n\tfolder:SetAttribute(\"corn_inventory_owned\", true)\n\tfolder:SetAttribute(\"corn_project_id\", \"children_of_corn\")\n\tfolder\046Parent = world\046Runtime\n\tlocal lookouts = Instance\046new(\"Folder\")\n\tlookouts\046Name = \"LookoutStumps\"\n\tlookouts:SetAttribute(\"corn_inventory_owned\", true)\n\tlookouts:SetAttribute(\"corn_project_id\", \"children_of_corn\")\n\tlookouts\046Parent = folder\n\tlocal self = setmetatable(\n\t\t{ world = world, folder = folder, pickups = {}, traps = {}, connections = {} },\n\t\tInventoryWorld\n\t)\n\tlocal slots = table\046clone(world\046Slots)\n\tfor index = #slots, 2, -1 do\n\t\tlocal other = random:NextInteger(1, index)\n\t\tslots[index], slots[other] = slots[other], slots[index]\n\tend\n\tlocal used = 0\n\tfor _, slot in slots do\n\t\tif slot == keySlot then\n\t\t\tcontinue\n\t\tend\n\t\tused += 1\n\t\tlocal kind = if used <= 2 then \"energy\" else \"trap\"\n\t\tlocal position = Vector3\046new(\n\t\t\tslot\046Position\046X + (if kind == \"energy\" then 3\0466 else -3\0466),\n\t\t\tworld\046Ground\046Position\046Y + world\046Ground\046Size\046Y / 2,\n\t\t\tslot\046Position\046Z\n\t\t)\n\t\tlocal frame = CFrame\046new(\n\t\t\tposition\n\t\t\t\t+ Vector3\046new(0, if kind == \"energy\" then Models\046StumpHeight + 0\04668 else 0\04622, 0)\n\t\t)\n\t\tlocal object, anchor\n\t\tif kind == \"energy\" then\n\t\t\tobject, anchor = Models\046Energy(frame)\n\t\telse\n\t\t\tobject, anchor = Models\046Trap(frame)\n\t\tend\n\t\tobject\046Name = \"Pickup\" \046\046 used\n\t\tobject:SetAttribute(\"item_kind\", kind)\n\t\tobject:SetAttribute(\"item_id\", tostring(used))\n\t\tobject:AddTag(\"corn_item_pickup\")\n\t\tif kind == \"energy\" then\n\t\t\tlocal lookout = Instance\046new(\"Model\")\n\t\t\tlookout\046Name = \"Lookout\" \046\046 used\n\t\t\tlookout:SetAttribute(\"corn_inventory_owned\", true)\n\t\t\tlookout:SetAttribute(\"corn_project_id\", \"children_of_corn\")\n\t\t\tlookout:SetAttribute(\"LookoutVersion\", 1)\n\t\t\tlookout:AddTag(\"corn_lookout_stump\")\n\t\t\tlookout\046PrimaryPart = Models\046Stump(\n\t\t\t\tlookout,\n\t\t\t\tCFrame\046new(position + Vector3\046new(0, Models\046StumpHeight / 2, 0))\n\t\t\t)\n\t\t\tlookout\046Parent = lookouts\n\t\tend\n\t\tlocal prompt = Instance\046new(\"ProximityPrompt\")\n\t\tprompt\046Name = \"CornItemPrompt\"\n\t\tprompt\046KeyboardKeyCode = Enum\046KeyCode\046E\n\t\tprompt\046ActionText = \"Подобрать\"\n\t\tprompt\046ObjectText = if kind == \"energy\" then \"Энергетик\" else \"Капкан\"\n\t\tprompt\046MaxActivationDistance = world\046Radius\n\t\tprompt\046RequiresLineOfSight = true\n\t\tprompt\046Parent = anchor\n\t\tlocal entry = { model = object, anchor = anchor, prompt = prompt, kind = kind }\n\t\ttable\046insert(self\046pickups, entry)\n\t\ttable\046insert(\n\t\t\tself\046connections,\n\t\t\tprompt\046Triggered:Connect(function(player)\n\t\t\t\tonPickup(player, entry)\n\t\t\tend)\n\t\t)\n\t\tobject\046Parent = folder\n\t\tif used == 4 then\n\t\t\tbreak\n\t\tend\n\tend\n\treturn self\nend\nfunction InventoryWorld:SetEnabled(enabled: boolean)\n\tfor _, entry in self\046pickups do\n\t\tif entry\046model\046Parent then\n\t\t\tentry\046prompt\046Enabled = enabled\n\t\tend\n\tend\nend\nfunction InventoryWorld:Take(entry: any): boolean\n\tif not table\046find(self\046pickups, entry) or entry\046model\046Parent ~= self\046folder then\n\t\treturn false\n\tend\n\tentry\046prompt\046Enabled = false\n\tentry\046model:Destroy()\n\treturn true\nend\nfunction InventoryWorld:Place(root: BasePart, character: Model): boolean\n\tif #self\046traps >= 2 then\n\t\treturn false\n\tend\n\tlocal params = RaycastParams\046new()\n\tparams\046FilterType = Enum\046RaycastFilterType\046Exclude\n\t-- Runtime lookouts are real collision surfaces\046 Do not place through their\n\t-- wood; other owned items/NPC are noncollidable and are skipped by the ray\046\n\tparams\046FilterDescendantsInstances = { character }\n\tparams\046RespectCanCollide = true\n\tlocal hit = Workspace:Raycast(root\046Position, Vector3\046new(0, -9, 0), params)\n\tlocal props = self\046world\046Root:FindFirstChild(\"Props\")\n\tlocal road = if props then props:FindFirstChild(\"VillageRoad\") else nil\n\tif\n\t\tnot hit\n\t\tor (hit\046Instance ~= self\046world\046Ground and not (road and hit\046Instance:IsDescendantOf(road)))\n\t\tor not self\046world:IsOnPlayground(hit\046Position)\n\tthen\n\t\treturn false\n\tend\n\tlocal object, anchor = Models\046Trap(CFrame\046new(hit\046Position + Vector3\046new(0, 0\04615, 0)))\n\tobject\046Name = \"PlacedTrap\" \046\046 (#self\046traps + 1)\n\tobject:AddTag(\"corn_placed_trap\")\n\tobject:SetAttribute(\"item_kind\", \"trap\")\n\tobject\046Parent = self\046folder\n\ttable\046insert(self\046traps, { model = object, position = anchor\046Position, spent = false })\n\treturn true\nend\nfunction InventoryWorld:CheckTraps(hunt: any, from: Vector3?, now: number): boolean\n\tlocal at = hunt:GetPosition()\n\tif not at or hunt\046state == \"trapped\" then\n\t\treturn false\n\tend\n\tlocal start = from or at\n\tlocal segment = Vector3\046new(at\046X - start\046X, 0, at\046Z - start\046Z)\n\tfor _, trap in self\046traps do\n\t\tif trap\046spent then\n\t\t\tcontinue\n\t\tend\n\t\tlocal offset = Vector3\046new(trap\046position\046X - start\046X, 0, trap\046position\046Z - start\046Z)\n\t\tlocal t = if segment\046Magnitude > 0\n\t\t\tthen math\046clamp(offset:Dot(segment) / segment:Dot(segment), 0, 1)\n\t\t\telse 0\n\t\tlocal closest = start + (at - start) * t\n\t\tif\n\t\t\tVector3\046new(closest\046X - trap\046position\046X, 0, closest\046Z - trap\046position\046Z)\046Magnitude\n\t\t\t\t<= 2\0463\n\t\t\tand math\046abs(closest\046Y - trap\046position\046Y) <= 5\n\t\t\tand hunt:Stun(now, 10)\n\t\tthen\n\t\t\ttrap\046spent = true\n\t\t\ttrap\046model:SetAttribute(\"Triggered\", true)\n\t\t\tlocal closed = Models\046Trap(CFrame\046new(trap\046position), true)\n\t\t\tclosed\046Name = \"SpentTrap\"\n\t\t\tclosed\046Parent = self\046folder\n\t\t\ttrap\046model:Destroy()\n\t\t\ttask\046delay(10, function()\n\t\t\t\tclosed:Destroy()\n\t\t\tend)\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\nfunction InventoryWorld:Destroy()\n\tfor _, connection in self\046connections do\n\t\tconnection:Disconnect()\n\tend\n\tself\046folder:Destroy()\n\ttable\046clear(self\046pickups)\n\ttable\046clear(self\046traps)\nend\nreturn InventoryWorld\n"},
{path="ServerScriptService/GameServer/Game/ItemModels",class="ModuleScript",hash="7a842078fe3551aea7f063deea0527d5aad9de7e31f3359eff0d68c068e0685d",history={"986ffb0ce0643694f1886f1b029a433783c416ec1a20d281984da5ae460f2eea"},source="--!strict\nlocal ItemModels = {}\nItemModels\046StumpHeight = 8\nItemModels\046StumpDiameter = 6\nlocal function part(\n\tparent: Instance,\n\tname: string,\n\tsize: Vector3,\n\tframe: CFrame,\n\tcolor: Color3,\n\tmaterial: Enum\046Material?\n): Part\n\tlocal item = Instance\046new(\"Part\")\n\titem\046Name = name\n\titem\046Size = size\n\titem\046CFrame = frame\n\titem\046Color = color\n\titem\046Material = material or Enum\046Material\046Metal\n\titem\046Anchored = true\n\titem\046CanCollide = false\n\titem\046CanTouch = false\n\titem\046CanQuery = false\n\titem\046Parent = parent\n\treturn item\nend\nlocal function model(name: string): (Model, Part)\n\tlocal object = Instance\046new(\"Model\")\n\tobject\046Name = name\n\tobject:SetAttribute(\"corn_inventory_owned\", true)\n\tobject:SetAttribute(\"corn_project_id\", \"children_of_corn\")\n\tlocal anchor =\n\t\tpart(object, \"Anchor\", Vector3\046new(0\0461, 0\0461, 0\0461), CFrame\046identity, Color3\046new(1, 1, 1))\n\tanchor\046Transparency = 1\n\tobject\046PrimaryPart = anchor\n\treturn object, anchor\nend\nfunction ItemModels\046Key(frame: CFrame): (Model, Part)\n\tlocal object, anchor = model(\"GateKeyModel\")\n\tlocal gold = Color3\046fromRGB(235, 192, 60)\n\tanchor\046CFrame = frame\n\tfor index = 1, 12 do\n\t\tlocal angle = index * math\046pi / 6\n\t\tpart(\n\t\t\tobject,\n\t\t\t\"Ring\" \046\046 index,\n\t\t\tVector3\046new(0\04626, 0\04615, 0\04642),\n\t\t\tframe\n\t\t\t\t* CFrame\046new(math\046cos(angle) * 0\04665, 0, -1 + math\046sin(angle) * 0\04665)\n\t\t\t\t* CFrame\046Angles(0, -angle, 0),\n\t\t\tgold\n\t\t)\n\tend\n\tpart(object, \"Shaft\", Vector3\046new(0\04623, 0\04617, 1\04695), frame * CFrame\046new(0, 0, 0\04658), gold)\n\tfor index = 1, 2 do\n\t\tpart(\n\t\t\tobject,\n\t\t\t\"Tooth\" \046\046 index,\n\t\t\tVector3\046new(0\04658, 0\04617, 0\04622),\n\t\t\tframe * CFrame\046new(0\0462, 0, 0\04675 + index * 0\04636),\n\t\t\tgold\n\t\t)\n\tend\n\treturn object, anchor\nend\nfunction ItemModels\046Energy(frame: CFrame): (Model, Part)\n\tlocal object, anchor = model(\"EnergyCan\")\n\tanchor\046CFrame = frame\n\tlocal body = part(\n\t\tobject,\n\t\t\"Can\",\n\t\tVector3\046new(1\04625, 0\04672, 0\04672),\n\t\tframe * CFrame\046Angles(0, 0, math\046pi / 2),\n\t\tColor3\046fromRGB(38, 116, 65)\n\t)\n\tbody\046Shape = Enum\046PartType\046Cylinder\n\tfor _, offset in { -0\04662, 0\04662 } do\n\t\tlocal lid = part(\n\t\t\tobject,\n\t\t\t\"Lid\",\n\t\t\tVector3\046new(0\04607, 0\04674, 0\04674),\n\t\t\tframe * CFrame\046new(0, offset, 0) * CFrame\046Angles(0, 0, math\046pi / 2),\n\t\t\tColor3\046fromRGB(180, 192, 185)\n\t\t)\n\t\tlid\046Shape = Enum\046PartType\046Cylinder\n\tend\n\tlocal label = Instance\046new(\"SurfaceGui\")\n\tlabel\046Face = Enum\046NormalId\046Front\n\tlabel\046CanvasSize = Vector2\046new(256, 256)\n\tlabel\046Parent = body\n\tlocal text = Instance\046new(\"TextLabel\")\n\ttext\046Size = UDim2\046fromScale(1, 1)\n\ttext\046BackgroundTransparency = 1\n\ttext\046Text = \"⚡\"\n\ttext\046TextColor3 = Color3\046fromRGB(240, 255, 133)\n\ttext\046TextScaled = true\n\ttext\046Parent = label\n\treturn object, anchor\nend\nfunction ItemModels\046Trap(frame: CFrame, closed: boolean?): (Model, Part)\n\tlocal object, anchor = model(\"BearTrap\")\n\tanchor\046CFrame = frame\n\tlocal steel = Color3\046fromRGB(91, 100, 99)\n\tlocal base = part(\n\t\tobject,\n\t\t\"Plate\",\n\t\tVector3\046new(0\04616, 2\0462, 2\0462),\n\t\tframe * CFrame\046Angles(0, 0, math\046pi / 2),\n\t\tsteel\n\t)\n\tbase\046Shape = Enum\046PartType\046Cylinder\n\tfor side = -1, 1, 2 do\n\t\tlocal jaw = frame * CFrame\046new(side * 0\04695, 0\04618, 0)\n\t\tif closed then\n\t\t\tjaw = jaw * CFrame\046Angles(0, 0, side * math\046rad(65))\n\t\tend\n\t\tpart(object, \"Jaw\", Vector3\046new(0\04618, 0\0462, 2\04615), jaw, steel)\n\t\tfor tooth = -2, 2 do\n\t\t\tpart(\n\t\t\t\tobject,\n\t\t\t\t\"Tooth\",\n\t\t\t\tVector3\046new(0\04616, 0\04632, 0\04618),\n\t\t\t\tjaw * CFrame\046new(0, 0\0462, tooth * 0\0464),\n\t\t\t\tColor3\046fromRGB(163, 170, 164)\n\t\t\t)\n\t\tend\n\tend\n\tpart(\n\t\tobject,\n\t\t\"Trigger\",\n\t\tVector3\046new(0\04665, 0\04613, 0\04665),\n\t\tframe * CFrame\046new(0, 0\04615, 0),\n\t\tColor3\046fromRGB(154, 118, 62)\n\t)\n\treturn object, anchor\nend\nfunction ItemModels\046Stump(parent: Instance, frame: CFrame): Part\n\tlocal function log(\n\t\tname: string,\n\t\tcapName: string,\n\t\tcenter: CFrame,\n\t\theight: number,\n\t\tdiameter: number\n\t): Part\n\t\tlocal body = part(\n\t\t\tparent,\n\t\t\tname,\n\t\t\tVector3\046new(height, diameter, diameter),\n\t\t\tcenter * CFrame\046Angles(0, 0, math\046pi / 2),\n\t\t\tColor3\046fromRGB(94, 70, 43),\n\t\t\tEnum\046Material\046Wood\n\t\t)\n\t\tbody\046Shape = Enum\046PartType\046Cylinder\n\t\tbody\046CanCollide = true\n\t\tbody\046CanQuery = true\n\t\tlocal cap = part(\n\t\t\tparent,\n\t\t\tcapName,\n\t\t\tVector3\046new(0\04612, diameter - 0\04615, diameter - 0\04615),\n\t\t\tcenter * CFrame\046new(0, height / 2 + 0\04601, 0) * CFrame\046Angles(0, 0, math\046pi / 2),\n\t\t\tColor3\046fromRGB(171, 143, 95),\n\t\t\tEnum\046Material\046Wood\n\t\t)\n\t\tcap\046Shape = Enum\046PartType\046Cylinder\n\t\treturn body\n\tend\n\tlocal stump = log(\"Stump\", \"CutWood\", frame, ItemModels\046StumpHeight, ItemModels\046StumpDiameter)\n\tlocal ground = frame * CFrame\046new(0, -ItemModels\046StumpHeight / 2, 0)\n\tlog(\"Step1\", \"Step1Top\", ground * CFrame\046new(-7, 1\04625, 0), 2\0465, 3\0462)\n\tlog(\"Step2\", \"Step2Top\", ground * CFrame\046new(-4, 2\0465, 0), 5, 3\0462)\n\treturn stump\nend\nreturn ItemModels\n"},
