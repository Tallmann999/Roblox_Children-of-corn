{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CornAppearanceController",class="ModuleScript",hash="475ba50562138abeede58b1379f18aeb9fc3064d3bd43e98a23185164ed8463b",history={"e0f754b62ccad10352e8f13fdc27d6addc4e8dcafcbd66a20dd81b3b15dc99ed","c64be7bdc71d70c9aa08d7727babd7936c9a24946111a757e857fb7b1a2c3bde"},source="--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Appearance = require(\n\tReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\"):WaitForChild(\"CornAppearance\")\n)\n\nlocal Controller = { Name = \"CornAppearanceController\", Order = 54 }\nlocal PROJECT = \"children_of_corn\"\nlocal BATCH = 384\nlocal TIME_BUDGET = 0\046002\nlocal MAP_ROOTS = {\n\tEditorFieldOverview = \"CornEditorOverview\",\n\tCornClientPlants = \"CornClientRendererOwned\",\n\tCornClientBackdrop = \"CornClientBackdropOwned\",\n}\n\nlocal function recognized(root: Instance, flag: string): boolean\n\treturn root:GetAttribute(flag) == true and root:GetAttribute(\"corn_project_id\") == PROJECT\nend\n\nlocal function ownedPart(root: any, part: MeshPart): boolean\n\tlocal folder = root\046folder\n\tif\n\t\tnot recognized(folder, root\046flag)\n\t\tor not part\046Anchored\n\t\tor part\046CanCollide\n\t\tor part\046CanTouch\n\t\tor part\046CanQuery\n\tthen\n\t\treturn false\n\tend\n\tif root\046flag == \"CornRuntimeArtOwned\" then\n\t\treturn part\046Parent == folder\n\t\t\tand part\046Name == \"CornPlantTemplate\"\n\t\t\tand part:GetAttribute(\"CornPlantTemplateOwned\") == true\n\telseif root\046flag == \"CornClientRendererOwned\" then\n\t\tlocal group = part\046Parent\n\t\treturn group ~= nil\n\t\t\tand group:IsA(\"Folder\")\n\t\t\tand group\046Parent == folder\n\t\t\tand part\046Name == \"Corn\"\n\t\t\tand part:GetAttribute(\"CornPlantTemplateOwned\") == true\n\tend\n\treturn part\046Parent == folder\n\t\tand part:GetAttribute(\"CornEditorOverview\") == true\n\t\tand part:GetAttribute(\"corn_project_id\") == PROJECT\n\t\tand (\n\t\t\troot\046flag ~= \"CornClientBackdropOwned\"\n\t\t\tor part:GetAttribute(\"CornClientBackdropOwned\") == true\n\t\t)\nend\n\nfunction Controller:_enqueue(part: MeshPart)\n\tif not self\046_queued[part] then\n\t\tself\046_queued[part] = true\n\t\ttable\046insert(self\046_queue, part)\n\tend\nend\n\nfunction Controller:_restore(part: MeshPart, entry: any)\n\t-- Preserve an unrelated manual texture change rather than overwriting it\046\n\tif entry\046applied and part\046TextureID == Appearance\046DryTextureId then\n\t\tpart\046TextureID = entry\046texture\n\tend\n\tentry\046applied = false\nend\n\nfunction Controller:_forget(part: MeshPart)\n\tlocal entry = self\046_entries[part]\n\tif entry then\n\t\tself:_restore(part, entry)\n\t\tentry\046root\046parts[part] = nil\n\t\tself\046_entries[part] = nil\n\tend\n\tself\046_queued[part] = nil\nend\n\nfunction Controller:_register(root: any, item: Instance)\n\tif\n\t\tnot item:IsA(\"MeshPart\")\n\t\tor item\046MeshId ~= Appearance\046MeshId\n\t\tor self\046_entries[item]\n\t\tor not ownedPart(root, item)\n\tthen\n\t\treturn\n\tend\n\tif item:FindFirstChildWhichIsA(\"SurfaceAppearance\") then\n\t\treturn\n\tend\n\tlocal texture = item\046TextureID\n\tif texture ~= Appearance\046GreenTextureId and texture ~= Appearance\046DryTextureId then\n\t\treturn\n\tend\n\t-- Prepared/saved yellow copies keep that exact baseline through menu/cleanup\046\n\tlocal entry = {\n\t\troot = root,\n\t\ttexture = texture,\n\t\tapplied = false,\n\t}\n\tself\046_entries[item] = entry\n\troot\046parts[item] = true\n\tself:_enqueue(item)\nend\n\nfunction Controller:_bind(folder: Instance, flag: string)\n\tif self\046_roots[folder] then\n\t\treturn\n\tend\n\tlocal root = { folder = folder, flag = flag, parts = {}, connections = {} }\n\tself\046_roots[folder] = root\n\ttable\046insert(\n\t\troot\046connections,\n\t\tfolder\046DescendantAdded:Connect(function(item)\n\t\t\tself:_register(root, item)\n\t\tend)\n\t)\n\ttable\046insert(\n\t\troot\046connections,\n\t\tfolder\046DescendantRemoving:Connect(function(item)\n\t\t\tif item:IsA(\"MeshPart\") then\n\t\t\t\tself:_forget(item)\n\t\t\tend\n\t\tend)\n\t)\n\tfor _, item in folder:GetDescendants() do\n\t\tself:_register(root, item)\n\tend\nend\n\nfunction Controller:_unbind(root: any)\n\tfor _, connection in root\046connections do\n\t\tconnection:Disconnect()\n\tend\n\tfor part in root\046parts do\n\t\tself:_forget(part)\n\tend\n\tself\046_roots[root\046folder] = nil\nend\n\nfunction Controller:_refresh()\n\tlocal map = Workspace:FindFirstChild(\"CornMap\")\n\tlocal validMap = map and map:IsA(\"Model\") and map:GetAttribute(\"corn_project_id\") == PROJECT\n\tlocal desired = {}\n\tif\n\t\tvalidMap\n\t\tand not Workspace:FindFirstChild(\"Asmr_Base\")\n\t\tand not Workspace:FindFirstChild(\"ASMR_Models\")\n\tthen\n\t\tfor name, flag in MAP_ROOTS do\n\t\t\tlocal folder = map:FindFirstChild(name)\n\t\t\tif folder and folder:IsA(\"Folder\") and recognized(folder, flag) then\n\t\t\t\tdesired[folder] = flag\n\t\t\tend\n\t\tend\n\t\tlocal art = ReplicatedStorage:FindFirstChild(\"CornRuntimeArt\")\n\t\tif art and art:IsA(\"Folder\") and recognized(art, \"CornRuntimeArtOwned\") then\n\t\t\tdesired[art] = \"CornRuntimeArtOwned\"\n\t\tend\n\tend\n\tfor folder, root in self\046_roots do\n\t\tif not desired[folder] then\n\t\t\tself:_unbind(root)\n\t\tend\n\tend\n\tfor folder, flag in desired do\n\t\tself:_bind(folder, flag)\n\tend\nend\n\nfunction Controller:_apply(part: MeshPart)\n\tlocal entry = self\046_entries[part]\n\tif not entry then\n\t\treturn\n\tend\n\tlocal root = entry\046root\n\tif\n\t\tnot part:IsDescendantOf(root\046folder)\n\t\tor not ownedPart(root, part)\n\t\tor part:FindFirstChildWhichIsA(\"SurfaceAppearance\")\n\tthen\n\t\tself:_forget(part)\n\t\treturn\n\tend\n\tlocal expected = if entry\046applied then Appearance\046DryTextureId else entry\046texture\n\tif part\046TextureID ~= expected or part\046MeshId ~= Appearance\046MeshId then\n\t\t-- Drop ownership of this appearance; the author changed the runtime copy\046\n\t\troot\046parts[part] = nil\n\t\tself\046_entries[part] = nil\n\t\treturn\n\tend\n\tif Appearance\046IsDry(self\046_mode) then\n\t\tpart\046TextureID = Appearance\046DryTextureId\n\t\tentry\046applied = true\n\telse\n\t\tself:_restore(part, entry)\n\tend\nend\n\nfunction Controller:SetMode(mode: string?)\n\tif not Appearance\046IsValidMode(mode) or mode == self\046_mode then\n\t\treturn\n\tend\n\tself\046_mode = mode\n\tfor part in self\046_entries do\n\t\tself:_enqueue(part)\n\tend\nend\n\nfunction Controller:Init(_context: any)\n\tself\046_mode = nil\n\tself\046_entries = {}\n\tself\046_roots = {}\n\tself\046_queue = {}\n\tself\046_queued = {}\n\tself\046_head = 1\n\tself\046_poll = 0\nend\n\nfunction Controller:Start(context: any)\n\tif\n\t\tnot RunService:IsStudio()\n\t\tor context\046Config\046Environment ~= \"DEV\"\n\t\tor context\046Config\046Game\046SessionMode ~= \"solo_local\"\n\tthen\n\t\treturn\n\tend\n\tself:_refresh()\n\tself\046_heartbeat = RunService\046Heartbeat:Connect(function(dt)\n\t\tself\046_poll += dt\n\t\tif self\046_poll >= 1 then\n\t\t\tself\046_poll = 0\n\t\t\tself:_refresh()\n\t\tend\n\t\tlocal began, count = os\046clock(), 0\n\t\twhile self\046_head <= #self\046_queue and count < BATCH and os\046clock() - began < TIME_BUDGET do\n\t\t\tlocal part = self\046_queue[self\046_head]\n\t\t\tself\046_head += 1\n\t\t\tself\046_queued[part] = nil\n\t\t\tself:_apply(part)\n\t\t\tcount += 1\n\t\tend\n\t\tif self\046_head > #self\046_queue then\n\t\t\ttable\046clear(self\046_queue)\n\t\t\tself\046_head = 1\n\t\tend\n\tend)\nend\n\nfunction Controller:Destroy()\n\tif self\046_heartbeat then\n\t\tself\046_heartbeat:Disconnect()\n\t\tself\046_heartbeat = nil\n\tend\n\tfor _, root in self\046_roots do\n\t\tself:_unbind(root)\n\tend\n\ttable\046clear(self\046_queue)\n\ttable\046clear(self\046_queued)\nend\n\nreturn Controller\n"},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CornBackdropController",class="ModuleScript",hash="40537424f04afc896c43669bef5997d8f3ab6ecf20a08af0c1fabd0c9beb0670",history={"8814ccdc2b741da460646e4178c7ca2a4803133a9d3eca2db8c09cd823189976"},source="--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal CornLayout = require(\n\tReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\"):WaitForChild(\"CornLayout\")\n)\n\nlocal CornBackdropController = { Name = \"CornBackdropController\", Order = 45 }\nlocal PROJECT_ID = \"children_of_corn\"\nlocal FOLDER_NAME = \"CornClientBackdrop\"\nlocal STRIDE = 2 -- CornLayout\046Spacing * 2 = 6 studs; tune only after foreground engine QA\046\nlocal MAX_PLANTS = 20000\nlocal CLONE_BUDGET = 18\nlocal TIME_BUDGET = 0\046002\nlocal POLL_SEC = 1\n\nlocal function owned(item: Instance): boolean\n\treturn item:GetAttribute(\"CornClientBackdropOwned\") == true\n\t\tand item:GetAttribute(\"corn_project_id\") == PROJECT_ID\nend\n\nlocal function ownedTree(folder: Instance): boolean\n\tif not owned(folder) then\n\t\treturn false\n\tend\n\tfor _, item in folder:GetDescendants() do\n\t\tif not owned(item) then\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\nlocal function staticArt(template: Instance): boolean\n\tfor _, item in template:GetDescendants() do\n\t\tif\n\t\t\titem:IsA(\"LuaSourceContainer\")\n\t\t\tor item:IsA(\"Sound\")\n\t\t\tor item:IsA(\"ParticleEmitter\")\n\t\t\tor item:IsA(\"Beam\")\n\t\t\tor item:IsA(\"Trail\")\n\t\t\tor item:IsA(\"ProximityPrompt\")\n\t\t\tor item:IsA(\"ClickDetector\")\n\t\t\tor item:IsA(\"RemoteEvent\")\n\t\t\tor item:IsA(\"RemoteFunction\")\n\t\tthen\n\t\t\treturn false\n\t\tend\n\tend\n\treturn template\046Archivable\nend\n\nfunction CornBackdropController:_warn(message: string)\n\tif self\046_lastWarning ~= message then\n\t\tself\046_lastWarning = message\n\t\twarn(\"[CornBackdropController] \" \046\046 message)\n\tend\nend\n\nfunction CornBackdropController:_bridge(folder: Folder): boolean\n\tlocal renderer = self\046_renderer\n\treturn renderer ~= nil\n\t\tand typeof(renderer\046UseBackdropReady) == \"function\"\n\t\tand renderer:UseBackdropReady(folder) == true\nend\n\nfunction CornBackdropController:_restoreOriginals()\n\tfor part, previous in self\046_originals do\n\t\tif part\046Parent then\n\t\t\tpart\046LocalTransparencyModifier = previous\n\t\tend\n\tend\n\ttable\046clear(self\046_originals)\nend\n\nfunction CornBackdropController:_clear()\n\tself\046_epoch += 1\n\tlocal folder = self\046_folder\n\tif folder and owned(folder) then\n\t\tself:_bridge(folder)\n\t\tfolder:SetAttribute(\"Ready\", false)\n\tend\n\tself:_restoreOriginals()\n\tif folder then\n\t\tif ownedTree(folder) then\n\t\t\tfolder:Destroy()\n\t\telse\n\t\t\tself:_warn(\n\t\t\t\t\"Changed ownership or foreign backdrop content was preserved; saved overview restored\"\n\t\t\t)\n\t\tend\n\tend\n\tself\046_folder = nil\n\tself\046_map = nil\n\tself\046_field = nil\n\tself\046_template = nil\n\tself\046_exclusions = nil\n\tself\046_signature = nil\n\tself\046_ready = false\n\tself\046_count = 0\nend\n\nfunction CornBackdropController:_publish(): boolean\n\tlocal folder, map = self\046_folder, self\046_map\n\tif not folder or not map or folder\046Parent ~= map or not owned(folder) then\n\t\treturn false\n\tend\n\tlocal overview = map:FindFirstChild(\"EditorFieldOverview\")\n\tif\n\t\tnot overview\n\t\tor not overview:IsA(\"Folder\")\n\t\tor overview:GetAttribute(\"CornEditorOverview\") ~= true\n\t\tor overview:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\tthen\n\t\tself:_warn(\"Unrecognized saved overview was preserved; backdrop not published\")\n\t\treturn false\n\tend\n\tlocal originals = overview:GetChildren()\n\tfor _, part in originals do\n\t\tif\n\t\t\tnot part:IsA(\"BasePart\")\n\t\t\tor part:GetAttribute(\"CornEditorOverview\") ~= true\n\t\t\tor part:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tthen\n\t\t\tself:_warn(\"Foreign saved overview content was preserved; backdrop not published\")\n\t\t\treturn false\n\t\tend\n\tend\n\t-- Bridge clears the old near-field mask before we capture its exact original LTM\046\n\t-- No yield between bridge, capture/hide and publication\046\n\tif not self:_bridge(folder) then\n\t\tself:_warn(\"Near-field backdrop bridge unavailable; saved overview preserved\")\n\t\treturn false\n\tend\n\tfor _, item in originals do\n\t\tlocal part = item :: BasePart\n\t\tself\046_originals[part] = part\046LocalTransparencyModifier\n\t\tpart\046LocalTransparencyModifier = 1\n\tend\n\tself\046_ready = true\n\tfolder:SetAttribute(\"LoadedPlants\", self\046_count)\n\tfolder:SetAttribute(\"Ready\", true)\n\treturn true\nend\n\nfunction CornBackdropController:_resolveInputs(): boolean\n\tif not self\046_renderer or typeof(self\046_renderer\046UseBackdropReady) ~= \"function\" then\n\t\tself:_clear()\n\t\tself:_warn(\"Near-field backdrop bridge unavailable; saved overview preserved\")\n\t\treturn false\n\tend\n\tlocal map = Workspace:FindFirstChild(\"CornMap\")\n\tlocal field = if map then map:FindFirstChild(\"FieldZone\") else nil\n\tlocal art = ReplicatedStorage:FindFirstChild(\"CornRuntimeArt\")\n\tlocal template = if art then art:FindFirstChild(\"CornPlantTemplate\") else nil\n\tif template and template:IsA(\"Model\") then\n\t\tself:_clear()\n\t\tself:_warn(\n\t\t\t\"Backdrop needs a prepared BasePart template compatible with near-field coverage; saved overview preserved\"\n\t\t)\n\t\treturn false\n\tend\n\tif\n\t\tnot map\n\t\tor not map:IsA(\"Model\")\n\t\tor map:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tor Workspace:FindFirstChild(\"Asmr_Base\")\n\t\tor Workspace:FindFirstChild(\"ASMR_Models\")\n\t\tor not field\n\t\tor not field:IsA(\"BasePart\")\n\t\tor field\046CFrame\046UpVector:Dot(Vector3\046yAxis) < 0\0469999\n\t\tor field\046Size\046X <= 0\n\t\tor field\046Size\046Z <= 0\n\t\tor not art\n\t\tor not art:IsA(\"Folder\")\n\t\tor art:GetAttribute(\"CornRuntimeArtOwned\") ~= true\n\t\tor art:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tor not template\n\t\tor not template:IsA(\"BasePart\")\n\t\tor template:GetAttribute(\"CornPlantTemplateOwned\") ~= true\n\t\tor not staticArt(template)\n\tthen\n\t\tself:_clear()\n\t\tself:_warn(\n\t\t\t\"Owned horizontal field and prepared static art unavailable; saved overview preserved\"\n\t\t)\n\t\treturn false\n\tend\n\tlocal exclusions = CornLayout\046ReadExclusions(map, field)\n\tlocal bounds, size = CornLayout\046Bounds(template)\n\tlocal signature = exclusions\046Signature\n\t\t\046\046 \"/template/\"\n\t\t\046\046 tostring(bounds)\n\t\t\046\046 \"/\"\n\t\t\046\046 tostring(size)\n\tlocal folder = self\046_folder\n\tif\n\t\tself\046_map == map\n\t\tand self\046_field == field\n\t\tand self\046_template == template\n\t\tand self\046_signature == signature\n\t\tand folder\n\t\tand folder\046Parent == map\n\t\tand owned(folder)\n\t\tand folder:GetAttribute(\"CornEditorOverview\") == true\n\t\tand folder:GetAttribute(\"Ready\") == self\046_ready\n\tthen\n\t\treturn true\n\tend\n\tself:_clear()\n\tif map:FindFirstChild(FOLDER_NAME) then\n\t\tself:_warn(\"Existing CornMap/CornClientBackdrop was preserved; no replacement attempted\")\n\t\treturn false\n\tend\n\tif self\046_failedSignature == signature then\n\t\treturn false\n\tend\n\tlocal minColumn, maxColumn, minRow, maxRow = CornLayout\046GetCellBounds(field)\n\tminColumn, minRow = math\046ceil(minColumn / STRIDE) * STRIDE, math\046ceil(minRow / STRIDE) * STRIDE\n\tmaxColumn, maxRow =\n\t\tmath\046floor(maxColumn / STRIDE) * STRIDE, math\046floor(maxRow / STRIDE) * STRIDE\n\tlocal candidateCount = (math\046floor((maxColumn - minColumn) / STRIDE) + 1)\n\t\t* (math\046floor((maxRow - minRow) / STRIDE) + 1)\n\tif candidateCount > MAX_PLANTS or candidateCount <= 0 then\n\t\tself:_warn(\"Full-field grid exceeds the 20000 plant cap; saved overview preserved\")\n\t\treturn false\n\tend\n\tself\046_map, self\046_field, self\046_template = map, field, template\n\tself\046_exclusions, self\046_signature = exclusions, signature\n\tself\046_minColumn, self\046_maxColumn = minColumn, maxColumn\n\tself\046_minRow, self\046_maxRow = minRow, maxRow\n\tself\046_column, self\046_row = minColumn, minRow\n\tself\046_fieldFrame = field\046CFrame\n\tself\046_fieldSize = field\046Size\n\tself\046_fieldYaw = math\046atan2(-field\046CFrame\046LookVector\046X, -field\046CFrame\046LookVector\046Z)\n\tfolder = Instance\046new(\"Folder\")\n\tfolder\046Name = FOLDER_NAME\n\tfolder:SetAttribute(\"CornClientBackdropOwned\", true)\n\tfolder:SetAttribute(\"CornEditorOverview\", true)\n\tfolder:SetAttribute(\"corn_project_id\", PROJECT_ID)\n\tfolder:SetAttribute(\"Ready\", false)\n\tfolder:SetAttribute(\"Stride\", STRIDE)\n\tfolder:SetAttribute(\"DetailStride\", STRIDE * CornLayout\046Spacing)\n\tfolder:SetAttribute(\"MaxPlants\", MAX_PLANTS)\n\tfolder:SetAttribute(\"LoadedPlants\", 0)\n\tfolder\046Parent = map\n\tself\046_folder = folder\n\tself\046_lastWarning = \"\"\n\treturn true\nend\n\nfunction CornBackdropController:_advance()\n\tself\046_column += STRIDE\n\tif self\046_column > self\046_maxColumn then\n\t\tself\046_column = self\046_minColumn\n\t\tself\046_row += STRIDE\n\tend\nend\n\nfunction CornBackdropController:_buildStep()\n\tlocal folder, field, template, exclusions =\n\t\tself\046_folder, self\046_field, self\046_template, self\046_exclusions\n\tif not folder or not field or not template or not exclusions or self\046_ready then\n\t\treturn\n\tend\n\tif\n\t\tfolder\046Parent ~= self\046_map\n\t\tor not owned(folder)\n\t\tor field\046CFrame ~= self\046_fieldFrame\n\t\tor field\046Size ~= self\046_fieldSize\n\tthen\n\t\tself:_clear()\n\t\tself\046_pollElapsed = POLL_SEC\n\t\treturn\n\tend\n\tlocal epoch, start = self\046_epoch, self\046_clock()\n\tlocal created = 0\n\twhile\n\t\tself\046_epoch == epoch\n\t\tand self\046_row <= self\046_maxRow\n\t\tand created < CLONE_BUDGET\n\t\tand self\046_count < MAX_PLANTS\n\t\tand self\046_clock() - start < TIME_BUDGET\n\tdo\n\t\tlocal column, row = self\046_column, self\046_row\n\t\tself:_advance()\n\t\tlocal position = CornLayout\046CellPosition(field, column, row)\n\t\tif CornLayout\046IsExcluded(position, exclusions) then\n\t\t\tcontinue\n\t\tend\n\t\tlocal plant = template:Clone()\n\t\tif not plant then\n\t\t\terror(\"Prepared backdrop plant could not be cloned\")\n\t\tend\n\t\tplant\046Name = string\046format(\"Far_%d_%d\", column, row)\n\t\tlocal parts = plant:GetDescendants()\n\t\ttable\046insert(parts, plant)\n\t\tfor _, item in parts do\n\t\t\titem:SetAttribute(\"CornClientBackdropOwned\", true)\n\t\t\titem:SetAttribute(\"CornEditorOverview\", true)\n\t\t\titem:SetAttribute(\"corn_project_id\", PROJECT_ID)\n\t\t\titem:SetAttribute(\"CornPlantTemplateOwned\", nil)\n\t\t\tif item:IsA(\"BasePart\") then\n\t\t\t\titem\046Anchored = true\n\t\t\t\titem\046CanCollide = false\n\t\t\t\titem\046CanTouch = false\n\t\t\t\titem\046CanQuery = false\n\t\t\t\titem\046CastShadow = false\n\t\t\tend\n\t\tend\n\t\tCornLayout\046ApplyVariation(plant, column, row)\n\t\tplant:PivotTo(\n\t\t\tCornLayout\046PivotForPlant(\n\t\t\t\tplant,\n\t\t\t\tposition,\n\t\t\t\tCornLayout\046CellYaw(column, row) + self\046_fieldYaw\n\t\t\t)\n\t\t)\n\t\tplant\046Parent = folder\n\t\tcreated += 1\n\t\tself\046_count += 1\n\tend\n\tfolder:SetAttribute(\"LoadedPlants\", self\046_count)\n\tfolder:SetAttribute(\"LastFrameClones\", created)\n\tfolder:SetAttribute(\"LastFrameSeconds\", self\046_clock() - start)\n\tif self\046_row > self\046_maxRow then\n\t\tif not self:_publish() then\n\t\t\tlocal failed = self\046_signature\n\t\t\tself:_clear()\n\t\t\tself\046_failedSignature = failed\n\t\tend\n\tend\nend\n\nfunction CornBackdropController:_step(delta: number)\n\tself\046_pollElapsed += delta\n\tif self\046_pollElapsed >= POLL_SEC then\n\t\tself\046_pollElapsed = 0\n\t\tself:_resolveInputs()\n\tend\n\tself:_buildStep()\nend\n\nfunction CornBackdropController:Init(context: any)\n\tself\046_enabled = RunService:IsStudio()\n\t\tand context\046Config\046Environment == \"DEV\"\n\t\tand context\046Config\046Game\046SessionMode == \"solo_local\"\n\tself\046_renderer = context\046Controllers\046CornController\n\tself\046_connection = nil\n\tself\046_clock = os\046clock\n\tself\046_epoch = 0\n\tself\046_originals = {}\n\tself\046_ready = false\n\tself\046_count = 0\n\tself\046_lastWarning = \"\"\n\tself\046_pollElapsed = math\046huge\n\tself\046_failedSignature = nil\nend\n\nfunction CornBackdropController:Start()\n\tif not self\046_enabled or self\046_connection then\n\t\treturn\n\tend\n\tself\046_connection = RunService\046Heartbeat:Connect(function(delta: number)\n\t\tlocal ok, problem = pcall(self\046_step, self, delta)\n\t\tif not ok then\n\t\t\tlocal failed = self\046_signature\n\t\t\tself:_clear()\n\t\t\tself\046_failedSignature = failed\n\t\t\tself:_warn(\"Backdrop build failed; saved overview restored: \" \046\046 tostring(problem))\n\t\tend\n\tend)\nend\n\nfunction CornBackdropController:Destroy()\n\tself\046_enabled = false\n\tif self\046_connection then\n\t\tself\046_connection:Disconnect()\n\t\tself\046_connection = nil\n\tend\n\tself:_clear()\n\tself\046_renderer = nil\nend\n\nreturn CornBackdropController\n"},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CornController",class="ModuleScript",hash="6d2c7e4336a1773bd8d5943bb85b686dc4df2c9097c1c7cdf836cc1476ef1e2d",history={"14f0606b7c0587eca7d54e21074846893aeab20f303757edf5dcd2e856d1ab84","788fb790d643d89c535f1511316343b4383d95a5101c42c44fa8676685dc802c"},source="--!strict\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal GameShared = ReplicatedStorage:WaitForChild(\"GameShared\")\nlocal CornLayout = require(GameShared:WaitForChild(\"Game\"):WaitForChild(\"CornLayout\"))\n\ntype Chunk = {\n\tKey: string,\n\tLod: number,\n\tFolder: Folder,\n\tMinColumn: number,\n\tMaxColumn: number,\n\tMinRow: number,\n\tMaxRow: number,\n\tColumn: number,\n\tRow: number,\n\tDistance: number,\n\tCount: number,\n\tAlive: boolean,\n\tDone: boolean,\n}\n\ntype OverviewItem = {\n\tPart: BasePart,\n\tPreviousModifier: number,\n\tFrame: CFrame,\n\tSize: Vector3,\n\tKeys: { string },\n\tHidden: boolean,\n}\n\nlocal CornController = {\n\tName = \"CornController\",\n\tOrder = 50,\n\t_enabled = false,\n\t_connection = nil :: RBXScriptConnection?,\n\t_map = nil :: Model?,\n\t_field = nil :: BasePart?,\n\t_template = nil :: CornLayout\046Plant?,\n\t_folder = nil :: Folder?,\n\t_chunks = {} :: { [string]: Chunk },\n\t_queue = {} :: { Chunk },\n\t_exclusions = nil :: CornLayout\046Exclusions?,\n\t_pivotOffset = CFrame\046identity,\n\t_height = CornLayout\046Height,\n\t_pollElapsed = math\046huge,\n\t_plantCount = 0,\n\t_lastWarning = \"\",\n\t_overviewFolder = nil :: Folder?,\n\t_overviewParts = {} :: { [BasePart]: OverviewItem },\n\t_overviewByChunk = {} :: { [string]: { OverviewItem } },\n\t_overviewDirty = {} :: { [OverviewItem]: boolean },\n\t_overviewFieldFrame = CFrame\046identity,\n\t_overviewFieldSize = Vector3\046zero,\n\t_overviewInvalid = true,\n\t_overviewRuntime = false,\n\t_overviewConnections = {} :: { RBXScriptConnection },\n}\n\nlocal PROJECT_ID = \"children_of_corn\"\nlocal POLL_SEC = 0\0463\nlocal CREATE_BUDGET = 18\nlocal CELL_BUDGET = 100\nlocal TIME_BUDGET_SEC = 0\046003\nlocal MAX_CHUNKS = 100\nlocal MAX_PLANTS = 4032\nlocal LOD_HYSTERESIS = 12\nlocal RETAIN_MARGIN = 18\nlocal ELEVATED_MEDIUM_RADIUS = 144\n\nfunction CornController:_warn(message: string)\n\tif self\046_lastWarning ~= message then\n\t\tself\046_lastWarning = message\n\t\twarn(\"[CornController] \" \046\046 message)\n\tend\nend\n\nlocal function overviewKeys(field: BasePart, part: BasePart): { string }\n\tlocal relative = field\046CFrame:ToObjectSpace(part\046CFrame)\n\tlocal half = part\046Size / 2\n\t-- Require completed fine groups across the entire rotated coarse footprint\046\n\t-- The margin also covers the small deterministic cell stagger\046\n\tlocal padding = CornLayout\046Spacing * 0\04675\n\tlocal halfX = math\046abs(relative\046RightVector\046X) * half\046X\n\t\t+ math\046abs(relative\046UpVector\046X) * half\046Y\n\t\t+ math\046abs(relative\046LookVector\046X) * half\046Z\n\t\t+ padding\n\tlocal halfZ = math\046abs(relative\046RightVector\046Z) * half\046X\n\t\t+ math\046abs(relative\046UpVector\046Z) * half\046Y\n\t\t+ math\046abs(relative\046LookVector\046Z) * half\046Z\n\t\t+ padding\n\tlocal fieldHalf = field\046Size / 2\n\tlocal minX = math\046max(relative\046Position\046X - halfX, -fieldHalf\046X)\n\tlocal maxX = math\046min(relative\046Position\046X + halfX, fieldHalf\046X)\n\tlocal minZ = math\046max(relative\046Position\046Z - halfZ, -fieldHalf\046Z)\n\tlocal maxZ = math\046min(relative\046Position\046Z + halfZ, fieldHalf\046Z)\n\tlocal keys: { string } = {}\n\tif minX > maxX or minZ > maxZ then\n\t\treturn keys\n\tend\n\tlocal width = CornLayout\046Spacing * CornLayout\046ChunkCells\n\tlocal offset = CornLayout\046Spacing / 2\n\tfor column = math\046floor((minX + offset) / width), math\046floor((maxX + offset) / width) do\n\t\tfor row = math\046floor((minZ + offset) / width), math\046floor((maxZ + offset) / width) do\n\t\t\ttable\046insert(keys, column \046\046 \":\" \046\046 row)\n\t\tend\n\tend\n\treturn keys\nend\n\nfunction CornController:_showOverview()\n\tfor _, entry in self\046_overviewParts do\n\t\tif entry\046Hidden then\n\t\t\tif entry\046Part\046Parent then\n\t\t\t\tentry\046Part\046LocalTransparencyModifier = entry\046PreviousModifier\n\t\t\tend\n\t\t\tentry\046Hidden = false\n\t\tend\n\tend\n\tself\046_overviewDirty = {}\nend\n\nfunction CornController:_invalidateOverview()\n\tif self\046_overviewInvalid then\n\t\treturn\n\tend\n\tself\046_overviewInvalid = true\n\t-- A changed footprint or ownership must never keep an old local coverage mask\046\n\tself:_showOverview()\n\tself\046_pollElapsed = POLL_SEC\nend\n\nfunction CornController:_restoreOverview()\n\tfor _, connection in self\046_overviewConnections do\n\t\tconnection:Disconnect()\n\tend\n\ttable\046clear(self\046_overviewConnections)\n\tself\046_overviewInvalid = true\n\tself:_showOverview()\n\tself\046_overviewFolder = nil\n\tself\046_overviewRuntime = false\n\tself\046_overviewParts = {}\n\tself\046_overviewByChunk = {}\nend\n\nfunction CornController:_markOverviewChunk(key: string)\n\tfor _, entry in self\046_overviewByChunk[key] or {} do\n\t\tself\046_overviewDirty[entry] = true\n\tend\nend\n\nlocal function ownedBackdrop(folder: Instance?, map: Model?): boolean\n\treturn folder ~= nil\n\t\tand map ~= nil\n\t\tand folder:IsA(\"Folder\")\n\t\tand folder\046Name == \"CornClientBackdrop\"\n\t\tand folder\046Parent == map\n\t\tand folder:GetAttribute(\"CornClientBackdropOwned\") == true\n\t\tand folder:GetAttribute(\"CornEditorOverview\") == true\n\t\tand folder:GetAttribute(\"corn_project_id\") == PROJECT_ID\nend\n\nfunction CornController:UseBackdropReady(folder: Folder): boolean\n\tlocal map = Workspace:FindFirstChild(\"CornMap\")\n\tif\n\t\tnot map\n\t\tor not map:IsA(\"Model\")\n\t\tor map:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tor not ownedBackdrop(folder, map)\n\tthen\n\t\treturn false\n\tend\n\t-- The backdrop calls this before capturing authored visibility and publishing Ready\046\n\t-- It also calls it before releasing the runtime layer, while ownership is intact\046\n\tself:_restoreOverview()\n\tself\046_pollElapsed = POLL_SEC\n\treturn true\nend\n\nfunction CornController:_bindOverview()\n\tlocal map = self\046_map\n\tlocal field = self\046_field\n\tlocal folder = if map then map:FindFirstChild(\"EditorFieldOverview\") else nil\n\tlocal backdrop = if map then map:FindFirstChild(\"CornClientBackdrop\") else nil\n\tlocal runtime = ownedBackdrop(backdrop, map) and backdrop:GetAttribute(\"Ready\") == true\n\tif runtime then\n\t\tfolder = backdrop\n\tend\n\tif not folder then\n\t\tself:_restoreOverview()\n\t\treturn\n\tend\n\tif\n\t\tnot field\n\t\tor not folder:IsA(\"Folder\")\n\t\tor folder:GetAttribute(\"CornEditorOverview\") ~= true\n\t\tor folder:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\tthen\n\t\tself:_restoreOverview()\n\t\tself:_warn(\"Unrecognized EditorFieldOverview is preserved\")\n\t\treturn\n\tend\n\tif\n\t\tnot self\046_overviewInvalid\n\t\tand self\046_overviewFolder == folder\n\t\tand self\046_overviewFieldFrame == field\046CFrame\n\t\tand self\046_overviewFieldSize == field\046Size\n\tthen\n\t\treturn -- Signals invalidate the index instead of scanning every saved plant every poll\046\n\tend\n\tlocal children = folder:GetChildren()\n\t-- This pass does not yield or change visibility\046 The whole container must be owned\046\n\tfor _, item in children do\n\t\tif\n\t\t\tnot item:IsA(\"BasePart\")\n\t\t\tor item:GetAttribute(\"CornEditorOverview\") ~= true\n\t\t\tor item:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tthen\n\t\t\tself:_restoreOverview()\n\t\t\tself:_warn(\"EditorFieldOverview contains unowned objects; all were preserved\")\n\t\t\treturn\n\t\tend\n\tend\n\tself:_restoreOverview()\n\tself\046_overviewFolder = folder\n\tself\046_overviewRuntime = runtime\n\tself\046_overviewFieldFrame = field\046CFrame\n\tself\046_overviewFieldSize = field\046Size\n\tlocal function invalidate()\n\t\tself:_invalidateOverview()\n\tend\n\tlocal function watch(signal: RBXScriptSignal)\n\t\ttable\046insert(self\046_overviewConnections, signal:Connect(invalidate))\n\tend\n\twatch(folder\046ChildAdded)\n\twatch(folder\046ChildRemoved)\n\twatch(folder\046AncestryChanged)\n\twatch(folder:GetPropertyChangedSignal(\"Name\"))\n\twatch(folder:GetAttributeChangedSignal(\"CornEditorOverview\"))\n\twatch(folder:GetAttributeChangedSignal(\"corn_project_id\"))\n\tif runtime then\n\t\twatch(folder\046DescendantAdded)\n\t\twatch(folder\046DescendantRemoving)\n\t\twatch(folder:GetAttributeChangedSignal(\"CornClientBackdropOwned\"))\n\t\twatch(folder:GetAttributeChangedSignal(\"Ready\"))\n\tend\n\twatch(field:GetPropertyChangedSignal(\"CFrame\"))\n\twatch(field:GetPropertyChangedSignal(\"Size\"))\n\tfor _, item in children do\n\t\tlocal part = item :: BasePart\n\t\tlocal entry: OverviewItem = {\n\t\t\tPart = part,\n\t\t\tPreviousModifier = part\046LocalTransparencyModifier,\n\t\t\tFrame = part\046CFrame,\n\t\t\tSize = part\046Size,\n\t\t\tKeys = overviewKeys(field, part),\n\t\t\tHidden = false,\n\t\t}\n\t\tself\046_overviewParts[part] = entry\n\t\tfor _, key in entry\046Keys do\n\t\t\tlocal items = self\046_overviewByChunk[key]\n\t\t\tif not items then\n\t\t\t\titems = {}\n\t\t\t\tself\046_overviewByChunk[key] = items\n\t\t\tend\n\t\t\ttable\046insert(items, entry)\n\t\tend\n\t\t-- The backdrop owns immutable client-only copies; authored overview stays editable\046\n\t\tif not runtime then\n\t\t\twatch(part:GetPropertyChangedSignal(\"CFrame\"))\n\t\t\twatch(part:GetPropertyChangedSignal(\"Size\"))\n\t\t\twatch(part:GetAttributeChangedSignal(\"CornEditorOverview\"))\n\t\t\twatch(part:GetAttributeChangedSignal(\"corn_project_id\"))\n\t\tend\n\tend\n\tself\046_overviewInvalid = false\n\tfor key, chunk in self\046_chunks do\n\t\tif chunk\046Done then\n\t\t\tself:_markOverviewChunk(key)\n\t\tend\n\tend\nend\n\nfunction CornController:_updateOverview()\n\tlocal folder = self\046_overviewFolder\n\tif not folder or self\046_overviewInvalid then\n\t\treturn\n\tend\n\tif\n\t\tfolder:GetAttribute(\"CornEditorOverview\") ~= true\n\t\tor folder:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tor (\n\t\t\tself\046_overviewRuntime\n\t\t\tand (not ownedBackdrop(folder, self\046_map) or folder:GetAttribute(\"Ready\") ~= true)\n\t\t)\n\tthen\n\t\tself:_restoreOverview()\n\t\treturn\n\tend\n\tfor entry in self\046_overviewDirty do\n\t\tlocal part = entry\046Part\n\t\tif\n\t\t\tpart\046Parent ~= folder\n\t\t\tor part:GetAttribute(\"CornEditorOverview\") ~= true\n\t\t\tor part:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tthen\n\t\t\tself:_restoreOverview()\n\t\t\tself:_warn(\"Overview ownership changed; its visibility was restored\")\n\t\t\treturn\n\t\tend\n\t\tlocal covered = #entry\046Keys > 0\n\t\tfor _, key in entry\046Keys do\n\t\t\tlocal chunk = self\046_chunks[key]\n\t\t\tif not chunk or not chunk\046Done or (self\046_overviewRuntime and chunk\046Lod > 2) then\n\t\t\t\tcovered = false\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tif covered ~= entry\046Hidden then\n\t\t\tpart\046LocalTransparencyModifier = if covered then 1 else entry\046PreviousModifier\n\t\t\tentry\046Hidden = covered\n\t\tend\n\tend\n\tself\046_overviewDirty = {}\nend\n\nfunction CornController:_clearChunks()\n\tself:_showOverview()\n\tfor _, chunk in self\046_chunks do\n\t\tchunk\046Alive = false\n\t\tchunk\046Folder:Destroy()\n\tend\n\tself\046_chunks = {}\n\tself\046_queue = {}\n\tself\046_plantCount = 0\n\tif self\046_folder then\n\t\tself\046_folder:SetAttribute(\"LoadedPlants\", 0)\n\tend\nend\n\nfunction CornController:_clearInputs()\n\tself:_clearChunks()\n\tself:_restoreOverview()\n\tif self\046_folder then\n\t\tself\046_folder:Destroy()\n\tend\n\tself\046_folder = nil\n\tself\046_map = nil\n\tself\046_field = nil\n\tself\046_template = nil\n\tself\046_exclusions = nil\n\tself\046_elevatedUntil = nil\nend\n\nfunction CornController:_resolveInputs(): boolean\n\tlocal map = Workspace:FindFirstChild(\"CornMap\")\n\tlocal field = if map then map:FindFirstChild(\"FieldZone\") else nil\n\tlocal art = ReplicatedStorage:FindFirstChild(\"CornRuntimeArt\")\n\tlocal template = if art then art:FindFirstChild(\"CornPlantTemplate\") else nil\n\tif not map or not map:IsA(\"Model\") or map:GetAttribute(\"corn_project_id\") ~= PROJECT_ID then\n\t\tself:_clearInputs()\n\t\tself:_warn(\"The owned CornMap is not available; editor preview is preserved\")\n\t\treturn false\n\tend\n\tif\n\t\tnot field\n\t\tor not field:IsA(\"BasePart\")\n\t\tor field\046CFrame\046UpVector:Dot(Vector3\046yAxis) < 0\0469999\n\tthen\n\t\tself:_clearInputs()\n\t\tself:_warn(\"CornMap needs a horizontal FieldZone; editor preview is preserved\")\n\t\treturn false\n\tend\n\tif\n\t\tnot art\n\t\tor not art:IsA(\"Folder\")\n\t\tor art:GetAttribute(\"CornRuntimeArtOwned\") ~= true\n\t\tor art:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tor not template\n\t\tor (not template:IsA(\"Model\") and not template:IsA(\"BasePart\"))\n\t\tor template:GetAttribute(\"CornPlantTemplateOwned\") ~= true\n\tthen\n\t\tself:_clearInputs()\n\t\tself:_warn(\"Prepared corn art is not available; check CornField Output\")\n\t\treturn false\n\tend\n\tif\n\t\tself\046_map == map\n\t\tand self\046_field == field\n\t\tand self\046_template == template\n\t\tand self\046_folder\n\tthen\n\t\treturn true\n\tend\n\tself:_clearInputs()\n\tlocal existing = map:FindFirstChild(\"CornClientPlants\")\n\tif existing then\n\t\tif\n\t\t\tnot existing:IsA(\"Folder\")\n\t\t\tor existing:GetAttribute(\"CornClientRendererOwned\") ~= true\n\t\t\tor existing:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tthen\n\t\t\tself:_warn(\"Refused to replace unowned CornMap/CornClientPlants\")\n\t\t\treturn false\n\t\tend\n\t\texisting:Destroy()\n\tend\n\tlocal bounds, size = CornLayout\046Bounds(template)\n\tself\046_pivotOffset = template:GetPivot():ToObjectSpace(bounds):Inverse()\n\tself\046_height = size\046Y\n\tself\046_map = map\n\tself\046_field = field\n\tself\046_template = template\n\tlocal folder = Instance\046new(\"Folder\")\n\tfolder\046Name = \"CornClientPlants\"\n\tfolder:SetAttribute(\"CornClientRendererOwned\", true)\n\tfolder:SetAttribute(\"corn_project_id\", PROJECT_ID)\n\tfolder:SetAttribute(\"LoadedPlants\", 0)\n\tfolder\046Parent = map\n\tself\046_folder = folder\n\t-- This client-only deletion never changes the author's saved scene or Props\046\n\tlocal preview = map:FindFirstChild(\"EditorPreview\")\n\tif\n\t\tpreview\n\t\tand preview:IsA(\"Folder\")\n\t\tand preview:GetAttribute(\"CornEditorPreview\") == true\n\t\tand preview:GetAttribute(\"corn_project_id\") == PROJECT_ID\n\tthen\n\t\tpreview:Destroy()\n\tend\n\tself\046_lastWarning = \"\"\n\treturn true\nend\n\nfunction CornController:_lodForDistance(\n\tdistance: number,\n\tprevious: number?,\n\tmediumRadius: number\n): number\n\tlocal dense = CornLayout\046DenseRadius\n\tif previous == 1 then\n\t\tif distance <= (dense + LOD_HYSTERESIS) ^ 2 then\n\t\t\treturn 1\n\t\tend\n\t\treturn if distance <= (mediumRadius + LOD_HYSTERESIS) ^ 2 then 2 else 3\n\telseif previous == 2 then\n\t\tif distance <= (dense - LOD_HYSTERESIS) ^ 2 then\n\t\t\treturn 1\n\t\tend\n\t\treturn if distance <= (mediumRadius + LOD_HYSTERESIS) ^ 2 then 2 else 3\n\telseif previous == 3 then\n\t\tif distance <= (dense - LOD_HYSTERESIS) ^ 2 then\n\t\t\treturn 1\n\t\tend\n\t\treturn if distance <= (mediumRadius - LOD_HYSTERESIS) ^ 2 then 2 else 3\n\tend\n\treturn if distance <= dense ^ 2 then 1 elseif distance <= mediumRadius ^ 2 then 2 else 3\nend\n\nfunction CornController:_elevatedView(root: BasePart, now: number): boolean\n\tlocal field = self\046_field :: BasePart\n\tlocal rootHeight = field\046CFrame:PointToObjectSpace(root\046Position)\046Y + field\046Size\046Y / 2\n\tlocal camera = Workspace\046CurrentCamera\n\tlocal cameraHeight = if camera\n\t\tthen field\046CFrame:PointToObjectSpace(camera\046CFrame\046Position)\046Y + field\046Size\046Y / 2\n\t\telse 0\n\tif math\046max(rootHeight, cameraHeight) > 6 then\n\t\tself\046_elevatedUntil = now + 2\n\tend\n\treturn now < (self\046_elevatedUntil or 0)\nend\n\nfunction CornController:_reconcile(root: BasePart)\n\tif not self:_resolveInputs() then\n\t\treturn\n\tend\n\tlocal map = self\046_map :: Model\n\tlocal field = self\046_field :: BasePart\n\tlocal folder = self\046_folder :: Folder\n\tself:_bindOverview()\n\tlocal exclusions = CornLayout\046ReadExclusions(map, field)\n\tif self\046_exclusions and self\046_exclusions\046Signature ~= exclusions\046Signature then\n\t\tself:_clearChunks()\n\tend\n\tself\046_exclusions = exclusions\n\tlocal minColumn, maxColumn, minRow, maxRow = CornLayout\046GetCellBounds(field)\n\tlocal localRoot = field\046CFrame:PointToObjectSpace(root\046Position)\n\tlocal width = CornLayout\046Spacing * CornLayout\046ChunkCells\n\tlocal elevated = self:_elevatedView(root, os\046clock())\n\tlocal radius = if elevated then CornLayout\046ElevatedRadius else CornLayout\046RenderRadius\n\tlocal mediumRadius = if elevated then ELEVATED_MEDIUM_RADIUS else CornLayout\046MediumRadius\n\tlocal retainRadius = radius + RETAIN_MARGIN\n\tlocal backdrop = self\046_overviewFolder\n\tlocal backdropStride = if self\046_overviewRuntime and backdrop\n\t\tthen backdrop:GetAttribute(\"DetailStride\")\n\t\telse nil\n\tlocal backdropCoversSparse = typeof(backdropStride) == \"number\"\n\t\tand backdropStride <= CornLayout\046Spacing * 2\n\tfolder:SetAttribute(\"ViewRadius\", radius)\n\tfolder:SetAttribute(\"ElevatedDetail\", elevated)\n\tlocal desired: { any } = {}\n\tfor chunkColumn = math\046floor((localRoot\046X - retainRadius) / width), math\046floor((localRoot\046X + retainRadius) / width) do\n\t\tfor chunkRow = math\046floor((localRoot\046Z - retainRadius) / width), math\046floor((localRoot\046Z + retainRadius) / width) do\n\t\t\tlocal firstColumn = math\046max(minColumn, chunkColumn * CornLayout\046ChunkCells)\n\t\t\tlocal lastColumn = math\046min(maxColumn, (chunkColumn + 1) * CornLayout\046ChunkCells - 1)\n\t\t\tlocal firstRow = math\046max(minRow, chunkRow * CornLayout\046ChunkCells)\n\t\t\tlocal lastRow = math\046min(maxRow, (chunkRow + 1) * CornLayout\046ChunkCells - 1)\n\t\t\tif firstColumn > lastColumn or firstRow > lastRow then\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tlocal centerX = (firstColumn + lastColumn) * CornLayout\046Spacing / 2\n\t\t\tlocal centerZ = (firstRow + lastRow) * CornLayout\046Spacing / 2\n\t\t\tlocal distance = (centerX - localRoot\046X) ^ 2 + (centerZ - localRoot\046Z) ^ 2\n\t\t\tlocal key = chunkColumn \046\046 \":\" \046\046 chunkRow\n\t\t\tlocal previous = self\046_chunks[key]\n\t\t\tif\n\t\t\t\tdistance <= radius * radius\n\t\t\t\tor (previous and distance <= retainRadius * retainRadius)\n\t\t\tthen\n\t\t\t\tlocal lod = self:_lodForDistance(\n\t\t\t\t\tdistance,\n\t\t\t\t\tif previous then previous\046Lod else nil,\n\t\t\t\t\tmediumRadius\n\t\t\t\t)\n\t\t\t\tif backdropCoversSparse and lod == 3 then\n\t\t\t\t\tcontinue -- Whole-field stride6 is already denser than sparse stride9\046\n\t\t\t\tend\n\t\t\t\ttable\046insert(desired, {\n\t\t\t\t\tKey = key,\n\t\t\t\t\tLod = lod,\n\t\t\t\t\tMinColumn = firstColumn,\n\t\t\t\t\tMaxColumn = lastColumn,\n\t\t\t\t\tMinRow = firstRow,\n\t\t\t\t\tMaxRow = lastRow,\n\t\t\t\t\tDistance = distance,\n\t\t\t\t})\n\t\t\tend\n\t\tend\n\tend\n\ttable\046sort(desired, function(a, b)\n\t\treturn if a\046Distance == b\046Distance then a\046Key < b\046Key else a\046Distance < b\046Distance\n\tend)\n\tlocal wanted: { [string]: boolean } = {}\n\tfor index, candidate in desired do\n\t\tif index > MAX_CHUNKS then\n\t\t\tbreak\n\t\tend\n\t\twanted[candidate\046Key] = true\n\t\tlocal chunk = self\046_chunks[candidate\046Key]\n\t\tif chunk and chunk\046Lod ~= candidate\046Lod then\n\t\t\tself:_markOverviewChunk(chunk\046Key)\n\t\t\tchunk\046Alive = false\n\t\t\tself\046_plantCount -= chunk\046Count\n\t\t\tchunk\046Folder:Destroy()\n\t\t\tself\046_chunks[candidate\046Key] = nil\n\t\t\tchunk = nil\n\t\tend\n\t\tif chunk then\n\t\t\tchunk\046Distance = candidate\046Distance\n\t\telse\n\t\t\tlocal chunkFolder = Instance\046new(\"Folder\")\n\t\t\tchunkFolder\046Name = \"Chunk_\" \046\046 candidate\046Key\n\t\t\tchunkFolder:SetAttribute(\"DetailStride\", candidate\046Lod * CornLayout\046Spacing)\n\t\t\tchunkFolder\046Parent = folder\n\t\t\tchunk = {\n\t\t\t\tKey = candidate\046Key,\n\t\t\t\tLod = candidate\046Lod,\n\t\t\t\tFolder = chunkFolder,\n\t\t\t\tMinColumn = candidate\046MinColumn,\n\t\t\t\tMaxColumn = candidate\046MaxColumn,\n\t\t\t\tMinRow = candidate\046MinRow,\n\t\t\t\tMaxRow = candidate\046MaxRow,\n\t\t\t\tColumn = candidate\046MinColumn,\n\t\t\t\tRow = candidate\046MinRow,\n\t\t\t\tDistance = candidate\046Distance,\n\t\t\t\tCount = 0,\n\t\t\t\tAlive = true,\n\t\t\t\tDone = false,\n\t\t\t}\n\t\t\tself\046_chunks[candidate\046Key] = chunk\n\t\tend\n\tend\n\tfor key, chunk in self\046_chunks do\n\t\tif not wanted[key] then\n\t\t\tself:_markOverviewChunk(key)\n\t\t\tchunk\046Alive = false\n\t\t\tself\046_plantCount -= chunk\046Count\n\t\t\tchunk\046Folder:Destroy()\n\t\t\tself\046_chunks[key] = nil\n\t\tend\n\tend\n\tself\046_queue = {}\n\tfor _, chunk in self\046_chunks do\n\t\tif not chunk\046Done then\n\t\t\ttable\046insert(self\046_queue, chunk)\n\t\tend\n\tend\n\ttable\046sort(self\046_queue, function(a, b)\n\t\treturn if a\046Distance == b\046Distance then a\046Key < b\046Key else a\046Distance < b\046Distance\n\tend)\n\tself:_updateOverview()\nend\n\nfunction CornController:_createBatch()\n\tlocal template = self\046_template\n\tlocal field = self\046_field\n\tlocal exclusions = self\046_exclusions\n\tif not template or not field or not exclusions then\n\t\treturn\n\tend\n\tlocal began = os\046clock()\n\tlocal _, fieldYaw = field\046CFrame:ToOrientation()\n\tlocal examined = 0\n\tlocal created = 0\n\twhile\n\t\t#self\046_queue > 0\n\t\tand examined < CELL_BUDGET\n\t\tand created < CREATE_BUDGET\n\t\tand self\046_plantCount < MAX_PLANTS\n\t\tand os\046clock() - began < TIME_BUDGET_SEC\n\tdo\n\t\tlocal chunk = self\046_queue[1]\n\t\tif not chunk\046Alive or chunk\046Done then\n\t\t\ttable\046remove(self\046_queue, 1)\n\t\t\tcontinue\n\t\tend\n\t\tlocal column = chunk\046Column\n\t\tlocal row = chunk\046Row\n\t\tchunk\046Column += 1\n\t\tif chunk\046Column > chunk\046MaxColumn then\n\t\t\tchunk\046Column = chunk\046MinColumn\n\t\t\tchunk\046Row += 1\n\t\tend\n\t\tif chunk\046Row > chunk\046MaxRow then\n\t\t\tchunk\046Done = true\n\t\t\tself:_markOverviewChunk(chunk\046Key)\n\t\t\ttable\046remove(self\046_queue, 1)\n\t\tend\n\t\texamined += 1\n\t\tif column % chunk\046Lod ~= 0 or row % chunk\046Lod ~= 0 then\n\t\t\tcontinue\n\t\tend\n\t\tlocal position = CornLayout\046CellPosition(field, column, row)\n\t\tif CornLayout\046IsExcluded(position, exclusions) then\n\t\t\tcontinue\n\t\tend\n\t\tlocal clone = template:Clone()\n\t\tif not clone then\n\t\t\tself:_warn(\"Prepared corn template is not Archivable\")\n\t\t\tself:Destroy()\n\t\t\treturn\n\t\tend\n\t\tlocal plant = clone :: CornLayout\046Plant\n\t\tplant\046Name = \"Corn\"\n\t\tif chunk\046Lod == 3 then\n\t\t\tlocal items = plant:GetDescendants()\n\t\t\ttable\046insert(items, plant)\n\t\t\tfor _, item in items do\n\t\t\t\tif item:IsA(\"MeshPart\") then\n\t\t\t\t\titem\046CastShadow = false\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tCornLayout\046ApplyVariation(plant, column, row)\n\t\tplant:PivotTo(\n\t\t\tCornLayout\046PivotForPlant(plant, position, CornLayout\046CellYaw(column, row) + fieldYaw)\n\t\t)\n\t\tplant\046Parent = chunk\046Folder\n\t\tchunk\046Count += 1\n\t\tself\046_plantCount += 1\n\t\tcreated += 1\n\tend\n\tif self\046_folder then\n\t\tself\046_folder:SetAttribute(\"LoadedPlants\", self\046_plantCount)\n\tend\n\tself:_updateOverview()\nend\n\nfunction CornController:_step(delta: number)\n\tself\046_pollElapsed += delta\n\tif self\046_pollElapsed >= POLL_SEC then\n\t\tself\046_pollElapsed = 0\n\t\tlocal character = Players\046LocalPlayer\046Character\n\t\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\t\tif root and root:IsA(\"BasePart\") then\n\t\t\tself:_reconcile(root)\n\t\t\tlocal torches = self\046_map and self\046_map:FindFirstChild(\"TorchMarkers\")\n\t\t\tif torches then\n\t\t\t\tfor _, torch in torches:GetChildren() do\n\t\t\t\t\tif torch:IsA(\"Model\") and torch:GetAttribute(\"CornTorchOwned\") == true then\n\t\t\t\t\t\tlocal distance = (torch:GetPivot()\046Position - root\046Position)\046Magnitude\n\t\t\t\t\t\tfor _, effect in torch:GetDescendants() do\n\t\t\t\t\t\t\tif effect:IsA(\"Fire\") then\n\t\t\t\t\t\t\t\teffect\046Enabled = self\046_torchesEnabled ~= false and distance < 220\n\t\t\t\t\t\t\telseif effect:IsA(\"PointLight\") then\n\t\t\t\t\t\t\t\teffect\046Enabled = self\046_torchesEnabled ~= false and distance < 90\n\t\t\t\t\t\t\telseif effect:IsA(\"BasePart\") and effect\046Name == \"Flame\" then\n\t\t\t\t\t\t\t\teffect\046LocalTransparencyModifier = if self\046_torchesEnabled\n\t\t\t\t\t\t\t\t\t\t== false\n\t\t\t\t\t\t\t\t\tthen 1\n\t\t\t\t\t\t\t\t\telse math\046clamp((distance - 240) / 80, 0, 1)\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\telse\n\t\t\tself:_clearChunks()\n\t\tend\n\tend\n\tself:_createBatch()\nend\n\nfunction CornController:SetLightingMode(mode: string?)\n\tlocal enabled = mode ~= \"easy\"\n\tif self\046_torchesEnabled ~= enabled then\n\t\tself\046_torchesEnabled = enabled\n\t\tself\046_pollElapsed = POLL_SEC\n\tend\nend\n\nfunction CornController:Init(context: any)\n\tself\046_torchesEnabled = true\n\tself\046_enabled = RunService:IsStudio()\n\t\tand context\046Config\046Environment == \"DEV\"\n\t\tand context\046Config\046Game\046SessionMode == \"solo_local\"\nend\n\nfunction CornController:Start()\n\tif not self\046_enabled or self\046_connection then\n\t\treturn\n\tend\n\tself\046_connection = RunService\046Heartbeat:Connect(function(delta: number)\n\t\tself:_step(delta)\n\tend)\nend\n\nfunction CornController:Destroy()\n\tself\046_enabled = false\n\tif self\046_connection then\n\t\tself\046_connection:Disconnect()\n\t\tself\046_connection = nil\n\tend\n\tself:_clearInputs()\nend\n\nreturn CornController\n"},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CornWindController",class="ModuleScript",hash="458d95a423b38f6abaa37b33bb138cef883d81b913e156a530a583e8d4aa6726",history={"6476f7cf8dfee6c40f4235740b4f3d239034041377dd8fb28cd4698398f917fd","b61d201febf3c2839d1af054e370e52b22190d226b73ab20a53b729344d85187"},source="--!strict\nlocal RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal CornWindController = { Name = \"CornWindController\", Order = 55 }\nlocal PROJECT_ID = \"children_of_corn\"\nlocal BUCKET_SIZE = 6\nlocal RADIUS = 5\nlocal MONSTER_VIEW_RADIUS = 70\nlocal UPDATE_SEC = 1 / 12\nlocal SELECT_SEC = 0\0462\nlocal RESOLVE_SEC = 0\0465\nlocal INDEX_BUDGET = 64\nlocal INDEX_SECONDS = 0\046001\nlocal ACTOR_LIMIT = 2\nlocal SCAN_LIMIT = 128\nlocal PART_LIMIT = 32\nlocal TRAIL_SEC = 0\0463\nlocal MAX_PARTS_PER_PLANT = 8\nlocal ANGLE = math\046rad(3)\n\nlocal function disconnect(connections: { RBXScriptConnection })\n\tfor _, connection in connections do\n\t\tconnection:Disconnect()\n\tend\n\ttable\046clear(connections)\nend\n\nlocal function decorative(part: BasePart): boolean\n\treturn part\046Anchored and not part\046CanCollide and not part\046CanTouch and not part\046CanQuery\nend\n\nlocal function bucketKey(x: number, z: number): string\n\treturn tostring(x) \046\046 \":\" \046\046 tostring(z)\nend\n\nfunction CornWindController:_ownedLayer(folder: Instance, kind: string): boolean\n\treturn folder:IsA(\"Folder\")\n\t\tand folder\046Parent == self\046_map\n\t\tand folder:GetAttribute(\"corn_project_id\") == PROJECT_ID\n\t\tand (\n\t\t\tif kind == \"near\"\n\t\t\t\tthen folder\046Name == \"CornClientPlants\" and folder:GetAttribute(\n\t\t\t\t\t\"CornClientRendererOwned\"\n\t\t\t\t) == true\n\t\t\t\telse folder\046Name == \"CornClientBackdrop\" and folder:GetAttribute(\n\t\t\t\t\t\"CornClientBackdropOwned\"\n\t\t\t\t) == true and folder:GetAttribute(\"CornEditorOverview\") == true\n\t\t)\nend\n\nfunction CornWindController:_validEntry(entry: any): boolean\n\tlocal layer = entry\046Layer\n\tif\n\t\tself\046_layers[layer\046Kind] ~= layer\n\t\tor not self:_ownedLayer(layer\046Folder, layer\046Kind)\n\t\tor entry\046Plant\046Parent ~= entry\046Parent\n\tthen\n\t\treturn false\n\tend\n\tif layer\046Kind == \"near\" then\n\t\tif\n\t\t\tentry\046Parent\046Parent ~= layer\046Folder\n\t\t\tor entry\046Plant\046Name ~= \"Corn\"\n\t\t\tor entry\046Plant:GetAttribute(\"CornPlantTemplateOwned\") ~= true\n\t\tthen\n\t\t\treturn false\n\t\tend\n\telseif\n\t\tentry\046Plant:GetAttribute(\"CornClientBackdropOwned\") ~= true\n\t\tor entry\046Plant:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\tthen\n\t\treturn false\n\tend\n\tfor _, saved in entry\046Parts do\n\t\tif not decorative(saved\046Part) then\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\nfunction CornWindController:_restore(entry: any)\n\tif not entry\046Moved then\n\t\treturn\n\tend\n\t-- Removed copies can still be unparented Instances\046 Restore their exact frames\n\t-- before forgetting them; destroyed copies need no recovery\046\n\tfor _, saved in entry\046Parts do\n\t\tpcall(function()\n\t\t\tsaved\046Part\046CFrame = saved\046Frame\n\t\tend)\n\tend\n\tentry\046Moved = false\nend\n\nfunction CornWindController:_restoreActive()\n\tfor entry in self\046_active do\n\t\tself:_restore(entry)\n\tend\n\tself\046_active = {}\n\tself\046_selected = {}\nend\n\nfunction CornWindController:_remove(layer: any, plant: Instance)\n\tlocal entry = layer\046Entries[plant]\n\tif not entry then\n\t\treturn\n\tend\n\tself:_restore(entry)\n\tself\046_active[entry] = nil\n\tlayer\046Entries[plant] = nil\n\tlayer\046Count -= 1\n\tlocal bucket = layer\046Buckets[entry\046Bucket]\n\tif bucket then\n\t\tbucket[entry] = nil\n\t\tif next(bucket) == nil then\n\t\t\tlayer\046Buckets[entry\046Bucket] = nil\n\t\tend\n\tend\n\tlocal group = layer\046Groups[entry\046Parent]\n\tif group then\n\t\tgroup\046Entries[plant] = nil\n\tend\n\tself\046_selectElapsed = SELECT_SEC\nend\n\nfunction CornWindController:_enqueue(layer: any, plant: Instance, parent: Instance)\n\tself\046_pendingTail += 1\n\tself\046_pending[self\046_pendingTail] = { Layer = layer, Plant = plant, Parent = parent }\nend\n\nfunction CornWindController:_register(job: any)\n\tlocal layer, plant, parent = job\046Layer, job\046Plant, job\046Parent\n\tif\n\t\tself\046_layers[layer\046Kind] ~= layer\n\t\tor layer\046Entries[plant]\n\t\tor not self:_ownedLayer(layer\046Folder, layer\046Kind)\n\t\tor plant\046Parent ~= parent\n\tthen\n\t\treturn\n\tend\n\tif layer\046Kind == \"near\" then\n\t\tif\n\t\t\tnot layer\046Groups[parent]\n\t\t\tor plant\046Name ~= \"Corn\"\n\t\t\tor plant:GetAttribute(\"CornPlantTemplateOwned\") ~= true\n\t\tthen\n\t\t\treturn\n\t\tend\n\telseif\n\t\tnot plant\046Name:match(\"^Far_%-?%d+_%-?%d+$\")\n\t\tor plant:GetAttribute(\"CornClientBackdropOwned\") ~= true\n\t\tor plant:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\tthen\n\t\treturn\n\tend\n\tif layer\046Count >= (if layer\046Kind == \"near\" then 4096 else 20000) then\n\t\treturn\n\tend\n\tlocal parts, frame, size = {}, nil, nil\n\tif plant:IsA(\"BasePart\") then\n\t\tif not decorative(plant) then\n\t\t\treturn\n\t\tend\n\t\ttable\046insert(parts, { Part = plant, Frame = plant\046CFrame })\n\t\tframe, size = plant\046CFrame, plant\046Size\n\telseif plant:IsA(\"Model\") then\n\t\tfor _, part in plant:GetDescendants() do\n\t\t\tif part:IsA(\"BasePart\") then\n\t\t\t\tif not decorative(part) or #parts >= MAX_PARTS_PER_PLANT then\n\t\t\t\t\treturn\n\t\t\t\tend\n\t\t\t\ttable\046insert(parts, { Part = part, Frame = part\046CFrame })\n\t\t\tend\n\t\tend\n\t\tif #parts == 0 then\n\t\t\treturn\n\t\tend\n\t\tframe, size = plant:GetBoundingBox()\n\telse\n\t\treturn\n\tend\n\tlocal position = frame\046Position\n\tlocal key =\n\t\tbucketKey(math\046floor(position\046X / BUCKET_SIZE), math\046floor(position\046Z / BUCKET_SIZE))\n\tlocal entry = {\n\t\tLayer = layer,\n\t\tPlant = plant,\n\t\tParent = parent,\n\t\tParts = parts,\n\t\tPosition = position,\n\t\tBase = position - Vector3\046new(0, size\046Y / 2, 0),\n\t\tBucket = key,\n\t\tPhase = (position\046X * 0\04617 + position\046Z * 0\04611) % (math\046pi * 2),\n\t\tMoved = false,\n\t}\n\tlayer\046Entries[plant] = entry\n\tlayer\046Count += 1\n\tif not layer\046Buckets[key] then\n\t\tlayer\046Buckets[key] = {}\n\tend\n\tlayer\046Buckets[key][entry] = true\n\tif layer\046Kind == \"near\" then\n\t\tlayer\046Groups[parent]\046Entries[plant] = true\n\tend\n\tself\046_selectElapsed = SELECT_SEC\nend\n\nfunction CornWindController:_indexBatch()\n\tlocal began, count = self\046_clock(), 0\n\twhile\n\t\tself\046_pendingHead <= self\046_pendingTail\n\t\tand count < INDEX_BUDGET\n\t\tand self\046_clock() - began < INDEX_SECONDS\n\tdo\n\t\tlocal job = self\046_pending[self\046_pendingHead]\n\t\tself\046_pending[self\046_pendingHead] = nil\n\t\tself\046_pendingHead += 1\n\t\tself:_register(job)\n\t\tcount += 1\n\tend\n\tif self\046_pendingHead > self\046_pendingTail then\n\t\tself\046_pending, self\046_pendingHead, self\046_pendingTail = {}, 1, 0\n\tend\nend\n\nfunction CornWindController:_removeGroup(layer: any, folder: Instance)\n\tlocal group = layer\046Groups[folder]\n\tif not group then\n\t\treturn\n\tend\n\tdisconnect(group\046Connections)\n\tfor plant in group\046Entries do\n\t\tself:_remove(layer, plant)\n\tend\n\tlayer\046Groups[folder] = nil\nend\n\nfunction CornWindController:_bindGroup(layer: any, folder: Instance)\n\tif\n\t\tlayer\046Groups[folder]\n\t\tor not folder:IsA(\"Folder\")\n\t\tor folder\046Parent ~= layer\046Folder\n\t\tor not folder\046Name:match(\"^Chunk_\")\n\tthen\n\t\treturn\n\tend\n\tlocal group = { Connections = {}, Entries = {} }\n\tlayer\046Groups[folder] = group\n\ttable\046insert(\n\t\tgroup\046Connections,\n\t\tfolder\046ChildAdded:Connect(function(plant)\n\t\t\tself:_enqueue(layer, plant, folder)\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tgroup\046Connections,\n\t\tfolder\046ChildRemoved:Connect(function(plant)\n\t\t\tself:_remove(layer, plant)\n\t\tend)\n\t)\n\tfor _, plant in folder:GetChildren() do\n\t\tself:_enqueue(layer, plant, folder)\n\tend\nend\n\nfunction CornWindController:_detachLayer(kind: string)\n\tlocal layer = self\046_layers[kind]\n\tif not layer then\n\t\treturn\n\tend\n\tfor _, group in layer\046Groups do\n\t\tdisconnect(group\046Connections)\n\tend\n\tdisconnect(layer\046Connections)\n\tfor _, entry in layer\046Entries do\n\t\tself:_restore(entry)\n\t\tself\046_active[entry] = nil\n\tend\n\tself\046_layers[kind] = nil\n\tself\046_selectElapsed = SELECT_SEC\nend\n\nfunction CornWindController:_bindLayer(folder: Instance?, kind: string)\n\tlocal previous = self\046_layers[kind]\n\tif previous and previous\046Folder == folder and self:_ownedLayer(previous\046Folder, kind) then\n\t\treturn\n\tend\n\tself:_detachLayer(kind)\n\tif not folder or not self:_ownedLayer(folder, kind) then\n\t\treturn\n\tend\n\tlocal layer = {\n\t\tKind = kind,\n\t\tFolder = folder,\n\t\tConnections = {},\n\t\tEntries = {},\n\t\tBuckets = {},\n\t\tGroups = {},\n\t\tCount = 0,\n\t}\n\tself\046_layers[kind] = layer\n\ttable\046insert(\n\t\tlayer\046Connections,\n\t\tfolder\046ChildAdded:Connect(function(plant)\n\t\t\tif kind == \"near\" then\n\t\t\t\tself:_bindGroup(layer, plant)\n\t\t\telse\n\t\t\t\tself:_enqueue(layer, plant, folder)\n\t\t\tend\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tlayer\046Connections,\n\t\tfolder\046ChildRemoved:Connect(function(plant)\n\t\t\tif kind == \"near\" then\n\t\t\t\tself:_removeGroup(layer, plant)\n\t\t\telse\n\t\t\t\tself:_remove(layer, plant)\n\t\t\tend\n\t\tend)\n\t)\n\tfor _, attribute in\n\t\t{\n\t\t\t\"corn_project_id\",\n\t\t\tif kind == \"near\" then \"CornClientRendererOwned\" else \"CornClientBackdropOwned\",\n\t\t\t\"Ready\",\n\t\t}\n\tdo\n\t\ttable\046insert(\n\t\t\tlayer\046Connections,\n\t\t\tfolder:GetAttributeChangedSignal(attribute):Connect(function()\n\t\t\t\tif not self:_ownedLayer(folder, kind) then\n\t\t\t\t\tself:_detachLayer(kind)\n\t\t\t\telseif kind == \"far\" and folder:GetAttribute(\"Ready\") ~= true then\n\t\t\t\t\tfolder:SetAttribute(\"CornWindAnimated\", 0)\n\t\t\t\t\tfor entry in self\046_active do\n\t\t\t\t\t\tif entry\046Layer == layer then\n\t\t\t\t\t\t\tself:_restore(entry)\n\t\t\t\t\t\t\tself\046_active[entry] = nil\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tself\046_selectElapsed = SELECT_SEC\n\t\t\tend)\n\t\t)\n\tend\n\tfor _, plant in folder:GetChildren() do\n\t\tif kind == \"near\" then\n\t\t\tself:_bindGroup(layer, plant)\n\t\telse\n\t\t\tself:_enqueue(layer, plant, folder)\n\t\tend\n\tend\nend\n\nfunction CornWindController:_clearMap()\n\tself\046_monsterSamples = {}\n\tself:_detachLayer(\"near\")\n\tself:_detachLayer(\"far\")\n\tdisconnect(self\046_mapConnections)\n\tself\046_map = nil\n\tself\046_pending, self\046_pendingHead, self\046_pendingTail = {}, 1, 0\n\tself:_restoreActive()\nend\n\nfunction CornWindController:_resolveMap()\n\tlocal map = Workspace:FindFirstChild(\"CornMap\")\n\tif\n\t\tnot map\n\t\tor not map:IsA(\"Model\")\n\t\tor map:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tor Workspace:FindFirstChild(\"Asmr_Base\")\n\t\tor Workspace:FindFirstChild(\"ASMR_Models\")\n\tthen\n\t\tself:_clearMap()\n\t\treturn\n\tend\n\tif map ~= self\046_map then\n\t\tself:_clearMap()\n\t\tself\046_map = map\n\t\ttable\046insert(\n\t\t\tself\046_mapConnections,\n\t\t\tmap\046AncestryChanged:Connect(function()\n\t\t\t\tif self\046_map == map and map\046Parent ~= Workspace then\n\t\t\t\t\tself:_clearMap()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\t\ttable\046insert(\n\t\t\tself\046_mapConnections,\n\t\t\tmap:GetAttributeChangedSignal(\"corn_project_id\"):Connect(function()\n\t\t\t\tif self\046_map == map and map:GetAttribute(\"corn_project_id\") ~= PROJECT_ID then\n\t\t\t\t\tself:_clearMap()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\t\ttable\046insert(\n\t\t\tself\046_mapConnections,\n\t\t\tmap\046ChildAdded:Connect(function(item)\n\t\t\t\tif item\046Name == \"CornClientPlants\" then\n\t\t\t\t\tself:_bindLayer(item, \"near\")\n\t\t\t\telseif item\046Name == \"CornClientBackdrop\" then\n\t\t\t\t\tself:_bindLayer(item, \"far\")\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\t\ttable\046insert(\n\t\t\tself\046_mapConnections,\n\t\t\tmap\046ChildRemoved:Connect(function(item)\n\t\t\t\tfor kind, layer in self\046_layers do\n\t\t\t\t\tif layer\046Folder == item then\n\t\t\t\t\t\tself:_detachLayer(kind)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\tend\n\tself:_bindLayer(map:FindFirstChild(\"CornClientPlants\"), \"near\")\n\tself:_bindLayer(map:FindFirstChild(\"CornClientBackdrop\"), \"far\")\nend\n\nlocal function horizontalDistanceSquared(a: Vector3, b: Vector3): number\n\tlocal delta = a - b\n\treturn delta\046X * delta\046X + delta\046Z * delta\046Z\nend\n\nlocal function visible(entry: any, camera: Camera): boolean\n\tif\n\t\thorizontalDistanceSquared(entry\046Position, camera\046CFrame\046Position)\n\t\t> MONSTER_VIEW_RADIUS ^ 2\n\tthen\n\t\treturn false\n\tend\n\tlocal shown = false\n\tfor _, saved in entry\046Parts do\n\t\tif saved\046Part\046Transparency < 0\04699 and saved\046Part\046LocalTransparencyModifier < 0\04699 then\n\t\t\tshown = true\n\t\t\tbreak\n\t\tend\n\tend\n\tif not shown then\n\t\treturn false\n\tend\n\tlocal screen, onScreen = camera:WorldToViewportPoint(entry\046Position)\n\treturn onScreen and screen\046Z > 0\nend\n\nfunction CornWindController:_actorCandidates(\n\tcamera: Camera,\n\tposition: Vector3,\n\tfront: Vector3?,\n\tactive: any\n): { any }\n\tlocal result, scanned = {}, 0\n\tfor _, kind in { \"near\", \"far\" } do\n\t\tlocal layer = self\046_layers[kind]\n\t\tif\n\t\t\tnot layer\n\t\t\tor not self:_ownedLayer(layer\046Folder, kind)\n\t\t\tor (kind == \"far\" and layer\046Folder:GetAttribute(\"Ready\") ~= true)\n\t\tthen\n\t\t\tcontinue\n\t\tend\n\t\tfor x = math\046floor((position\046X - RADIUS) / BUCKET_SIZE), math\046floor((position\046X + RADIUS) / BUCKET_SIZE) do\n\t\t\tfor z = math\046floor((position\046Z - RADIUS) / BUCKET_SIZE), math\046floor((position\046Z + RADIUS) / BUCKET_SIZE) do\n\t\t\t\tfor entry in layer\046Buckets[bucketKey(x, z)] or {} do\n\t\t\t\t\tscanned += 1\n\t\t\t\t\tif scanned > SCAN_LIMIT then\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\t\tlocal delta = entry\046Position - position\n\t\t\t\t\tlocal distance = delta\046X * delta\046X + delta\046Z * delta\046Z\n\t\t\t\t\tlocal ahead = front == nil\n\t\t\t\t\t\tor distance <= 1\0468 ^ 2\n\t\t\t\t\t\tor delta\046X * front\046X + delta\046Z * front\046Z >= 0\n\t\t\t\t\tif\n\t\t\t\t\t\tdistance <= RADIUS ^ 2\n\t\t\t\t\t\tand ahead\n\t\t\t\t\t\tand not active[entry]\n\t\t\t\t\t\tand math\046abs(position\046Y - entry\046Base\046Y) <= 7\n\t\t\t\t\t\tand self:_validEntry(entry)\n\t\t\t\t\t\tand visible(entry, camera)\n\t\t\t\t\tthen\n\t\t\t\t\t\ttable\046insert(result, { Entry = entry, Distance = distance })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif scanned > SCAN_LIMIT then\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\t\tif scanned > SCAN_LIMIT then\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tif scanned > SCAN_LIMIT then\n\t\t\tbreak\n\t\tend\n\tend\n\tself\046_lastScanned += math\046min(scanned, SCAN_LIMIT)\n\ttable\046sort(result, function(a, b)\n\t\treturn a\046Distance < b\046Distance\n\tend)\n\tlocal selected = {}\n\tfor index = 1, math\046min(ACTOR_LIMIT, #result) do\n\t\ttable\046insert(selected, result[index]\046Entry)\n\tend\n\treturn selected\nend\n\nfunction CornWindController:_playerPosition(): Vector3?\n\tlocal character = self\046_player and self\046_player\046Character\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tlocal root = character and character:FindFirstChild(\"HumanoidRootPart\")\n\tif not humanoid or humanoid\046Health <= 0 or not root or not root:IsA(\"BasePart\") then\n\t\tself\046_playerRoot, self\046_previousPlayer, self\046_playerTrail = nil, nil, 0\n\t\treturn nil\n\tend\n\tif self\046_playerRoot ~= root then\n\t\tself:_restoreActive()\n\t\tself\046_playerRoot, self\046_previousPlayer, self\046_playerTrail = root, nil, 0\n\tend\n\tlocal position = root\046Position\n\tif\n\t\thumanoid\046MoveDirection\046Magnitude > 0\04605\n\t\tor (\n\t\t\tself\046_previousPlayer\n\t\t\tand horizontalDistanceSquared(position, self\046_previousPlayer) > 0\04601\n\t\t)\n\tthen\n\t\tself\046_playerTrail = self\046_time + TRAIL_SEC\n\tend\n\tself\046_previousPlayer = position\n\treturn if self\046_playerTrail > self\046_time then position else nil\nend\n\nfunction CornWindController:_monsterPosition(): Vector3?\n\tlocal runtime = self\046_map and self\046_map:FindFirstChild(\"CornRoundRuntime\")\n\tlocal nearest, nearestRoot, distance = nil, nil, math\046huge\n\tfor index = 1, 3 do\n\t\tlocal monster = runtime\n\t\t\tand runtime:IsA(\"Folder\")\n\t\t\tand runtime:GetAttribute(\"corn_project_id\") == PROJECT_ID\n\t\t\tand runtime:FindFirstChild(if index == 1 then \"Monster\" else \"Monster\" \046\046 index)\n\t\tlocal root = monster and monster:FindFirstChild(\"Root\")\n\t\tlocal state = monster and monster:GetAttribute(\"HuntState\")\n\t\tif\n\t\t\tnot monster\n\t\t\tor not monster:IsA(\"Model\")\n\t\t\tor monster:GetAttribute(\"CornMonsterOwned\") ~= true\n\t\t\tor monster:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\t\tor monster:GetAttribute(\"MonsterRigVersion\") ~= 1\n\t\t\tor monster:GetAttribute(\"MonsterIndex\") ~= index\n\t\t\tor not root\n\t\t\tor not root:IsA(\"BasePart\")\n\t\t\tor (state ~= \"patrol\" and state ~= \"chase\")\n\t\tthen\n\t\t\tself\046_monsterSamples[index] = nil\n\t\t\tcontinue\n\t\tend\n\t\tlocal sample = self\046_monsterSamples[index]\n\t\tif not sample or sample\046root ~= root then\n\t\t\tsample = { root = root, previous = root\046Position, untilAt = 0 }\n\t\t\tself\046_monsterSamples[index] = sample\n\t\tend\n\t\tlocal position = root\046Position\n\t\tif horizontalDistanceSquared