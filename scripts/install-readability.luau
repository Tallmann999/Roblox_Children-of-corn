{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CaptureController",class="ModuleScript",hash="f89773a4ad435464819c6f81afae008e07ec63a179f55c3df2e48107894abc32",history={"8b53504a62550696ac1080add03b6358c14acecc260aa81faa22da0b63d0f86b","a9b4a10040d0472ccfaab6e4b70c303b2e609de2ddfc059efdc3b6057e7b8048","a8d5c2032f3f8858066fd79edbf667d467bfed012341e9307252fc87871d6686","1cc7d44ceaaf431a6ee2b19931973a9b817c05c518dc953583f240981bd937b3","c55771cddb7c305493962fef2c6e9923fb9f1ccadeef4f7096a0673747647f52"},source="--!strict\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal HttpService = game:GetService(\"HttpService\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\")\nlocal Capture = require(Shared:WaitForChild(\"CapturePresentation\"))\nlocal Pose = require(Shared:WaitForChild(\"MonsterPose\"))\nlocal player = Players\046LocalPlayer\nlocal VISUAL_NAME = \"CornCaptureVisual\"\nlocal PAINT_NAME = \"CornCapturePaint\"\nlocal CAMERA_OWNER = \"CornCaptureCameraOwner\"\nlocal BINDING = \"CornCaptureCamera\"\nlocal PROJECT = \"children_of_corn\"\n-- Lift only the decorative shot above nearby corn; server catch geometry stays exact\046\nlocal PRESENTATION_OFFSET = CFrame\046new(0, 4, 0)\nlocal Controller = { Name = \"CaptureController\", Order = 92 }\nlocal HEAD_PARTS = { Head = true, Hat = true, LeftEye = true, RightEye = true }\nlocal PAINT_COLORS = {\n\tColor3\046fromRGB(30, 218, 197),\n\tColor3\046fromRGB(250, 211, 53),\n\tColor3\046fromRGB(154, 87, 230),\n}\n\nfunction Controller:Init(_context: any)\n\tself\046_state = Capture\046NewState()\n\tself\046_snapshot = nil\n\tself\046_movement = nil\n\tself\046_minimap = nil\n\tself\046_round = nil\n\tself\046_visual = nil\n\tself\046_parts = {}\n\tself\046_mouthParts = {}\n\tself\046_paint = nil\n\tself\046