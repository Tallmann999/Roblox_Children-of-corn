inition\046Name) :: BasePart\n\t\ttable\046insert(self\046_hiddenServer, {\n\t\t\tpart = part,\n\t\t\tprevious = part\046LocalTransparencyModifier,\n\t\t\tmodel = model,\n\t\t\tindex = model:GetAttribute(\"MonsterIndex\"),\n\t\t\tname = model\046Name,\n\t\t})\n\t\tpart\046LocalTransparencyModifier = 1\n\tend\nend\n\nfunction Controller:_restoreServerRig()\n\tfor _, entry in self\046_hiddenServer do\n\t\tif\n\t\t\tknownMonster(entry\046model)\n\t\t\tand entry\046model\046Name == entry\046name\n\t\t\tand entry\046model:GetAttribute(\"MonsterIndex\") == entry\046index\n\t\t\tand entry\046part\046Parent == entry\046model\n\t\t\tand entry\046part\046LocalTransparencyModifier == 1\n\t\tthen\n\t\t\tentry\046part\046LocalTransparencyModifier = entry\046previous\n\t\tend\n\tend\n\ttable\046clear(self\046_hiddenServer)\nend\n\nfunction Controller:_livingCharacter(): (Model?, Humanoid?, BasePart?)\n\tlocal character = player\046Character\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\tif character and humanoid and humanoid\046Health > 0 and root and root:IsA(\"BasePart\") then\n\t\treturn character, humanoid, root\n\tend\n\treturn nil, nil, nil\nend\n\nfunction Controller:_presentation(active: boolean)\n\tif self\046_minimap and active then\n\t\tself\046_minimap:SetExpanded(false)\n\tend\n\tif self\046_movement then\n\t\tself\046_movement:SetCaptureActive(active)\n\tend\n\tlocal hud = if self\046_round then self\046_round\046_hud else nil\n\tif hud then\n\t\thud:SetCaptureActive(active)\n\tend\nend\n\nfunction Controller:_buildVisual(frame: CFrame): boolean\n\tframe *= PRESENTATION_OFFSET\n\tif workspace:FindFirstChild(VISUAL_NAME) then\n\t\twarn(\"[CaptureController] Existing capture visual refused; unknown ownership/state\")\n\t\treturn false\n\tend\n\tassert(#Pose\046Parts == 9, \"Capture pose requires exactly nine decorative parts\")\n\t