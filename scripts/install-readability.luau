pshot(snapshot: any)\n\tlocal previous = self\046_snapshot\n\tif\n\t\tnot previous\n\t\tor previous\046phase ~= snapshot\046phase\n\t\tor previous\046minimap\046round_id ~= snapshot\046minimap\046round_id\n\tthen\n\t\tself:SetExpanded(false)\n\t\tself\046_elapsed = math\046huge\n\tend\n\tself\046_snapshot = snapshot\n\tself\046_visible = VISIBLE_PHASES[snapshot\046phase] == true\n\tself\046_hud:SetVisible(self\046_visible)\n\tself\046_hud:SetSnapshot(snapshot)\nend\n\nfunction MinimapController:_gatePosition(field: BasePart): Vector3?\n\tlocal map = workspace:FindFirstChild(\"CornMap\")\n\tif\n\t\tnot map\n\t\tor not map:IsA(\"Model\")\n\t\tor map:GetAttribute(\"corn_project_id\") ~= \"children_of_corn\"\n\t\tor not field:IsDescendantOf(map)\n\tthen\n\t\treturn nil\n\tend\n\tlocal gate = map:FindFirstChild(\"EscapeGate\")\n\tif not gate or not gate:IsA(\"Model\") or not gate:HasTag(\"corn_gate\") then\n\t\treturn nil\n\tend\n\tlocal anchor = gate:FindFirstChild(\"InteractionAnchor\")\n\treturn if anchor and anchor:IsA(\"BasePart\") then anchor\046Position else nil\nend\n\nfunction MinimapController:_update()\n\tif not self\046_visible then\n\t\treturn\n\tend\n\tlocal field = self\046_field\n\tif not field or not field:IsDescendantOf(workspace) then\n\t\tself\046_field = nil\n\t\tlocal map = workspace:FindFirstChild(\"CornMap\")\n\t\tif map and map:GetAttribute(\"corn_project_id\") == \"children_of_corn\" then\n\t\t\tfor _, candidate in CollectionService:GetTagged(\"corn_field_zone\") do\n\t\t\t\tif candidate:IsA(\"BasePart\") and candidate:IsDescendantOf(map) then\n\t\t\t\t\tself\046_field = candidate\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tfield = self\046_field\n\tend\n\tif not field or field\046Size\046X <= 0 or field\046Size\046Z <= 0 then\n\t\treturn\n\tend\n\tlocal position = nil\n\tlocal direction = nil\n\tlocal snapshot = self\046_snapshot\n\tif snapshot and (snapshot\046phase == \"active\" or snapshot\046phase == \"caught\") then\n\t\tlocal c