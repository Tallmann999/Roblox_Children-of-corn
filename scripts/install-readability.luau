{path="ReplicatedStorage/GameShared/Game/CornLayout",class="ModuleScript",hash="a2b9c16abf461d8b984cf562cc36aa77130acc485a5156c02d415b988849a1a1",history={"f7bee1060ed07acc7740b4b41a488515e1d3f9ddbec40ff51a78e29858b4ed8c"},source="--!strict\n\nlocal CornLayout = {\n\tHeight = 8,\n\tSpacing = 3,\n\tSeed = 817,\n\tChunkCells = 12,\n\tRenderRadius = 150,\n\tElevatedRadius = 200,\n\tDenseRadius = 60,\n\tMediumRadius = 130,\n}\n\nexport type Plant = Model | BasePart\nexport type Box = { Frame: CFrame, HalfSize: Vector2 }\nexport type Circle = { Center: Vector3, Radius: number }\nexport type Exclusions = { Boxes: { Box }, Circles: { Circle }, Signature: string }\n\nlocal SLOT_RADIUS = 6\nlocal BOX_PADDING = 1\0465\n\nlocal function finite(value: number): boolean\n\treturn value == value and value > -math\046huge and value < math\046huge\nend\n\nfunction CornLayout\046Bounds(plant: Plant): (CFrame, Vector3)\n\tif plant:IsA(\"Model\") then\n\t\treturn plant:GetBoundingBox()\n\tend\n\treturn plant\046CFrame, plant\046Size\nend\n\nfunction CornLayout\046PrepareTemplate(source: Instance, height: number?): (Plant?, string?)\n\tif not source:IsA(\"Model\") and not source:IsA(\"BasePart\") then\n\t\treturn nil, \"Corn source must be a Model or BasePart\"\n\tend\n\tlocal targetHeight = height or CornLayout\046Height\n\tif not finite(targetHeight) or targetHeight <= 0 then\n\t\treturn nil, \"Corn height must be positive and finite\"\n\tend\n\tlocal items = source:GetDescendants()\n\ttable\046insert(items, source)\n\tlocal partCount = 0\n\tfor _, item in items do\n\t\tif item:IsA(\"LuaSourceContainer\") then\n\t\t\treturn nil, \"Corn source contains code\"\n\t\tend\n\t\tif\n\t\t\titem:IsA(\"Sound\")\n\t\t\tor item:IsA(\"ParticleEmitter\")\n\t\t\tor item:IsA(\"Beam\")\n\t\t\tor item:IsA(\"Trail\")\n\t\t\tor item:IsA(\"ProximityPrompt\")\n\t\t\tor item:IsA(\"ClickDetector\")\n\t\t\tor item:IsA(\"RemoteEvent\")\n\t\t\tor item:IsA(\"RemoteFunction\")\n\t\tthen\n\t\t\treturn nil, \"Corn source must contain only static art\"\n\t\tend\n\t\tif not item\046Archivable then\n\t\t\treturn nil, \"Corn source has non-Archivable contents\"\n\t\tend\n\t\tif item:IsA(\"BasePart\") then\n\t\t\tpartCount += 1\n\t\tend\n\tend\n\tif partCount == 0 then\n\t\treturn nil, \"Corn source has no BaseParts\"\n\tend\n\n\tlocal prepared = source:Clone() :: Plant?\n\tif not prepared then\n\t\treturn nil, \"Corn source could not be cloned\"\n\tend\n\tlocal ok, problem = pcall(function()\n\t\tlocal _, size = CornLayout\046Bounds(prepared :: Plant)\n\t\tif not finite(size\046Y) or size\046Y <= 0 then\n\t\t\terror(\"Corn source has no usable height\")\n\t\tend\n\t\tlocal ratio = targetHeight / size\046Y\n\t\tif prepared:IsA(\"Model\") then\n\t\t\tprepared:ScaleTo(prepared:GetScale() * ratio)\n\t\telse\n\t\t\tprepared\046Size *= ratio\n\t\t\tfor _, item in prepared:GetChildren() do\n\t\t\t\tif item:IsA(\"SpecialMesh\") then\n\t\t\t\t\titem\046Scale *= ratio\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\t-- The imported plant has one mesh plus import poses/animation metadata\046\n\t\t-- Keep only that normalized mesh on decorative copies; the source is untouched\046\n\t\tif prepared:IsA(\"Model\") and partCount == 1 then\n\t\t\tlocal mesh = prepared:FindFirstChildWhichIsA(\"MeshPart\", true)\n\t\t\tif mesh and mesh:IsA(\"MeshPart\") then\n\t\t\t\tmesh\046Parent = nil\n\t\t\t\tprepared:Destroy()\n\t\t\t\tprepared = mesh\n\t\t\tend\n\t\tend\n\t\tfor _, item in prepared:GetDescendants() do\n\t\t\tif\n\t\t\t\titem:IsA(\"AnimationController\")\n\t\t\t\tor (item:IsA(\"Folder\") and item\046Name == \"InitialPoses\")\n\t\t\tthen\n\t\t\t\titem:Destroy()\n\t\t\tend\n\t\tend\n\t\tlocal clones = prepared:GetDescendants()\n\t\ttable\046insert(clones, prepared)\n\t\tfor _, item in clones do\n\t\t\t-- Art tags must not become gameplay bindings on every decorative clone\046\n\t\t\tfor _, tag in item:GetTags() do\n\t\t\t\titem:RemoveTag(tag)\n\t\t\tend\n\t\t\tif item:IsA(\"BasePart\") then\n\t\t\t\titem\046Anchored = true\n\t\t\t\titem\046CanCollide = false\n\t\t\t\titem\046CanTouch = false\n\t\t\t\titem\046CanQuery = false\n\t\t\t\titem\046CastShadow = false\n\t\t\t\tif item:IsA(\"MeshPart\") then\n\t\t\t\t\titem\046DoubleSided = true\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tprepared:PivotTo(CornLayout\046PivotForPlant(prepared, Vector3\046zero, 0))\n\tend)\n\tif not ok then\n\t\tprepared:Destroy()\n\t\treturn nil, tostring(problem)\n\tend\n\treturn prepared, nil\nend\n\nfunction CornLayout\046PivotForPlant(plant: Plant, groundPosition: Vector3, yaw: number): CFrame\n\tlocal bounds, size = CornLayout\046Bounds(plant)\n\tlocal boundsFromPivot = plant:GetPivot():ToObjectSpace(bounds)\n\treturn CFrame\046new(groundPosition + Vector3\046new(0, size\046Y / 2, 0))\n\t\t* CFrame\046Angles(0, yaw, 0)\n\t\t* boundsFromPivot:Inverse()\nend\n\nfunction CornLayout\046GetCellBounds(field: BasePart): (number, number, number, number)\n\tlocal half = field\046Size / 2\n\treturn math\046ceil(-half\046X / CornLayout\046Spacing),\n\t\tmath\046floor(half\046X / CornLayout\046Spacing),\n\t\tmath\046ceil(-half\046Z / CornLayout\046Spacing),\n\t\tmath\046floor(half\046Z / CornLayout\046Spacing)\nend\n\nfunction CornLayout\046BaseCellPosition(field: BasePart, column: number, row: number): Vector3\n\tlocal half = field\046Size / 2\n\tlocal hashX = (column * 92837111 + row * 689287499 + CornLayout\046Seed) % 104729\n\tlocal hashZ = (column * 19349663 + row * 83492791 + CornLayout\046Seed) % 104729\n\tlocal stagger = if row % 2 == 0 then -CornLayout\046Spacing * 0\04615 else CornLayout\046Spacing * 0\04615\n\tlocal x = column * CornLayout\046Spacing\n\t\t+ stagger\n\t\t+ (hashX / 104729 - 0\0465) * CornLayout\046Spacing * 0\04612\n\tlocal z = row * CornLayout\046Spacing + (hashZ / 104729 - 0\0465) * CornLayout\046Spacing * 0\04612\n\treturn field\046CFrame:PointToWorldSpace(\n\t\tVector3\046new(math\046clamp(x, -half\046X, half\046X), -half\046Y, math\046clamp(z, -half\046Z, half\046Z))\n\t)\nend\n\nlocal function hash(column: number, row: number, salt: number): number\n\treturn ((column * 73856093 + row * 19349663 + CornLayout\046Seed * salt) % 104729) / 104729\nend\n\nfunction CornLayout\046CellPosition(field: BasePart, column: number, row: number): Vector3\n\tlocal point = field\046CFrame:PointToObjectSpace(CornLayout\046BaseCellPosition(field, column, row))\n\tlocal half = field\046Size / 2\n\treturn field\046CFrame:PointToWorldSpace(\n\t\tVector3\046new(\n\t\t\tmath\046clamp(\n\t\t\t\tpoint\046X + (hash(column, row, 17) * 2 - 1) * CornLayout\046Spacing * 0\0461,\n\t\t\t\t-half\046X,\n\t\t\t\thalf\046X\n\t\t\t),\n\t\t\tpoint\046Y,\n\t\t\tmath\046clamp(\n\t\t\t\tpoint\046Z + (hash(column, row, 31) * 2 - 1) * CornLayout\046Spacing * 0\0461,\n\t\t\t\t-half\046Z,\n\t\t\t\thalf\046Z\n\t\t\t)\n\t\t)\n\t)\nend\n\nfunction CornLayout\046CellYaw(column: number, row: number): number\n\tlocal sign = if hash(column, row, 47) < 0\0465 then -1 else 1\n\treturn math\046rad(10 + hash(column, row, 61) * 20) * sign\nend\n\nfunction CornLayout\046HeightFactor(column: number, row: number): number\n\tlocal sign = if hash(column, row, 79) < 0\0465 then -1 else 1\n\treturn 1 + sign * (0\0461 + hash(column, row, 97) * 0\04605)\nend\n\nfunction CornLayout\046ApplyVariation(plant: Plant, column: number, row: number)\n\tlocal factor = CornLayout\046HeightFactor(column, row)\n\tif plant:IsA(\"BasePart\") then\n\t\tplant\046Size = Vector3\046new(plant\046Size\046X, plant\046Size\046Y * factor, plant\046Size\046Z)\n\telse\n\t\tplant:ScaleTo(plant:GetScale() * factor)\n\tend\nend\n\nlocal function footprint(frame: CFrame, size: Vector3, padding: number): Box\n\tlocal look = frame\046LookVector\n\tlocal yaw = math\046atan2(-look\046X, -look\046Z)\n\tlocal flat = CFrame\046new(frame\046Position) * CFrame\046Angles(0, yaw, 0)\n\tlocal half = size / 2\n\tlocal right = flat\046RightVector\n\tlocal forward = flat\046LookVector\n\tlocal width = math\046abs(right:Dot(frame\046RightVector)) * half\046X\n\t\t+ math\046abs(right:Dot(frame\046UpVector)) * half\046Y\n\t\t+ math\046abs(right:Dot(frame\046LookVector)) * half\046Z\n\tlocal depth = math\046abs(forward:Dot(frame\046RightVector)) * half\046X\n\t\t+ math\046abs(forward:Dot(frame\046UpVector)) * half\046Y\n\t\t+ math\046abs(forward:Dot(frame\046LookVector)) * half\046Z\n\treturn { Frame = flat, HalfSize = Vector2\046new(width + padding, depth + padding) }\nend\n\nlocal function authorDescendants(map: Model): { Instance }\n\tlocal result: { Instance } = {}\n\tlocal stack = map:GetChildren()\n\twhile #stack > 0 do\n\t\tlocal item = table\046remove(stack)\n\t\tlocal owned = item:GetAttribute(\"corn_project_id\") == \"children_of_corn\"\n\t\tlocal decoration = owned\n\t\t\tand (\n\t\t\t\t(item\046Name == \"EditorPreview\" and item:GetAttribute(\"CornEditorPreview\") == true)\n\t\t\t\tor (item\046Name == \"EditorFieldOverview\" and item:GetAttribute(\"CornEditorOverview\") == true)\n\t\t\t\tor (item\046Name == \"CornClientPlants\" and item:GetAttribute(\"CornClientRendererOwned\") == true)\n\t\t\t\tor (item\046Name == \"CornClientBackdrop\" and item:GetAttribute(\n\t\t\t\t\t\"CornClientBackdropOwned\"\n\t\t\t\t) == true)\n\t\t\t\tor item\046Name == \"CornRoundRuntime\"\n\t\t\t)\n\t\tif decoration then\n\t\t\tcontinue\n\t\tend\n\t\ttable\046insert(result, item)\n\t\tfor _, child in item:GetChildren() do\n\t\t\ttable\046insert(stack, child)\n\t\tend\n\tend\n\treturn result\nend\nfunction CornLayout\046ReadExclusions(map: Model, field: BasePart): Exclusions\n\tlocal boxes: { Box } = {}\n\tlocal circles: { Circle } = {}\n\tlocal signatures: { string } = { tostring(field\046CFrame) \046\046 \"/\" \046\046 tostring(field\046Size) }\n\tlocal included: { [Instance]: boolean } = {}\n\tlocal function addBox(part: BasePart, padding: number)\n\t\tif included[part] then\n\t\t\treturn\n\t\tend\n\t\tincluded[part] = true\n\t\ttable\046insert(boxes, footprint(part\046CFrame, part\046Size, padding))\n\t\ttable\046insert(\n\t\t\tsignatures,\n\t\t\tpart:GetFullName()\n\t\t\t\t\046\046 \"/box/\"\n\t\t\t\t\046\046 tostring(part\046CFrame)\n\t\t\t\t\046\046 \"/\"\n\t\t\t\t\046\046 tostring(part\046Size)\n\t\t\t\t\046\046 \"/\"\n\t\t\t\t\046\046 padding\n\t\t)\n\tend\n\tfor _, folderName in { \"NoCornZones\", \"Props\" } do\n\t\tlocal folder = map:FindFirstChild(folderName)\n\t\tif folder then\n\t\t\tfor _, item in folder:GetDescendants() do\n\t\t\t\tif item:IsA(\"BasePart\") then\n\t\t\t\t\taddBox(item, BOX_PADDING)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tfor _, item in authorDescendants(map) do\n\t\tif item:IsA(\"BasePart\") then\n\t\t\tif item:HasTag(\"corn_no_corn_zone\") then\n\t\t\t\taddBox(item, BOX_PADDING)\n\t\t\tend\n\t\t\tif item:HasTag(\"corn_key_slot\") then\n\t\t\t\ttable\046insert(circles, { Center = item\046Position, Radius = SLOT_RADIUS })\n\t\t\t\ttable\046insert(signatures, item:GetFullName() \046\046 \"/slot/\" \046\046 tostring(item\046Position))\n\t\t\telseif item:HasTag(\"corn_spawn\") then\n\t\t\t\taddBox(item, 4)\n\t\t\t\ttable\046insert(circles, { Center = item\046Position, Radius = 10 })\n\t\t\t\ttable\046insert(signatures, item:GetFullName() \046\046 \"/spawn/\" \046\046 tostring(item\046Position))\n\t\t\tend\n\t\tend\n\tend\n\tlocal gate = map:FindFirstChild(\"EscapeGate\")\n\tif gate then\n\t\tlocal door = gate:FindFirstChild(\"Door\", true)\n\t\tif door and door:IsA(\"BasePart\") then\n\t\t\taddBox(door, 6)\n\t\tend\n\tend\n\ttable\046sort(signatures)\n\treturn { Boxes = boxes, Circles = circles, Signature = table\046concat(signatures, \"|\") }\nend\n\nfunction CornLayout\046IsExcluded(position: Vector3, exclusions: Exclusions): boolean\n\tfor _, circle in exclusions\046Circles do\n\t\tlocal delta = position - circle\046Center\n\t\tif delta\046X * delta\046X + delta\046Z * delta\046Z <= circle\046Radius * circle\046Radius then\n\t\t\treturn true\n\t\tend\n\tend\n\tfor _, box in exclusions\046Boxes do\n\t\tlocal localPosition = box\046Frame:PointToObjectSpace(position)\n\t\tif\n\t\t\tmath\046abs(localPosition\046X) <= box\046HalfSize\046X\n\t\t\tand math\046abs(localPosition\046Z) <= box\046HalfSize\046Y\n\t\tthen\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nreturn CornLayout\n"},
{path="ReplicatedStorage/GameShared/Game/FarmEditableMeshBuilder",class="ModuleScript",hash="ec407baace6b9eb0042fbe5a160970d08cba5bed97a2760a546c788d4db727a2",history={"abf83a2ea5ef57ba4c3e71e0b99fc8ff43fa9cf0348cecc79981788036b8b0d5"},source="--!strict\n-- Shared peer-local construction/restoration; never uploads or authors placements\046\nlocal KEYS =\n\t{ \"SM_Bld_Barn_03\", \"SM_Prop_Truck_Rusted_01\", \"SM_Prop_Tyre_01\", \"SM_Prop_Rubbish_Pile_05\" }\nlocal DataFolder = script\046Parent:WaitForChild(\"FarmGeometryData\")\nlocal Catalog = {}\nlocal total = 0\nfor _, key in KEYS do\n\tlocal data = require(DataFolder:WaitForChild(key))\n\tassert(\n\t\ttype(data) == \"table\"\n\t\t\tand data\046index_base == 1\n\t\t\tand type(data\046meshes) == \"table\"\n\t\t\tand #data\046meshes == (if key == \"SM_Bld_Barn_03\" then 7 else 1),\n\t\t\"Unknown neutral farm catalog: \" \046\046 key\n\t)\n\tCatalog[key] = data\n\ttotal += #data\046meshes\nend\nassert(total == 10, \"Expected ten verified original farm meshes\")\nlocal function finite(value: any): boolean\n\treturn type(value) == \"number\" and value == value and math\046abs(value) < 10000000\nend\nlocal function validate(data: any)\n\tassert(\n\t\ttype(data) == \"table\" and type(data\046world_bounds) == \"table\",\n\t\t\"Neutral mesh/bounds required\"\n\t)\n\tlocal operations = 0\n\tlocal function tick()\n\t\toperations += 1\n\t\tif operations >= 500 then\n\t\t\toperations = 0\n\t\t\ttask\046wait()\n\t\tend\n\tend\n\tlocal function tuples(values: any, width: number, limit: number)\n\t\tassert(type(values) == \"table\" and #values <= limit, \"Invalid/oversized mesh channel\")\n\t\tfor _, tuple in values do\n\t\t\tassert(type(tuple) == \"table\" and #tuple == width, \"Mesh channel tuple width mismatch\")\n\t\t\tfor _, value in tuple do\n\t\t\t\tassert(finite(value), \"Nonfinite mesh channel coordinate\")\n\t\t\tend\n\t\t\ttick()\n\t\tend\n\tend\n\ttuples(data\046positions, 3, 60000)\n\tassert(#data\046positions > 0, \"Mesh vertices required\")\n\ttuples(data\046uvs_roblox_flip_v, 2, 120000)\n\tassert(#data\046uvs_roblox_flip_v > 0, \"Mesh UVs required\")\n\ttuples(data\046normals, 3, 120000)\n\ttuples(data\046colors, 4, 120000)\n\ttuples({ data\046world_bounds\046min, data\046world_bounds\046max }, 3, 2)\n\tlocal low, high = data\046world_bounds\046min, data\046world_bounds\046max\n\tfor axis = 1, 3 do\n\t\tassert(high[axis] > low[axis], \"Positive mesh bounds required\")\n\tend\n\tassert(\n\t\ttype(data\046triangles) == \"table\" and #data\046triangles > 0 and #data\046triangles <= 20000,\n\t\t\"Triangle count outside supported limits\"\n\t)\n\tlocal function corner(indices: any, limit: number)\n\t\tassert(type(indices) == \"table\" and #indices == 3, \"Triangle corner triple required\")\n\t\tfor _, index in indices do\n\t\t\tassert(\n\t\t\t\tfinite(index) and index % 1 == 0 and index >= 1 and index <= limit,\n\t\t\t\t\"Invalid triangle/corner index\"\n\t\t\t)\n\t\tend\n\tend\n\tfor _, name in { \"triangle_uvs\", \"triangle_normals\", \"triangle_colors\" } do\n\t\tassert(\n\t\t\ttype(data[name]) == \"table\" and #data[name] == #data\046triangles,\n\t\t\t\"Triangle channel count mismatch\"\n\t\t)\n\tend\n\tfor index, triangle in data\046triangles do\n\t\tcorner(triangle, #data\046positions)\n\t\tcorner(data\046triangle_uvs[index], #data\046uvs_roblox_flip_v)\n\t\tif #data\046normals > 0 then\n\t\t\tcorner(data\046triangle_normals[index], #data\046normals)\n\t\tend\n\t\tif #data\046colors > 0 then\n\t\t\tcorner(data\046triangle_colors[index], #data\046colors)\n\t\tend\n\t\ttick()\n\tend\nend\n\n-- Pure EditableMesh construction from verified neutral FBX data\046\n-- Never uploads, parents instances, changes Workspace, or reads/writes a place\046\nlocal function rawBuild(data, batchSize)\n\tassert(\n\t\ttype(data) == \"table\" and type(data\046positions) == \"table\" and #data\046positions > 0,\n\t\t\"Verified mesh positions required\"\n\t)\n\tassert(\n\t\ttype(data\046triangles) == \"table\" and #data\046triangles > 0,\n\t\t\"Verified mesh triangles required\"\n\t)\n\tassert(type(data\046world_bounds) == \"table\", \"Baked world bounds required\")\n\tlocal limit = batchSize or 500\n\tassert(type(limit) == \"number\" and limit >= 1 and limit % 1 == 0, \"Integer batch size required\")\n\tlocal function vector(v)\n\t\tassert(type(v) == \"table\" and #v == 3, \"Vector3 triple required\")\n\t\tfor _, n in v do\n\t\t\tassert(\n\t\t\t\ttype(n) == \"number\" and n == n and math\046abs(n) < math\046huge,\n\t\t\t\t\"Finite mesh coordinates required\"\n\t\t\t)\n\t\tend\n\t\treturn Vector3\046new(v[1], v[2], v[3])\n\tend\n\tlocal low, high = vector(data\046world_bounds\046min), vector(data\046world_bounds\046max)\n\tlocal center = (low + high) / 2\n\tlocal vertexCount, uvCount, normalCount, colorCount =\n\t\t#data\046positions, #data\046uvs_roblox_flip_v, #data\046normals, #data\046colors\n\tassert(\n\t\t#data\046triangle_uvs == #data\046triangles\n\t\t\tand #data\046triangle_normals == #data\046triangles\n\t\t\tand #data\046triangle_colors == #data\046triangles,\n\t\t\"Per-corner channel counts differ\"\n\t)\n\tlocal function indices(values, size)\n\t\tassert(type(values) == \"table\" and #values == 3, \"Triangle index triple required\")\n\t\tfor _, n in values do\n\t\t\tassert(\n\t\t\t\ttype(n) == \"number\" and n % 1 == 0 and n >= 1 and n <= size,\n\t\t\t\t\"Out-of-range mesh index\"\n\t\t\t)\n\t\tend\n\tend\n\tfor i, triangle in data\046triangles do\n\t\tindices(triangle, vertexCount)\n\t\tindices(data\046triangle_uvs[i], uvCount)\n\t\tif normalCount > 0 then\n\t\t\tindices(data\046triangle_normals[i], normalCount)\n\t\tend\n\t\tif colorCount > 0 then\n\t\t\tindices(data\046triangle_colors[i], colorCount)\n\t\tend\n\tend\n\tlocal mesh = assert(\n\t\tgame:GetService(\"AssetService\"):CreateEditableMesh(),\n\t\t\"EditableMesh memory budget unavailable\"\n\t)\n\tlocal operations = 0\n\tlocal function tick()\n\t\toperations += 1\n\t\tif operations >= limit then\n\t\t\toperations = 0\n\t\t\ttask\046wait()\n\t\tend\n\tend\n\tlocal ok, problem = pcall(function()\n\t\tlocal vertices, uvs, normals, colors = {}, {}, {}, {}\n\t\tfor i, value in data\046positions do\n\t\t\tvertices[i] = mesh:AddVertex(vector(value) - center)\n\t\t\ttick()\n\t\tend\n\t\tfor i, value in data\046uvs_roblox_flip_v do\n\t\t\tassert(\n\t\t\t\ttype(value) == \"table\"\n\t\t\t\t\tand #value == 2\n\t\t\t\t\tand value[1] == value[1]\n\t\t\t\t\tand value[2] == value[2],\n\t\t\t\t\"Finite UV pair required\"\n\t\t\t)\n\t\t\tuvs[i] = mesh:AddUV(Vector2\046new(value[1], value[2]))\n\t\t\ttick()\n\t\tend\n\t\tfor i, value in data\046normals do\n\t\t\tnormals[i] = mesh:AddNormal(vector(value))\n\t\t\ttick()\n\t\tend\n\t\tfor i, value in data\046colors do\n\t\t\tassert(type(value) == \"table\" and #value == 4, \"RGBA color required\")\n\t\t\tcolors[i] = mesh:AddColor(Color3\046new(value[1], value[2], value[3]), value[4])\n\t\t\ttick()\n\t\tend\n\t\tfor i, triangle in data\046triangles do\n\t\t\tlocal face = mesh:AddTriangle(\n\t\t\t\tvertices[triangle[1]],\n\t\t\t\tvertices[triangle[2]],\n\t\t\t\tvertices[triangle[3]]\n\t\t\t)\n\t\t\ttick()\n\t\t\tlocal uv = data\046triangle_uvs[i]\n\t\t\tmesh:SetFaceUVs(face, { uvs[uv[1]], uvs[uv[2]], uvs[uv[3]] })\n\t\t\ttick()\n\t\t\tif normalCount > 0 then\n\t\t\t\tlocal n = data\046triangle_normals[i]\n\t\t\t\tmesh:SetFaceNormals(face, { normals[n[1]], normals[n[2]], normals[n[3]] })\n\t\t\t\ttick()\n\t\t\tend\n\t\t\tif colorCount > 0 then\n\t\t\t\tlocal c = data\046triangle_colors[i]\n\t\t\t\tmesh:SetFaceColors(face, { colors[c[1]], colors[c[2]], colors[c[3]] })\n\t\t\t\ttick()\n\t\t\tend\n\t\tend\n\tend)\n\tif not ok then\n\t\tmesh:Destroy()\n\t\terror(\"Neutral mesh construction failed: \" \046\046 tostring(problem))\n\tend\n\t-- Center and Size remain raw cm\046 Parent applies one uniform scale to size and center,\n\t-- then places MeshPart at modelFrame * CFrame\046new(center * scale)\046\n\treturn mesh,\n\t\tcenter,\n\t\t{\n\t\t\tMin = low,\n\t\t\tMax = high,\n\t\t\tSize = high - low,\n\t\t\tSourceName = data\046name,\n\t\t\tVertexCount = vertexCount,\n\t\t\tTriangleCount = #data\046triangles,\n\t\t}\nend\n\nlocal function build(data: any, batchSize: number?)\n\tvalidate(data)\n\treturn rawBuild(data, batchSize)\nend\nlocal PROPERTIES = {\n\t\"CFrame\",\n\t\"Size\",\n\t\"PivotOffset\",\n\t\"TextureID\",\n\t\"TextureContent\",\n\t\"Color\",\n\t\"Material\",\n\t\"MaterialVariant\",\n\t\"Transparency\",\n\t\"Reflectance\",\n\t\"Anchored\",\n\t\"CanCollide\",\n\t\"CanTouch\",\n\t\"CanQuery\",\n\t\"CastShadow\",\n\t\"DoubleSided\",\n\t\"CollisionGroup\",\n\t\"Massless\",\n\t\"CustomPhysicalProperties\",\n}\nlocal PROJECT = \"children_of_corn\"\nlocal Runtime = {}\nRuntime\046__index = Runtime\nlocal function assetKeyForName(name: string): string?\n\tif table\046find({ \"HouseWest\", \"HouseEast\", \"HouseNorthWest\" }, name) then\n\t\treturn KEYS[1]\n\telseif name == \"RustedTruck\" then\n\t\treturn KEYS[2]\n\telseif name:match(\"^Tyre_%d+$\") then\n\t\treturn KEYS[3]\n\telseif name:match(\"^RubbishPile_%d+$\") then\n\t\treturn KEYS[4]\n\tend\n\treturn nil\nend\nlocal function modelKey(model: Instance, source: boolean): string?\n\tlocal key = model:GetAttribute(\"AssetKey\")\n\tif type(key) ~= \"string\" or not Catalog[key] then\n\t\treturn nil\n\tend\n\tif source then\n\t\treturn if model\046Name == key then key else nil\n\tend\n\treturn if assetKeyForName(model\046Name) == key then key else nil\nend\nlocal function contentObject(part: MeshPart): any\n\tlocal content = part\046MeshContent\n\tassert(part\046MeshId == \"\", \"Owned farm mesh has manual URI; preserving it: \" \046\046 part\046Name)\n\tassert(\n\t\tcontent\046SourceType == Enum\046ContentSourceType\046None\n\t\t\tor content\046SourceType == Enum\046ContentSourceType\046Object,\n\t\t\"Unsupported owned farm content type\"\n\t)\n\treturn if content\046SourceType == Enum\046ContentSourceType\046Object then content\046Object else nil\nend\nfunction Runtime:_collect(): ({ any }, number)\n\tlocal world = game:GetService(\"Workspace\")\n\tlocal map = world:FindFirstChild(\"CornMap\")\n\tassert(\n\t\tmap\n\t\t\tand map:IsA(\"Model\")\n\t\t\tand map:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\tand not world:FindFirstChild(\"Asmr_Base\")\n\t\t\tand not world:FindFirstChild(\"ASMR_Models\"),\n\t\t\"Farm geometry requires Children_of_corn\"\n\t)\n\tlocal props = map:FindFirstChild(\"Props\")\n\tassert(props and props:IsA(\"Folder\"), \"CornMap Props missing\")\n\tlocal roots = { { Root = props, Source = false } }\n\tif self\046_scope == \"server\" then\n\t\tlocal source = game:GetService(\"ServerStorage\"):FindFirstChild(\"CornFarmAssets\")\n\t\tif source then\n\t\t\tassert(\n\t\t\t\tsource:IsA(\"Folder\")\n\t\t\t\t\tand source:GetAttribute(\"CornFarmAssetsOwned\") == true\n\t\t\t\t\tand source:GetAttribute(\"corn_project_id\") == PROJECT,\n\t\t\t\t\"Foreign CornFarmAssets was preserved\"\n\t\t\t)\n\t\t\ttable\046insert(roots, { Root = source, Source = true })\n\t\tend\n\tend\n\tlocal targets, pending = {}, 0\n\tfor _, root in roots do\n\t\tfor _, model in root\046Root:GetChildren() do\n\t\t\tlocal owned = model:GetAttribute(\"CornFarmAssetOwned\") == true\n\t\t\tif not owned then\n\t\t\t\tlocal pendingOwner = false\n\t\t\t\tfor _, item in model:GetDescendants() do\n\t\t\t\t\tif item:GetAttribute(\"CornFarmMeshOwned\") == true then\n\t\t\t\t\t\tif\n\t\t\t\t\t\t\tself\046_scope == \"client\"\n\t\t\t\t\t\t\tand model:IsA(\"Model\")\n\t\t\t\t\t\t\tand assetKeyForName(model\046Name)\n\t\t\t\t\t\tthen\n\t\t\t\t\t\t\tpendingOwner = true\n\t\t\t\t\t\telse\n\t\t\t\t\t\t\terror(\"Owned farm mesh outside recognized model\")\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif pendingOwner then\n\t\t\t\t\tpending += 1\n\t\t\t\tend\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tassert(model:IsA(\"Model\"), \"Malformed owned farm model\")\n\t\t\tlocal project, declaredKey =\n\t\t\t\tmodel:GetAttribute(\"corn_project_id\"), model:GetAttribute(\"AssetKey\")\n\t\t\tif\n\t\t\t\tself\046_scope == \"client\"\n\t\t\t\tand (project == nil or declaredKey == nil)\n\t\t\t\tand assetKeyForName(model\046Name)\n\t\t\tthen\n\t\t\t\tpending += 1\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tassert(project == PROJECT, \"Malformed owned farm model\")\n\t\t\tlocal key = modelKey(model, root\046Source)\n\t\t\tassert(key, \"Unknown owned farm model/key; preserving metadata\")\n\t\t\tlocal indices, modelTargets, incomplete = {}, {}, false\n\t\t\tfor _, part in model:GetDescendants() do\n\t\t\t\tif part:GetAttribute(\"CornFarmMeshOwned\") ~= true then\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tassert(\n\t\t\t\t\tpart:IsA(\"MeshPart\") and part\046Parent == model,\n\t\t\t\t\t\"Malformed/outside owned farm MeshPart\"\n\t\t\t\t)\n\t\t\t\tlocal partProject, partKey, index =\n\t\t\t\t\tpart:GetAttribute(\"corn_project_id\"),\n\t\t\t\t\tpart:GetAttribute(\"AssetKey\"),\n\t\t\t\t\tpart:GetAttribute(\"MeshIndex\")\n\t\t\t\tif\n\t\t\t\t\tself\046_scope == \"client\"\n\t\t\t\t\tand (partProject == nil or partKey == nil or index == nil)\n\t\t\t\tthen\n\t\t\t\t\tincomplete = true\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tassert(\n\t\t\t\t\tpartProject == PROJECT and partKey == key,\n\t\t\t\t\t\"Malformed/outside owned farm MeshPart\"\n\t\t\t\t)\n\t\t\t\tassert(\n\t\t\t\t\tfinite(index)\n\t\t\t\t\t\tand index % 1 == 0\n\t\t\t\t\t\tand index >= 1\n\t\t\t\t\t\tand index <= #Catalog[key]\046meshes\n\t\t\t\t\t\tand not indices[index],\n\t\t\t\t\t\"Invalid/duplicate owned farm MeshIndex\"\n\t\t\t\t)\n\t\t\t\tindices[index] = true\n\t\t\t\tcontentObject(part)\n\t\t\t\tassert(\n\t\t\t\t\tfinite(part\046Size\046X)\n\t\t\t\t\t\tand finite(part\046Size\046Y)\n\t\t\t\t\t\tand finite(part\046Size\046Z)\n\t\t\t\t\t\tand part\046Size\046X > 0\n\t\t\t\t\t\tand part\046Size\046Y > 0\n\t\t\t\t\t\tand part\046Size\046Z > 0,\n\t\t\t\t\t\"Invalid authored mesh Size\"\n\t\t\t\t)\n\t\t\t\tassert(\n\t\t\t\t\tfinite(part\046CFrame\046Position\046X)\n\t\t\t\t\t\tand finite(part\046CFrame\046Position\046Y)\n\t\t\t\t\t\tand finite(part\046CFrame\046Position\046Z),\n\t\t\t\t\t\"Invalid authored mesh CFrame\"\n\t\t\t\t)\n\t\t\t\ttable\046insert(modelTargets, {\n\t\t\t\t\tPart = part,\n\t\t\t\t\tModel = model,\n\t\t\t\t\tRoot = root\046Root,\n\t\t\t\t\tMap = map,\n\t\t\t\t\tSource = root\046Source,\n\t\t\t\t\tAssetKey = key,\n\t\t\t\t\tMeshIndex = index,\n\t\t\t\t\tKey = key \046\046 \":\" \046\046 tostring(index),\n\t\t\t\t})\n\t\t\tend\n\t\t\tfor index = 1, #Catalog[key]\046meshes do\n\t\t\t\tif not indices[index] then\n\t\t\t\t\tincomplete = true\n\t\t\t\tend\n\t\t\tend\n\t\t\tif incomplete then\n\t\t\t\tassert(self\046_scope == \"client\", \"Owned farm asset is incomplete: \" \046\046 model\046Name)\n\t\t\t\tpending += 1\n\t\t\telse\n\t\t\t\tfor _, target in modelTargets do\n\t\t\t\t\ttable\046insert(targets, target)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn targets, pending\nend\nfunction Runtime:_validateTarget(target: any)\n\tlocal world = game:GetService(\"Workspace\")\n\tlocal map, root = target\046Map, target\046Root\n\tassert(\n\t\tmap\046Parent == world\n\t\t\tand world:FindFirstChild(\"CornMap\") == map\n\t\t\tand map:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\tand not world:FindFirstChild(\"Asmr_Base\")\n\t\t\tand not world:FindFirstChild(\"ASMR_Models\"),\n\t\t\"Farm map binding changed during construction\"\n\t)\n\tif target\046Source then\n\t\tlocal storage = game:GetService(\"ServerStorage\")\n\t\tassert(\n\t\t\troot\046Parent == storage\n\t\t\t\tand storage:FindFirstChild(\"CornFarmAssets\") == root\n\t\t\t\tand root:GetAttribute(\"CornFarmAssetsOwned\") == true\n\t\t\t\tand root:GetAttribute(\"corn_project_id\") == PROJECT,\n\t\t\t\"Farm source folder binding changed during construction\"\n\t\t)\n\telse\n\t\tassert(\n\t\t\troot\046Parent == map and map:FindFirstChild(\"Props\") == root,\n\t\t\t\"Farm Props binding changed during construction\"\n\t\t)\n\tend\n\tlocal part, model = target\046Part, target\046Model\n\tassert(\n\t\tmodel\046Parent == target\046Root\n\t\t\tand model:GetAttribute(\"CornFarmAssetOwned\") == true\n\t\t\tand model:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\tand modelKey(model, target\046Source) == target\046AssetKey,\n\t\t\"Farm binding changed during construction\"\n\t)\n\tassert(\n\t\tpart\046Parent == model\n\t\t\tand part:GetAttribute(\"CornFarmMeshOwned\") == true\n\t\t\tand part:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\tand part:GetAttribute(\"AssetKey\") == target\046AssetKey\n\t\t\tand part:GetAttribute(\"MeshIndex\") == target\046MeshIndex,\n\t\t\"Farm mesh metadata changed during construction\"\n\t)\n\tcontentObject(part)\nend\nlocal function dispose(entry: any)\n\tif entry\046Part then\n\t\tentry\046Part:Destroy()\n\tend\n\tif entry\046Mesh then\n\t\tentry\046Mesh:Destroy()\n\tend\nend\nlocal function snapshot(part: MeshPart): any\n\tlocal values = {}\n\tfor _, property in PROPERTIES do\n\t\tvalues[property] = (part :: any)[property]\n\tend\n\tlocal clone = assert(part:Clone(), \"Owned farm mesh is not Archivable; cannot protect rollback\")\n\tclone\046Parent = nil\n\treturn { Part = part, Values = values, Clone = clone }\nend\nlocal function restoreProperties(saved: any)\n\t-- TextureContent is restored after TextureID so object-backed textures survive too\046\n\tfor _, property in PROPERTIES do\n\t\t(saved\046Part :: any)[property] = saved\046Values[property]\n\tend\nend\nfunction Runtime:Ensure(): any\n\tassert(not self\046_destroyed, \"Farm geometry runtime is destroyed\")\n\tassert(not self\046_busy, \"Farm geometry restoration is already running\")\n\tself\046_busy = true\n\tlocal generation = self\046_generation\n\tlocal created, snapshots, applied = {}, {}, {}\n\tlocal report = { targets = 0, built = 0, applied = 0, pending = 0, scope = self\046_scope }\n\tlocal ok, result = pcall(function()\n\t\tlocal targets, pending = self:_collect()\n\t\treport\046targets = #targets\n\t\treport\046pending = pending\n\t\tlocal requested = {}\n\t\tfor _, target in targets do\n\t\t\tlocal part = target\046Part\n\t\t\tlocal prior = requested[target\046Key]\n\t\t\tlocal collision, render = part\046CollisionFidelity, part\046RenderFidelity\n\t\t\tif prior then\n\t\t\t\tassert(\n\t\t\t\t\tprior\046Collision == collision and prior\046Render == render,\n\t\t\t\t\t\"One farm mesh has incompatible authored fidelity settings\"\n\t\t\t\t)\n\t\t\telse\n\t\t\t\trequested[target\046Key] = { Target = target, Collision = collision, Render = render }\n\t\t\tend\n\t\tend\n\t\tfor key, request in requested do\n\t\t\tlocal target = request\046Target\n\t\t\tlocal cached = self\046_cache[key]\n\t\t\tif cached then\n\t\t\t\tassert(\n\t\t\t\t\tcached\046Collision == request\046Collision and cached\046Render == request\046Render,\n\t\t\t\t\t\"Authored fidelity changed; preserving manual settings\"\n\t\t\t\t)\n\t\t\telse\n\t\t\t\tvalidate(Catalog[target\046AssetKey]\046meshes[target\046MeshIndex])\n\t\t\tend\n\t\tend\n\t\tlocal service = game:GetService(\"AssetService\")\n\t\tfor key, request in requested do\n\t\t\tif self\046_cache[key] then\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tassert(\n\t\t\t\tnot self\046_destroyed and self\046_generation == generation,\n\t\t\t\t\"Farm restoration cancelled\"\n\t\t\t)\n\t\t\tlocal data = Catalog[request\046Target\046AssetKey]\046meshes[request\046Target\046MeshIndex]\n\t\t\tlocal mesh, center, bounds = rawBuild(data, 500)\n\t\t\tlocal entry = {\n\t\t\t\tMesh = mesh,\n\t\t\t\tCenter = center,\n\t\t\t\tBounds = bounds,\n\t\t\t\tCollision = request\046Collision,\n\t\t\t\tRender = request\046Render,\n\t\t\t}\n\t\t\tcreated[key] = entry\n\t\t\tif self\046_scope == \"client\" then\n\t\t\t\tlocal fixed = assert(\n\t\t\t\t\tservice:CreateEditableMeshAsync(Content\046fromObject(mesh), { FixedSize = true }),\n\t\t\t\t\t\"Fixed-size farm EditableMesh memory budget unavailable\"\n\t\t\t\t)\n\t\t\t\tentry\046Mesh = fixed\n\t\t\t\tmesh:Destroy()\n\t\t\t\tmesh = fixed\n\t\t\t\tassert(fixed\046FixedSize, \"Client farm cache requires fixed-size geometry\")\n\t\t\t\tassert(\n\t\t\t\t\tnot self\046_destroyed and self\046_generation == generation,\n\t\t\t\t\t\"Farm restoration cancelled\"\n\t\t\t\t)\n\t\t\tend\n\t\t\tentry\046Part = assert(\n\t\t\t\tservice:CreateMeshPartAsync(\n\t\t\t\t\tContent\046fromObject(mesh),\n\t\t\t\t\t{ CollisionFidelity = request\046Collision, RenderFidelity = request\046Render }\n\t\t\t\t),\n\t\t\t\t\"Canonical farm MeshPart unavailable\"\n\t\t\t)\n\t\t\tentry\046Part\046Parent = nil\n\t\t\treport\046built += 1\n\t\tend\n\t\tassert(not self\046_destroyed and self\046_generation == generation, \"Farm restoration cancelled\")\n\t\tfor _, target in targets do\n\t\t\tself:_validateTarget(target)\n\t\t\tlocal entry = self\046_cache[target\046Key] or created[target\046Key]\n\t\t\tassert(\n\t\t\t\ttarget\046Part\046CollisionFidelity == entry\046Collision\n\t\t\t\t\tand target\046Part\046RenderFidelity == entry\046Render,\n\t\t\t\t\"Fidelity changed during construction\"\n\t\t\t)\n\t\t\tassert(\n\t\t\t\ttarget\046Part\046FluidFidelity == entry\046Part\046FluidFidelity,\n\t\t\t\t\"Unsupported authored fluid fidelity was preserved\"\n\t\t\t)\n\t\t\tif contentObject(target\046Part) ~= entry\046Mesh then\n\t\t\t\tlocal saved = snapshot(target\046Part)\n\t\t\t\tsaved\046Entry = entry\n\t\t\t\ttable\046insert(snapshots, saved)\n\t\t\tend\n\t\tend\n\t\tfor _, saved in snapshots do\n\t\t\ttable\046insert(applied, saved)\n\t\t\tsaved\046Part:ApplyMesh(saved\046Entry\046Part)\n\t\t\trestoreProperties(saved)\n\t\t\tassert(\n\t\t\t\tcontentObject(saved\046Part) == saved\046Entry\046Mesh,\n\t\t\t\t\"EditableMesh application did not produce current local Object content\"\n\t\t\t)\n\t\t\treport\046applied += 1\n\t\tend\n\t\tfor key, entry in created do\n\t\t\tself\046_cache[key] = entry\n\t\tend\n\t\tfor _, saved in snapshots do\n\t\t\tsaved\046Clone:Destroy()\n\t\tend\n\t\treturn report\n\tend)\n\tself\046_busy = false\n\tif not ok then\n\t\tlocal rollbackErrors = {}\n\t\tfor index = #applied, 1, -1 do\n\t\t\tlocal saved = applied[index]\n\t\t\tlocal restored, problem = pcall(function()\n\t\t\t\tsaved\046Part:ApplyMesh(saved\046Clone)\n\t\t\t\trestoreProperties(saved)\n\t\t\tend)\n\t\t\tif not restored then\n\t\t\t\ttable\046insert(rollbackErrors, tostring(problem))\n\t\t\tend\n\t\tend\n\t\tfor _, saved in snapshots do\n\t\t\tsaved\046Clone:Destroy()\n\t\tend\n\t\tfor _, entry in created do\n\t\t\tdispose(entry)\n\t\tend\n\t\terror(\n\t\t\t\"Farm geometry restoration failed; preserved authored placement: \"\n\t\t\t\t\046\046 tostring(result)\n\t\t\t\t\046\046 (\n\t\t\t\t\tif #rollbackErrors > 0\n\t\t\t\t\t\tthen \"; rollback errors: \" \046\046 table\046concat(rollbackErrors, \"; \")\n\t\t\t\t\t\telse \"\"\n\t\t\t\t)\n\t\t)\n\tend\n\tself\046_lastReport = result\n\treturn result\nend\nfunction Runtime:Destroy()\n\tself\046_destroyed = true\n\tself\046_generation += 1\n\tfor _, entry in self\046_cache do\n\t\tdispose(entry)\n\tend\n\tself\046_cache = {}\nend\nlocal function newRuntime(scope: string): any\n\tassert(scope == \"server\" or scope == \"client\", \"Farm runtime peer scope required\")\n\treturn setmetatable(\n\t\t{ _scope = scope, _cache = {}, _busy = false, _destroyed = false, _generation = 0 },\n\t\tRuntime\n\t)\nend\nreturn setmetatable({\n\tBuild = build,\n\tValidate = validate,\n\tnewRuntime = newRuntime,\n\tAssetKeyForName = assetKeyForName,\n}, {\n\t__call = function(_, data, batchSize)\n\t\treturn build(data, batchSize)\n\tend,\n})\n"},
