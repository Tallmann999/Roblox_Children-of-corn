46_gesture\n\t\t\tand os\046clock() >= self\046_gesture\046deadline\n\t\tthen\n\t\t\tself:_cancelGesture()\n\t\t\tself:_step(os\046clock())\n\t\tend\n\tend)\nend\n\nfunction Controller:SetSnapshot(snapshot: any)\n\tif\n\t\ttype(snapshot) ~= \"table\"\n\t\tor type(snapshot\046minimap) ~= \"table\"\n\t\tor not Inventory\046IsValidSnapshot(snapshot\046inventory)\n\tthen\n\t\tself:Clear(\"malformed\")\n\t\treturn\n\tend\n\tlocal roundId = snapshot\046minimap\046round_id\n\tlocal use = snapshot\046inventory\046use\n\tif\n\t\ttype(roundId) ~= \"number\"\n\t\tor roundId % 1 ~= 0\n\t\tor roundId < self\046_roundId\n\t\tor type(use) ~= \"table\"\n\t\tor type(use\046id) ~= \"number\"\n\t\tor use\046id % 1 ~= 0\n\t\tor use\046id < 0\n\t\tor use\046id == math\046huge\n\tthen\n\t\treturn\n\tend\n\tif\n\t\troundId == self\046_roundId\n\t\tand snapshot\046phase == \"active\"\n\t\tand (use\046id < self\046_useId or self\046_endedRound == roundId)\n\tthen\n\t\treturn\n\tend\n\tlocal first = roundId ~= self\046_roundId\n\tlocal previous = self\046_snapshot\n\tif first then\n\t\tself:_cancelGesture()\n\t\tself:_clearVisual()\n\t\tself\046_roundId, self\046_useId = roundId, use\046id\n\t\tself\046_endedRound = nil\n\tend\n\tself\046_snapshot = snapshot\n\tif\n\t\tsnapshot\046phase == \"escaped\"\n\t\tor snapshot\046phase == \"aborted\"\n\t\tor snapshot\046phase == \"caught_out\"\n\tthen\n\t\tself\046_endedRound = roundId\n\tend\n\tlocal selected = snapshot\046inventory\046selected\n\tif\n\t\tself\046_gesture\n\t\tand previous\n\t\tand (\n\t\t\tprevious\046inventory\046selected ~= selected\n\t\t\tor (\n\t\t\t\tprevious\046inventory\046slots[selected] ~= snapshot\046inventory\046slots[selected]\n\t\t\t\tand snapshot\046inventory\046slots[selected] ~= \"empty\"\n\t\t\t)\n\t\t)\n\tthen\n\t\tself:_cancelGesture()\n\tend\n\tif not first and use\046id > self\046_useId then\n\t\tself\046_useId = use\046id\n\t\tlocal camera = workspace\046CurrentCamera\n\t\tlocal _, humanoid = self:_livingCharacter()\n\t\tif (use\046kind == \"energy\" or use\046kind == \"trap\") and self:_canShow(camera, humanoid) then\n\t\t\tself:_beginGesture(use\046kind, selected, os\046clock())\n\t\tend\n\tend\n\tself:_step(os\046clock())\nend\n\nfunction Controller:Start(context: any)\n\tself\046_minimap = context\046Controllers\046MinimapController\n\tself\046_capture = context\046Controllers\046CaptureController\n\tRunService:BindToRenderStep(BINDING, Enum\046RenderPriority\046Camera\046Value + 2, function()\n\t\tself:_step(os\046clock())\n\tend)\n\tself\046_bound = true\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tGuiService\046MenuOpened:Connect(function()\n\t\t\tself:_cancelGesture()\n\t\t\tself:_clearVisual()\n\t\tend)\n\t)\n\tfor _, signal in { player\046CharacterAdded, player\046CharacterRemoving } do\n\t\ttable\046insert(\n\t\t\tself\046_connections,\n\t\t\tsignal:Connect(function()\n\t\t\t\tself:Clear(\"character changed\")\n\t\t\tend)\n\t\t)\n\tend\nend\n\nfunction Controller:Destroy()\n\tself:Clear(\"destroy\")\n\tif self\046_bound then\n\t\tRunService:UnbindFromRenderStep(BINDING)\n\t\tself\046_bound = false\n\tend\n\tfor _, connection in self\046_connections do\n\t\tconnection:Disconnect()\n\tend\n\ttable\046clear(self\046_connections)\n\tself\046_minimap, self\046_capture = nil, nil\nend\n\nreturn Controller\n"},
