046BackgroundColor3 = PAINT_COLORS[definition\046color]\n\t\tdrop\046BackgroundTransparency = 1\n\t\tdrop\046BorderSizePixel = 0\n\t\tdrop\046Active = false\n\t\tdrop\046Selectable = false\n\t\tdrop\046Parent = gui\n\t\tlocal corner = Instance\046new(\"UICorner\")\n\t\tannotatePaint(corner)\n\t\tcorner\046CornerRadius = UDim\046new(1, 0)\n\t\tcorner\046Parent = drop\n\t\ttable\046insert(drops, drop)\n\tend\n\tself\046_paint, self\046_paintDrops = gui, drops\n\tgui\046Parent = playerGui\nend\n\nfunction Controller:_clearPaint()\n\tlocal gui = self\046_paint\n\tself\046_paint, self\046_paintDrops = nil, {}\n\tif not gui then\n\t\treturn\n\tend\n\tif not paintOwned(gui) then\n\t\twarn(\"[CaptureController] Changed paint overlay preserved during cleanup\")\n\t\treturn\n\tend\n\t-- A foreign insertion must survive even when its temporary owned parent ends\046\n\tfor _, item in gui:GetDescendants() do\n\t\tif not paintOwned(item) and item\046Parent and paintOwned(item\046Parent) then\n\t\t\titem\046Parent = gui\046Parent\n\t\tend\n\tend\n\tgui:Destroy()\nend\n\nfunction Controller:_restoreCamera()\n\tlocal saved = self\046_saved\n\tself\046_saved = nil\n\tif not saved or saved\046camera:GetAttribute(CAMERA_OWNER) ~= self\046_token then\n\t\treturn\n\tend\n\tlocal camera = saved\046camera\n\tif camera\046CameraType ~= Enum\046CameraType\046Scriptable then\n\t\t-- Another camera controller changed the type without our token handshake\046\n\t\tcamera:SetAttribute(CAMERA_OWNER, nil)\n\t\treturn\n\tend\n\tlocal character, humanoid, root = self:_livingCharacter()\n\tcamera\046FieldOfView = saved\046fieldOfView\n\tcamera\046CameraSubject = if character ~= saved\046character and humanoid\n\t\tthen humanoid\n\t\telse saved\046subject\n\tif\n\t\troot\n\t\tand self\046_snapshot\n\t\tand (self\046_snapshot\046phase == \"active\" or self\046_snapshot\046phase == \"caught\")\n\tthen\n\t\tlocal direction = self\046_snapshot\046start_look\n\t\tif typeof(direction) ~= \"Vector3\" or direc