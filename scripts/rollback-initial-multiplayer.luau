== \"caught\" then\n\t\tstop(self\046wakeSound)\n\t\tself\046wakeUntil = 0\n\telseif\n\t\tnot self\046wakePlayed\n\t\tand self\046wakeObservedDormant\n\t\tand primary\n\t\tand not primary\046destroyed\n\t\tand primary\046state ~= \"dormant\"\n\t\tand primary\046state ~= \"stopped\"\n\tthen\n\t\tself\046wakePlayed = true\n\t\tself\046wakeUntil = now\n\t\t\t+ math\046max(Assets\046Get(\"COC_Monster_03\")\046Duration, self\046wakeSound\046TimeLength)\n\t\tfor _, sound in self\046voices do\n\t\t\tstop(sound)\n\t\tend\n\t\trequest(self\046wakeSound, true)\n\telseif self\046wakePlayed and now >= self\046wakeUntil then\n\t\tstop(self\046wakeSound)\n\tend\n\tfor _, entry in self\046crickets do\n\t\tself:_stepCricket(entry, now)\n\tend\n\tfor _, sound in self\046fires do\n\t\trequest(sound, mode == \"medium\" or mode == \"hard\")\n\tend\n\tlocal lead = self\046leadHunt\n\tlocal chasing = phase == \"active\" and lead and not lead\046destroyed and lead\046state == \"chase\"\n\tif not chasing then\n\t\tfor _, sound in self\046voices do\n\t\t\tstop(sound)\n\t\tend\n\telseif not self\046chasing then\n\t\tself\046voiceAt = now + Rules\046FirstVoiceDelay\n\t\tself\046voiceUntil = now\n\tend\n\tself\046chasing = chasing == true\n\tif now < self\046pollAt then\n\t\treturn\n\tend\n\tself\046pollAt = now + 0\0461\n\tif self\046chasing then\n\t\tself:_voice(now)\n\tend\n\tfor _, actor in self\046npcActors do\n\t\tlocal source = actor\046hunt\n\t\tlocal floor = self\046world\046Ground\046Position\046Y + self\046world\046Ground\046Size\046Y / 2\n\t\tself:_stepActor(\n\t\t\tactor,\n\t\t\tnow,\n\t\t\tphase == \"active\"\n\t\t\t\tand source\n\t\t\t\tand (source\046state == \"patrol\" or source\046state == \"chase\")\n\t\t\t\tand math\046abs(actor\046root\046Position\046Y - floor - 3) <= 3\n\t\t)\n\tend\n\tself:_players(now, phase)\nend\n\nfunction RoundAudio:Destroy()\n\tif self\046destroyed then\n\t\treturn\n\tend\n\tself\046destroyed = true\n\tfor index = #self\046created, 1, -1 do\n\t\tlo