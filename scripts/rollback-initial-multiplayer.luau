{path="ServerScriptService/GameServer/Game/MonsterHunt",class="ModuleScript",initial="5e82a9e50fdf6cb7b0193d370d1890287aeb18e373b5f9f0e203682af0e6c63a",baseline="f4528ca78f7c9227016a6ce0ab23fd10a8a1b699673c4744f841b4ad82a019e1",source="--!strict\nlocal PathfindingService = game:GetService(\"PathfindingService\")\nlocal Pose = require(\n\tgame:GetService(\"ReplicatedStorage\")\n\t\t:WaitForChild(\"GameShared\")\n\t\t:WaitForChild(\"Game\")\n\t\t:WaitForChild(\"MonsterPose\")\n)\nlocal MonsterHunt = {}\nMonsterHunt\046__index = MonsterHunt\n\nfunction MonsterHunt\046new(\n\tworld: any,\n\tbalance: any,\n\tstartedAt: number,\n\ttargetUserId: number?,\n\toptions: any?\n)\n\toptions = options or {}\n\tlocal index = options\046index or 1\n\tassert(index == 1 or index == 2 or index == 3, \"Unknown monster index\")\n\tlocal modelName = if index == 1 then \"Monster\" else \"Monster\" \046\046 index\n\tassert(not world\046Runtime:FindFirstChild(modelName), \"Monster name already occupied\")\n\tlocal home = world\046Home:FindFirstChild(\"Body\") :: BasePart\n\tassert(home and home:IsA(\"BasePart\"), \"Scarecrow home body missing\")\n\tlocal floor = world\046Ground\046Position\046Y + world\046Ground\046Size\046Y / 2\n\tlocal model = Instance\046new(\"Model\")\n\tmodel\046Name = modelName\n\tmodel:SetAttribute(\"CornMonsterOwned\", true)\n\tmodel:SetAttribute(\"corn_project_id\", \"children_of_corn\")\n\tmodel:SetAttribute(\"MonsterRigVersion\", 1)\n\tmodel:SetAttribute(\"MonsterIndex\", index)\n\tmodel:SetAttribute(\"HuntState\", \"dormant\")\n\tmodel:SetAttribute(\"ChaseTargetUserId\", 0)\n\tlocal at = options\046position or home\046Position\n\tassert(typeof(at) == \"Vector3\", \"Monster spawn position missing\")\n\tlocal origin = Vector3\046new(at\046X, floor + 3, at\046Z)\n\tlocal visuals = {}\n\tlocal function part(\n\t\tname: string,\n\t\tsize: Vector3,\n\t\toffset: Vector3,\n\t\tcolor: Color3,\n\t\thidden: boolean?\n\t): Part\n\t\tlocal p = Instance\046new(\"Part\")\n\t\tp\046Name = name\n\t\tp\046Size = size\n\t\tp\046CFrame = CFrame\046new(origin + offset)\n\t\tp\046Color = color\n\t\tp\046Anchored = true\n\t\tp\046CanCollide = false\n\t\tp\046CanTouch = false\n\t\tp\046CanQuery = false\n\t\tp\046Transparency = 1\n\t\tp\046Parent = model\n\t\tif not hidden then\n\t\t\ttable\046insert(visuals, p)\n\t\tend\n\t\treturn p\n\tend\n\tlocal root = part(\"Root\", Vector3\046new(3, 6, 2), Vector3\046zero, Color3\046new(), true)\n\tfor _, definition in Pose\046Parts do\n\t\tlocal visual = part(\n\t\t\tdefinition\046Name,\n\t\t\tdefinition\046Size,\n\t\t\tPose\046Rest[definition\046Name]\046Position,\n\t\t\tdefinition\046Color\n\t\t)\n\t\tvisual\046Material = definition\046Material\n\tend\n\tmodel:SetAttribute(\"MonsterHeightScale\", Pose\046HeightScale)\n\tmodel\046PrimaryPart = root\n\tmodel\046Parent = world\046Runtime\n\tlocal self = setmetatable({\n\t\tworld = world,\n\t\tbalance = balance,\n\t\tstartedAt = startedAt,\n\t\tmodel = model,\n\t\troot = root,\n\t\tvisuals = visuals,\n\t\thome = origin,\n\t\tstate = \"dormant\",\n\t\tchaseStartedAt = nil,\n\t\tfirstChaseUsed = options\046immediate == true,\n\t\tdetectRadius = balance\046monster_detect_radius,\n\t\tfirstChaseUntil = nil,\n\t\treacquireAt = -math\046huge,\n\t\ttargetUserId = if targetUserId\n\t\t\t\tand targetUserId > 0\n\t\t\t\tand targetUserId % 1 == 0\n\t\t\tthen targetUserId\n\t\t\telse 0,\n\t\tstunnedUntil = nil,\n\t\tlostSince = nil,\n\t\tlastSeenPosition = nil,\n\t\tpatrolSlot = nil,\n\t\tpatrolIndex = nil,\n\t\tgoal = nil,\n\t\troute = nil,\n\t\trouteIndex = 2,\n\t\tpathAt = -math\046huge,\n\t\tpathBusy = false,\n\t\tgeneration = 0,\n\t\tdestroyed = false,\n\t\toriginalMarker = {},\n\t\tblockedSince = nil,\n\t}, MonsterHunt)\n\tif options\046immediate then\n\t\tfor _, visual in visuals do\n\t\t\tvisual\046Transparency = 0\n\t\tend\n\t\tself:_state(\"patrol\", startedAt)\n\tend\n\treturn self\nend\n\nfunction MonsterHunt:SetDetectionMultiplier(multiplier: number)\n\tassert(multiplier == 1 or multiplier == 2, \"Invalid hunt detection multiplier\")\n\tself\046detectRadius = self\046balance\046monster_detect_radius * multiplier\n\tself\046model:SetAttribute(\"DetectionRadius\", self\046detectRadius)\nend\n\nfunction MonsterHunt:_state(state: string, now: number?)\n\tif self\046state == state then\n\t\treturn\n\tend\n\t-- A completed path belongs to the state that requested it\046 Cancel stale work\n\t-- only on transitions; visible chase polls must preserve a current path\046\n\tself\046generation += 1\n\tself\046route = nil\n\tself\046routeIndex = 2\n\tself\046pathBusy = false\n\tself\046pathAt = -math\046huge\n\tself\046state = state\n\tself\046chaseStartedAt = if state == \"chase\" then now or os\046clock() else nil\n\tif state ~= \"chase\" then\n\t\t-- Consumption belongs to the round, not a capture, trap or home reset\046\n\t\tself\046firstChaseUntil = nil\n\tend\n\tself\046model:SetAttribute(\"HuntState\", state)\n\tself\046model:SetAttribute(\"ChaseTargetUserId\", if state == \"chase\" then self\046targetUserId else 0)\nend\n\nfunction MonsterHunt:_params(character: Model?): RaycastParams\n\tlocal params = RaycastParams\046new()\n\tparams\046FilterType = Enum\046RaycastFilterType\046Exclude\n\tparams\046FilterDescendantsInstances = if character\n\t\tthen { self\046model, self\046world\046Home, character }\n\t\telse { self\046model, self\046world\046Home }\n\tparams\046RespectCanCollide = true\n\treturn params\nend\n\nfunction MonsterHunt:CanSee(playerRoot: BasePart): boolean\n\tlocal start = self\046root\046Position + Vector3\046new(0, 1, 0)\n\treturn workspace:Raycast(\n\t\tstart,\n\t\tplayerRoot\046Position - start,\n\t\tself:_params(playerRoot\046Parent :: Model)\n\t) == nil\nend\n\nfunction MonsterHunt:CanCapture(playerRoot: BasePart, now: number?): boolean\n\tlocal at = now or os\046clock()\n\tif\n\t\tself\046destroyed\n\t\tor self\046state ~= \"chase\"\n\t\tor not self\046chaseStartedAt\n\t\tor at - self\046chaseStartedAt < self\046balance\046monster_chase_windup_sec\n\t\tor (self\046firstChaseUntil and at >= self\046firstChaseUntil)\n\tthen\n\t\treturn false\n\tend\n\tlocal delta = playerRoot\046Position - self\046root\046Position\n\tif\n\t\tVector3\046new(delta\046X, 0, delta\046Z)\046Magnitude > self\046balance\046monster_capture_radius\n\t\tor math\046abs(delta\046Y) > 7\n\tthen\n\t\treturn false\n\tend\n\treturn self:CanSee(playerRoot)\nend\n\nfunction MonsterHunt:_chaseSpeed(playerRoot: BasePart, now: number): number\n\tif self\046firstChaseUntil then\n\t\tlocal character = playerRoot\046Parent\n\t\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\t\tlocal speed = if humanoid then humanoid\046WalkSpeed else nil\n\t\t-- SoloRound writes this server value before Step\046 Never accept a client\n\t\t-- speed argument; invalid values fall back to normal walking\046 Energy's\n\t\t-- existing multiplier is two, including sprint+energy (18*2 = 36)\046\n\t\tlocal maxSpeed = math\046max(self\046balance\046walk_speed, self\046balance\046sprint_speed) * 2\n\t\treturn if typeof(speed) == \"number\"\n\t\t\t\tand speed == speed\n\t\t\t\tand speed > 0\n\t\t\t\tand speed < math\046huge\n\t\t\tthen math\046min(speed, maxSpeed)\n\t\t\telse self\046balance\046walk_speed\n\tend\n\treturn if self\046chaseStartedAt\n\t\t\tand now - self\046chaseStartedAt >= self\046balance\046monster_chase_windup_sec\n\t\tthen self\046balance\046monster_chase_speed\n\t\telse self\046balance\046monster_patrol_speed\nend\n\nfunction MonsterHunt:BeginCapture(playerPosition: Vector3): CFrame\n\tlocal at = self\046root\046Position\n\tlocal facing = Vector3\046new(playerPosition\046X - at\046X, 0, playerPosition\046Z - at\046Z)\n\tif facing\046Magnitude > 0\046001 then\n\t\tself\046model:PivotTo(CFrame\046lookAt(at, at + facing))\n\tend\n\tself\046goal = nil\n\tself\046lostSince = nil\n\tself\046lastSeenPosition = nil\n\tself:_state(\"capturing\")\n\treturn self\046root\046CFrame\nend\n\nfunction MonsterHunt:GetPosition(): Vector3?\n\tif self\046destroyed or self\046state == \"dormant\" or self\046state == \"stopped\" then\n\t\treturn nil\n\tend\n\treturn self\046root\046Position\nend\n\nfunction MonsterHunt:Stun(now: number, duration: number): boolean\n\tif\n\t\tself\046destroyed\n\t\tor (self\046state ~= \"patrol\" and self\046state ~= \"chase\")\n\t\tor typeof(now) ~= \"number\"\n\t\tor typeof(duration) ~= \"number\"\n\t\tor now ~= now\n\t\tor duration ~= duration\n\t\tor math\046abs(now) == math\046huge\n\t\tor duration <= 0\n\t\tor duration == math\046huge\n\t\tor math\046abs(now + duration) == math\046huge\n\tthen\n\t\treturn false\n\tend\n\tself\046stunnedUntil = now + duration\n\tself\046goal = nil\n\tself\046lostSince = nil\n\tself\046lastSeenPosition = nil\n\tself\046blockedSince = nil\n\t-- _state invalidates pending ComputeAsync jobs before they can restore a\n\t-- route for the chase that stepped into the trap\046\n\tself:_state(\"trapped\")\n\treturn true\nend\n\nfunction MonsterHunt:_patrol(_playerPosition: Vector3): Vector3\n\tlocal slots = self\046world\046Slots\n\tlocal index = self\046patrolIndex\n\tif index then\n\t\tindex = (index - 1 + 7) % #slots + 1\n\telse\n\t\tlocal distance = math\046huge\n\t\tfor candidateIndex, slot in slots do\n\t\t\tlocal d = (slot\046Position - self\046root\046Position)\046Magnitude\n\t\t\tif d < distance then\n\t\t\t\tindex = candidateIndex\n\t\t\t\tdistance = d\n\t\t\tend\n\t\tend\n\tend\n\t-- AuthoredWorld sorts the fifteen available slots by their unique slot_id\046\n\t-- A stride of seven visits every slot once without using the player's position\046\n\tself\046patrolIndex = index or 1\n\tself\046patrolSlot = slots[self\046patrolIndex]\n\treturn self\046patrolSlot\046Position\nend\n\nfunction MonsterHunt:_path(goal: Vector3, now: number)\n\tif self\046pathBusy or now - self\046pathAt < 1 then\n\t\treturn\n\tend\n\tself\046pathBusy = true\n\tself\046pathAt = now\n\tlocal generation = self\046generation\n\tlocal began = self\046root\046Position\n\ttask\046spawn(function()\n\t\tlocal path = PathfindingService:CreatePath({\n\t\t\tAgentRadius = 2,\n\t\t\tAgentHeight = 9,\n\t\t\tAgentCanJump = false,\n\t\t\tWaypointSpacing = 4,\n\t\t})\n\t\tlocal ok = pcall(function()\n\t\t\tpath:ComputeAsync(began, goal)\n\t\tend)\n\t\tif self\046destroyed or self\046generation ~= generation then\n\t\t\treturn\n\t\tend\n\t\tself\046pathBusy = false\n\t\tif ok and path\046Status == Enum\046PathStatus\046Success then\n\t\t\tself\046route = path:GetWaypoints()\n\t\t\tself\046routeIndex = 2\n\t\telse\n\t\t\tself\046route = nil\n\t\tend\n\tend)\nend\n\nfunction MonsterHunt:ResetHome()\n\tself\046stunnedUntil = nil\n\tself\046generation += 1\n\tself\046pathBusy = false\n\tself\046route = nil\n\tself\046goal = nil\n\tself\046lostSince = nil\n\tself\046lastSeenPosition = nil\n\tself\046patrolSlot = nil\n\tself\046patrolIndex = nil\n\tself\046blockedSince = nil\n\tself\046model:PivotTo(CFrame\046new(self\046home))\n\tself:_state(\"patrol\")\nend\n\nfunction MonsterHunt:Step(\n\tdt: number,\n\tnow: number,\n\tplayerRoot: BasePart,\n\tprotected: boolean\n): (boolean, boolean)\n\tif self\046destroyed or self\046state == \"capturing\" then\n\t\treturn false, false\n\tend\n\tif self\046state == \"trapped\" then\n\t\tif now < self\046stunnedUntil then\n\t\t\treturn false, false\n\t\tend\n\t\tself\046stunnedUntil = nil\n\t\tself:_state(\"patrol\")\n\tend\n\tlocal awakened = false\n\tif self\046state == \"dormant\" then\n\t\tif now - self\046startedAt < self\046balance\046hunt_start_delay_sec then\n\t\t\treturn false, false\n\t\tend\n\t\tfor _, p in self\046visuals do\n\t\t\tp\046Transparency = 0\n\t\tend\n\t\tfor _, item in self\046world\046Home:GetDescendants() do\n\t\t\tif item:IsA(\"BasePart\") and item\046Name ~= \"Pole\" then\n\t\t\t\tself\046originalMarker[item] = item\046Transparency\n\t\t\t\titem\046Transparency = 1\n\t\t\tend\n\t\tend\n\t\tself:_state(\"patrol\")\n\t\tawakened = true\n\tend\n\tlocal delta = playerRoot\046Position - self\046root\046Position\n\tlocal distance = Vector3\046new(delta\046X, 0, delta\046Z)\046Magnitude\n\tlocal canSee = not protected and self:CanSee(playerRoot)\n\tif self\046state == \"chase\" and self\046firstChaseUntil and now >= self\046firstChaseUntil then\n\t\t-- The timed loss wins over capture even if the target is still visible\n\t\t-- and close\046 Transition cancels the old asynchronous route by epoch\046\n\t\tself\046reacquireAt = now + self\046balance\046monster_first_chase_reacquire_sec\n\t\tself:_state(\"patrol\")\n\t\tself\046goal = nil\n\t\tself\046lostSince = nil\n\t\tself\046lastSeenPosition = nil\n\t\tself\046blockedSince = nil\n\tend\n\tif\n\t\tcanSee\n\t\tand distance <= (self\046detectRadius or self\046balance\046monster_detect_radius)\n\t\tand now >= self\046reacquireAt\n\tthen\n\t\tlocal newlyDetected = self\046state ~= \"chase\"\n\t\tself:_state(\"chase\", now)\n\t\tif newlyDetected then\n\t\t\tif not self\046firstChaseUsed then\n\t\t\t\tself\046firstChaseUntil = now + self\046balance\046monster_first_chase_duration_sec\n\t\t\tend\n\t\t\tself\046firstChaseUsed = true\n\t\tend\n\t\tself\046lostSince = nil\n\t\tself\046lastSeenPosition = playerRoot\046Position\n\tend\n\tif self\046state == \"chase\" then\n\t\tif protected then\n\t\t\tself:_state(\"patrol\")\n\t\t\tself\046goal = nil\n\t\t\tself\046lostSince = nil\n\t\t\tself\046lastSeenPosition = nil\n\t\telse\n\t\t\tif canSee then\n\t\t\t\tself\046lastSeenPosition = playerRoot\046Position\n\t\t\tend\n\t\t\tif distance > self\046balance\046monster_lose_radius or not canSee then\n\t\t\t\tself\046lostSince = self\046lostSince or now\n\t\t\t\tif now - self\046lostSince >= self\046balance\046monster_lose_delay_sec then\n\t\t\t\t\tself:_state(\"patrol\")\n\t\t\t\t\tself\046goal = nil\n\t\t\t\t\tself\046lostSince = nil\n\t\t\t\t\tself\046lastSeenPosition = nil\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tself\046lostSince = nil\n\t\t\tend\n\t\tend\n\tend\n\tif not protected and self:CanCapture(playerRoot, now) then\n\t\treturn true, awakened\n\tend\n\tif self\046state == \"chase\" then\n\t\tself\046goal = self\046lastSeenPosition or self\046root\046Position\n\telseif\n\t\tnot self\046goal\n\t\tor (Vector3\046new(self\046goal\046X, self\046root\046Position\046Y, self\046goal\046Z) - self\046root\046Position)\046Magnitude\n\t\t\t< 3\n\tthen\n\t\tself\046goal = self:_patrol(playerRoot\046Position)\n\tend\n\tlocal goal = Vector3\046new(self\046goal\046X, self\046home\046Y, self\046goal\046Z)\n\tlocal params = self:_params(playerRoot\046Parent :: Model)\n\tlocal direct = goal - self\046root\046Position\n\tlocal obstructed = workspace:Blockcast(\n\t\tself\046root\046CFrame + Vector3\046new(0, 0\0463, 0),\n\t\tVector3\046new(3, 5\0464, 2),\n\t\tdirect,\n\t\tparams\n\t) ~= nil\n\tlocal target = goal\n\tif obstructed then\n\t\tself:_path(goal, now)\n\t\tlocal route = self\046route\n\t\tif route then\n\t\t\twhile self\046routeIndex <= #route do\n\t\t\t\tlocal waypoint = Vector3\046new(\n\t\t\t\t\troute[self\046routeIndex]\046Position\046X,\n\t\t\t\t\tself\046home\046Y,\n\t\t\t\t\troute[self\046routeIndex]\046Position\046Z\n\t\t\t\t)\n\t\t\t\tif (waypoint - self\046root\046Position)\046Magnitude > 1 then\n\t\t\t\t\ttarget = waypoint\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\t\tself\046routeIndex += 1\n\t\t\tend\n\t\tend\n\tend\n\tlocal direction = target - self\046root\046Position\n\tlocal speed = if self\046state == \"chase\"\n\t\tthen self:_chaseSpeed(playerRoot, now)\n\t\telse self\046balance\046monster_patrol_speed\n\tif direction\046Magnitude > 0\04605 then\n\t\tlocal step = direction\046Unit * math\046min(direction\046Magnitude, speed * math\046clamp(dt, 0, 0\04625))\n\t\tlocal hit = workspace:Blockcast(\n\t\t\tself\046root\046CFrame + Vector3\046new(0, 0\0463, 0),\n\t\t\tVector3\046new(3, 5\0464, 2),\n\t\t\tstep,\n\t\t\tparams\n\t\t)\n\t\tif not hit then\n\t\t\tlocal position = self\046root\046Position + step\n\t\t\tself\046model:PivotTo(CFrame\046lookAt(position, position + direction))\n\t\t\tself\046blockedSince = nil\n\t\telse\n\t\t\tself\046blockedSince = self\046blockedSince or now\n\t\t\tif self\046state == \"patrol\" and now - self\046blockedSince > 2 then\n\t\t\t\tself\046goal = nil\n\t\t\t\tself\046route = nil\n\t\t\t\tself\046blockedSince = nil\n\t\t\tend\n\t\tend\n\tend\n\tself\046model:SetAttribute(\"TargetDistance\", distance)\n\treturn not protected and self:CanCapture(playerRoot, now), awakened\nend\n\nfunction MonsterHunt:Destroy()\n\tself\046destroyed = true\n\tself\046stunnedUntil = nil\n\tself\046generation += 1\n\tfor p, transparency in self\046originalMarker do\n\t\tif p\046Parent then\n\t\t\tp\046Transparency = transparency\n\t\tend\n\tend\n\tself\046model:Destroy()\n\tself\046state = \"stopped\"\nend\n\nreturn MonsterHunt\n"},
{path="ServerScriptService/GameServer/Game/RoundAudio",class="ModuleScript",initial="0e56f5f20f869d539920f8e8e4e336d4ba5c91a25f36c6d8ace7bd4197bce4eb",baseline="81804da1512f3e5419e87cc9a7b86f94803a73226e0bac1c43fe97eb49462b74",source="--!strict\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal SoundService = game:GetService(\"SoundService\")\nlocal HttpService = game:GetService(\"HttpService\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\")\nlocal Assets = require(Shared:WaitForChild(\"AudioAssets\"))\nlocal Rules = require(Shared:WaitForChild(\"AudioRules\"))\nlocal Layout = require(Shared:WaitForChild(\"CornLayout\"))\n\nlocal RoundAudio = {}\nRoundAudio\046__index = RoundAudio\n\nlocal PROJECT = \"children_of_corn\"\nlocal LOOP_KEY = \"COC_Corn_Continuous_02\"\nlocal VOICE_KEYS = Rules\046VoiceKeys\n\nlocal function finite(value: number): boolean\n\treturn value == value and value > -math\046huge and value < math\046huge\nend\n\nlocal function owned(item: Instance): boolean\n\treturn item:GetAttribute(\"CornAudioOwned\") == true\n\t\tand item:GetAttribute(\"corn_project_id\") == PROJECT\nend\n\nlocal function annotate(item: Instance, role: string)\n\titem:SetAttribute(\"CornAudioOwned\", true)\n\titem:SetAttribute(\"corn_project_id\", PROJECT)\n\titem:SetAttribute(\"audio_role\", role)\nend\n\nlocal function stop(sound: Sound)\n\tif sound:GetAttribute(\"AudioRequestedPlaying\") ~= false then\n\t\tsound:SetAttribute(\"AudioRequestedPlaying\", false)\n\t\tsound:Stop()\n\tend\nend\n\nlocal function request(sound: Sound, playing: boolean)\n\tif not playing then\n\t\tstop(sound)\n\telseif sound:GetAttribute(\"AudioRequestedPlaying\") ~= true then\n\t\tsound:SetAttribute(\"AudioRequestedPlaying\", true)\n\t\t-- An empty ID is configuration awaiting import, not loaded audio\046\n\t\tif sound\046SoundId ~= \"\" then\n\t\t\tsound:Play()\n\t\tend\n\tend\nend\n\n-- Preserve an inserted foreign child even when its owned parent is removed\046\nlocal function destroyOwned(item: Instance)\n\tif not owned(item) then\n\t\treturn\n\tend\n\tlocal safeParent = item\046Parent\n\twhile safeParent and owned(safeParent) do\n\t\tsafeParent = safeParent\046Parent\n\tend\n\tlocal descendants = item:GetDescendants()\n\tfor _, child in descendants do\n\t\tif not owned(child) and child\046Parent and owned(child\046Parent) then\n\t\t\tchild\046Parent = safeParent\n\t\tend\n\tend\n\titem:Destroy()\nend\n\nfunction RoundAudio:_remember(item: Instance, role: string)\n\tannotate(item, role)\n\ttable\046insert(self\046created, item)\n\treturn item\nend\n\nfunction RoundAudio:_remove(item: Instance)\n\tif item:IsA(\"Sound\") then\n\t\tstop(item)\n\tend\n\tdestroyOwned(item)\n\tlocal index = table\046find(self\046created, item)\n\tif index then\n\t\ttable\046remove(self\046created, index)\n\tend\nend\n\nfunction RoundAudio:_sound(\n\tparent: Instance,\n\tkey: string,\n\trole: string,\n\tvolume: number,\n\tcategory: string,\n\trange: any,\n\tlooped: boolean\n): Sound\n\tlocal definition = Assets\046Get(key)\n\tlocal sound = Instance\046new(\"Sound\")\n\tsound\046Name = \"CornAudio_\" \046\046 role\n\tself:_remember(sound, role)\n\tsound:SetAttribute(\"AudioAssetKey\", key)\n\tsound:SetAttribute(\"AudioRequestedPlaying\", false)\n\tsound\046SoundId = definition\046Id\n\tsound\046Volume = math\046clamp(volume * definition\046Gain, 0, 1)\n\tsound\046Looped = looped\n\tsound\046RollOffMode = Enum\046RollOffMode\046InverseTapered\n\tsound\046RollOffMinDistance = range\046Min\n\tsound\046RollOffMaxDistance = range\046Max\n\tsound\046SoundGroup = self\046groups[category]\n\tsound\046Parent = parent\n\treturn sound\nend\n\nfunction RoundAudio:_stepCricket(entry: any, now: number)\n\tlocal sound = entry\046sound\n\tlocal elapsed = now - self\046startedAt - entry\046offset\n\tlocal inSlot = Rules\046CricketIsOn(now, self\046startedAt, entry\046offset)\n\tif sound:GetAttribute(\"AudioRequestedPlaying\") ~= inSlot then\n\t\tsound:SetAttribute(\"AudioRequestedPlaying\", inSlot)\n\tend\n\tif elapsed < 0 then\n\t\tsound\046Volume = 0\n\t\treturn\n\tend\n\tlocal cycle = math\046floor(elapsed / Rules\046Cycle)\n\tlocal slotAt = self\046startedAt + entry\046offset + cycle * Rules\046Cycle\n\tif cycle ~= entry\046cycle then\n\t\t-- A stalled/unavailable request stayed silent\046 Cancel only that\n\t\t-- never-decoded attempt before considering a later scheduled slot\046\n\t\tif entry\046requestedAt and not entry\046playBeganAt and not entry\046abandoned then\n\t\t\tif not sound\046IsLoaded and sound\046TimePosition == 0 then\n\t\t\t\tsound:Stop()\n\t\t\tend\n\t\tend\n\t\tentry\046cycle = cycle\n\t\tentry\046requestedAt, entry\046playBeganAt = nil, nil\n\t\tentry\046abandoned = false\n\t\t-- One attempt per slot; no replay of missed slots after a stall\046\n\t\tif\n\t\t\tinSlot\n\t\t\tand now - slotAt <= Rules\046CricketStartWindow\n\t\t\tand sound\046SoundId ~= \"\"\n\t\t\tand not sound\046IsPlaying\n\t\tthen\n\t\t\tsound\046Volume = 0\n\t\t\tsound\046TimePosition = 0\n\t\t\tentry\046requestedAt = now\n\t\t\tentry\046startDeadline = slotAt + Rules\046CricketStartWindow\n\t\t\tsound:Play()\n\t\tend\n\tend\n\tif entry\046requestedAt and not entry\046playBeganAt and not entry\046abandoned then\n\t\tlocal progressed = finite(sound\046TimePosition) and sound\046TimePosition > 0\n\t\tif now <= entry\046startDeadline and ((sound\046IsLoaded and sound\046IsPlaying) or progressed) then\n\t\t\t-- Fade from the first observed decode/playback, never jump to the\n\t\t\t-- historical gain of a partially elapsed slot after cold loading\046\n\t\t\tentry\046playBeganAt = now\n\t\telseif now >= entry\046startDeadline then\n\t\t\tentry\046abandoned = true\n\t\t\tif not sound\046IsLoaded and not progressed then\n\t\t\t\tsound:Stop()\n\t\t\tend\n\t\tend\n\tend\n\tlocal alpha = 0\n\tif inSlot and entry\046playBeganAt and not entry\046abandoned and sound\046IsPlaying then\n\t\tlocal played = math\046max(0, now - entry\046playBeganAt)\n\t\tlocal length = entry\046duration\n\t\tif finite(sound\046TimeLength) and sound\046TimeLength > 0 then\n\t\t\tlength = math\046min(length, sound\046TimeLength)\n\t\tend\n\t\tlocal progress = if finite(sound\046TimePosition)\n\t\t\tthen math\046max(played, sound\046TimePosition)\n\t\t\telse played\n\t\talpha = Rules\046CricketEnvelope(played, slotAt + Rules\046CricketOn - now, length - progress)\n\tend\n\t-- Normal off is silence followed by natural Ended, never a timer Stop\046\n\tsound\046Volume = entry\046gain * alpha\nend\n\nfunction RoundAudio\046new(world: any, ownerPlayer: Player, hunt: any, random: Random?)\n\tassert(world\046Root and world\046Root:IsA(\"Model\"), \"Round audio requires a bound map\")\n\tassert(world\046Field and world\046Field:IsA(\"BasePart\"), \"Round audio requires Field\")\n\tassert(world\046Runtime and world\046Ground, \"Round audio requires runtime and Ground\")\n\tlocal self = setmetatable({\n\t\tworld = world,\n\t\townerPlayer = ownerPlayer,\n\t\trandom = random or Random\046new(),\n\t\tcreated = {} :: { Instance },\n\t\tgroups = {} :: { [string]: SoundGroup },\n\t\tcrickets = {},\n\t\tfires = {} :: { Sound },\n\t\tactors = {} :: { [Player]: any },\n\t\tnpc = nil :: any,\n\t\tnpcActors = {} :: { [BasePart]: any },\n\t\tprimaryHunt = nil :: any,\n\t\tleadHunt = nil :: any,\n\t\tvoiceRoot = nil :: BasePart?,\n\t\tvoices = {} :: { Sound },\n\t\tvoiceBag = {} :: { number },\n\t\tvoiceLast = 0,\n\t\tvoiceUntil = 0,\n\t\tvoiceAt = 0,\n\t\tchasing = false,\n\t\twakeObservedDormant = hunt and hunt\046state == \"dormant\",\n\t\twakePlayed = false,\n\t\twakePrimaryRoot = nil :: BasePart?,\n\t\twakeUntil = 0,\n\t\tstartedAt = nil :: number?,\n\t\tpollAt = -math\046huge,\n\t\tdestroyed = false,\n\t\texclusions = Layout\046ReadExclusions(world\046Root, world\046Field),\n\t}, RoundAudio)\n\tlocal id = HttpService:GenerateGUID(false)\n\tlocal folder = Instance\046new(\"Folder\")\n\tfolder\046Name = \"CornRoundAudio_\" \046\046 id\n\tself:_remember(folder, \"runtime\")\n\tfolder\046Parent = world\046Runtime\n\tself\046folder = folder\n\tlocal wakeAnchor = Instance\046new(\"Part\")\n\twakeAnchor\046Name = \"AwakeningEmitter\"\n\tself:_remember(wakeAnchor, \"awakening_emitter\")\n\twakeAnchor:AddTag(\"corn_audio_emitter\")\n\twakeAnchor\046Size = Vector3\046one\n\twakeAnchor\046Transparency = 1\n\twakeAnchor\046Anchored = true\n\twakeAnchor\046CanCollide = false\n\twakeAnchor\046CanTouch = false\n\twakeAnchor\046CanQuery = false\n\twakeAnchor\046CastShadow = false\n\twakeAnchor\046Position = if hunt and hunt\046home then hunt\046home else world\046Field\046Position\n\twakeAnchor\046Parent = folder\n\tlocal groupsFolder = Instance\046new(\"Folder\")\n\tgroupsFolder\046Name = \"CornRoundAudio_\" \046\046 id\n\tself:_remember(groupsFolder, \"groups\")\n\tgroupsFolder\046Parent = SoundService\n\tfor _, category in { \"Music\", \"Ambience\", \"Effects\" } do\n\t\tlocal group = Instance\046new(\"SoundGroup\")\n\t\tgroup\046Name = category\n\t\tself:_remember(group, \"group_\" \046\046 category)\n\t\tgroup\046Volume = math\046clamp(Rules\046Mix\046Master * Rules\046Mix[category], 0, 1)\n\t\tgroup\046Parent = groupsFolder\n\t\tself\046groups[category] = group\n\tend\n\tself\046wakeSound = self:_sound(\n\t\twakeAnchor,\n\t\t\"COC_Monster_03\",\n\t\t\"awakening\",\n\t\tRules\046Volume\046Awakening,\n\t\t\"Effects\",\n\t\tRules\046Ranges\046Awakening,\n\t\tfalse\n\t)\n\tself\046wakeSound\046RollOffMode = Enum\046RollOffMode\046Linear\n\tlocal half = world\046Field\046Size / 2\n\tfor index, offset in\n\t\t{\n\t\t\tVector2\046new(-0\04662, -0\04662),\n\t\t\tVector2\046new(0\04662, -0\04662),\n\t\t\tVector2\046new(0, 0),\n\t\t\tVector2\046new(-0\04662, 0\04662),\n\t\t\tVector2\046new(0\04662, 0\04662),\n\t\t}\n\tdo\n\t\tlocal anchor = Instance\046new(\"Part\")\n\t\tanchor\046Name = \"Crickets\" \046\046 index\n\t\tself:_remember(anchor, \"crickets_emitter\")\n\t\tanchor:AddTag(\"corn_audio_emitter\")\n\t\tanchor\046Size = Vector3\046one\n\t\tanchor\046Transparency = 1\n\t\tanchor\046Anchored = true\n\t\tanchor\046CanCollide = false\n\t\tanchor\046CanTouch = false\n\t\tanchor\046CanQuery = false\n\t\tanchor\046CastShadow = false\n\t\tanchor\046Position = world\046Field\046CFrame:PointToWorldSpace(\n\t\t\tVector3\046new(offset\046X * half\046X, -half\046Y + 1, offset\046Y * half\046Z)\n\t\t)\n\t\tanchor\046Parent = folder\n\t\tlocal sound = self:_sound(\n\t\t\tanchor,\n\t\t\t\"COC_Crickets_15s\",\n\t\t\t\"crickets\",\n\t\t\tRules\046Volume\046Crickets,\n\t\t\t\"Ambience\",\n\t\t\tRules\046Ranges\046Crickets,\n\t\t\tfalse\n\t\t)\n\t\tlocal gain = sound\046Volume\n\t\tsound\046Volume = 0\n\t\ttable\046insert(self\046crickets, {\n\t\t\tsound = sound,\n\t\t\toffset = (index - 1) * Rules\046Cycle / 5,\n\t\t\tgain = gain,\n\t\t\tduration = math\046max(0\0461, Assets\046Get(\"COC_Crickets_15s\")\046Duration),\n\t\t\tcycle = -1,\n\t\t\trequestedAt = nil,\n\t\t\tplayBeganAt = nil,\n\t\t\tabandoned = false,\n\t\t})\n\tend\n\tlocal markers = world\046Root:FindFirstChild(\"TorchMarkers\")\n\tif\n\t\tmarkers\n\t\tand markers:GetAttribute(\"CornTorchMarkersOwned\") == true\n\t\tand markers:GetAttribute(\"corn_project_id\") == PROJECT\n\tthen\n\t\tfor _, torch in markers:GetChildren() do\n\t\t\tif\n\t\t\t\ttorch:IsA(\"Model\")\n\t\t\t\tand torch:GetAttribute(\"CornTorchOwned\") == true\n\t\t\t\tand torch:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\t\tand torch:HasTag(\"corn_torch\")\n\t\t\tthen\n\t\t\t\tlocal flame = torch:FindFirstChild(\"Flame\")\n\t\t\t\tif flame and flame:IsA(\"BasePart\") then\n\t\t\t\t\ttable\046insert(\n\t\t\t\t\t\tself\046fires,\n\t\t\t\t\t\tself:_sound(\n\t\t\t\t\t\t\tflame,\n\t\t\t\t\t\t\t\"COC_Fire\",\n\t\t\t\t\t\t\t\"fire\",\n\t\t\t\t\t\t\tRules\046Volume\046Fire,\n\t\t\t\t\t\t\t\"Ambience\",\n\t\t\t\t\t\t\tRules\046Ranges\046Fire,\n\t\t\t\t\t\t\ttrue\n\t\t\t\t\t\t)\n\t\t\t\t\t)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tself:_setHunt(hunt)\n\treturn self\nend\n\nfunction RoundAudio:_setHunt(hunt: any, hunts: { any }?)\n\tlocal desired = {} :: { [BasePart]: any }\n\tself\046primaryHunt = nil\n\t-- Exactly three authoritative sources, without a Workspace/field scan\046\n\tfor index = 1, 3 do\n\t\tlocal source = if hunts then hunts[index] else (if index == 1 then hunt else nil)\n\t\tlocal root = if source and not source\046destroyed then source\046root else nil\n\t\tif root and root:IsA(\"BasePart\") and root\046Parent and not desired[root] then\n\t\t\tdesired[root] = source\n\t\t\tif index == 1 then\n\t\t\t\tself\046primaryHunt = source\n\t\t\tend\n\t\tend\n\tend\n\tif not self\046wakePlayed then\n\t\tlocal primary = self\046primaryHunt\n\t\tlocal root = if primary then primary\046root else nil\n\t\tif self\046wakePrimaryRoot ~= root then\n\t\t\tself\046wakePrimaryRoot = root\n\t\t\tself\046wakeObservedDormant = primary ~= nil and primary\046state == \"dormant\"\n\t\t\tif primary then\n\t\t\t\tself\046wakeSound\046Parent\046Position = primary\046home or self\046world\046Field\046Position\n\t\t\tend\n\t\telseif primary and primary\046state == \"dormant\" then\n\t\t\tself\046wakeObservedDormant = true\n\t\tend\n\tend\n\t-- Remove only vanished NPCs before adding replacements; the live corn pool\n\t-- stays bounded at three and lead handoffs never cut another NPC's tail\046\n\tfor root, actor in self\046npcActors do\n\t\tif not desired[root] then\n\t\t\tself:_remove(actor\046sound)\n\t\t\tself\046npcActors[root] = nil\n\t\tend\n\tend\n\tfor root, source in desired do\n\t\tlocal actor = self\046npcActors[root]\n\t\tif not actor then\n\t\t\tactor = self:_actor(root)\n\t\t\tself\046npcActors[root] = actor\n\t\tend\n\t\tactor\046hunt = source\n\tend\n\tlocal leadRoot = if hunt and not hunt\046destroyed then hunt\046root else nil\n\tlocal selected = if leadRoot then self\046npcActors[leadRoot] else nil\n\tif not selected and self\046primaryHunt then\n\t\tselected = self\046npcActors[self\046primaryHunt\046root]\n\tend\n\tself\046npc = selected -- Legacy alias for the selected voice/threat source\046\n\tself\046leadHunt = if selected then selected\046hunt else nil\n\tlocal root = if selected then selected\046root else nil\n\tif self\046voiceRoot == root then\n\t\treturn\n\tend\n\tfor _, sound in self\046voices do\n\t\tself:_remove(sound)\n\tend\n\tself\046voices = {}\n\tself\046voiceRoot = root\n\tself\046voiceBag = {}\n\tself\046voiceLast, self\046voiceUntil, self\046voiceAt = 0, 0, 0\n\tself\046chasing = false\n\tif root then\n\t\tfor index, key in VOICE_KEYS do\n\t\t\tself\046voices[index] = self:_sound(\n\t\t\t\troot,\n\t\t\t\tkey,\n\t\t\t\t\"monster_voice_\" \046\046 index,\n\t\t\t\tRules\046Volume\046Monster,\n\t\t\t\t\"Effects\",\n\t\t\t\tRules\046Ranges\046Monster,\n\t\t\t\tfalse\n\t\t\t)\n\t\tend\n\tend\nend\n\nfunction RoundAudio:_actor(root: BasePart): any\n\t-- This silent Sound is a replicated, owned movement binding only\046\n\tlocal sound =\n\t\tself:_sound(root, LOOP_KEY, \"corn_rustle\", 0, \"Effects\", Rules\046Ranges\046Rustle, true)\n\tsound:SetAttribute(\"AudioCornActive\", false)\n\tsound:SetAttribute(\"AudioCornSpeed\", 1)\n\treturn { root = root, sound = sound, lastPosition = nil, lastAt = nil, playbackSpeed = 1 }\nend\n\nfunction RoundAudio:_inCorn(point: Vector3): boolean\n\tlocal field = self\046world\046Field\n\tlocal at = field\046CFrame:PointToObjectSpace(point)\n\tlocal half = field\046Size / 2\n\treturn math\046abs(at\046X) <= half\046X\n\t\tand math\046abs(at\046Z) <= half\046Z\n\t\tand not Layout\046IsExcluded(point, self\046exclusions)\nend\n\nfunction RoundAudio:_stepActor(actor: any, now: number, eligible: boolean)\n\tlocal root, sound = actor\046root, actor\046sound\n\tlocal point, before, beforeAt = root\046Position, actor\046lastPosition, actor\046lastAt\n\tactor\046lastPosition, actor\046lastAt = point, now\n\tlocal dt = if beforeAt then now - beforeAt else 0\n\tlocal delta = if before then point - before else Vector3\046zero\n\tlocal distance = Vector3\046new(delta\046X, 0, delta\046Z)\046Magnitude\n\tlocal moving = dt > 0\n\t\tand dt <= 1\n\t\tand distance >= 0\04605\n\t\tand distance <= 12\n\t\tand distance / dt <= 45\n\t\tand math\046abs(delta\046Y) < 4\n\tlocal active = eligible == true and moving and self:_inCorn(point)\n\tlocal speed = 1\n\tif active then\n\t\tlocal stableRatio = actor\046playerSpeed\n\t\tlocal hunt = actor\046hunt\n\t\tif not stableRatio and hunt then\n\t\t\tlocal huntSpeed\n\t\t\tlocal character = self\046ownerPlayer\046Character\n\t\t\tlocal playerRoot = if character\n\t\t\t\tthen character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\telse nil\n\t\t\tif hunt\046state == \"chase\" and playerRoot and type(hunt\046_chaseSpeed) == \"function\" then\n\t\t\t\tlocal ok, value = pcall(hunt\046_chaseSpeed, hunt, playerRoot, now)\n\t\t\t\tif ok then\n\t\t\t\t\thuntSpeed = value\n\t\t\t\tend\n\t\t\telseif hunt\046state == \"patrol\" and type(hunt\046balance) == \"table\" then\n\t\t\t\thuntSpeed = hunt\046balance\046monster_patrol_speed\n\t\t\tend\n\t\t\tif type(huntSpeed) == \"number\" and finite(huntSpeed) and huntSpeed > 0 then\n\t\t\t\tstableRatio = huntSpeed / 10\n\t\t\tend\n\t\tend\n\t\tlocal ratio = stableRatio or distance / dt / 10\n\t\tratio = math\046floor(math\046clamp(ratio, 1, 2) * 10 + 0\0465) / 10\n\t\t-- NPC waypoint/physics noise must not modulate pitch every poll\046\n\t\tspeed = if stableRatio or math\046abs(ratio - actor\046playbackSpeed) >= 0\04615\n\t\t\tthen ratio\n\t\t\telse actor\046playbackSpeed\n\tend\n\tactor\046playbackSpeed = speed\n\tif sound:GetAttribute(\"AudioCornSpeed\") ~= speed then\n\t\tsound:SetAttribute(\"AudioCornSpeed\", speed)\n\tend\n\tif sound:GetAttribute(\"AudioCornActive\") ~= active then\n\t\tsound:SetAttribute(\"AudioCornActive\", active)\n\tend\nend\n\nfunction RoundAudio:_grounded(character: Model, humanoid: Humanoid, root: BasePart): boolean\n\tif humanoid\046Health <= 0 or humanoid\046FloorMaterial == Enum\046Material\046Air then\n\t\treturn false\n\tend\n\tlocal params = RaycastParams\046new()\n\tparams\046FilterType = Enum\046RaycastFilterType\046Exclude\n\tparams\046FilterDescendantsInstances = { character }\n\tparams\046RespectCanCollide = true\n\tlocal legHeight = 0\n\tif humanoid\046RigType == Enum\046HumanoidRigType\046R6 then\n\t\tlocal leg = character:FindFirstChild(\"Left Leg\")\n\t\tif leg and leg:IsA(\"BasePart\") then\n\t\t\tlegHeight = leg\046Size\046Y\n\t\tend\n\tend\n\tlocal length = math\046max(3, legHeight + humanoid\046HipHeight + root\046Size\046Y / 2 + 2)\n\tlocal hit = workspace:Raycast(root\046Position, Vector3\046new(0, -length, 0), params)\n\treturn hit ~= nil and hit\046Instance == self\046world\046Ground\nend\n\nfunction RoundAudio:_players(now: number, phase: string)\n\tlocal players = Players:GetPlayers()\n\ttable\046sort(players, function(a, b)\n\t\tif a == b then\n\t\t\treturn false\n\t\telseif a == self\046ownerPlayer then\n\t\t\treturn true\n\t\telseif b == self\046ownerPlayer then\n\t\t\treturn false\n\t\tend\n\t\treturn a\046UserId < b\046UserId\n\tend)\n\tlocal alive: { [Player]: boolean } = {}\n\tfor index, player in players do\n\t\tif index > Rules\046ActorLimit then\n\t\t\tbreak\n\t\tend\n\t\tlocal character = player\046Character\n\t\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\t\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\t\tif\n\t\t\tnot character\n\t\t\tor not humanoid\n\t\t\tor not root\n\t\t\tor not root:IsA(\"BasePart\")\n\t\t\tor humanoid\046Health <= 0\n\t\tthen\n\t\t\tcontinue\n\t\tend\n\t\talive[player] = true\n\t\tlocal actor = self\046actors[player]\n\t\tif actor and actor\046root ~= root then\n\t\t\tself:_remove(actor\046sound)\n\t\t\tactor = nil\n\t\tend\n\t\tif not actor then\n\t\t\tactor = self:_actor(root)\n\t\t\tself\046actors[player] = actor\n\t\tend\n\t\tactor\046playerSpeed = if