1\nend\n\nlocal function getRemote(folder: Instance, name: string): RemoteEvent?\n\tlocal instance = folder:WaitForChild(name, REMOTE_WAIT_SEC)\n\tif not instance or not instance:IsA(\"RemoteEvent\") then\n\t\twarn(\n\t\t\tstring\046format(\n\t\t\t\t\"[RoundController] RemoteEvent %s is unavailable after %ds\",\n\t\t\t\tname,\n\t\t\t\tREMOTE_WAIT_SEC\n\t\t\t)\n\t\t)\n\t\treturn nil\n\tend\n\treturn instance\nend\n\nfunction RoundController:Init(_context: any)\n\tself\046_snapshot = nil :: Snapshot?\n\tself\046_requestRemote = nil :: RemoteEvent?\n\tself\046_snapshotConnection = nil :: RBXScriptConnection?\n\tself\046_lastRequest = -math\046huge\n\tself\046_hud = nil\n\n\tlocal playerGui = Players\046LocalPlayer:WaitForChild(\"PlayerGui\", REMOTE_WAIT_SEC)\n\tif not playerGui or not playerGui:IsA(\"PlayerGui\") then\n\t\twarn(\"[RoundController] PlayerGui is unavailable; the round interface was not created\")\n\t\treturn\n\tend\n\tself\046_hud = RoundHud\046new(playerGui)\n\tself\046_hud:SetOnAction(function(action: string, mode: string?)\n\t\tself:_request(action, mode)\n\tend)\nend\n\nfunction RoundController:_request(action: string, mode: string?)\n\tlocal remote = self\046_requestRemote\n\tlocal hud = self\046_hud\n\tif\n\t\tnot remote\n\t\tor not hud\n\t\tor hud\046_unavailable\n\t\tor not self\046_snapshot\n\t\tor ACTIONS[action] ~= true\n\tthen\n\t\treturn\n\tend\n\tif (action == \"start\" or action == \"retry\") and not LightingModes\046IsValid(mode) then\n\t\treturn\n\tend\n\tif action == \"start\" and self\046_snapshot\046phase ~= \"ready\" then\n\t\treturn\n\tend\n\tif\n\t\taction == \"revive\"\n\t\tand (\n\t\t\tmode ~= nil\n\t\t\tor self\046_snapshot\046phase ~= \"caught\"\n\t\t\tor self\046_snapshot\046capture\046remaining ~= 0\n\t\t\tor self\046_snapshot\046catches_remaining ~= 1\n\t\t\tor hud\046_captureActive\n\t\t)\n\tthen\n\t\treturn\n\tend\n\tif\n\t\taction == \"retry\"\n\t\tand self\046_snapshot\046phase ~= \"escaped\"\n\t\tand self\046_snapshot\0