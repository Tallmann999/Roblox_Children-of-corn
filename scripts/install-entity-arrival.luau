{path="ServerScriptService/GameServer/Game/RoundAudio",class="ModuleScript",before="81804da1512f3e5419e87cc9a7b86f94803a73226e0bac1c43fe97eb49462b74",after="904bbff3c86998c0c99dd75494c6dabf049e8919c503f6663487e48a3c2c8c0f",source="--!strict\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal SoundService = game:GetService(\"SoundService\")\nlocal HttpService = game:GetService(\"HttpService\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\")\nlocal Assets = require(Shared:WaitForChild(\"AudioAssets\"))\nlocal Rules = require(Shared:WaitForChild(\"AudioRules\"))\nlocal Layout = require(Shared:WaitForChild(\"CornLayout\"))\n\nlocal RoundAudio = {}\nRoundAudio\046__index = RoundAudio\n\nlocal PROJECT = \"children_of_corn\"\nlocal LOOP_KEY = \"COC_Corn_Continuous_02\"\nlocal VOICE_KEYS = Rules\046VoiceKeys\nlocal ARRIVAL_KEYS = { [2] = \"COC_Monster_01\", [3] = \"COC_Monster_02\" }\n\nlocal function finite(value: number): boolean\n\treturn value == value and value > -math\046huge and value < math\046huge\nend\n\nlocal function owned(item: Instance): boolean\n\treturn item:GetAttribute(\"CornAudioOwned\") == true\n\t\tand item:GetAttribute(\"corn_project_id\") == PROJECT\nend\n\nlocal function annotate(item: Instance, role: string)\n\titem:SetAttribute(\"CornAudioOwned\", true)\n\titem:SetAttribute(\"corn_project_id\", PROJECT)\n\titem:SetAttribute(\"audio_role\", role)\nend\n\nlocal function stop(sound: Sound)\n\tif sound:GetAttribute(\"AudioRequestedPlaying\") ~= false then\n\t\tsound:SetAttribute(\"AudioRequestedPlaying\", false)\n\t\tsound:Stop()\n\tend\nend\n\nlocal function request(sound: Sound, playing: boolean)\n\tif not playing then\n\t\tstop(sound)\n\telseif sound:GetAttribute(\"AudioRequestedPlaying\") ~= true then\n\t\tsound:SetAttribute(\"AudioRequestedPlaying\", true)\n\t\t-- An empty ID is configuration awaiting import, not loaded audio\046\n\t\tif sound\046SoundId ~= \"\" then\n\t\t\tsound:Play()\n\t\tend\n\tend\nend\n\n-- Preserve an inserted foreign child even when its owned parent is removed\046\nlocal function destroyOwned(item: Instance)\n\tif not owned(item) then\n\t\treturn\n\tend\n\tlocal safeParent = item\046Parent\n\twhile safeParent and owned(safeParent) do\n\t\tsafeParent = safeParent\046Parent\n\tend\n\tlocal descendants = item:GetDescendants()\n\tfor _, child in descendants do\n\t\tif not owned(child) and child\046Parent and owned(child\046Parent) then\n\t\t\tchild\046Parent = safeParent\n\t\tend\n\tend\n\titem:Destroy()\nend\n\nfunction RoundAudio:_remember(item: Instance, role: string)\n\tannotate(item, role)\n\ttable\046insert(self\046created, item)\n\treturn item\nend\n\nfunction RoundAudio:_remove(item: Instance)\n\tif item:IsA(\"Sound\") then\n\t\tstop(item)\n\tend\n\tdestroyOwned(item)\n\tlocal index = table\046find(self\046created, item)\n\tif index then\n\t\ttable\046remove(self\046created, index)\n\tend\nend\n\nfunction RoundAudio:_sound(\n\tparent: Instance,\n\tkey: string,\n\trole: string,\n\tvolume: number,\n\tcategory: string,\n\trange: any,\n\tlooped: boolean\n): Sound\n\tlocal definition = Assets\046Get(key)\n\tlocal sound = Instance\046new(\"Sound\")\n\tsound\046Name = \"CornAudio_\" \046\046 role\n\tself:_remember(sound, role)\n\tsound:SetAttribute(\"AudioAssetKey\", key)\n\tsound:SetAttribute(\"AudioRequestedPlaying\", false)\n\tsound\046SoundId = definition\046Id\n\tsound\046Volume = math\046clamp(volume * definition\046Gain, 0, 1)\n\tsound\046Looped = looped\n\tsound\046RollOffMode = Enum\046RollOffMode\046InverseTapered\n\tsound\046RollOffMinDistance = range\046Min\n\tsound\046RollOffMaxDistance = range\046Max\n\tsound\046SoundGroup = self\046groups[category]\n\tsound\046Parent = parent\n\treturn sound\nend\n\nfunction RoundAudio:_reinforcementIndex(hunt: any): number?\n\tif type(hunt) ~= \"table\" or hunt\046destroyed ~= false or hunt\046world ~= self\046world then\n\t\treturn nil\n\tend\n\tlocal model, root = hunt\046model, hunt\046root\n\tif\n\t\ttypeof(model) ~= \"Instance\"\n\t\tor not model:IsA(\"Model\")\n\t\tor typeof(root) ~= \"Instance\"\n\t\tor not root:IsA(\"BasePart\")\n\t\tor typeof(self\046world\046Runtime) ~= \"Instance\"\n\t\tor self\046world\046Runtime\046Parent ~= self\046world\046Root\n\t\tor self\046world\046Runtime:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor model\046Parent ~= self\046world\046Runtime\n\t\tor model:GetAttribute(\"CornMonsterOwned\") ~= true\n\t\tor model:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor model:GetAttribute(\"MonsterRigVersion\") ~= 1\n\t\tor root\046Parent ~= model\n\t\tor root\046Name ~= \"Root\"\n\t\tor model\046PrimaryPart ~= root\n\tthen\n\t\treturn nil\n\tend\n\tlocal index = model:GetAttribute(\"MonsterIndex\")\n\tif\n\t\t(index ~= 2 and index ~= 3)\n\t\tor model\046Name ~= \"Monster\" \046\046 tostring(index)\n\t\tor not ({ patrol = true, chase = true, trapped = true, capturing = true })[hunt\046state]\n\tthen\n\t\treturn nil\n\tend\n\treturn index\nend\n\nfunction RoundAudio:_arrivalGroupOwned(group: any): boolean\n\treturn typeof(group) == \"Instance\"\n\t\tand group:IsA(\"SoundGroup\")\n\t\tand self\046groups\046Effects == group\n\t\tand group\046Parent == self\046arrivalGroupsFolder\n\t\tand group\046Name == \"Effects\"\n\t\tand owned(group)\n\t\tand group:GetAttribute(\"audio_role\") == \"group_Effects\"\n\t\tand self\046arrivalGroupsFolder\046Parent == SoundService\n\t\tand owned(self\046arrivalGroupsFolder)\n\t\tand self\046arrivalGroupsFolder:GetAttribute(\"audio_role\") == \"groups\"\nend\n\nfunction RoundAudio:_arrivalOwned(entry: any): boolean\n\tlocal sound, group = entry\046sound, entry\046group\n\treturn self:_reinforcementIndex(entry\046hunt) == entry\046index\n\t\tand entry\046hunt\046root == entry\046root\n\t\tand entry\046hunt\046model == entry\046model\n\t\tand sound\046Parent == entry\046root\n\t\tand owned(sound)\n\t\tand sound\046Name == \"CornAudio_\" \046\046 entry\046role\n\t\tand sound:GetAttribute(\"audio_role\") == entry\046role\n\t\tand sound:GetAttribute(\"AudioAssetKey\") == entry\046key\n\t\tand sound\046SoundId == entry\046id\n\t\tand not sound\046Looped\n\t\tand sound\046SoundGroup == group\n\t\tand self:_arrivalGroupOwned(group)\nend\n\n-- Only SoloRound's successful authoritative two-NPC spawn calls this method\046\n-- Binding or synchronizing an existing hunt in Step never emits an arrival\046\nfunction RoundAudio:ReinforcementsSpawned(hunts: any): number\n\tif self\046destroyed or type(hunts) ~= \"table\" or #hunts ~= 2 then\n\t\treturn 0\n\tend\n\tfor key in hunts do\n\t\tif key ~= 1 and key ~= 2 then\n\t\t\treturn 0\n\t\tend\n\tend\n\tlocal byIndex = {}\n\tfor _, hunt in hunts do\n\t\tlocal index = self:_reinforcementIndex(hunt)\n\t\tif not index or byIndex[index] then\n\t\t\treturn 0\n\t\tend\n\t\tbyIndex[index] = hunt\n\tend\n\tif not byIndex[2] or not byIndex[3] then\n\t\treturn 0\n\tend\n\tlocal pending = {}\n\tfor index = 2, 3 do\n\t\tif not self\046arrivalSeen[index] then\n\t\t\t-- Consume both appearances before any playback can notify observers\046\n\t\t\tself\046arrivalSeen[index] = true\n\t\t\tpending[index] = true\n\t\tend\n\tend\n\tlocal requested = 0\n\tfor index = 2, 3 do\n\t\t-- Replaced roots, handoffs and revival cannot replay a round's appearance\046\n\t\tif not pending[index] or not self:_arrivalGroupOwned(self\046groups\046Effects) then\n\t\t\tcontinue\n\t\tend\n\t\tlocal hunt, key = byIndex[index], ARRIVAL_KEYS[index]\n\t\tlocal role = \"reinforcement_arrival_\" \046\046 tostring(index)\n\t\tlocal sound = self:_sound(\n\t\t\thunt\046root,\n\t\t\tkey,\n\t\t\trole,\n\t\t\tRules\046Volume\046Awakening,\n\t\t\t\"Effects\",\n\t\t\tRules\046Ranges\046Awakening,\n\t\t\tfalse\n\t\t)\n\t\t-- These sounds have a stricter ownership lifecycle than legacy voices\046\n\t\t-- Keep them outside generic cleanup so a foreign takeover is preserved\046\n\t\tlocal createdIndex = table\046find(self\046created, sound)\n\t\tif createdIndex then\n\t\t\ttable\046remove(self\046created, createdIndex)\n\t\tend\n\t\tsound\046RollOffMode = Enum\046RollOffMode\046Linear\n\t\tlocal entry = {\n\t\t\thunt = hunt,\n\t\t\tindex = index,\n\t\t\tmodel = hunt\046model,\n\t\t\troot = hunt\046root,\n\t\t\tsound = sound,\n\t\t\tgroup = self\046groups\046Effects,\n\t\t\tkey = key,\n\t\t\trole = role,\n\t\t\tid = Assets\046Get(key)\046Id,\n\t\t}\n\t\tif self:_arrivalOwned(entry) then\n\t\t\tself\046arrivals[index] = entry\n\t\t\trequest(sound, true)\n\t\t\trequested += 1\n\t\tend\n\tend\n\treturn requested\nend\n\nfunction RoundAudio:_stepArrivals(caught: boolean, removing: boolean?)\n\tfor index, entry in self\046arrivals do\n\t\tif not self:_arrivalOwned(entry) then\n\t\t\t-- Foreign identity, parent, URI or group: relinquish without any writes\046\n\t\t\tself\046arrivals[index] = nil\n\t\telseif removing then\n\t\t\tstop(entry\046sound)\n\t\t\tdestroyOwned(entry\046sound)\n\t\t\tself\046arrivals[index] = nil\n\t\telseif caught then\n\t\t\tstop(entry\046sound)\n\t\tend\n\tend\nend\n\nfunction RoundAudio:_stepCricket(entry: any, now: number)\n\tlocal sound = entry\046sound\n\tlocal elapsed = now - self\046startedAt - entry\046offset\n\tlocal inSlot = Rules\046CricketIsOn(now, self\046startedAt, entry\046offset)\n\tif sound:GetAttribute(\"AudioRequestedPlaying\") ~= inSlot then\n\t\tsound:SetAttribute(\"AudioRequestedPlaying\", inSlot)\n\tend\n\tif elapsed < 0 then\n\t\tsound\046Volume = 0\n\t\treturn\n\tend\n\tlocal cycle = math\046floor(elapsed / Rules\046Cycle)\n\tlocal slotAt = self\046startedAt + entry\046offset + cycle * Rules\046Cycle\n\tif cycle ~= entry\046cycle then\n\t\t-- A stalled/unavailable request stayed silent\046 Cancel only that\n\t\t-- never-decoded attempt before considering a later scheduled slot\046\n\t\tif entry\046requestedAt and not entry\046playBeganAt and not entry\046abandoned then\n\t\t\tif not sound\046IsLoaded and sound\046TimePosition == 0 then\n\t\t\t\tsound:Stop()\n\t\t\tend\n\t\tend\n\t\tentry\046cycle = cycle\n\t\tentry\046requestedAt, entry\046playBeganAt = nil, nil\n\t\tentry\046abandoned = false\n\t\t-- One attempt per slot; no replay of missed slots after a stall\046\n\t\tif\n\t\t\tinSlot\n\t\t\tand now - slotAt <= Rules\046CricketStartWindow\n\t\t\tand sound\046SoundId ~= \"\"\n\t\t\tand not sound\046IsPlaying\n\t\tthen\n\t\t\tsound\046Volume = 0\n\t\t\tsound\046TimePosition = 0\n\t\t\tentry\046requestedAt = now\n\t\t\tentry\046startDeadline = slotAt + Rules\046CricketStartWindow\n\t\t\tsound:Play()\n\t\tend\n\tend\n\tif entry\046requestedAt and not entry\046playBeganAt and not entry\046abandoned then\n\t\tlocal progressed = finite(sound\046TimePosition) and sound\046TimePosition > 0\n\t\tif now <= entry\046startDeadline and ((sound\046IsLoaded and sound\046IsPlaying) or progressed) then\n\t\t\t-- Fade from the first observed decode/playback, never jump to the\n\t\t\t-- historical gain of a partially elapsed slot after cold loading\046\n\t\t\tentry\046playBeganAt = now\n\t\telseif now >= entry\046startDeadline then\n\t\t\tentry\046abandoned = true\n\t\t\tif not sound\046IsLoaded and not progressed then\n\t\t\t\tsound:Stop()\n\t\t\tend\n\t\tend\n\tend\n\tlocal alpha = 0\n\tif inSlot and entry\046playBeganAt and not entry\046abandoned and sound\046IsPlaying then\n\t\tlocal played = math\046max(0, now - entry\046playBeganAt)\n\t\tlocal length = entry\046duration\n\t\tif finite(sound\046TimeLength) and sound\046TimeLength > 0 then\n\t\t\tlength = math\046min(length, sound\046TimeLength)\n\t\tend\n\t\tlocal progress = if finite(sound\046TimePosition)\n\t\t\tthen math\046max(played, sound\046TimePosition)\n\t\t\telse played\n\t\talpha = Rules\046CricketEnvelope(played, slotAt + Rules\046CricketOn - now, length - progress)\n\tend\n\t-- Normal off is silence followed by natural Ended, never a timer Stop\046\n\tsound\046Volume = entry\046gain * alpha\nend\n\nfunction RoundAudio\046new(world: any, ownerPlayer: Player, hunt: any, random: Random?)\n\tassert(world\046Root and world\046Root:IsA(\"Model\"), \"Round audio requires a bound map\")\n\tassert(world\046Field and world\046Field:IsA(\"BasePart\"), \"Round audio requires Field\")\n\tassert(world\046Runtime and world\046Ground, \"Round audio requires runtime and Ground\")\n\tlocal self = setmetatable({\n\t\tworld = world,\n\t\townerPlayer = ownerPlayer,\n\t\trandom = random or Random\046new(),\n\t\tcreated = {} :: { Instance },\n\t\tgroups = {} :: { [string]: SoundGroup },\n\t\tcrickets = {},\n\t\tfires = {} :: { Sound },\n\t\tactors = {} :: { [Player]: any },\n\t\tnpc = nil :: any,\n\t\tnpcActors = {} :: { [BasePart]: any },\n\t\tprimaryHunt = nil :: any,\n\t\tleadHunt = nil :: any,\n\t\tvoiceRoot = nil :: BasePart?,\n\t\tvoices = {} :: { Sound },\n\t\tvoiceBag = {} :: { number },\n\t\tvoiceLast = 0,\n\t\tvoiceUntil = 0,\n\t\tvoiceAt = 0,\n\t\tchasing = false,\n\t\twakeObservedDormant = hunt and hunt\046state == \"dormant\",\n\t\twakePlayed = false,\n\t\twakePrimaryRoot = nil :: BasePart?,\n\t\twakeUntil = 0,\n\t\tarrivals = {},\n\t\tarrivalSeen = {},\n\t\tstartedAt = nil :: number?,\n\t\tpollAt = -math\046huge,\n\t\tdestroyed = false,\n\t\texclusions = Layout\046ReadExclusions(world\046Root, world\046Field),\n\t}, RoundAudio)\n\tlocal id = HttpService:GenerateGUID(false)\n\tlocal folder = Instance\046new(\"Folder\")\n\tfolder\046Name = \"CornRoundAudio_\" \046\046 id\n\tself:_remember(folder, \"runtime\")\n\tfolder\046Parent = world\046Runtime\n\tself\046folder = folder\n\tlocal wakeAnchor = Instance\046new(\"Part\")\n\twakeAnchor\046Name = \"AwakeningEmitter\"\n\tself:_remember(wakeAnchor, \"awakening_emitter\")\n\twakeAnchor:AddTag(\"corn_audio_emitter\")\n\twakeAnchor\046Size = Vector3\046one\n\twakeAnchor\046Transparency = 1\n\twakeAnchor\046Anchored = true\n\twakeAnchor\046CanCollide = false\n\twakeAnchor\046CanTouch = false\n\twakeAnchor\046CanQuery = false\n\twakeAnchor\046CastShadow = false\n\twakeAnchor\046Position = if hunt and hunt\046home then hunt\046home else world\046Field\046Position\n\twakeAnchor\046Parent = folder\n\tlocal groupsFolder = Instance\046new(\"Folder\")\n\tgroupsFolder\046Name = \"CornRoundAudio_\" \046\046 id\n\tself:_remember(groupsFolder, \"groups\")\n\tgroupsFolder\046Parent = SoundService\n\tself\046arrivalGroupsFolder = groupsFolder\n\tfor _, category in { \"Music\", \"Ambience\", \"Effects\" } do\n\t\tlocal group = Instance\046new(\"SoundGroup\")\n\t\tgroup\046Name = category\n\t\tself:_remember(group, \"group_\" \046\046 category)\n\t\tgroup\046Volume = math\046clamp(Rules\046Mix\046Master * Rules\046Mix[category], 0, 1)\n\t\tgroup\046Parent = groupsFolder\n\t\tself\046groups[category] = group\n\tend\n\tself\046wakeSound = self:_sound(\n\t\twakeAnchor,\n\t\t\"COC_Monster_03\",\n\t\t\"awakening\",\n\t\tRules\046Volume\046Awakening,\n\t\t\"Effects\",\n\t\tRules\046Ranges\046Awakening,\n\t\tfalse\n\t)\n\tself\046wakeSound\046RollOffMode = Enum\046RollOffMode\046Linear\n\tlocal half = world\046Field\046Size / 2\n\tfor index, offset in\n\t\t{\n\t\t\tVector2\046new(-0\04662, -0\04662),\n\t\t\tVector2\046new(0\04662, -0\04662),\n\t\t\tVector2\046new(0, 0),\n\t\t\tVector2\046new(-0\04662, 0\04662),\n\t\t\tVector2\046new(0\04662, 0\04662),\n\t\t}\n\tdo\n\t\tlocal anchor = Instance\046new(\"Part\")\n\t\tanchor\046Name = \"Crickets\" \046\046 index\n\t\tself:_remember(anchor, \"crickets_emitter\")\n\t\tanchor:AddTag(\"corn_audio_emitter\")\n\t\tanchor\046Size = Vector3\046one\n\t\tanchor\046Transparency = 1\n\t\tanchor\046Anchored = true\n\t\tanchor\046CanCollide = false\n\t\tanchor\046CanTouch = false\n\t\tanchor\046CanQuery = false\n\t\tanchor\046CastShadow = false\n\t\tanchor\046Position = world\046Field\046CFrame:PointToWorldSpace(\n\t\t\tVector3\046new(offset\046X * half\046X, -half\046Y + 1, offset\046Y * half\046Z)\n\t\t)\n\t\tanchor\046Parent = folder\n\t\tlocal sound = self:_sound(\n\t\t\tanchor,\n\t\t\t\"COC_Crickets_15s\",\n\t\t\t\"crickets\",\n\t\t\tRules\046Volume\046Crickets,\n\t\t\t\"Ambience\",\n\t\t\tRules\046Ranges\046Crickets,\n\t\t\tfalse\n\t\t)\n\t\tlocal gain = sound\046Volume\n\t\tsound\046Volume = 0\n\t\ttable\046insert(self\046crickets, {\n\t\t\tsound = sound,\n\t\t\toffset = (index - 1) * Rules\046Cycle / 5,\n\t\t\tgain = gain,\n\t\t\tduration = math\046max(0\0461, Assets\046Get(\"COC_Crickets_15s\")\046Duration),\n\t\t\tcycle = -1,\n\t\t\trequestedAt = nil,\n\t\t\tplayBeganAt = nil,\n\t\t\tabandoned = false,\n\t\t})\n\tend\n\tlocal markers = world\046Root:FindFirstChild(\"TorchMarkers\")\n\tif\n\t\tmarkers\n\t\tand markers:GetAttribute(\"CornTorchMarkersOwned\") == true\n\t\tand markers:GetAttribute(\"corn_project_id\") == PROJECT\n\tthen\n\t\tfor _, torch in markers:GetChildren() do\n\t\t\tif\n\t\t\t\ttorch:IsA(\"Model\")\n\t\t\t\tand torch:GetAttribute(\"CornTorchOwned\") == true\n\t\t\t\tand torch:GetAttribute(\"corn_project_id\") == PROJECT\n\t\t\t\tand torch:HasTag(\"corn_torch\")\n\t\t\tthen\n\t\t\t\tlocal flame = torch:FindFirstChild(\"Flame\")\n\t\t\t\tif flame and flame:IsA(\"BasePart\") then\n\t\t\t\t\ttable\046insert(\n\t\t\t\t\t\tself\046fires,\n\t\t\t\t\t\tself:_sound(\n\t\t\t\t\t\t\tflame,\n\t\t\t\t\t\t\t\"COC_Fire\",\n\t\t\t\t\t\t\t\"fire\",\n\t\t\t\t\t\t\tRules\046Volume\046Fire,\n\t\t\t\t\t\t\t\"Ambience\",\n\t\t\t\t\t\t\tRules\046Ranges\046Fire,\n\t\t\t\t\t\t\ttrue\n\t\t\t\t\t\t)\n\t\t\t\t\t)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tself:_setHunt(hunt)\n\treturn self\nend\n\nfunction RoundAudio:_setHunt(hunt: any, hunts: { any }?)\n\tlocal desired = {} :: { [BasePart]: any }\n\tself\046primaryHunt = nil\n\t-- Exactly three authoritative sources, without a Workspace/field scan\046\n\tfor index = 1, 3 do\n\t\tlocal source = if hunts then hunts[index] else (if index == 1 then hunt else nil)\n\t\tlocal root = if source and not source\046destroyed then source\046root else nil\n\t\tif root and root:IsA(\"BasePart\") and root\046Parent and not desired[root] then\n\t\t\tdesired[root] = source\n\t\t\tif index == 1 then\n\t\t\t\tself\046primaryHunt = source\n\t\t\tend\n\t\tend\n\tend\n\tif not self\046wakePlayed then\n\t\tlocal primary = self\046primaryHunt\n\t\tlocal root = if primary then primary\046root else nil\n\t\tif self\046wakePrimaryRoot ~= root then\n\t\t\tself\046wakePrimaryRoot = root\n\t\t\tself\046wakeObservedDormant = primary ~= nil and primary\046state == \"dormant\"\n\t\t\tif primary then\n\t\t\t\tself\046wakeSound\046Parent\046Position = primary\046home or self\046world\046Field\046Position\n\t\t\tend\n\t\telseif primary and primary\046state == \"dormant\" then\n\t\t\tself\046wakeObservedDormant = true\n\t\tend\n\tend\n\t-- Remove only vanished NPCs before adding replacements; the live corn pool\n\t-- stays bounded at three and lead handoffs never cut another NPC's tail\046\n\tfor root, actor in self\046npcActors do\n\t\tif not desired[root] then\n\t\t\tself:_remove(actor\046sound)\n\t\t\tself\046npcActors[root] = nil\n\t\tend\n\tend\n\tfor root, source in desired do\n\t\tlocal actor = self\046npcActors[root]\n\t\tif not actor then\n\t\t\tactor = self:_actor(root)\n\t\t\tself\046npcActors[root] = actor\n\t\tend\n\t\tactor\046hunt = source\n\tend\n\tlocal leadRoot = if hunt and not hunt\046destroyed then hunt\046root else nil\n\tlocal selected = if leadRoot then self\046npcActors[leadRoot] else nil\n\tif not selected and self\046primaryHunt then\n\t\tselected = self\046npcActors[self\046primaryHunt\046root]\n\tend\n\tself\046npc = selected -- Legacy alias for the selected voice/threat source\046\n\tself\046leadHunt = if selected then selected\046hunt else nil\n\tlocal root = if selected then selected\046root else nil\n\tif self\046voiceRoot == root then\n\t\treturn\n\tend\n\tfor _, sound in self\046voices do\n\t\tself:_remove(sound)\n\tend\n\tself\046voices = {}\n\tself\046voiceRoot = root\n\tself\046voiceBag = {}\n\tself\046voiceLast, self\046voiceUntil, self\046voiceAt = 0, 0, 0\n\tself\046chasing = false\n\tif root then\n\t\tfor index, key in VOICE_KEYS do\n\t\t\tself\046voices[index] = self:_sound(\n\t\t\t\troot,\n\t\t\t\tkey,\n\t\t\t\t\"monster_voice_\" \046\046 index,\n\t\t\t\tRules\046Volume\046Monster,\n\t\t\t\t\"Effects\",\n\t\t\t\tRules\046Ranges\046Monster,\n\t\t\t\tfalse\n\t\t\t)\n\t\tend\n\tend\nend\n\nfunction RoundAudio:_actor(root: BasePart): any\n\t-- This silent Sound is a replicated, owned movement binding only\046\n\tlocal sound =\n\t\tself:_sound(root, LOOP_KEY, \"corn_rustle\", 0, \"Effects\", Rules\046Ranges\046Rustle, true)\n\tsound:SetAttribute(\"AudioCornActive\", false)\n\tsound:SetAttribute(\"AudioCornSpeed\", 1)\n\treturn { root = root, sound = sound, lastPosition = nil, lastAt = nil, playbackSpeed = 1 }\nend\n\nfunction RoundAudio:_inCorn(point: Vector3): boolean\n\tlocal field = self\046world\046Field\n\tlocal at = field\046CFrame:PointToObjectSpace(point)\n\tlocal half = field\046Size / 2\n\treturn math\046abs(at\046X) <= half\046X\n\t\tand math\046abs(at\046Z) <= half\046Z\n\t\tand not Layout\046IsExcluded(point, self\046exclusions)\nend\n\nfunction RoundAudio:_stepActor(actor: any, now: number, eligible: boolean)\n\tlocal root, sound = actor\046root, actor\046sound\n\tlocal point, before, beforeAt = root\046Position, actor\046lastPosition, actor\046lastAt\n\tactor\046lastPosition, actor\046lastAt = point, now\n\tlocal dt = if beforeAt then now - beforeAt else 0\n\tlocal delta = if before then point - before else Vector3\046zero\n\tlocal distance = Vector3\046new(delta\046X, 0, delta\046Z)\046Magnitude\n\tlocal moving = dt > 0\n\t\tand dt <= 1\n\t\tand distance >= 0\04605\n\t\tand distance <= 12\n\t\tand distance / dt <= 45\n\t\tand math\046abs(delta\046Y) < 4\n\tlocal active = eligible == true and moving and self:_inCorn(point)\n\tlocal speed = 1\n\tif active then\n\t\tlocal stableRatio = actor\046playerSpeed\n\t\tlocal hunt = actor\046hunt\n\t\tif not stableRatio and hunt then\n\t\t\tlocal huntSpeed\n\t\t\tlocal character = self\046owne