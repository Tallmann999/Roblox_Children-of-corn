{
  "name": "ChildrenOfCorn",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "GameShared": {
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "GameServer": {
        "$path": "src/server",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "GameClient": {
          "$path": "src/client",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "$ignoreUnknownInstances": true
  },
  "serveAddress": "127.0.0.1",
  "servePort": 34872
}
