local function closeNumber(actual, expected, tolerance)
	return actual == actual
		and math.abs(actual) < math.huge
		and math.abs(actual - expected) <= tolerance
end

local function frameMatches(actual, expected)
	for i, value in { actual:GetComponents() } do
		if not closeNumber(value, expected[i], if i <= 3 then 0.0001 else 0.00025) then
			return false
		end
	end
	return true
end

local function findExpected(point, bucketsToSearch, values, used, predicate)
	local bx, bz = math.floor(point.X / BUCKET), math.floor(point.Z / BUCKET)
	for x = bx - 1, bx + 1 do
		for z = bz - 1, bz + 1 do
			local bucket = bucketsToSearch[token(x, z)]
			if bucket then
				for _, index in bucket do
					if not used[index] and predicate(values[index]) then
						used[index] = true
						return true
					end
				end
			end
		end
	end
	return false
end

function GreenBedLayout.MatchesExclusions(exclusions, field): boolean
	-- Only a CLIENT caller may use this narrow replication tolerance. Edit and
	-- server authoring retain the independent exact signature preflight.
	if #exclusions.Boxes ~= #raw.expected.boxes or #exclusions.Circles ~= #raw.expected.circles then
		return false
	end
	if
		field.Size ~= Vector3.new(table.unpack(raw.expected.fieldSize))
		or not frameMatches(field.CFrame, raw.expected.fieldFrame)
	then
		return false
	end
	local used = {}
	for _, box in exclusions.Boxes do
		if
			not findExpected(
				box.Frame.Position,
				expectedBoxBuckets,
				raw.expected.boxes,
				used,
				function(expected)
					return closeNumber(box.HalfSize.X, expected.half[1], 0.0001)
						and closeNumber(box.HalfSize.Y, expected.half[2], 0.0001)
						and frameMatches(box.Frame, expected.frame)
				end
			)
		then
			return false
		end
	end
	used = {}
	for _, circle in exclusions.Circles do
		if
			not findExpected(
				circle.Center,
				expectedCircleBuckets,
				raw.expected.circles,
				used,
				function(expected)
					return closeNumber(circle.Radius, expected.radius, 0.0001)
						and closeNumber(circle.Center.X, expected.center[1], 0.0001)
						and closeNumber(circle.Center.Y, expected.center[2], 0.0001)
						and closeNumber(circle.Center.Z, expected.center[3], 0.0001)
				end
			)
		then
			return false
		end
	end
	return true
end

