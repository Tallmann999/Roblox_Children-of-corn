		for bx = math.floor(math.min(a[1], b[1], c[1]) / 2), math.floor(math.max(a[1], b[1], c[1]) / 2) do
			for bz = math.floor(math.min(a[3], b[3], c[3]) / 2), math.floor(math.max(a[3], b[3], c[3]) / 2) do
				local code = token(bx, bz)
				if not grid[code] then
