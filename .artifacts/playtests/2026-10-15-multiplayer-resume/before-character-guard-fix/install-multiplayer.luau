tGateOpen(true)\n\tworld:SetInteractionEnabled(true, true)\n\tif not self:_startEvacuation(os\046clock(), root) then\n\t\tself:_abortAll(\"corn_loop_setup_error\")\n\t\treturn\n\tend\n\tfor _, entry in self\046order do\n\t\tif entry\046phase == \"active\" then\n\t\t\tentry\046notice = \"corn_evacuation_started\"\n\t\tend\n\tend\n\tself:Broadcast()\nend\n\nfunction TeamRound:_startRound()\n\tif self\046state ~= \"waiting\" and self\046state ~= \"finished\" then\n\t\treturn\n\tend\n\tif not self:_ensureWorld() then\n\t\tfor _, member in self\046order do\n\t\t\tmember\046ready = false\n\t\t\tmember\046notice = \"corn_loop_setup_error\"\n\t\tend\n\t\tself:Broadcast()\n\t\treturn\n\tend\n\tself:_cleanup(\"preparing\")\n\tself\046roundId += 1\n\tself\046gateOpen = false\n\tself\046startedAt = nil\n\tself\046world:SetGateOpen(false)\n\tlocal starts = table\046clone(self\046world\046Spawns)\n\tfor index = #starts, 2, -1 do\n\t\tlocal other = self\046random:NextInteger(1, index)\n\t\tstarts[index], starts[other] = starts[other], starts[index]\n\tend\n\tlocal roster = self:_admitted()\n\tfor index, member in roster do\n\t\tmember:Reset(starts[index])\n\tend\n\tself\046lightingState = LightingModes\046Capture(Lighting)\n\tLightingModes\046Apply(Lighting, self\046lightingMode)\n\tself:Broadcast()\n\tlocal epoch = self\046epoch\n\ttask\046spawn(function()\n\t\tlocal deadline = os\046clock() + 10\n\t\twhile self\046epoch == epoch and self\046state == \"preparing\" do\n\t\t\tlocal waiting = false\n\t\t\tfor _, member in roster do\n\t\t\t\tif\n\t\t\t\t\tnot member\046destroyed\n\t\t\t\t\tand member\046phase == \"preparing\"\n\t\t\t\t\tand not member:_livingCharacter()\n\t\t\t\tthen\n\t\t\t\t\twaiting = true\n\t\t\t\tend\n\t\t\tend\n\t\t\tif not waiting or os\046clock() >= deadline then\n\t\t\t\tbreak\n\t\t\tend\n\t\t\ttask\046wait(0\0461)\n\t\tend\n\t\tif self\046epoch ~= epoch or self\046state ~= \"preparing\" then\n\t\t\treturn\n\t\tend\n\t\tfor _, member in roster do\n\t\t\tif member\046destroyed or member\046phase ~= \"preparing\" then\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tlocal character = member:_livingCharacter()\n\t\t\tif not character then\n\t\t\t\tmember:_finish(\"aborted\", \"corn_loop_setup_error\")\n\t\t\telse\n\t\t\t\tmember:_moveToStart(character)\n\t\t\t\tmember\046roundCharacter = character\n\t\t\tend\n\t\tend\n\t\tif self\046epoch ~= epoch or self\046state ~= \"preparing\" then\n\t\t\treturn\n\t\tend\n\t\tlocal ok, problem = pcall(function()\n\t\t\tassert(self\046world:IsValid(), \"CornMap changed during preparation\")\n\t\t\tself\046keySlot = self\046world\046Slots[self\046random:NextInteger(1, #self\046world\046Slots)]\n\t\t\tself:_bindKey(self\046world:SpawnKey(self\046keySlot))\n\t\t\tself\046items = InventoryWorld\046new(\n\t\t\t\tself\046world,\n\t\t\t\tself\046random,\n\t\t\t\tself\046keySlot,\n\t\t\t\tfunction(player, entry)\n\t\t\t\t\tlocal member = self\046members[player]\n\t\t\t\t\tif\n\t\t\t\t\t\tself\046epoch ~= epoch\n\t\t\t\t\t\tor self\046state ~= \"active\"\n\t\t\t\t\t\tor not member\n\t\t\t\t\t\tor not self\046items\n\t\t\t\t\t\tor entry\046model\046Parent ~= self\046items\046folder\n\t\t\t\t\t\tor not member:_canInteract(player, entry\046anchor, entry\046prompt)\n\t\t\t\t\tthen\n\t\t\t\t\t\treturn\n\t\t\t\t\tend\n\t\t\t\t\tif not Inventory\046Add(member\046inventory, entry\046kind) then\n\t\t\t\t\t\tmember\046notice = \"corn_inventory_full\"\n\t\t\t\t\t\tmember:_send()\n\t\t\t\t\t\treturn\n\t\t\t\t\tend\n\t\t\t\t\tassert(self\046items:Take(entry), \"Pickup invalidated during server transaction\")\n\t\t\t\t\tmember\046notice = \"\"\n\t\t\t\t\tmember:_send()\n\t\t\t\tend\n\t\t\t)\n\t\t\tself\046startedAt = os\046clock()\n\t\t\tself\046hunt = MonsterHunt\046new(self\046world, self\046balance, self\046startedAt)\n\t\t\tself\046audio = RoundAudio\046new(self\046world, roster[1]\046player, self\046hunt, self\046random)\n\t\tend)\n\t\tif not ok then\n\t\t\tself\046context\046Log:Warn(\"Cannot start team round:\", p