s(point\046Z) == math\046huge\n\t\tthen\n\t\t\tcontinue\n\t\tend\n\t\ttable\046insert(available, candidate)\n\t\tif\n\t\t\tself\046state == \"chase\"\n\t\t\tand not candidate\046protected\n\t\t\tand candidate\046userId == self\046targetUserId\n\t\t\tand root == self\046targetRoot\n\t\tthen\n\t\t\tretained = candidate\n\t\tend\n\tend\n\tif self\046state == \"chase\" and not retained then\n\t\t-- Departures, replacement characters and protection invalidate the old\n\t\t-- target and its asynchronous path without moving or resetting the NPC\046\n\t\tself:_state(\"patrol\")\n\t\tself\046goal, self\046lostSince, self\046lastSeenPosition, self\046blockedSince = nil, nil, nil, nil\n\tend\n\tlocal selected, nearest = retained, nil\n\tlocal bestDistance, nearestDistance = math\046huge, math\046huge\n\tfor _, candidate in available do\n\t\tlocal delta = candidate\046root\046Position - self\046root\046Position\n\t\tlocal distance = Vector3\046new(delta\046X, 0, delta\046Z)\046Magnitude\n\t\tif\n\t\t\tnot nearest\n\t\t\tor distance < nearestDistance\n\t\t\tor (distance == nearestDistance and candidate\046userId < nearest\046userId)\n\t\tthen\n\t\t\tnearest, nearestDistance = candidate, distance\n\t\tend\n\t\tif\n\t\t\tnot retained\n\t\t\tand not candidate\046protected\n\t\t\tand distance <= (self\046detectRadius or self\046balance\046monster_detect_radius)\n\t\t\tand now >= self\046reacquireAt\n\t\t\tand (not selected or distance < bestDistance or (distance == bestDistance and candidate\046userId < selected\046userId))\n\t\t\tand self:CanSee(candidate\046root)\n\t\tthen\n\t\t\tselected, bestDistance = candidate, distance\n\t\tend\n\tend\n\tself\046targetRoot = if selected then selected\046root else nil\n\tself\046targetUserId = if selected then selected\046userId else 0\n\tlocal root = if selected then selected\046root elseif nearest then nearest\046root else self\046root\n\tlocal caught, awakened = self:Step(dt, now, root, selected == nil)\n\treturn if caught then selected else nil, awakened\nend\n\nfunction MonsterHunt:Destroy()\n\tself\046destroyed = true\n\tself\046stunnedUntil = nil\n\tself\046generation += 1\n\tfor p, transparency in self\046originalMarker do\n\t\tif p\046Parent then\n\t\t\tp\046Transparency = transparency\n\t\tend\n\tend\n\tself\046model:Destroy()\n\tself\046state = \"stopped\"\nend\n\nreturn MonsterHunt\n"},
{path="ServerScriptService/GameServer/Game/RoundAudio",class="ModuleScript",before="904bbff3c86998c0c99dd75494c6dabf049e8919c503f6663487e48a3c2c8c0f",after="41912a9f0f7605b34460716c47c928a483df05c3de77da87a93eb5602ef085eb",source="--!strict\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal SoundService = game:GetService(\"SoundService\")\nlocal HttpService = game:GetService(\"HttpService\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\")\nlocal Assets = require(Shared:WaitForChild(\"AudioAssets\"))\nlocal Rules = require(Shared:WaitForChild(\"AudioRules\"))\nlocal Layout = require(Shared:WaitForChild(\"CornLayout\"))\n\nlocal RoundAudio = {}\nRoundAudio\046__index = RoundAudio\n\nlocal PROJECT = \"children_of_corn\"\nlocal LOOP_KEY = \"COC_Corn_Continuous_02\"\nlocal VOICE_KEYS = Rules\046VoiceKeys\nlocal ARRIVAL_KEYS = { [2] = \"COC_Monster_01\", [3] = \"COC_Monster_02\" }\n\nlocal function finite(value: number): boolean\n\treturn value == value and value > -math\046huge and value < math\046huge\nend\n\nlocal function owned(item: Instance): boolean\n\treturn item:GetAttribute(\"CornAudioOwned\") == true\n\t\tand item:GetAttribute(\"corn_project_id\") == PROJECT\nend\n\nlocal function annotate(item: Instance, role: string)\n\titem:SetAttribute(\"CornAudioOwned\", true)\n\titem:SetAttribute(\"corn_project_id\", PROJECT)\n\titem:SetAttribute(\"audio_role\", role)\nend\n\nlocal function stop(sound: Sound)\n\tif sound:GetAttribute(\"AudioRequestedPlaying\") ~= false then\n\t\tsound:SetAttribute(\"AudioRequestedPlaying\", false)\n\t\tsound:Stop()\n\tend\nend\n\nlocal function request(sound: Sound, playing: boolean)\n\tif not playing then\n\t\tstop(sound)\n\telseif sound:GetAttribute(\"AudioRequestedPlaying\") ~= true then\n\t\tsound:SetAttribute(\"AudioRequestedPlaying\", true)\n\t\t-- An empty ID is configuration awaiting import, not loaded audio\046\n\t\tif sound\046SoundId ~= \"\" then\n\t\t\tsound:Play()\n\t\tend\n\tend\nend\n\n-- Preserve an inserted foreign child even when its owned parent is removed\046\nlocal function destroyOwned(item: Instance)\n\tif not owned(item) then\n\t\treturn\n\tend\n\tlocal safeParent = item\046Parent\n\twhile safeParent and owned(safeParent) do\n\t\tsafeParent = safeParent\046Parent\n\tend\n\tlocal descendants = item:GetDescendants()\n\tfor _, child in descendants do\n\t\tif not owned(child) and child\046Parent and owned(child\046Parent) then\n\t\t\tchild\046Parent = safeParent\n\t\tend\n\tend\n\titem:Destroy()\nend\n\nfunction RoundAudio:_remember(item: Instance, role: string)\n\tannotate(item, role)\n\ttable\046insert(self\046created, item)\n\treturn item\nend\n\nfunction RoundAudio:_remove(item: Instance)\n\tif item:IsA(\"Sound\") then\n\t\tstop(item)\n\tend\n\tdestroyOwned(item)\n\tlocal index = table\046find(self\046created, item)\n\tif index then\n\t\ttable\046remove(self\046created, index)\n\tend\nend\n\nfunction RoundAudio:_sound(\n\tparent: Instance,\n\tkey: string,\n\trole: string,\n\tvolume: number,\n\tcategory: string,\n\trange: any,\n\tlooped: boolean\n): Sound\n\tlocal definition = Assets\046Get(key)\n\tlocal sound = Instance\046new(\"Sound\")\n\tsound\046Name = \"CornAudio_\" \046\046 role\n\tself:_remember(sound, role)\n\tsound:SetAttribute(\"AudioAssetKey\", key)\n\tsound:SetAttribute(\"AudioRequestedPlaying\", false)\n\tsound\046SoundId = definition\046Id\n\tsound\046Volume = math\046clamp(volume * definition\046Gain, 0, 1)\n\tsound\046Looped = looped\n\tsound\046RollOffMode = Enum\046RollOffMode\046InverseTapered\n\tsound\046RollOffMinDistance = range\046Min\n\tsound\046RollOffMaxDistance = range\046Max\n\tsound\046SoundGroup = self\046groups[category]\n\tsound\046Parent = parent\n\treturn sound\nend\n\nfunction RoundAudio:_reinforcementIndex(hunt: any): number?\n\tif type(hunt) ~= \"table\" or hunt\046destroyed ~= false or hunt\046world ~= self\046world then\n\t\treturn