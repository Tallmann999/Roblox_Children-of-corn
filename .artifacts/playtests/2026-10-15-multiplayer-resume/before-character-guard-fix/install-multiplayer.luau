{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/MonsterAnimationController",class="ModuleScript",before="395d94fa951ab881140122f02b48f90c54d6bdb30e20b2eeb68e14f63c98d681",after="2a9020558ef07edb1b85a388f75b0f2992f8b5f48c8280fb1938fa8888951e75",source="--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Pose = require(\n\tReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\"):WaitForChild(\"MonsterPose\")\n)\n\nlocal Controller = { Name = \"MonsterAnimationController\", Order = 80 }\nlocal PROJECT = \"children_of_corn\"\nlocal UPDATE_SEC, RESOLVE_SEC = 1 / 30, 0\0465\nlocal sizes = {}\nfor _, definition in Pose\046Parts do\n\tsizes[definition\046Name] = definition\046Size\nend\n\nlocal function disconnect(connections: { RBXScriptConnection })\n\tfor _, connection in connections do\n\t\tconnection:Disconnect()\n\tend\n\ttable\046clear(connections)\nend\n\nlocal function decorative(part: Instance?): boolean\n\treturn part ~= nil\n\t\tand part:IsA(\"BasePart\")\n\t\tand part\046Anchored\n\t\tand not part\046CanCollide\n\t\tand not part\046CanTouch\n\t\tand not part\046CanQuery\nend\n\nfunction Controller:_restore()\n\tlocal root = self\046_root\n\tif not root then\n\t\treturn\n\tend\n\tfor name, part in self\046_parts do\n\t\tpcall(function()\n\t\t\tpart\046CFrame = root\046CFrame * Pose\046Rest[name]\n\t\tend)\n\tend\n\tself\046_restored = true\nend\n\nfunction Controller:_unbindMonster()\n\tself:_restore()\n\tdisconnect(self\046_monsterConnections)\n\tself\046_model, self\046_root, self\046_parts = nil, nil, {}\n\tself\046_previousPosition, self\046_movingUntil = nil, 0\n\tself\046_state, self\046_stateAt, self\046_lastWrites = nil, self\046_time, 0\nend\n\nfunction Controller:_valid(): boolean\n\tlocal model, root, runtime, map = self\046_model, self\046_root, self\046_runtime, self\046_map\n\tif\n\t\tnot map\n\t\tor map\046Parent ~= Workspace\n\t\tor map:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor not runtime\n\t\tor runtime\046Parent ~= map\n\t\tor runtime:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor not model\n\t\tor model\046Parent ~= runtime\n\t\tor model\046Name ~= (if self\046_monsterIndex == 1\n\t\t\tthen \"Monster\"\n\t\t\telse \"Monster\" \046\046 self\046_monsterIndex)\n\t\tor model:GetAttribute(\"MonsterIndex\") ~= self\046_monsterIndex\n\t\tor model:GetAttribute(\"CornMonsterOwned\") ~= true\n\t\tor model:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor model:GetAttribute(\"MonsterRigVersion\") ~= 1\n\t\tor not decorative(root)\n\t\tor root\046Parent ~= model\n\t\tor model\046PrimaryPart ~= root\n\tthen\n\t\treturn false\n\tend\n\tfor name, part in self\046_parts do\n\t\tif\n\t\t\tpart\046Parent ~= model\n\t\t\tor part\046Name ~= name\n\t\t\tor part\046Size ~= sizes[name]\n\t\t\tor not decorative(part)\n\t\tthen\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\nfunction Controller:_resolveMonster()\n\tlocal name = if self\046_monsterIndex == 1 then \"Monster\" else \"Monster\" \046\046 self\046_monsterIndex\n\tlocal model = self\046_runtime and self\046_runtime:FindFirstChild(name)\n\tif model == self\046_model and self:_valid() then\n\t\treturn\n\tend\n\tself:_unbindMonster()\n\tif\n\t\tnot model\n\t\tor not model:IsA(\"Model\")\n\t\tor model:GetAttribute(\"MonsterIndex\") ~= self\046_monsterIndex\n\t\tor model:GetAttribute(\"CornMonsterOwned\") ~= true\n\t\tor model:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor model:GetAttribute(\"MonsterRigVersion\") ~= 1\n\tthen\n\t\treturn\n\tend\n\tlocal root = model:FindFirstChild(\"Root\")\n\tif not decorative(root) or model\046PrimaryPart ~= root then\n\t\treturn\n\tend\n\tlocal parts, count = {}, 0\n\tfor _, item in model:GetChildren() do\n\t\tif item ~= root then\n\t\t\tif\n\t\t\t\tnot Pose\046Rest[item\046Name]\n\t\t\t\tor parts[item\046Name]\n\t\t\t\tor item\046Size ~