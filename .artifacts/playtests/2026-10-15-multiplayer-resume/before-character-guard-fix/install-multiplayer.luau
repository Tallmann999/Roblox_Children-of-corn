{path="ServerScriptService/GameServer/Game/TeamRound",class="ModuleScript",before=nil,after="f8f32eac3b12eed5b4443844d29d4c278cfd11762b2cac5315b11e15152d33ba",source="--!strict\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Lighting = game:GetService(\"Lighting\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"GameShared\")\nlocal Endpoints = require(Shared:WaitForChild(\"Network\"):WaitForChild(\"EndpointNames\"))\nlocal Inventory = require(Shared:WaitForChild(\"Game\"):WaitForChild(\"Inventory\"))\nlocal LightingModes = require(Shared\046Game:WaitForChild(\"LightingModes\"))\nlocal AuthoredWorld = require(script\046Parent:WaitForChild(\"AuthoredWorld\"))\nlocal Participant = require(script\046Parent:WaitForChild(\"RoundParticipant\"))\nlocal InventoryWorld = require(script\046Parent:WaitForChild(\"InventoryWorld\"))\nlocal MonsterHunt = require(script\046Parent:WaitForChild(\"MonsterHunt\"))\nlocal RoundAudio = require(script\046Parent:WaitForChild(\"RoundAudio\"))\nlocal MinimapState = require(script\046Parent:WaitForChild(\"MinimapState\"))\n\nlocal TeamRound = {}\nTeamRound\046__index = TeamRound\n\nfunction TeamRound\046new(context: any): any\n\tlocal network = context\046Services\046NetworkService\n\treturn setmetatable({\n\t\tcontext = context,\n\t\tbalance = context\046Config\046CoreLoop,\n\t\tcapacity = context\046Config\046Game\046MaxPlayers,\n\t\taction = network:GetEvent(Endpoints\046RequestRoundAction),\n\t\tsnapshot = network:GetEvent(Endpoints\046RoundSnapshot),\n\t\tsprintIntent = network:GetEvent(Endpoints\046RequestSprintIntent),\n\t\tinventoryAction = network:GetEvent(Endpoints\046RequestInventoryAction),\n\t\tmembers = {},\n\t\torder = {},\n\t\tconnections = {},\n\t\tstate = \"waiting\",\n\t\troundId = 0,\n\t\tepoch = 0,\n\t\tworld = nil,\n\t\titems = nil,\n\t\thunt = nil,\n\t\treinforcements = {},\n\t\taudio = nil,\n\t\tkeyCarrier = nil,\n\t\tkeySlot = nil,\n\t\tkeyConnection = nil,\n\t\tgateOpen = false,\n\t\tevacuationActive = false,\n\t\tevacuationDeadline = nil,\n\t\tlightingMode = LightingModes\046Default,\n\t\tlightingState = nil,\n\t\tstartedAt = nil,\n\t\thuntAt = 0,\n\t\tpollAt = 0,\n\t\tsnapshotAt = 0,\n\t\trandom = Random\046new(),\n\t\tending = false,\n\t}, TeamRound)\nend\n\nfunction TeamRound:_admitted(): { any }\n\tlocal result = {}\n\tfor _, member in self\046order do\n\t\tif member\046admitted and not member\046destroyed then\n\t\t\ttable\046insert(result, member)\n\t\tend\n\tend\n\treturn result\nend\n\nfunction TeamRound:_remaining(): number\n\tlocal count = 0\n\tfor _, member in self\046order do\n\t\tif\n\t\t\tmember\046inRound\n\t\t\tand member\046joinedRound == self\046roundId\n\t\t\tand (\n\t\t\t\tmember\046phase == \"active\"\n\t\t\t\tor member\046phase == \"caught\"\n\t\t\t\tor member\046phase == \"preparing\"\n\t\t\t)\n\t\tthen\n\t\t\tcount += 1\n\t\tend\n\tend\n\treturn count\nend\n\nfunction TeamRound:Snapshot(member: any): any\n\tlocal admitted = self:_admitted()\n\tlocal ready = 0\n\tfor _, entry in admitted do\n\t\tif entry\046ready then\n\t\t\tready += 1\n\t\tend\n\tend\n\treturn {\n\t\tround_id = self\046roundId,\n\t\tstate = self\046state,\n\t\tcapacity = self\046capacity,\n\t\tcount = #admitted,\n\t\tready_count = ready,\n\t\tremaining = self:_remaining(),\n\t\tready = member\046ready,\n\t\tcan_start = member\046admitted\n\t\t\tand not member\046ready\n\t\t\tand (self\046state == \"waiting\" or self\046state == \"finished\"),\n\t\tkey_state = if self\046gateOpen\n\t\t\tthen \"opened\"\n\t\t\telseif self\046keyCarrier then \"carried\"\n\t\t\telse \"hidden\",\n\t\tcarrier_name = if self\046keyCarrier\n\t\t\tthen string\046sub(self\046keyCarrier\046player\046Name, 1, 50)\n\t\t\telse \"\",\n\t}\nend\n\nfunction TeamRound:Broadcast()\n\tfor _, member in self\046order do\n\t\tmember:_send()\n\tend\nend\n\nfunction TeamRound:_hunts(): { any }\n\tlocal 