nt,\n\t\tParent = parent,\n\t\tParts = parts,\n\t\tPosition = position,\n\t\tBase = position - Vector3\046new(0, size\046Y / 2, 0),\n\t\tBucket = key,\n\t\tPhase = (position\046X * 0\04617 + position\046Z * 0\04611) % (math\046pi * 2),\n\t\tMoved = false,\n\t}\n\tlayer\046Entries[plant] = entry\n\tlayer\046Count += 1\n\tif not layer\046Buckets[key] then\n\t\tlayer\046Buckets[key] = {}\n\tend\n\tlayer\046Buckets[key][entry] = true\n\tif layer\046Kind == \"near\" then\n\t\tlayer\046Groups[parent]\046Entries[plant] = true\n\tend\n\tself\046_selectElapsed = SELECT_SEC\nend\n\nfunction CornWindController:_indexBatch()\n\tlocal began, count = self\046_clock(), 0\n\twhile\n\t\tself\046_pendingHead <= self\046_pendingTail\n\t\tand count < INDEX_BUDGET\n\t\tand self\046_clock() - began < INDEX_SECONDS\n\tdo\n\t\tlocal job = self\046_pending[self\046_pendingHead]\n\t\tself\046_pending[self\046_pendingHead] = nil\n\t\tself\046_pendingHead += 1\n\t\tself:_register(job)\n\t\tcount += 1\n\tend\n\tif self\046_pendingHead > self\046_pendingTail then\n\t\tself\046_pending, self\046_pendingHead, self\046_pendingTail = {}, 1, 0\n\tend\nend\n\nfunction CornWindController:_removeGroup(layer: any, folder: Instance)\n\tlocal group = layer\046Groups[folder]\n\tif not group then\n\t\treturn\n\tend\n\tdisconnect(group\046Connections)\n\tfor plant in group\046Entries do\n\t\tself:_remove(layer, plant)\n\tend\n\tlayer\046Groups[folder] = nil\nend\n\nfunction CornWindController:_bindGroup(layer: any, folder: Instance)\n\tif\n\t\tlayer\046Groups[folder]\n\t\tor not folder:IsA(\"Folder\")\n\t\tor folder\046Parent ~= layer\046Folder\n\t\tor not folder\046Name:match(\"^Chunk_\")\n\tthen\n\t\treturn\n\tend\n\tlocal group = { Connections = {}, Entries = {} }\n\tlayer\046Groups[folder] = group\n\ttable\046insert(\n\t\tgroup\046Connections,\n\t\tfolder\046ChildAdded:Connect(function(plant)\n\t\t\tself:_enqueue(layer, plant, folder)\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tgroup\046Connections,\n\t\tfold