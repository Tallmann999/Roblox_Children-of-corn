6find(self\046created, sound)\n\t\tif createdIndex then\n\t\t\ttable\046remove(self\046created, createdIndex)\n\t\tend\n\t\tsound\046RollOffMode = Enum\046RollOffMode\046Linear\n\t\tlocal entry = {\n\t\t\thunt = hunt,\n\t\t\tindex = index,\n\t\t\tmodel = hunt\046model,\n\t\t\troot = hunt\046root,\n\t\t\tsound = sound,\n\t\t\tgroup = self\046groups\046Effects,\n\t\t\tkey = key,\n\t\t\trole = role,\n\t\t\tid = Assets\046Get(key)\046Id,\n\t\t}\n\t\tif self:_arrivalOwned(entry) then\n\t\t\tself\046arrivals[index] = entry\n\t\t\trequest(sound, true)\n\t\t\trequested += 1\n\t\tend\n\tend\n\treturn requested\nend\n\nfunction RoundAudio:_stepArrivals(caught: boolean, removing: boolean?)\n\tfor index, entry in self\046arrivals do\n\t\tif not self:_arrivalOwned(entry) then\n\t\t\t-- Foreign identity, parent, URI or group: relinquish without any writes\046\n\t\t\tself\046arrivals[index] = nil\n\t\telseif removing then\n\t\t\tstop(entry\046sound)\n\t\t\tdestroyOwned(entry\046sound)\n\t\t\tself\046arrivals[index] = nil\n\t\telseif caught then\n\t\t\tstop(entry\046sound)\n\t\tend\n\tend\nend\n\nfunction RoundAudio:_stepCricket(entry: any, now: number)\n\tlocal sound = entry\046sound\n\tlocal elapsed = now - self\046startedAt - entry\046offset\n\tlocal inSlot = Rules\046CricketIsOn(now, self\046startedAt, entry\046offset)\n\tif sound:GetAttribute(\"AudioRequestedPlaying\") ~= inSlot then\n\t\tsound:SetAttribute(\"AudioRequestedPlaying\", inSlot)\n\tend\n\tif elapsed < 0 then\n\t\tsound\046Volume = 0\n\t\treturn\n\tend\n\tlocal cycle = math\046floor(elapsed / Rules\046Cycle)\n\tlocal slotAt = self\046startedAt + entry\046offset + cycle * Rules\046Cycle\n\tif cycle ~= entry\046cycle then\n\t\t-- A stalled/unavailable request stayed silent\046 Cancel only that\n\t\t-- never-decoded attempt before considering a later scheduled slot\046\n\t\tif entry\046requestedAt and not entry\046playBeganAt and not entry\046abandoned then\n\t\t\tif not sound\046IsLoaded and sound\046TimePosition == 