{path="ServerScriptService/GameServer/Game/CornField",class="ModuleScript",before="17b7f01b8fc6a44116a91b20f64cf0be92dd05be179c48687ec8ba741e8595e5",after="69a0610927931b2dd0bb87a342372a03b6286c6a6a5b4017deb74acdf4dce187",source="--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal GameShared = ReplicatedStorage:WaitForChild(\"GameShared\")\nlocal Config = require(GameShared:WaitForChild(\"Config\"):WaitForChild(\"GameConfig\"))\nlocal CornLayout = require(GameShared:WaitForChild(\"Game\"):WaitForChild(\"CornLayout\"))\nlocal CornAppearance = require(GameShared:WaitForChild(\"Game\"):WaitForChild(\"CornAppearance\"))\n\nlocal CornField = {}\nlocal PROJECT_ID = \"children_of_corn\"\nlocal OWNER_ATTRIBUTE = \"CornRuntimeArtOwned\"\n\nfunction CornField\046Prepare(): boolean\n\tif\n\t\tnot RunService:IsStudio()\n\t\tor Config\046Environment ~= \"DEV\"\n\t\tor (Config\046Game\046SessionMode ~= \"solo_local\" and Config\046Game\046SessionMode ~= \"team_local\")\n\tthen\n\t\treturn false\n\tend\n\tlocal sources: { Instance } = {}\n\tfor _, item in ServerStorage:GetChildren() do\n\t\tif item\046Name == \"CornPlantTemplate\" or item\046Name == \"SM_Prop_Plant_Corn_01_L\" then\n\t\t\ttable\046insert(sources, item)\n\t\tend\n\tend\n\tif #sources ~= 1 then\n\t\twarn(\n\t\t\t\"[CornField] Expected exactly one ServerStorage CornPlantTemplate or SM_Prop_Plant_Corn_01_L art source\"\n\t\t)\n\t\treturn false\n\tend\n\tlocal prepared, problem = CornLayout\046PrepareTemplate(sources[1])\n\tif not prepared then\n\t\twarn(\"[CornField] \" \046\046 (problem or \"Could not prepare corn art\"))\n\t\treturn false\n\tend\n\tif\n\t\tnot prepared:IsA(\"MeshPart\")\n\t\tor prepared\046MeshId ~= CornAppearance\046MeshId\n\t\tor (prepared\046TextureID ~= CornAppearance\046GreenTextureId and prepared\046TextureID ~= CornAppearance\046DryTextureId)\n\t\tor prepared:FindFirstChildWhichIsA(\"SurfaceAppearance\")\n\tthen\n\t\tprepared:Destroy()\n\t\twarn(\"[CornField] Unknown corn appearance; existing prepared art was preserved\")\n\t\treturn false\n\tend\n\t-- Both renderers inherit yellow before the template can replicate or be cloned\046\n\tprepared\046TextureID = CornAppearance\046DryTextureId\n\tlocal folder: Instance? = nil\n\tfor _, item in ReplicatedStorage:GetChildren() do\n\t\tif item\046Name == \"CornRuntimeArt\" then\n\t\t\tif folder then\n\t\t\t\tprepared:Destroy()\n\t\t\t\twarn(\n\t\t\t\t\t\"[CornField] Duplicate CornRuntimeArt containers; existing contents were preserved\"\n\t\t\t\t)\n\t\t\t\treturn false\n\t\t\tend\n\t\t\tfolder = item\n\t\tend\n\tend\n\tif\n\t\tfolder\n\t\tand (\n\t\t\tnot folder:IsA(\"Folder\")\n\t\t\tor folder:GetAttribute(OWNER_ATTRIBUTE) ~= true\n\t\t\tor folder:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\t)\n\tthen\n\t\tprepared:Destroy()\n\t\twarn(\"[CornField] Refused to overwrite an unowned CornRuntimeArt container\")\n\t\treturn false\n\tend\n\tif folder then\n\t\tfor _, item in folder:GetChildren() do\n\t\t\tif\n\t\t\t\titem\046Name == \"CornPlantTemplate\"\n\t\t\t\tand item:GetAttribute(\"CornPlantTemplateOwned\") ~= true\n\t\t\tthen\n\t\t\t\tprepared:Destroy()\n\t\t\t\twarn(\"[CornField] Refused to overwrite unowned CornPlantTemplate art\")\n\t\t\t\treturn false\n\t\t\tend\n\t\tend\n\telse\n\t\tfolder = Instance\046new(\"Folder\")\n\t\tfolder\046Name = \"CornRuntimeArt\"\n\t\tfolder:SetAttribute(OWNER_ATTRIBUTE, true)\n\t\tfolder:SetAttribute(\"corn_project_id\", PROJECT_ID)\n\tend\n\tprepared\046Name = \"CornPlantTemplate\"\n\tprepared:SetAttribute(\"CornPlantTemplateOwned\", true)\n\tprepared:SetAttribute(\"CornPlantHeight\", CornLayout\046Height)\n\tfor _, item in folder:GetChildren() do\n\t\tif\n\t\t\titem\046Name == \"CornPlantTemplate\"\n\t\t\tand item:GetAttribute(\"CornPlantTemplateOwned\") == true\n\t\tthen\n\t\t\titem:Destroy()\n\t\tend\n\tend\n\tprepared\046Parent = folder\n\tfolder\046Parent = ReplicatedStorage\n\tprint(\"[CornField] Prepared a corn art clone; ServerStorage source is unchanged\")\n\treturn true\nend\n\nreturn CornField\n"},
