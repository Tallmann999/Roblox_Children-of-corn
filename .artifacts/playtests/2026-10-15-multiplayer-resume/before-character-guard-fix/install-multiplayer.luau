046energyUntil = 0\n\tlocal hadKey = self\046hasKey\n\tself\046team:DropKey(self, root\046Position)\n\tself\046notice = if self\046catches >= self\046balance\046max_catches\n\t\tthen \"corn_hunt_defeat_notice\"\n\t\telseif hadKey then \"corn_hunt_key_dropped\"\n\t\telse \"corn_hunt_first_catch\"\n\tself:_controls(false)\n\tself\046team:Broadcast()\n\tlocal teamEpoch, actorEpoch = self\046team\046epoch, self\046epoch\n\ttask\046delay(self\046balance\046capture_transition_sec, function()\n\t\tif self\046team\046epoch ~= teamEpoch then\n\t\t\treturn\n\t\tend\n\t\tif not captor\046destroyed and captor\046state == \"capturing\" then\n\t\t\tcaptor:EndCapture()\n\t\tend\n\t\tif self\046destroyed or self\046epoch ~= actorEpoch or self\046phase ~= \"caught\" then\n\t\t\treturn\n\t\tend\n\t\tself\046captureUntil = 0\n\t\tif self\046catches >= self\046balance\046max_catches then\n\t\t\tself:_finish(\"caught_out\", \"corn_hunt_defeat_notice\")\n\t\telse\n\t\t\tself:_send()\n\t\tend\n\tend)\nend\n\nfunction Participant:_revive()\n\tif self\046team:ExpireEvacuation(os\046clock()) then\n\t\treturn\n\tend\n\tif\n\t\tself\046phase ~= \"caught\"\n\t\tor self\046captureUntil ~= 0\n\t\tor self\046catches ~= 1\n\t\tor self\046team\046state ~= \"active\"\n\tthen\n\t\treturn\n\tend\n\tlocal character = self:_livingCharacter()\n\tif\n\t\tnot character\n\t\tor character ~= self\046roundCharacter\n\t\tor not self\046world\n\t\tor not self\046world:IsValid()\n\tthen\n\t\tself:_finish(\"aborted\", \"corn_loop_result_aborted\")\n\t\treturn\n\tend\n\tself:_moveToStart(character)\n\tself\046stamina = Stamina\046new(self\046balance\046stamina_capacity, os\046clock())\n\tself\046protectedUntil = os\046clock() + self\046balance\046respawn_protection_sec\n\tself\046phase = \"active\"\n\tself\046notice = \"\"\n\tself:_controls(true)\n\tself\046team:Broadcast()\nend\n\nfunction Participant:_menu()\n\tif self\046phase == \"caught\" and self\046captureUntil == 0 then\n\t\tself:_finish(\"aborted\", \"corn_loop_result_aborted\")\n\tend\n\tif self\046phase ~= \"escaped\" and self\046phase ~= \"aborted\" and self\046phase ~= \"caught_out\" then\n\t\treturn\n\tend\n\tself\046phase = \"ready\"\n\tself\046ready = false\n\tself\046inRound = false\n\tself\046notice = \"\"\n\tself\046minimap:ClearHistory()\n\tlocal character = self:_livingCharacter()\n\tif character then\n\t\tself:_moveToStart(character)\n\tend\n\tself:_controls(false)\n\tself\046team:Broadcast()\nend\n\nfunction Participant:_bindCharacter(character: Model)\n\tif self\046destroyed or character == self\046boundCharacter then\n\t\treturn\n\tend\n\tif self\046roundCharacter and character ~= self\046roundCharacter then\n\t\tself:_recordCharacterDeath(self\046roundCharacter)\n\t\tself:_finish(\"aborted\", \"corn_loop_result_aborted\")\n\tend\n\tself\046boundCharacter = character\n\tif self\046deathConnection then\n\t\tself\046deathConnection:Disconnect()\n\tend\n\ttask\046spawn(function()\n\t\tlocal humanoid = character:WaitForChild(\"Humanoid\", 10)\n\t\tlocal root = character:WaitForChild(\"HumanoidRootPart\", 10)\n\t\tif\n\t\t\tself\046destroyed\n\t\t\tor self\046player\046Character ~= character\n\t\t\tor self\046boundCharacter ~= character\n\t\tthen\n\t\t\treturn\n\t\tend\n\t\tif not humanoid or not humanoid:IsA(\"Humanoid\") or not root or not root:IsA(\"BasePart\") then\n\t\t\tself:_finish(\"aborted\", \"corn_loop_setup_error\")\n\t\t\treturn\n\t\tend\n\t\tself\046deathConnection = humanoid\046Died:Connect(function()\n\t\t\tif self\046player\046Character == character then\n\t\t\t\tself:_recordCharacterDeath(character)\n\t\t\t\tself:_finish(\"aborted\", \"corn_loop_result_aborted\")\n\t\t\tend\n\t\tend)\n\t\tif self\046phase ~= \"active\" and self\046phase ~= \"preparing\" then\n\t\t\tself:_moveToStart(character)\n\t\tend\n\t\tself:_controls(self\046phase == \"active\" and self\046roundCharacter == character)\n\t\tself:_send()\n\tend)\nend\n\nfunction Participant:Bind()\n\tself\046characterConnection = self\