hild(ReplicatedStorage, \"GameRemotes\")\n\tif not remotes then\n\t\treturn false, \"GameRemotes\"\n\tend\n\tassert(remotes:IsA(\"Folder\"), \"GameRemotes must be a Folder\")\n\tfor _, name in\n\t\t{\n\t\t\tEndpoints\046RequestRoundAction,\n\t\t\tEndpoints\046RoundSnapshot,\n\t\t\tEndpoints\046RequestSprintIntent,\n\t\t\tEndpoints\046RequestInventoryAction,\n\t\t}\n\tdo\n\t\tlocal endpoint = uniqueChild(remotes, name)\n\t\tif not endpoint then\n\t\t\treturn false, name\n\t\tend\n\t\tassert(endpoint:IsA(\"RemoteEvent\"), \"Server endpoint must be a RemoteEvent: \" \046\046 name)\n\tend\n\tlocal art = uniqueChild(ReplicatedStorage, \"CornRuntimeArt\")\n\tif not art then\n\t\treturn false, \"CornRuntimeArt\"\n\tend\n\tassert(art:IsA(\"Folder\"), \"CornRuntimeArt must be a Folder\")\n\tlocal owner, project =\n\t\tart:GetAttribute(\"CornRuntimeArtOwned\"), art:GetAttribute(\"corn_project_id\")\n\tassert(owner == nil or owner == true, \"CornRuntimeArt has foreign ownership\")\n\tassert(\n\t\tproject == nil or project == \"children_of_corn\",\n\t\t\"CornRuntimeArt belongs to another project\"\n\t)\n\tif owner ~= true or project ~= \"children_of_corn\" then\n\t\treturn false, \"CornRuntimeArt ownership\"\n\tend\n\tlocal template = uniqueChild(art, \"CornPlantTemplate\")\n\tif not template then\n\t\treturn false, \"CornPlantTemplate\"\n\tend\n\tassert(template:IsA(\"MeshPart\"), \"CornPlantTemplate must be a MeshPart\")\n\tlocal templateOwner = template:GetAttribute(\"CornPlantTemplateOwned\")\n\tassert(templateOwner == nil or templateOwner == true, \"CornPlantTemplate has foreign ownership\")\n\tif templateOwner ~= true then\n\t\treturn false, \"CornPlantTemplate ownership\"\n\tend\n\tlocal mesh = template :: MeshPart\n\tif\n\t\tnot mesh\046Anchored\n\t\tor not mesh\046Archivable\n\t\tor mesh\046CanCollide\n\t\tor mesh\046CanTouch\n\t\tor mesh\046CanQuery\n\t\tor mesh\046MeshId == \"\"\n\tthen\n\t\treturn false, \"CornPlantTemplate static art\"\n\tend\n\tfor _, value in { mesh\046Size\046X, mesh\046Size\046Y, mesh\046Size\046Z } do\n\t\tassert(\n\t\t\tvalue == value and value > 0 and value < math\046huge,\n\t\t\t\"CornPlantTemplate has invalid Size\"\n\t\t)\n\tend\n\tfor _, child in template:GetDescendants() do\n\t\tassert(\n\t\t\tnot child:IsA(\"LuaSourceContainer\")\n\t\t\t\tand not child:IsA(\"Sound\")\n\t\t\t\tand not child:IsA(\"ParticleEmitter\")\n\t\t\t\tand not child:IsA(\"Beam\")\n\t\t\t\tand not child:IsA(\"Trail\")\n\t\t\t\tand not child:IsA(\"ProximityPrompt\")\n\t\t\t\tand not child:IsA(\"ClickDetector\")\n\t\t\t\tand not child:IsA(\"RemoteEvent\")\n\t\t\t\tand not child:IsA(\"RemoteFunction\"),\n\t\t\t\"CornPlantTemplate must contain only static art\"\n\t\t)\n\tend\n\treturn true, \"\"\nend\nlocal readinessOk, problem = pcall(function()\n\tlocal player = assert(Players\046LocalPlayer, \"Local player unavailable during startup\")\n\tlocal gui = player:FindFirstChild(\"PlayerGui\")\n\twhile not gui and os\046clock() < deadline do\n\t\ttask\046wait(math\046min(0\0461, deadline - os\046clock()))\n\t\tgui = player:FindFirstChild(\"PlayerGui\")\n\tend\n\tassert(os\046clock() <= deadline, \"Server map readiness timed out after 60 seconds: PlayerGui\")\n\tassert(gui and gui:IsA(\"PlayerGui\"), \"PlayerGui unavailable before startup deadline\")\n\tlocal screen = Instance\046new(\"ScreenGui\")\n\tloading = screen\n\tscreen\046Name = \"ChildrenOfCornLoading\"\n\tscreen:SetAttribute(\"CornLoadingOwned\", true)\n\tscreen:SetAttribute(\"corn_project_id\", \"children_of_corn\")\n\tscreen\046IgnoreGuiInset = true\n\tscreen\046ResetOnSpawn = false\n\tscreen\046DisplayOrder = 1000\n\tlocal background = Instance\046new(\"Frame\")\n\tbackground\046Size = UDim2\046fromScale(1, 1)\n\tbackground\046BackgroundColor3 = Color3\046fromRGB(15, 19, 14)\n\tbackground\046BackgroundTransparency = 0\04612\n\tbackground\046BorderSizePixel = 0\n\tbackground\046Parent = screen\n\tlocal label = Instance\046new(\"TextLabel\")\n\tlabel\046Size = UDim2\046new(1, -40, 0, 64)\n\tlabel\046AnchorPoint = Vector2\046new(0\0465, 0\0465)\n\tlabel\046Position = UDim2\046fromScale(0\0465, 0\0465)\n\tlabel\046BackgroundTransparency = 1\n\tlabel\046Font = Enum\046Font\046GothamMedium\n\tlabel\046TextSize = 24\n\tlabel\046TextColor3 = Color3\046fromRGB(244, 231, 192)\n\tlabel\046Text = \"Подготовка карты…\"\n\tlabel\046Parent = background\n\tscreen\046Parent = gui\n\tlocal available, missing = ready()\n\twhile not available do\n\t\tlocal remaining = deadline - os\046clock()\n\t\tassert(remaining > 0, \"Server map readiness timed out after 60 seconds: \" \046\046 missing)\n\t\ttask\046wait(math\046min(0\0461, remaining))\n\t\tassert(\n\t\t\tos\046clock() <= deadline,\n\t\t\t\"Server map readiness timed out after 60 seconds: \" \046\046 missing\n\t\t)\n\t\tavailable, missing = ready()\n\tend\n\tassert(\n\t\tos\046clock() <= deadline,\n\t\t\"Server map readiness timed out after 60 seconds: server bindings\"\n\t)\nend)\nif loading then\n\tloading:Destroy()\nend\nif not readinessOk then\n\terror(\"[ChildrenOfCorn] Client startup failed before controllers: \" \046\046 tostring(problem))\nend\n\nlocal controllersFolder = script\046Parent:WaitForChild(\"Controllers\")\n\ntype RuntimeModule = {\n\tName: string?,\n\tOrder: number?,\n\tInit: ((self: RuntimeModule, context: any) -> ())?,\n\tStart: ((self: RuntimeModule, context: any) -> ())?,\n}\n\nlocal loaded: { RuntimeModule } = {}\nlocal byName: { [string]: RuntimeModule } = {}\n\nfor _, child in controllersFolder:GetChildren() do\n\tif child:IsA(\"ModuleScript\") then\n\t\tlocal ok, result = pcall(require, child)\n\t\tif not ok then\n\t\t\terror(\n\t\t\t\tstring\046format(\n\t\t\t\t\t\"Failed to require controller %s: %s\",\n\t\t\t\t\tchild:GetFullName(),\n\t\t\t\t\ttostring(result)\n\t\t\t\t)\n\t\t\t)\n\t\tend\n\t\tif type(result) ~= \"table\" then\n\t\t\terror(string\046format(\"Controller %s must return a table\", child:GetFullName()))\n\t\tend\n\t\tlocal module = result :: RuntimeModule\n\t\tlocal name = module\046Name or child\046Name\n\t\tif byName[name] then\n\t\t\terror(string\046format(\"Duplicate controller name: %s\", name))\n\t\tend\n\t\tmodule\046Name = name\n\t\tbyName[name] = module\n\t\ttable\046insert(loaded, module)\n\tend\nend\n\ntable\046sort(loaded, function(a, b)\n\treturn (a\046Order or 100) < (b\046Order or 100)\nend)\n\nlocal context = {\n\tConfig = Config,\n\tControllers = byName,\n\tLog = Logger\046new(\"Client\", Config\046Debug),\n}\n\nfor _, module in loaded do\n\tif module\046Init then\n\t\tmodule:Init(context)\n\tend\nend\n\nfor _, module in loaded do\n\tif module\046Start then\n\t\tmodule:Start(context)\n\tend\nend\n\nlog:Info(string\046format(\"Started %d controllers\", #loaded))\n"},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/AudioController",class="ModuleScript",before="c6ef8ce10e445663014edb0b4a501bbdbc30b3b7cd989ed4d7eeb1b67b72094c",after="c6ef8ce10e445663014edb0b4a501bbdbc30b3b7cd989ed4d7eeb1b67b72094c",source=nil},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CaptureController",class="ModuleScript",before="f89773a4ad435464819c6f81afae008e07ec63a179f55c3df2e48107894abc32",after="f89773a4ad435464819c6f81afae008e07ec63a179f55c3df2e48107894abc32",source=nil},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CornAppearanceController",class="ModuleScript",before="475ba50562138abeede58b1379f18aeb9fc3064d3bd43e98a23185164ed8463b",after="e2545700c7dc5517699f54a2ae8ee7a3e2939992bb55bd3c1c90be32d2187b60",source="--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Appearance = require(\n\tReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\"):WaitForChild(\"CornAppearance\")\n)\n\nlocal Controller = { Name = \"CornAppearanceController\", Order = 54 }\nlocal PROJECT = \"children_of_corn\"\nlocal BATCH = 384\nlocal TIME_BUDGET = 0\046002\nlocal MAP_ROOTS = {\n\tEditorFieldOverview = \"CornEditorOverview\",\n\tCornClientPlants = \"CornClientRendererOwned\",\n\tCornClientBackdrop = \"CornClientBackdropOwned\",\n}\n\nlocal function recognized(root: Instance, flag: string): boolean\n\treturn root:GetAttribute(flag) == true and root:GetAttribute(\"corn_project_id\") == PROJECT\nend\n\nlocal function ownedPart(root: any, part: MeshPart): boolean\n\tlocal folder = root\046folder\n\tif\n\t\tnot recognized(folder, root\046flag)\n\t\tor not part\046Anchored\n\t\tor part\046CanCollide\n\t\tor part\046CanTouch\n\t\tor part\046CanQuery\n\tthen\n\t\treturn false\n\tend\n\tif root\046flag == \"CornRuntimeArtOwned\" then\n\t\treturn part\046Parent == folder\n\t\t\tand part\046Name == \"CornPlantTemplate\"\n\t\t\tand part:GetAttribute(\"CornPlantTemplateOwned\") == true\n\telseif root\046flag == \"CornClientRendererOwned\" then\n\t\tlocal group = part\046Parent\n\t\treturn group ~= nil\n\t\t\tand group:IsA(\"Folder\")\n\t\t\tand group\046Parent == folder\n\t\t\tand part\046Name == \"Corn\"\n\t\t\tand part:GetAttribute(\"CornPlantTemplateOwned\") == true\n\tend\n\treturn part\046Parent == folder\n\t\tand part:GetAttribute(\"CornEditorOverview\") == true\n\t\tand part:GetAttribute(\"corn_project_id\") == PROJECT\n\t\tand (\n\t\t\troot\046flag ~= \"CornClientBackdropOwned\"\n\t\t\tor part:GetAttribute(\"CornClientBackdropOwned\") == true\n\t\t)\nend\n\nfunction Controller:_enqueue(part: MeshPart)\n\tif not self\046_queued[part] then\n\t\tself\046_queued[part] = true\n\t\ttable\046insert(self\046_queue, part)\n\tend\nend\n\nfunction Controller:_restore(part: MeshPart, entry: any)\n\t-- Preserve an unrelated manual texture change rather than overwriting it\046\n\tif entry\046applied and part\046TextureID == Appearance\046DryTextureId then\n\t\tpart\046TextureID = entry\046texture\n\tend\n\tentry\046applied = false\nend\n\nfunction Controller:_forget(part: MeshPart)\n\tlocal entry = self\046_entries[part]\n\tif entry then\n\t\tself:_restore(part, entry)\n\t\tentry\046root\046parts[part] = nil\n\t\tself\046_entries[part] = nil\n\tend\n\tself\046_queued[part] = nil\nend\n\nfunction Controller:_register(root: any, item: Instance)\n\tif\n\t\tnot item:IsA(\"MeshPart\")\n\t\tor item\046MeshId ~= Appearance\046MeshId\n\t\tor self\046_entries[item]\n\t\tor not ownedPart(root, item)\n\tthen\n\t\treturn\n\tend\n\tif item:FindFirstChildWhichIsA(\"SurfaceAppearance\") then\n\t\treturn\n\tend\n\tlocal texture = item\046TextureID\n\tif texture ~= Appearance\046GreenTextureId and texture ~= Appearance\046DryTextureId then\n\t\treturn\n\tend\n\t-- Prepared/saved yellow copies keep that exact baseline through menu/cleanup\046\n\tlocal entry = {\n\t\troot = root,\n\t\ttexture = texture,\n\t\tapplied = false,\n\t}\n\tself\046_entries[item] = entry\n\troot\046parts[item] = true\n\tself:_enqueue(item)\nend\n\nfunction Controller:_bind(folder: Instance, flag: string)\n\tif self\046_roots[folder] then\n\t\treturn\n\tend\n\tlocal root = { folder = folder, flag = flag, parts = {}, connections = {} }\n\tself\046_roots[folder] = root\n\ttable\046insert(\n\t\troot\046connections,\n\t\tfolder\046DescendantAdded:Connect(function(item)\n\t\t\tself:_register(root, item)\n\t\tend)\n\t)\n\ttable\046insert(\n\t\troot\046connections,\n\t\tfolder\046DescendantRemoving:Connect(function(item)\n\t\t\tif item:IsA(\"MeshPart\") then\n\t\t\t\tself:_forget(item)\n\t\t\tend\n\t\tend)\n\t)\n\tfor _, item in folder:GetDescendants() do\n\t\tself:_register(root, item)\n\tend\nend\n\nfunction Controller:_unbind(root: any)\n\tfor _, connection in root\046connections do\n\t\tconnection:Disconnect()\n\tend\n\tfor part in root\046parts do\n\t\tself:_forget(part)\n\tend\n\tself\046_roots[root\046folder] = nil\nend\n\nfunction Controller:_refresh()\n\tlocal map = Workspace:FindFirstChild(\"CornMap\")\n\tlocal validMap = map and map:IsA(\"Model\") and map:GetAttribute(\"corn_project_id\") == PROJECT\n\tlocal desired = {}\n\tif\n\t\tvalidMap\n\t\tand not Workspace:FindFirstChild(\"Asmr_Base\")\n\t\tand not Workspace:FindFirstChild(\"ASMR_Models\")\n\tthen\n\t\tfor name, flag in MAP_ROOTS do\n\t\t\tlocal folder = map:FindFirstChild(name)\n\t\t\tif folder and folder:IsA(\"Folder\") and recognized(folder, flag) then\n\t\t\t\tdesired[folder] = flag\n\t\t\tend\n\t\tend\n\t\tlocal art = ReplicatedStorage:FindFirstChild(\"CornRuntimeArt\")\n\t\tif art and art:IsA(\"Folder\") and recognized(art, \"CornRuntimeArtOwned\") then\n\t\t\tdesired[art] = \"CornRuntimeArtOwned\"\n\t\tend\n\tend\n\tfor folder, root in self\046_roots do\n\t\tif not desired[folder] then\n\t\t\tself:_unbind(root)\n\t\tend\n\tend\n\tfor folder, flag in desired do\n\t\tself:_bind(folder, flag)\n\tend\nend\n\nfunction Controller:_apply(part: MeshPart)\n\tlocal entry = self\046_entries[part]\n\tif not entry then\n\t\treturn\n\tend\n\tlocal root = entry\046root\n\tif\n\t\tnot part:IsDescendantOf(root\046folder)\n\t\tor not ownedPart(root, part)\n\t\tor part:FindFirstChildWhichIsA(\"SurfaceAppearance\")\n\tthen\n\t\tself:_forget(part)\n\t\treturn\n\tend\n\tlocal expected = if entry\046applied then Appearance\046DryTextureId else entry\046texture\n\tif part\046TextureID ~= expected or part\046MeshId ~= Appearance\046MeshId then\n\t\t-- Drop ownership of this appearance; the author changed the runtime copy\046\n\t\troot\046parts[part] = nil\n\t\tself\046_entries[part] = nil\n\t\treturn\n\tend\n\tif Appearance\046IsDry(self\046_mode) then\n\t\tpart\046TextureID = Appearance\046DryTextureId\n\t\tentry\046applied = true\n\telse\n\t\tself:_restore(part, entry)\n\tend\nend\n\nfunction Controller:SetMode(mode: string?)\n\tif not Appearance\046IsValidMode(mode) or mode == self\046_mode then\n\t\treturn\n\tend\n\tself\046_mode = mode\n\tfor part in self\046_entries do\n\t\tself:_enqueue(part)\n\tend\nend\n\nfunction Controller:Init(_context: any)\n\tself\046_mode = nil\n\tself\046_entries = {}\n\tself\046_roots = {}\n\tself\046_queue = {}\n\tself\046_queued = {}\n\tself\046_head = 1\n\tself\046_poll = 0\nend\n\nfunction Controller:Start(context: any)\n\tif\n\t\tnot RunService:IsStudio()\n\t\tor context\046Config\046Environment ~= \"DEV\"\n\t\tor (\n\t\t\tcontext\046Config\046Game\046SessionMode ~= \"solo_local\"\n\t\t\tand context\046Config\046Game\046SessionMode ~= \"team_local\"\n\t\t)\n\tthen\n\t\treturn\n\tend\n\tself:_refresh()\n\tself\046_heartbeat = RunService\046Heartbeat:Connect(function(dt)\n\t\tself\046_poll += dt\n\t\tif self\046_poll >= 1 then\n\t\t\tself\046_poll = 0\n\t\t\tself:_refresh()\n\t\tend\n\t\tlocal began, count = os\046clock(), 0\n\t\twhile self\046_head <= #self\046_queue and count < BATCH and os\046clock() - began < TIME_BUDGET do\n\t\t\tlocal part = self\046_queue[self\046_head]\n\t\t\tself\046_head += 1\n\t\t\tself\046_queued[part] = nil\n\t\t\tself:_apply(part)\n\t\t\tcount += 1\n\t\tend\n\t\tif self\046_head > #self\046_queue then\n\t\t\ttable\046clear(self\046_queue)\n\t\t\tself\046_head = 1\n\t\tend\n\tend)\nend\n\nfunction Controller:Destroy()\n\tif self\046_heartbeat then\n\t\tself\046_heartbeat:Disconnect()\n\t\tself\046_heartbeat = nil\n\tend\n\tfor _, root in self\046_roots do\n\t\tself:_unbind(root)\n\tend\n\ttable\046clear(self\046_queue)\n\ttable\046clear(self\046_queued)\nend\n\nreturn Controller\n"},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CornBackdropController",class="ModuleScript",before="40537424f04afc896c43669bef5997d8f3ab6ecf20a08af0c1fabd0c9beb0670",after="cdb5ea1633cc45a3aa33a9180713a05b5eaff4ee50ec8dab2df4b0ec29f4699c",source="--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal CornLayout = require(\n\tReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\"):WaitForChild(\"CornLayout\")\n)\n\nlocal CornBackdropController = { Name = \"CornBackdropController\", Order = 45 }\nlocal PROJECT_ID = \"children_of_corn\"\nlocal FOLDER_NAME = \"CornClientBackdrop\"\nlocal STRIDE = 2 -- CornLayout\046Spacing * 2 = 6 studs; tune only after foreground engine QA\046\nlocal MAX_PLANTS = 20000\nlocal CLONE_BUDGET = 18\nlocal TIME_BUDGET = 0\046002\nlocal POLL_SEC = 1\n\nlocal function owned(item: Instance): boolean\n\treturn item:GetAttribute(\"CornClientBackdropOwned\") == true\n\t\tand item:GetAttribute(\"corn_project_id\") == PROJECT_ID\nend\n\nlocal function ownedTree(folder: Instance): boolean\n\tif not owned(folder) then\n\t\treturn false\n\tend\n\tfor _, item in folder:GetDescendants() do\n\t\tif not owned(item) then\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\nlocal function staticArt(template: Instance): boolean\n\tfor _, item in template:GetDescendants() do\n\t\tif\n\t\t\titem:IsA(\"LuaSourceContainer\")\n\t\t\tor item:IsA(\"Sound\")\n\t\t\tor item:IsA(\"ParticleEmitter\")\n\t\t\tor item:IsA(\"Beam\")\n\t\t\tor item:IsA(\"Trail\")\n\t\t\tor item:IsA(\"ProximityPrompt\")\n\t\t\tor item:IsA(\"ClickDetector\")\n\t\t\tor item:IsA(\"RemoteEvent\")\n\t\t\tor item:IsA(\"RemoteFunction\")\n\t\tthen\n\t\t\treturn false\n\t\tend\n\tend\n\treturn template\046Archivable\nend\n\nfunction CornBackdropController:_warn(message: string)\n\tif self\046_lastWarning ~= message then\n\t\tself\046_lastWarning = message\n\t\twarn(\"[CornBackdropController] \" \046\046 message)\n\tend\nend\n\nfunction CornBackdropController:_bridge(folder: Folder): boolean\n\tlocal renderer = self\046_renderer\n\treturn renderer ~= nil\n\t\tand typeof(renderer\046UseBackdropReady) == \"function\"\n\t\tand renderer:UseBackdropReady(folder) == true\nend\n\nfunction CornBackdropController:_restoreOriginals()\n\tfor part, previous in self\046_originals do\n\t\tif part\046Parent then\n\t\t\tpart\046LocalTransparencyModifier = previous\n\t\tend\n\tend\n\ttable\046clear(self\046_originals)\nend\n\nfunction CornBackdropController:_clear()\n\tself\046_epoch += 1\n\tlocal folder = self\046_folder\n\tif folder and owned(folder) then\n\t\tself:_bridge(folder)\n\t\tfolder:SetAttribute(\"Ready\", false)\n\tend\n\tself:_restoreOriginals()\n\tif folder then\n\t\tif ownedTree(folder) then\n\t\t\tfolder:Destroy()\n\t\telse\n\t\t\tself:_warn(\n\t\t\t\t\"Changed ownership or foreign backdrop content was preserved; saved overview restored\"\n\t\t\t)\n\t\tend\n\tend\n\tself\046_folder = nil\n\tself\046_map = nil\n\tself\046_field = nil\n\tself\046_template = nil\n\tself\046_exclusions = nil\n\tself\046_signature = nil\n\tself\046_ready = false\n\tself\046_count = 0\nend\n\nfunction CornBackdropController:_publish(): boolean\n\tlocal folder, map = self\046_folder, self\046_map\n\tif not folder or not map or folder\046Parent ~= map or not owned(folder) then\n\t\treturn false\n\tend\n\tlocal overview = map:FindFirstChild(\"EditorFieldOverview\")\n\tif\n\t\tnot overview\n\t\tor not overview:IsA(\"Folder\")\n\t\tor overview:GetAttribute(\"CornEditorOverview\") ~= true\n\t\tor overview:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\tthen\n\t\tself:_warn(\"Unrecognized saved overview was preserved; backdrop not published\")\n\t\treturn false\n\tend\n\tlocal originals = overview:GetChildren()\n\tfor _, part in originals do\n\t\tif\n\t\t\tnot part:IsA(\"BasePart\")\n\t\t\tor part:GetAttribute(\"CornEditorOverview\") ~= true\n\t\t\tor part:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tthen\n\t\t\tself:_warn(\"Foreign saved overview content was preserved; backdrop not published\")\n\t\t\treturn false\n\t\tend\n\tend\n\t-- Bridge clears the old near-field mask before we capture its exact original LTM\046\n\t-- No yield between bridge, capture/hide and publication\046\n\tif not self:_bridge(folder) then\n\t\tself:_warn(\"Near-field backdrop bridge unavailable; saved overview preserved\")\n\t\treturn false\n\tend\n\tfor _, item in originals do\n\t\tlocal part = item :: BasePart\n\t\tself\046_originals[part] = part\046LocalTransparencyModifier\n\t\tpart\046LocalTransparencyModifier = 1\n\tend\n\tself\046_ready = true\n\tfolder:SetAttribute(\"LoadedPlants\", self\046_count)\n\tfolder:SetAttribute(\"Ready\", true)\n\treturn true\nend\n\nfunction CornBackdropController:_resolveInputs(): boolean\n\tif not self\046_renderer or typeof(self\046_renderer\046UseBackdropReady) ~= \"function\" then\n\t\tself:_clear()\n\t\tself:_warn(\"Near-field backdrop bridge unavailable; saved overview preserved\")\n\t\treturn false\n\tend\n\tlocal map = Workspace:FindFirstChild(\"CornMap\")\n\tlocal field = if map then map:FindFirstChild(\"FieldZone\") else nil\n\tlocal art = ReplicatedStorage:FindFirstChild(\"CornRuntimeArt\")\n\tlocal template = if art then art:FindFirstChild(\"CornPlantTemplate\") else nil\n\tif template and template:IsA(\"Model\") then\n\t\tself:_clear()\n\t\tself:_warn(\n\t\t\t\"Backdrop needs a prepared BasePart template compatible with near-field coverage; saved overview preserved\"\n\t\t)\n\t\treturn false\n\tend\n\tif\n\t\tnot map\n\t\tor not map:IsA(\"Model\")\n\t\tor map:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tor Workspace:FindFirstChild(\"Asmr_Base\")\n\t\tor Workspace:FindFirstChild(\"ASMR_Models\")\n\t\tor not field\n\t\tor not field:IsA(\"BasePart\")\n\t\tor field\046CFrame\046UpVector:Dot(Vector3\046yAxis) < 0\0469999\n\t\tor field\046Size\046X <= 0\n\t\tor field\046Size\046Z <= 0\n\t\tor not art\n\t\tor not art:IsA(\"Folder\")\n\t\tor art:GetAttribute(\"CornRuntimeArtOwned\") ~= true\n\t\tor art:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tor not template\n\t\tor not template:IsA(\"BasePart\")\n\t\tor template:GetAttribute(\"CornPlantTemplateOwned\") ~= true\n\t\tor not staticArt(template)\n\tthen\n\t\tself:_clear()\n\t\tself:_warn(\n\t\t\t\"Owned horizontal field and prepared static art unavailable; saved overview preserved\"\n\t\t)\n\t\treturn false\n\tend\n\tlocal exclusions = CornLayout\046ReadExclusions(map, field)\n\tlocal bounds, size = CornLayout\046Bounds(template)\n\tlocal signature = exclusions\046Signature\n\t\t\046\046 \"/template/\"\n\t\t\046\046 tostring(bounds)\n\t\t\046\046 \"/\"\n\t\t\046\046 tostring(size)\n\tlocal folder = self\046_folder\n\tif\n\t\tself\046_map == map\n\t\tand self\046_field == field\n\t\tand self\046_template == template\n\t\tand self\046_signature == signature\n\t\tand folder\n\t\tand folder\046Parent == map\n\t\tand owned(folder)\n\t\tand folder:GetAttribute(\"CornEditorOverview\") == true\n\t\tand folder:GetAttribute(\"Ready\") == self\046_ready\n\tthen\n\t\treturn true\n\tend\n\tself:_clear()\n\tif map:FindFirstChild(FOLDER_NAME) then\n\t\tself:_warn(\"Existing CornMap/CornClientBackdrop was preserved; no replacement attempted\")\n\t\treturn false\n\tend\n\tif self\046_failedSignature == signature then\n\t\treturn false\n\tend\n\tlocal minColumn, maxColumn, minRow, maxRow = CornLayout\046GetCellBounds(field)\n\tminColumn, minRow = math\046ceil(minColumn / STRIDE) * STRIDE, math\046ceil(minRow / STRIDE) * STRIDE\n\tmaxColumn, maxRow =\n\t\tmath\046floor(maxColumn / STRIDE) * STRIDE, math\046floor(maxRow / STRIDE) * STRIDE\n\tlocal candidateCount = (math\046floor((maxColumn - minColumn) / STRIDE) + 1)\n\t\t* (math\046floor((maxRow - minRow) / STRIDE) + 1)\n\tif candidateCount > MAX_PLANTS or candidateCount <= 0 then\n\t\tself:_warn(\"Full-field grid exceeds the 20000 plant cap; saved overview preserved\")\n\t\treturn false\n\tend\n\tself\046_map, self\046_field, self\046_template = map, field, template\n\tself\046_exclusions, self\046_signature = exclusions, signature\n\tself\046_minColumn, self\046_maxColumn = minColumn, maxColumn\n\tself\046_minRow, self\046_maxRow = minRow, maxRow\n\tself\046_column, self\046_row = minColumn, minRow\n\tself\046_fieldFrame = field\046CFrame\n\tself\046_fieldSize = field\046Size\n\tself\046_fieldYaw = math\046atan2(-field\046CFrame\046LookVector\046X, -field\046CFrame\046LookVector\046Z)\n\tfolder = Instance\046new(\"Folder\")\n\tfolder\046Name = FOLDER_NAME\n\tfolder:SetAttribute(\"CornClientBackdropOwned\", true)\n\tfolder:SetAttribute(\"CornEditorOverview\", true)\n\tfolder:SetAttribute(\"corn_project_id\", PROJECT_ID)\n\tfolder:SetAttribute(\"Ready\", false)\n\tfolder:SetAttribute(\"Stride\", STRIDE)\n\tfolder:SetAttribute(\"DetailStride\", STRIDE * CornLayout\046Spacing)\n\tfolder:SetAttribute(\"MaxPlants\", MAX_PLANTS)\n\tfolder:SetAttribute(\"LoadedPlants\", 0)\n\tfolder\046Parent = map\n\tself\046_folder = folder\n\tself\046_lastWarning = \"\"\n\treturn true\nend\n\nfunction CornBackdropController:_advance()\n\tself\046_column += STRIDE\n\tif self\046_column > self\046_maxColumn then\n\t\tself\046_column = self\046_minColumn\n\t\tself\046_row += STRIDE\n\tend\nend\n\nfunction CornBackdropController:_buildStep()\n\tlocal folder, field, template, exclusions =\n\t\tself\046_folder, self\046_field, self\046_template, self\046_exclusions\n\tif not folder or not field or not template or not exclusions or self\046_ready then\n\t\treturn\n\tend\n\tif\n\t\tfolder\046Parent ~= self\046_map\n\t\tor not owned(folder)\n\t\tor field\046CFrame ~= self\046_fieldFrame\n\t\tor field\046Size ~= self\046_fieldSize\n\tthen\n\t\tself:_clear()\n\t\tself\046_pollElapsed = POLL_SEC\n\t\treturn\n\tend\n\tlocal epoch, start = self\046_epoch, self\046_clock()\n\tlocal created = 0\n\twhile\n\t\tself\046_epoch == epoch\n\t\tand self\046_row <= self\046_maxRow\n\t\tand created < CLONE_BUDGET\n\t\tand self\046_count < MAX_PLANTS\n\t\tand self\046_clock() - start < TIME_BUDGET\n\tdo\n\t\tlocal column, row = self\046_column, self\046_row\n\t\tself:_advance()\n\t\tlocal position = CornLayout\046CellPosition(field, column, row)\n\t\tif CornLayout\046IsExcluded(position, exclusions) then\n\t\t\tcontinue\n\t\tend\n\t\tlocal plant = template:Clone()\n\t\tif not plant then\n\t\t\terror(\"Prepared backdrop plant could not be cloned\")\n\t\tend\n\t\tplant\046Name = string\046format(\"Far_%d_%d\", column, row)\n\t\tlocal parts = plant:GetDescendants()\n\t\ttable\046insert(parts, plant)\n\t\tfor _, item in parts do\n\t\t\titem:SetAttribute(\"CornClientBackdropOwned\", true)\n\t\t\titem:SetAttribute(\"CornEditorOverview\", true)\n\t\t\titem:SetAttribute(\"corn_project_id\", PROJECT_ID)\n\t\t\titem:SetAttribute(\"CornPlantTemplateOwned\", nil)\n\t\t\tif item:IsA(\"BasePart\") then\n\t\t\t\titem\046Anchored = true\n\t\t\t\titem\046CanCollide = false\n\t\t\t\titem\046CanTouch = false\n\t\t\t\titem\046CanQuery = false\n\t\t\t\titem\046CastShadow = false\n\t\t\tend\n\t\tend\n\t\tCornLayout\046ApplyVariation(plant, column, row)\n\t\tplant:PivotTo(\n\t\t\tCornLayout\046PivotForPlant(\n\t\t\t\tplant,\n\t\t\t\tposition,\n\t\t\t\tCornLayout\046CellYaw(column, row) + self\046_fieldYaw\n\t\t\t)\n\t\t)\n\t\tplant\046Parent = folder\n\t\tcreated += 1\n\t\tself\046_count += 1\n\tend\n\tfolder:SetAttribute(\"LoadedPlants\", self\046_count)\n\tfolder:SetAttribute(\"LastFrameClones\", created)\n\tfolder:SetAttribute(\"LastFrameSeconds\", self\046_clock() - start)\n\tif self\046_row > self\046_maxRow then\n\t\tif not self:_publish() then\n\t\t\tlocal failed = self\046_signature\n\t\t\tself:_clear()\n\t\t\tself\046_failedSignature = failed\n\t\tend\n\tend\nend\n\nfunction CornBackdropController:_step(delta: number)\n\tself\046_pollElapsed += delta\n\tif self\046_pollElapsed >= POLL_SEC then\n\t\tself\046_pollElapsed = 0\n\t\tself:_resolveInputs()\n\tend\n\tself:_buildStep()\nend\n\nfunction CornBackdropController:Init(context: any)\n\tself\046_enabled = RunService:IsStudio()\n\t\tand context\046Config\046Environment == \"DEV\"\n\t\tand (\n\t\t\tcontext\046Config\046Game\046SessionMode == \"solo_local\"\n\t\t\tor context\046Config\046Game\046SessionMode == \"team_local\"\n\t\t)\n\tself\046_renderer = context\046Controllers\046CornController\n\tself\046_connection = nil\n\tself\046_clock = os\046clock\n\tself\046_epoch = 0\n\tself\046_originals = {}\n\tself\046_ready = false\n\tself\046_count = 0\n\tself\046_lastWarning = \"\"\n\tself\046_pollElapsed = math\046huge\n\tself\046_failedSignature = nil\nend\n\nfunction CornBackdropController:Start()\n\tif not self\046_enabled or self\046_connection then\n\t\treturn\n\tend\n\tself\046_connection = RunService\046Heartbeat:Connect(function(delta: number)\n\t\tlocal ok, problem = pcall(self\046_step, self, delta)\n\t\tif not ok then\n\t\t\tlocal failed = self\046_signature\n\t\t\tself:_clear()\n\t\t\tself\046_failedSignature = failed\n\t\t\tself:_warn(\"Backdrop build failed; saved overview restored: \" \046\046 tostring(problem))\n\t\tend\n\tend)\nend\n\nfunction CornBackdropController:Destroy()\n\tself\046_enabled = false\n\tif self\046_connection then\n\t\tself\046_connection:Disconnect()\n\t\tself\046_connection = nil\n\tend\n\tself:_clear()\n\tself\046_renderer = nil\nend\n\nreturn CornBackdropController\n"},
{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CornController",class="ModuleScript",before="6d2c7e4336a1773bd8d5943bb85b686dc4df2c9097c1c7cdf836cc1476ef1e2d",after="9b4fda9dcb51a2351ddefed6ecf2d77ea7c4e3a98b14fe6ba37355a315f2bcc4",source="--!strict\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal GameShared = ReplicatedStorage:WaitForChild(\"GameShared\")\nlocal CornLayout = require(GameShared:WaitForChild(\"Game\"):WaitForChild(\"CornLayout\"))\n\ntype Chunk = {\n\tKey: string,\n\tLod: number,\n\tFolder: Folder,\n\tMinColumn: number,\n\tMaxColumn: number,\n\tMinRow: number,\n\tMaxRow: number,\n\tColumn: number,\n\tRow: number,\n\tDistance: number,\n\tCount: number,\n\tAlive: boolean,\n\tDone: boolean,\n}\n\ntype OverviewItem = {\n\tPart: BasePart,\n\tPreviousModifier: number,\n\tFrame: CFrame,\n\tSize: Vector3,\n\tKeys: { string },\n\tHidden: boolean,\n}\n\nlocal CornController = {\n\tName = \"CornController\",\n\tOrder = 50,\n\t_enabled = false,\n\t_connection = nil :: RBXScriptConnection?,\n\t_map = nil :: Model?,\n\t_field = nil :: BasePart?,\n\t_template = nil :: CornLayout\046Plant?,\n\t_folder = nil :: Folder?,\n\t_chunks = {} :: { [string]: Chunk },\n\t_queue = {} :: { Chunk },\n\t_exclusions = nil :: CornLayout\046Exclusions?,\n\t_pivotOffset = CFrame\046identity,\n\t_height = CornLayout\046Height,\n\t_pollElapsed = math\046huge,\n\t_plantCount = 0,\n\t_lastWarning = \"\",\n\t_overviewFolder = nil :: Folder?,\n\t_overviewParts = {} :: { [BasePart]: OverviewItem },\n\t_overviewByChunk = {} :: { [string]: { OverviewItem } },\n\t_overviewDirty = {} :: { [OverviewItem]: boolean },\n\t_overviewFieldFrame = CFrame\046identity,\n\t_overviewFieldSize = Vector3\046zero,\n\t_overviewInvalid = true,\n\t_overviewRuntime = false,\n\t_overviewConnections = {} :: { RBXScriptConnection },\n}\n\nlocal PROJECT_ID = \"children_of_corn\"\nlocal POLL_SEC = 0\0463\nlocal CREATE_BUDGET = 18\nlocal CELL_BUDGET = 100\nlocal TIME_BUDGET_SEC = 0\046003\nlocal MAX_CHUNKS = 100\nlocal MAX_PLANTS = 4032\nlocal LOD_HYSTERESIS = 12\nlocal RETAIN_MARGIN = 18\nlocal ELEVATED_MEDIUM_RADIUS = 144\n\nfunction CornController:_warn(message: string)\n\tif self\046_lastWarning ~= message then\n\t\tself\046_lastWarning = message\n\t\twarn(\"[CornController] \" \046\046 message)\n\tend\nend\n\nlocal function overviewKeys(field: BasePart, part: BasePart): { string }\n\tlocal relative = field\046CFrame:ToObjectSpace(part\046CFrame)\n\tlocal half = part\046Size / 2\n\t-- Require completed fine groups across the entire rotated coarse footprint\046\n\t-- The margin also covers the small deterministic cell stagger\046\n\tlocal padding = CornLayout\046Spacing * 0\04675\n\tlocal halfX = math\046abs(relative\046RightVector\046X) * half\046X\n\t\t+ math\046abs(relative\046UpVector\046X) * half\046Y\n\t\t+ math\046abs(relative\046LookVector\046X) * half\046Z\n\t\t+ padding\n\tlocal halfZ = math\046abs(relative\046RightVector\046Z) * half\046X\n\t\t+ math\046abs(relative\046UpVector\046Z) * half\046Y\n\t\t+ math\046abs(relative\046LookVector\046Z) * half\046Z\n\t\t+ padding\n\tlocal fieldHalf = field\046Size / 2\n\tlocal minX = math\046max(relative\046Position\046X - halfX, -fieldHalf\046X)\n\tlocal maxX = math\046min(relative\046Position\046X + halfX, fieldHalf\046X)\n\tlocal minZ = math\046max(relative\046Position\046Z - halfZ, -fieldHalf\046Z)\n\tlocal maxZ = math\046min(relative\046Position\046Z + halfZ, fieldHalf\046Z)\n\tlocal keys: { string } = {}\n\tif minX > maxX or minZ > maxZ then\n\t\treturn keys\n\tend\n\tlocal width = CornLayout\046Spacing * CornLayout\046ChunkCells\n\tlocal offset = CornLayout\046Spacing / 2\n\tfor column = math\046floor((minX + offset) / width), math\046floor((maxX + offset) / width) do\n\t\tfor row = math\046floor((minZ + offset) / width), math\046floor((maxZ + offset) / width) do\n\t\t\ttable\046insert(keys, column \046\046 \":\" \046\046 row)\n\t\tend\n\tend\n\treturn keys\nend\n\nfunction CornController:_showOverview()\n\tfor _, entry in self\046_overviewParts do\n\t\tif entry\046Hidden then\n\t\t\tif entry\046Part\046Parent then\n\t\t\t\tentry\046Part\046LocalTransparencyModifier = entry\046PreviousModifier\n\t\t\tend\n\t\t\tentry\046Hidden = false\n\t\tend\n\tend\n\tself\046_overviewDirty = {}\nend\n\nfunction CornController:_invalidateOverview()\n\tif self\046_overviewInvalid then\n\t\treturn\n\tend\n\tself\046_overviewInvalid = true\n\t-- A changed footprint or ownership must never keep an old local coverage mask\046\n\tself:_showOverview()\n\tself\046_pollElapsed = POLL_SEC\nend\n\nfunction CornController:_restoreOverview()\n\tfor _, connection in self\046_overviewConnections do\n\t\tconnection:Disconnect()\n\tend\n\ttable\046clear(self\046_overviewConnections)\n\tself\046_overviewInvalid = true\n\tself:_showOverview()\n\tself\046_overviewFolder = nil\n\tself\046_overviewRuntime = false\n\tself\046_overviewParts = {}\n\tself\046_overviewByChunk = {}\nend\n\nfunction CornController:_markOverviewChunk(key: string)\n\tfor _, entry in self\046_overviewByChunk[key] or {} do\n\t\tself\046_overviewDirty[entry] = true\n\tend\nend\n\nlocal function ownedBackdrop(folder: Instance?, map: Model?): boolean\n\treturn folder ~= nil\n\t\tand map ~= nil\n\t\tand folder:IsA(\"Folder\")\n\t\tand folder\046Name == \"CornClientBackdrop\"\n\t\tand folder\046Parent == map\n\t\tand folder:GetAttribute(\"CornClientBackdropOwned\") == true\n\t\tand folder:GetAttribute(\"CornEditorOverview\") == true\n\t\tand folder:GetAttribute(\"corn_project_id\") == PROJECT_ID\nend\n\nfunction CornController:UseBackdropReady(folder: Folder): boolean\n\tlocal map = Workspace:FindFirstChild(\"CornMap\")\n\tif\n\t\tnot map\n\t\tor not map:IsA(\"Model\")\n\t\tor map:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tor not ownedBackdrop(folder, map)\n\tthen\n\t\treturn false\n\tend\n\t-- The backdrop calls this before capturing authored visibility and publishing Ready\046\n\t-- It also calls it before releasing the runtime layer, while ownership is intact\046\n\tself:_restoreOverview()\n\tself\046_pollElapsed = POLL_SEC\n\treturn true\nend\n\nfunction CornController:_bindOverview()\n\tlocal map = self\046_map\n\tlocal field = self\046_field\n\tlocal folder = if map then map:FindFirstChild(\"EditorFieldOverview\") else nil\n\tlocal backdrop = if map then map:FindFirstChild(\"CornClientBackdrop\") else nil\n\tlocal runtime = ownedBackdrop(backdrop, map) and backdrop:GetAttribute(\"Ready\") == true\n\tif runtime then\n\t\tfolder = backdrop\n\tend\n\tif not folder then\n\t\tself:_restoreOverview()\n\t\treturn\n\tend\n\tif\n\t\tnot field\n\t\tor not folder:IsA(\"Folder\")\n\t\tor folder:GetAttribute(\"CornEditorOverview\") ~= true\n\t\tor folder:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\tthen\n\t\tself:_restoreOverview()\n\t\tself:_warn(\"Unrecognized EditorFieldOverview is preserved\")\n\t\treturn\n\tend\n\tif\n\t\tnot self\046_overviewInvalid\n\t\tand self\046_overviewFolder == folder\n\t\tand self\046_overviewFieldFrame == field\046CFrame\n\t\tand self\046_overviewFieldSize == field\046Size\n\tthen\n\t\treturn -- Signals invalidate the index instead of scanning every saved plant every poll\046\n\tend\n\tlocal children = folder:GetChildren()\n\t-- This pass does not yield or change visibility\046 The whole container must be owned\046\n\tfor _, item in children do\n\t\tif\n\t\t\tnot item:IsA(\"BasePart\")\n\t\t\tor item:GetAttribute(\"CornEditorOverview\") ~= true\n\t\t\tor item:GetAttribute(\"corn_project_id\") ~= PROJECT_ID\n\t\tthen\n\t\t\tself:_restoreOverview()\n\t\t\tself:_warn(\"EditorFieldOverview contains unowned objects; all were preserved\")\n\t\t\treturn\n\t\tend\n\tend\n\tself:_restoreOverview()\n\tself\046_overviewFolder = folder\n\tself\046_overviewRuntime = runtime\n\tself\046_overvie