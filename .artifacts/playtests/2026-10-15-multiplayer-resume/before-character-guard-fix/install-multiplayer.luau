{path="StarterPlayer/StarterPlayerScripts/GameClient/Controllers/CornWindController",class="ModuleScript",before="458d95a423b38f6abaa37b33bb138cef883d81b913e156a530a583e8d4aa6726",after="16138f9575f184e1f26606ca4586c897177b6b40210124f87bdd40ae09871515",source="--!strict\nlocal RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal CornWindController = { Name = \"CornWindController\", Order = 55 }\nlocal PROJECT_ID = \"children_of_corn\"\nlocal BUCKET_SIZE = 6\nlocal RADIUS = 5\nlocal MONSTER_VIEW_RADIUS = 70\nlocal UPDATE_SEC = 1 / 12\nlocal SELECT_SEC = 0\0462\nlocal RESOLVE_SEC = 0\0465\nlocal INDEX_BUDGET = 64\nlocal INDEX_SECONDS = 0\046001\nlocal ACTOR_LIMIT = 2\nlocal SCAN_LIMIT = 128\nlocal PART_LIMIT = 32\nlocal TRAIL_SEC = 0\0463\nlocal MAX_PARTS_PER_PLANT = 8\nlocal ANGLE = math\046rad(3)\n\nlocal function disconnect(connections: { RBXScriptConnection })\n\tfor _, connection in connections do\n\t\tconnection:Disconnect()\n\tend\n\ttable\046clear(connections)\nend\n\nlocal function decorative(part: BasePart): boolean\n\treturn part\046Anchored and not part\046CanCollide and not part\046CanTouch and not part\046CanQuery\nend\n\nlocal function bucketKey(x: number, z: number): string\n\treturn tostring(x) \046\046 \":\" \046\046 tostring(z)\nend\n\nfunction CornWindController:_ownedLayer(folder: Instance, kind: string): boolean\n\treturn folder:IsA(\"Folder\")\n\t\tand folder\046Parent == self\046_map\n\t\tand folder:GetAttribute(\"corn_project_id\") == PROJECT_ID\n\t\tand (\n\t\t\tif kind == \"near\"\n\t\t\t\tthen folder\046Name == \"CornClientPlants\" and folder:GetAttribute(\n\t\t\t\t\t\"CornClientRendererOwned\"\n\t\t\t\t) == true\n\t\t\t\telse folder\046Name == \"CornClientBackdrop\" and folder:GetAttribute(\n\t\t\t\t\t\"CornClientBackdropOwned\"\n\t\t\t\t) == true and folder:GetAttribute(\"CornEditorOverview\") == true\n\t\t)\nend\n\nfunction CornWindController