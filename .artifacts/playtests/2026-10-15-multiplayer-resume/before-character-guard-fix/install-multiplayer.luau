d value <= maximum\nend\n\nlocal function validTeam(value: any): boolean\n\treturn value == nil\n\t\tor (\n\t\t\ttypeof(value) == \"table\"\n\t\t\tand boundedInteger(value\046round_id, 9007199254740991)\n\t\t\tand typeof(value\046state) == \"string\"\n\t\t\tand ({ waiting = true, preparing = true, active = true, finished = true })[value\046state] == true\n\t\t\tand value\046capacity == 4\n\t\t\tand boundedInteger(value\046count, value\046capacity)\n\t\t\tand boundedInteger(value\046ready_count, value\046count)\n\t\t\tand boundedInteger(value\046remaining, value\046count)\n\t\t\tand typeof(value\046ready) == \"boolean\"\n\t\t\tand typeof(value\046can_start) == \"boolean\"\n\t\t\tand typeof(value\046key_state) == \"string\"\n\t\t\tand ({ hidden = true, carried = true, opened = true })[value\046key_state] == true\n\t\t\tand typeof(value\046carrier_name) == \"string\"\n\t\t\tand #value\046carrier_name <= 50\n\t\t)\nend\n\nlocal function validSnapshot(value: any): boolean\n\treturn typeof(value) == \"table\"\n\t\tand validTeam(value\046team)\n\t\tand LightingModes\046IsValid(value\046lighting_mode)\n\t\tand MinimapGeometry\046IsValid(value\046minimap)\n\t\tand Inventory\046IsValidSnapshot(value\046inventory)\n\t\tand Capture\046IsValidSnapshot(value\046capture)\n\t\tand typeof(value\046phase) == \"string\"\n\t\tand PHASES[value\046phase] == true\n\t\tand (value\046phase == \"caught\" or value\046capture\046remaining == 0)\n\t\tand typeof(value\046has_key) == \"boolean\"\n\t\tand typeof(value\046gate_open) == \"boolean\"\n\t\tand (value\046evacuation == nil or (typeof(value\046evacuation) == \"table\" and typeof(\n\t\t\tvalue\046evacuation\046active\n\t\t) == \"boolean\" and value\046evacuation\046duration == 120 and nonnegativeNumber(\n\t\t\tvalue\046evacuation\046remaining\n\t\t) and value\046evacuation\046remaining <= 120 and (value\046evacuation\046active or value\046evacuation\046remaining == 0)))\n\t\tand nonnegativeNumber(value\046session_diamonds)\n\t\tand nonnega