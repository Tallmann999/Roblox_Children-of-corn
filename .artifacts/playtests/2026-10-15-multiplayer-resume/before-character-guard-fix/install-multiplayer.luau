{path="ServerScriptService/GameServer/Game/MonsterHunt",class="ModuleScript",before="f4528ca78f7c9227016a6ce0ab23fd10a8a1b699673c4744f841b4ad82a019e1",after="5e82a9e50fdf6cb7b0193d370d1890287aeb18e373b5f9f0e203682af0e6c63a",source="--!strict\nlocal PathfindingService = game:GetService(\"PathfindingService\")\nlocal Pose = require(\n\tgame:GetService(\"ReplicatedStorage\")\n\t\t:WaitForChild(\"GameShared\")\n\t\t:WaitForChild(\"Game\")\n\t\t:WaitForChild(\"MonsterPose\")\n)\nlocal MonsterHunt = {}\nMonsterHunt\046__index = MonsterHunt\n\nlocal function validUserId(value: any): boolean\n\treturn type(value) == \"number\"\n\t\tand value == value\n\t\tand math\046abs(value) < math\046huge\n\t\tand value ~= 0\n\t\tand value % 1 == 0\nend\n\nfunction MonsterHunt\046new(\n\tworld: any,\n\tbalance: any,\n\tstartedAt: number,\n\ttargetUserId: number?,\n\toptions: any?\n)\n\toptions = options or {}\n\tlocal index = options\046index or 1\n\tassert(index == 1 or index == 2 or index == 3, \"Unknown monster index\")\n\tlocal modelName = if index == 1 then \"Monster\" else \"Monster\" \046\046 index\n\tassert(not world\046Runtime:FindFirstChild(modelName), \"Monster name already occupied\")\n\tlocal home = world\046Home:FindFirstChild(\"Body\") :: BasePart\n\tassert(home and home:IsA(\"BasePart\"), \"Scarecrow home body missing\")\n\tlocal floor = world\046Ground\046Position\046Y + world\046Ground\046Size\046Y / 2\n\tlocal model = Instance\046new(\"Model\")\n\tmodel\046Name = modelName\n\tmodel:SetAttribute(\"CornMonsterOwned\", true)\n\tmodel:SetAttribute(\"corn_project_id\", \"children_of_corn\")\n\tmodel:SetAttribute(\"MonsterRigVersion\", 1)\n\tmodel:SetAttribute(\"MonsterIndex\", index)\n\tmodel:SetAttribute(\"HuntState\", \"dormant\")\n\tmodel:SetAttribute(\"ChaseTargetUserId\", 0)\n\tlocal at = options\046position or home\046Position\n\tassert(typeof(at) == \"Vector3\", \"Monster spawn position missing\")\n\tlocal origin = Vector3\046new(at\046X, floor + 3, at\046Z)\n\tlocal visuals = {}\n\tlocal function part(\n\t\tname: string,\n\t\tsize: Vector3,\n\t\toffset: Vector3,\n\t\tcolor: Color3,\n\t\thidden: boolean?\n\t): Part\n\t\tlocal p = Instance\046new(\"Part\")\n\t\tp\046Name = name\n\t\tp\046Size = size\n\t\tp\046CFrame = CFrame\046new(origin + offset)\n\t\tp\046Color = color\n\t\tp\046Anchored = true\n\t\tp\046CanCollide = false\n\t\tp\046CanTouch = false\n\t\tp\046CanQuery = false\n\t\tp\046Transparency = 1\n\t\tp\046Parent = model\n\t\tif not hidden then\n\t\t\ttable\046insert(visuals, p)\n\t\tend\n\t\treturn p\n\tend\n\tlocal root = part(\"Root\", Vector3\046new(3, 6, 2), Vector3\046zero, Color3\046new(), true)\n\tfor _, definition in Pose\046Parts do\n\t\tlocal visual = part(\n\t\t\tdefinition\046Name,\n\t\t\tdefinition\046Size,\n\t\t\tPose\046Rest[definition\046Name]\046Position,\n\t\t\tdefinition\046Color\n\t\t)\n\t\tvisual\046Material = definition\046Material\n\tend\n\tmodel:SetAttribute(\"MonsterHeightScale\", Pose\046HeightScale)\n\tmodel\046PrimaryPart = root\n\tmodel\046Parent = world\046Runtime\n\tlocal self = setmetatable({\n\t\tworld = world,\n\t\tbalance = balance,\n\t\tstartedAt = startedAt,\n\t\tmodel = model,\n\t\troot = root,\n\t\tvisuals = visuals,\n\t\thome = origin,\n\t\tstate = \"dormant\",\n\t\tchaseStartedAt = nil,\n\t\tfirstChaseUsed = options\046immediate == true,\n\t\tdetectRadius = balance\046monster_detect_radius,\n\t\tfirstChaseUntil = nil,\n\t\treacquireAt = -math\046huge,\n\t\ttargetUserId = if validUserId(targetUserId) then targetUserId else 0,\n\t\ttargetRoot = nil :: BasePart?,\n\t\tstunnedUntil = nil,\n\t\tlostSince = nil,\n\t\tlastSeenPosition = nil,\n\t\tpatrolSlot = nil,\n\t\tpatrolIndex = nil,\n\t\tgoal = nil,\n\t\troute = nil,\n\t\trouteIndex = 2,\n\t\tpathAt = -math\046huge,\n\t\tpathBusy = false,\n\t\tgeneration = 0,\n\t\tdestroyed = false,\n\t\toriginalMarker = {},\n\t\tblockedSince = nil,\n\t}, MonsterHunt)\n\tif options\046immediate then\n\t\tfor _, visual in visuals do\n\t\t\tvisual\046Transparency = 0\n\t\tend\n\t\tself:_state(\"patrol\", startedAt)\n\tend\n\treturn self\nend\n\nfunction MonsterHunt:SetDetectionMultiplier(multiplier: number)\n\tassert(multiplier == 1 or multiplier == 2, \"Invalid hunt detection multiplier\")\n\tself\046detectRadius = self\046balance\046monster_detect_radius * multiplier\n\tself\046model:SetAttribute(\"DetectionRadius\", self\046detectRadius)\nend\n\nfunction MonsterHunt:_state(state: string, now: number?)\n\tif self\046state == state then\n\t\treturn\n\tend\n\t-- A completed path belongs to the state that requested it\046 Cancel stale work\n\t-- only on transitions; visible chase polls must preserve a current path\046\n\tself\046generation += 1\n\tself\046route = nil\n\tself\046routeIndex = 2\n\tself\046pathBusy = false\n\tself\046pathAt = -math\046huge\n\tself\046state = state\n\tself\046chaseStartedAt = if state == \"chase\" then now or os\046clock() else nil\n\tif state ~= \"chase\" then\n\t\t-- Consumption belongs to the round, not a capture, trap or home reset\046\n\t\tself\046firstChaseUntil = nil\n\tend\n\tself\046model:SetAttribute(\"HuntState\", state)\n\tself\046model:SetAttribute(\"ChaseTargetUserId\", if state == \"chase\" then self\046targetUserId else 0)\nend\n\nfunction MonsterHunt:_params(character: Model?): RaycastParams\n\tlocal params = RaycastParams\046new()\n\tparams\046FilterType = Enum\046RaycastFilterType\046Exclude\n\tparams\046FilterDescendantsInstances = if character\n\t\tthen { self\046model, self\046world\046Home, character }\n\t\telse { self\046model, self\046world\046Home }\n\tparams\046RespectCanCollide = true\n\treturn params\nend\n\nfunction MonsterHunt:CanSee(playerRoot: BasePart): boolean\n\tlocal start = self\046root\046Position + Vector3\046new(0, 1, 0)\n\treturn workspace:Raycast(\n\t\tstart,\n\t\tplayerRoot\046Position - start,\n\t\tself:_params(playerRoot\046Parent :: Model)\n\t) == nil\nend\n\nfunction MonsterHunt:CanCapture(playerRoot: BasePart, now: number?): boolean\n\tlocal at = now or os\046clock()\n\tif\n\t\tself\046destroyed\n\t\tor self\046state ~= \"chase\"\n\t\tor not self\046chaseStartedAt\n\t\tor at - self\046chaseStartedAt < self\046balance\046monster_chase_windup_sec\n\t\tor (self\046firstChaseUntil and at >= self\046firstChaseUntil)\n\tthen\n\t\treturn false\n\tend\n\tlocal delta = playerRoot\046Position - self\046root\046Position\n\tif\n\t\tVector3\046new(delta\046X, 0, delta\046Z)\046Magnitude > self\046balance\046monster_capture_radius\n\t\tor math\046abs(delta\046Y) > 7\n\tthen\n\t\treturn false\n\tend\n\treturn self:CanSee(playerRoot)\nend\n\nfunction MonsterHunt:_chaseSpeed(playerRoot: BasePart, now: number): number\n\tif self\046firstChaseUntil then\n\t\tlocal character = playerRoot\046Parent\n\t\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\t\tlocal speed = if humanoid then humanoid\046WalkSpeed else nil\n\t\t-- SoloRound writes this server value before Step\046 Never accept a client\n\t\t-- speed argument; invalid values fall back to normal walking\046 Energy's\n\t\t-- existing multiplier is two, including sprint+energy (18*2 = 36)\046\n\t\tlocal maxSpeed = math\046max(self\046balance\046walk_speed, self\046balance\046sprint_speed) * 2\n\t\treturn if typeof(speed) == \"number\"\n\t\t\t\tand speed == speed\n\t\t\t\tand speed > 0\n\t\t\t\tand speed < math\046huge\n\t\t\tthen math\046min(speed, maxSpeed)\n\t\t\telse self\046balance\046walk_speed\n\tend\n\treturn if self\046chaseStartedAt\n\t\t\tand now - self\046chaseStartedAt >= self\046balance\046monster_chase_windup_sec\n\t\tthen self\046balance\046monster_chase_speed\n\t\telse self\046balance\046monster_patrol_speed\nend\n\nfunction MonsterHunt:BeginCapture(playerPosition: Vector3): CFrame\n\tlocal at = self\046root\046Position\n\tlocal facing = Vector3\046new(playerPosition\046X - at\046X, 0, playerPosition\046Z - at\046Z)\n\tif facing\046Magnitude > 0\046001 then\n\t\tself\046model:PivotTo(CFrame\046lookAt(at, at + facing))\n\tend\n\tself\046goal = nil\n\tself\046lostSince = nil\n\tself\046lastSeenPosition = nil\n\tself:_state(\"capturing\")\n\treturn self\046root\046CFrame\nend\n\nfunction MonsterHunt:EndCapture(): boolean\n\tif self\046destroyed or self\046state ~= \"capturing\" then\n\t\treturn false\n\tend\n\tself\046targetRoot, self\046targetUserId = nil, 0\n\tself\046goal, self\046lostSince, self\046lastSeenPosition, self\046blockedSince = nil, nil, nil, nil\n\tself:_state(\"patrol\")\n\treturn true\nend\n\nfunction MonsterHunt:GetPosition(): Vector3?\n\tif self\046destroyed or self\046state == \"dormant\" or self\046state == \"stopped\" then\n\t\treturn nil\n\tend\n\treturn self\046root\046Position\nend\n\nfunction MonsterHunt:Stun(now: number, duration: number): boolean\n\tif\n\t\tself\046destroyed\n\t\tor (self\046state ~= \"patrol\" and self\046state ~= \"chase\")\n\t\tor typeof(now) ~= \"number\"\n\t\tor typeof(duration) ~= \"number\"\n\t\tor now ~= now\n\t\tor duration ~= duration\n\t\tor math\046abs(now) == math\046huge\n\t\tor duration <= 0\n\t\tor duration == math\046huge\n\t\tor math\046abs(now + duration) == math\046huge\n\tthen\n\t\treturn false\n\tend\n\tself\046stunnedUntil = now + duration\n\tself\046goal = nil\n\tself\046lostSince = nil\n\tself\046lastSeenPosition = nil\n\tself\046blockedSince = nil\n\t-- _state invalidates pending ComputeAsync jobs before they can restore a\n\t-- route for the chase that stepped into the trap\046\n\tself:_state(\"trapped\")\n\treturn true\nend\n\nfunction MonsterHunt:_patrol(_playerPosition: Vector3): Vector3\n\tlocal slots = self\046world\046Slots\n\tlocal index = self\046patrolIndex\n\tif index then\n\t\tindex = (index - 1 + 7) % #slots + 1\n\telse\n\t\tlocal distance = math\046huge\n\t\tfor candidateIndex, slot in slots do\n\t\t\tlocal d = (slot\046Position - self\046root\046Position)\046Magnitude\n\t\t\tif d < distance then\n\t\t\t\tindex = candidateIndex\n\t\t\t\tdistance = d\n\t\t\tend\n\t\tend\n\tend\n\t-- AuthoredWorld sorts the fifteen available slots by their unique slot_id\046\n\t-- A stride of seven visits every slot once without using the player's position\046\n\tself\046patrolIndex = index or 1\n\tself\046patrolSlot = slots[self\046patrolIndex]\n\treturn self\046patrolSlot\046Position\nend\n\nfunction MonsterHunt:_path(goal: Vector3, now: number)\n\tif self\046pathBusy or now - self\046pathAt < 1 then\n\t\treturn\n\tend\n\tself\046pathBusy = true\n\tself\046pathAt = now\n\tlocal generation = self\046generation\n\tlocal began = self\046root\046Position\n\ttask\046spawn(function()\n\t\tlocal path = PathfindingService:CreatePath({\n\t\t\tAgentRadius = 2,\n\t\t\tAgentHeight = 9,\n\t\t\tAgentCanJump = false,\n\t\t\tWaypointSpacing = 4,\n\t\t})\n\t\tlocal ok = pcall(function()\n\t\t\tpath:ComputeAsync(began, goal)\n\t\tend)\n\t\tif self\046destroyed or self\046generation ~= generation then\n\t\t\treturn\n\t\tend\n\t\tself\046pathBusy = false\n\t\tif ok and path\046Status == Enum\046PathStatus\046Success then\n\t\t\tself\046route = path:GetWaypoints()\n\t\t\tself\046routeIndex = 2\n\t\telse\n\t\t\tself\046route = nil\n\t\tend\n\tend)\nend\n\nfunction MonsterHunt:ResetHome()\n\tself\046stunnedUntil = nil\n\tself\046generation += 1\n\tself\046pathBusy = false\n\tself\046route = nil\n\tself\046goal = nil\n\tself\046lostSince = nil\n\tself\046lastSeenPosition = nil\n\tself\046patrolSlot = nil\n\tself\046patrolIndex = nil\n\tself\046blockedSince = nil\n\tself\046model:PivotTo(CFrame\046new(self\046home))\n\tself:_state(\"patrol\")\nend\n\nfunction MonsterHunt:Step(\n\tdt: number,\n\tnow: number,\n\tplayerRoot: BasePart,\n\tprotected: boolean\n): (boolean, boolean)\n\tif self\046destroyed or self\046state == \"capturing\" then\n\t\treturn false, false\n\tend\n\tif self\046state == \"trapped\" then\n\t\tif now < self\046stunnedUntil then\n\t\t\treturn false, false\n\t\tend\n\t\tself\046stunnedUntil = nil\n\t\tself:_state(\"patrol\")\n\tend\n\tlocal awakened = false\n\tif self\046state == \"dormant\" then\n\t\tif now - self\046startedAt < self\046balance\046hunt_start_delay_sec then\n\t\t\treturn false, false\n\t\tend\n\t\tfor _, p in self\046visuals do\n\t\t\tp\046Transparency = 0\n\t\tend\n\t\tfor _, item in self\046world\046Home:GetDescendants() do\n\t\t\tif item:IsA(\"BasePart\") and item\046Name ~= \"Pole\" then\n\t\t\t\tself\046originalMarker[item] = item\046Transparency\n\t\t\t\titem\046Transparency = 1\n\t\t\tend\n\t\tend\n\t\tself:_state(\"patrol\")\n\t\tawakened = true\n\tend\n\tlocal delta = playerRoot\046Position - self\046root\046Position\n\tlocal distance = Vector3\046new(delta\046X, 0, delta\046Z)\046Magnitude\n\tlocal canSee = not protected and self:CanSee(playerRoot)\n\tif self\046state == \"chase\" and self\046firstChaseUntil and now >= self\046firstChaseUntil then\n\t\t-- The timed loss wins over capture even if the target is still visible\n\t\t-- and close\046 Transition cancels the old asynchronous route by epoch\046\n\t\tself\046reacquireAt = now + self\046balance\046monster_first_chase_reacquire_sec\n\t\tself:_state(\"patrol\")\n\t\tself\046goal = nil\n\t\tself\046lostSince = nil\n\t\tself\046lastSeenPosition = nil\n\t\tself\046blockedSince = nil\n\tend\n\tif\n\t\tcanSee\n\t\tand distance <= (self\046detectRadius or self\046balance\046monster_detect_radius)\n\t\tand now >= self\046reacquireAt\n\tthen\n\t\tlocal newlyDetected = self\046state ~= \"chase\"\n\t\tself:_state(\"chase\", now)\n\t\tif newlyDetected then\n\t\t\tif not self\046firstChaseUsed then\n\t\t\t\tself\046firstChaseUntil = now + self\046balance\046monster_first_chase_duration_sec\n\t\t\tend\n\t\t\tself\046firstChaseUsed = true\n\t\tend\n\t\tself\046lostSince = nil\n\t\tself\046lastSeenPosition = playerRoot\046Position\n\tend\n\tif self\046state == \"chase\" then\n\t\tif protected then\n\t\t\tself:_state(\"patrol\")\n\t\t\tself\046goal = nil\n\t\t\tself\046lostSince = nil\n\t\t\tself\046lastSeenPosition = nil\n\t\telse\n\t\t\tif canSee then\n\t\t\t