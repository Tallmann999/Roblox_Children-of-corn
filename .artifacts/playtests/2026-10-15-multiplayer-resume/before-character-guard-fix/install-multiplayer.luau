ated\")\n\t\treturn\n\tend\n\tself\046_hud = RoundHud\046new(playerGui)\n\tself\046_hud:SetOnAction(function(action: string, mode: string?)\n\t\tself:_request(action, mode)\n\tend)\nend\n\nfunction RoundController:_request(action: string, mode: string?)\n\tlocal remote = self\046_requestRemote\n\tlocal hud = self\046_hud\n\tif\n\t\tnot remote\n\t\tor not hud\n\t\tor hud\046_unavailable\n\t\tor not self\046_snapshot\n\t\tor ACTIONS[action] ~= true\n\tthen\n\t\treturn\n\tend\n\tif (action == \"start\" or action == \"retry\") and not LightingModes\046IsValid(mode) then\n\t\treturn\n\tend\n\tlocal team = self\046_snapshot\046team\n\tif (action == \"start\" or action == \"retry\") and team and (team\046ready or not team\046can_start) then\n\t\treturn\n\tend\n\tif action == \"start\" and self\046_snapshot\046phase ~= \"ready\" then\n\t\treturn\n\tend\n\tif\n\t\taction == \"revive\"\n\t\tand (\n\t\t\tmode ~= nil\n\t\t\tor self\046_snapshot\046phase ~= \"caught\"\n\t\t\tor self\046_snapshot\046capture\046remaining ~= 0\n\t\t\tor self\046_snapshot\046catches_remaining ~= 1\n\t\t\tor hud\046_captureActive\n\t\t)\n\tthen\n\t\treturn\n\tend\n\tif\n\t\taction == \"retry\"\n\t\tand self\046_snapshot\046phase ~= \"escaped\"\n\t\tand self\046_snapshot\046phase ~= \"aborted\"\n\t\tand self\046_snapshot\046phase ~= \"caught_out\"\n\tthen\n\t\treturn\n\tend\n\tlocal now = os\046clock()\n\tif now - self\046_lastRequest < DEBOUNCE_SEC then\n\t\treturn\n\tend\n\tself\046_lastRequest = now\n\thud:SetBusy(true)\n\tremote:FireServer(action, mode)\n\t-- Only the server changes the view\046 A rejected request must not leave buttons stuck\046\n\ttask\046delay(DEBOUNCE_SEC, function()\n\t\tif self\046_hud == hud then\n\t\t\thud:SetBusy(false)\n\t\tend\n\tend)\nend\n\nfunction RoundController:Start(context: any)\n\tlocal hud = self\046_hud\n\tif not hud then\n\t\treturn\n\tend\n\tlocal folder = ReplicatedStorage:WaitForChild(\"GameRemotes\", REMOTE_WAIT_SEC)\n\tif not folder or not folder:IsA(\"