n\n\t\t\tself:_ensure()\n\t\tend\n\tend)\nend\nfunction Controller:_watch(item: Instance): boolean\n\tif self\046_parts[item] then\n\t\treturn true\n\tend\n\tlocal isModel = item:IsA(\"Model\") and item\046Parent == self\046_props\n\tlocal model = if isModel then item else item\046Parent\n\tif\n\t\tnot model\n\t\tor (not isModel and (not item:IsA(\"MeshPart\") or model\046Parent ~= self\046_props))\n\t\tor not (\n\t\t\tmodel:GetAttribute(\"CornFarmAssetOwned\") == true or Builder\046AssetKeyForName(model\046Name)\n\t\t)\n\tthen\n\t\treturn false\n\tend\n\tlocal connections = {}\n\tlocal attributes = if isModel\n\t\tthen { \"CornFarmAssetOwned\", \"corn_project_id\", \"AssetKey\" }\n\t\telse { \"CornFarmMeshOwned\", \"corn_project_id\", \"AssetKey\", \"MeshIndex\" }\n\tfor _, attribute in attributes do\n\t\ttable\046insert(\n\t\t\tconnections,\n\t\t\titem:GetAttributeChangedSignal(attribute):Connect(function()\n\t\t\t\tself:_schedule()\n\t\t\tend)\n\t\t)\n\tend\n\tif isModel then\n\t\ttable\046insert(\n\t\t\tconnections,\n\t\t\titem:GetPropertyChangedSignal(\"Name\"):Connect(function()\n\t\t\t\tself:_schedule()\n\t\t\tend)\n\t\t)\n\telse\n\t\ttable\046insert(\n\t\t\tconnections,\n\t\t\titem:GetPropertyChangedSignal(\"MeshContent\"):Connect(function()\n\t\t\t\t-- ApplyMesh and rollback also fire this signal\046 During Ensure, current\n\t\t\t\t-- server content is captured after construction; our own writes need no retry\046\n\t\t\t\tif not self\046_running then\n\t\t\t\t\tself:_schedule()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\tend\n\tself\046_parts[item] = connections\n\treturn true\nend\nfunction Controller:_bind()\n\tif self\046_props then\n\t\treturn\n\tend\n\tlocal map = world:WaitForChild(\"CornMap\", 10)\n\tself\046_map = map\n\tlocal props = map and map:WaitForChild(\"Props\", 10)\n\tassert(props and props:IsA(\"Folder\"), \"Farm geometry client Props unavailable\")\n\tif not self\046_enabled then\n\t\treturn\n\tend\n\tself\046_props = props\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tprops\046DescendantAdded:Connect(function(item)\n\t\t\tif self:_watch(item) or item:GetAttribute(\"CornFarmMeshOwned\") == true then\n\t\t\t\tself:_schedule()\n\t\t\tend\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tself\046_connections,\n\t\tprops\046DescendantRemoving:Connect(function(item)\n\t\t\tlocal connections = self\046_parts[item]\n\t\t\tif connections then\n\t\t\t\tfor _, connection in connections do\n\t\t\t\t\tconnection:Disconnect()\n\t\t\t\tend\n\t\t\t\tself\046_parts[item] = nil\n\t\t\t\tself:_schedule()\n\t\t\tend\n\t\tend)\n\t)\n\tfor _, item in props:GetDescendants() do\n\t\tself:_watch(item)\n\tend\nend\nfunction Controller:_ensure()\n\tif not self\046_enabled then\n\t\treturn\n\tend\n\tself\046_running = true\n\tself\046_pending = false\n\tlocal ok, result = pcall(function()\n\t\tself:_bind()\n\t\tif not self\046_enabled then\n\t\t\treturn nil\n\t\tend\n\t\tself:_status(\"building\", 0)\n\t\treturn self\046_runtime:Ensure()\n\tend)\n\tself\046_running = false\n\tif not self\046_enabled then\n\t\treturn\n\tend\n\tif not ok then\n\t\tlocal problem = \"[FarmGeometryController] local rendering restoration failed: \"\n\t\t\t\046\046 tostring(result)\n\t\tself:_status(\"error\", 0, problem)\n\t\tif self\046_lastError ~= problem then\n\t\t\twarn(problem)\n\t\tend\n\t\tself\046_lastError = problem\n\telse\n\t\tself\046_lastError = nil\n\t\tself:_status(if result\046pending > 0 then \"waiting\" else \"ready\", result\046pending)\n\tend\n\tif self\046_pending then\n\t\tself:_schedule()\n\tend\nend\nfunction Controller:Start()\n\tif not self\046_enabled or self\046_started then\n\t\treturn\n\tend\n\tself\046_started = true\n\t-- Streaming and EditableMesh allocation must not interrupt other controllers\046\n\tself:_schedule()\nend\nfunction Controller:Destroy()\n\tself\046_enabled = false\n\tself:_status(\"stopped\", 0)\n\tfor _, connection in self\046_connections do\n\t\tconnection:Disconnect()\n\tend\n\tfor _, connections in self\046_parts do\n\t\tfor _, connection in connections do\n\t\t\tconnection:Disconnect()\n\t\tend\n\tend\n\tself\046_connections = {}\n\tself\046_parts = {}\n\tself\046_runtime:Destroy()\nend\nreturn Controller\n"},
