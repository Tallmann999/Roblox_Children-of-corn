hild(\"CornRoundRuntime\")\n\tif\n\t\tnot runtime\n\t\tor not runtime:IsA(\"Folder\")\n\t\tor runtime:GetAttribute(\"corn_project_id\") ~= PROJECT\n\tthen\n\t\tself:_clearRuntime()\n\t\treturn\n\tend\n\tif runtime ~= self\046_runtime then\n\t\tself:_clearRuntime()\n\t\tself\046_runtime = runtime\n\t\ttable\046insert(\n\t\t\tself\046_runtimeConnections,\n\t\t\truntime\046ChildAdded:Connect(function(item)\n\t\t\t\tif\n\t\t\t\t\titem\046Name\n\t\t\t\t\t== (\n\t\t\t\t\t\tif self\046_monsterIndex == 1\n\t\t\t\t\t\t\tthen \"Monster\"\n\t\t\t\t\t\t\telse \"Monster\" \046\046 self\046_monsterIndex\n\t\t\t\t\t)\n\t\t\t\tthen\n\t\t\t\t\tself:_resolveMonster()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\t\ttable\046insert(\n\t\t\tself\046_runtimeConnections,\n\t\t\truntime\046ChildRemoved:Connect(function(item)\n\t\t\t\tif item == self\046_model then\n\t\t\t\t\tself:_unbindMonster()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\t\ttable\046insert(\n\t\t\tself\046_runtimeConnections,\n\t\t\truntime\046AncestryChanged:Connect(function()\n\t\t\t\tif runtime\046Parent ~= self\046_map then\n\t\t\t\t\tself:_clearRuntime()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\t\ttable\046insert(\n\t\t\tself\046_runtimeConnections,\n\t\t\truntime:GetAttributeChangedSignal(\"corn_project_id\"):Connect(function()\n\t\t\t\tif runtime:GetAttribute(\"corn_project_id\") ~= PROJECT then\n\t\t\t\t\tself:_clearRuntime()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\tend\n\tself:_resolveMonster()\nend\n\nfunction Controller:_clearMap()\n\tself:_clearRuntime()\n\tdisconnect(self\046_mapConnections)\n\tself\046_map = nil\nend\n\nfunction Controller:_resolveMap()\n\tlocal map = Workspace:FindFirstChild(\"CornMap\")\n\tif\n\t\tnot map\n\t\tor not map:IsA(\"Model\")\n\t\tor map:GetAttribute(\"corn_project_id\") ~= PROJECT\n\t\tor Workspace:FindFirstChild(\"Asmr_Base\")\n\t\tor Workspace:FindFirstChild(\"ASMR_Models\")\n\tthen\n\t\tself:_clearMap()\n\t\treturn\n\tend\n\tif map ~= self\046_map then\n\t\tself:_clearMap()\n\t\tself\046_map = map\n\t\ttable\046insert(\n\t\t\tself\046_mapConnections,\n\t\t\tmap\046ChildAdded:Connect(function(item)\n\t\t\t\tif item\046Name == \"CornRoundRuntime\" then\n\t\t\t\t\tself:_resolveRuntime()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\t\ttable\046insert(\n\t\t\tself\046_mapConnections,\n\t\t\tmap\046ChildRemoved:Connect(function(item)\n\t\t\t\tif item == self\046_runtime then\n\t\t\t\t\tself:_clearRuntime()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\t\ttable\046insert(\n\t\t\tself\046_mapConnections,\n\t\t\tmap\046AncestryChanged:Connect(function()\n\t\t\t\tif map\046Parent ~= Workspace then\n\t\t\t\t\tself:_clearMap()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\t\ttable\046insert(\n\t\t\tself\046_mapConnections,\n\t\t\tmap:GetAttributeChangedSignal(\"corn_project_id\"):Connect(function()\n\t\t\t\tif map:GetAttribute(\"corn_project_id\") ~= PROJECT then\n\t\t\t\t\tself:_clearMap()\n\t\t\t\tend\n\t\t\tend)\n\t\t)\n\tend\n\tself:_resolveRuntime()\nend\n\nfunction Controller:_step(delta: number)\n\tself\046_time += math\046clamp(delta, 0, 0\04625)\n\tself\046_resolveElapsed += delta\n\tif self\046_resolveElapsed >= RESOLVE_SEC then\n\t\tself\046_resolveElapsed = 0\n\t\tself:_resolveMap()\n\tend\n\tself\046_updateElapsed += delta\n\tif self\046_updateElapsed < UPDATE_SEC or not self\046_model then\n\t\treturn\n\tend\n\tself\046_updateElapsed %= UPDATE_SEC\n\tself\046_lastWrites = 0\n\tif not self:_valid() then\n\t\tself:_unbindMonster()\n\t\treturn\n\tend\n\tlocal position = self\046_root\046Position\n\tif self\046_previousPosition and (position - self\046_previousPosition)\046Magnitude > 0\046015 then\n\t\tself\046_movingUntil = self\046_time + 0\04615\n\tend\n\tself\046_previousPosition = position\n\tlocal pose = Pose\046Get(self\046_state, self\046_time - self\046_stateAt, self\046_movingUntil > self\046_time)\n\tif pose == Pose\046Rest and self\046_restored then\n\t\treturn\n\tend\n\tlocal frame = self\046_root\046CFrame\n\tfor name, part in self\046_parts do\n\t\tpart\046CFrame = frame * pose[name]\n\t\tself\046_lastWrites += 1\n\tend\n\tself\046_restored = pose == Pose\046Rest\nend\n\nfunction Controller:Init(context: any, monsterIndex: number?)\n\tself\046_monsterIndex = monsterIndex or 1\n\tself\046_companions = {}\n\tself\046_enabled = RunService:IsStudio()\n\t\tand context\046Config\046Environment == \"DEV\"\n\t\tand (\n\t\t\tcontext\046Config\046Game\046SessionMode == \"solo_local\"\n\t\t\tor context\046Config\046Game\046SessionMode == \"team_local\"\n\t\t)\n\tself\046_map, self\046_runtime, self\046_model, self\046_root = nil, nil, nil, nil\n\tself\046_parts = {}\n\tself\046_topConnections, self\046_mapConnections, self\046_runtimeConnections, self\046_monsterConnections =\n\t\t{}, {}, {}, {}\n\tself\046_time, self\046_stateAt, self\046_movingUntil, self\046_lastWrites = 0, 0, 0, 0\n\tself\046_updateElapsed, self\046_resolveElapsed = UPDATE_SEC, RESOLVE_SEC\n\tself\046_state, self\046_previousPosition, self\046_restored = nil, nil, true\n\tself\046_connection = nil\n\tif monsterIndex == nil then\n\t\t-- Reuse the same guarded lifecycle independently for exactly three rigs\046\n\t\tfor index = 2, 3 do\n\t\t\t-- Bootstrap initializes this Module table itself\046 A __index pointing\n\t\t\t-- at it would inherit its later _connection and skip companion Start\046\n\t\t\tlocal companion = table\046clone(Controller)\n\t\t\tcompanion:Init(context, index)\n\t\t\ttable\046insert(self\046_companions, companion)\n\t\tend\n\tend\nend\n\nfunction Controller:Start()\n\tif not self\046_enabled or self\046_connection then\n\t\treturn\n\tend\n\tself:_resolveMap()\n\ttable\046insert(\n\t\tself\046_topConnections,\n\t\tWorkspace\046ChildAdded:Connect(function(item)\n\t\t\tif item\046Name == \"CornMap\" then\n\t\t\t\tself:_resolveMap()\n\t\t\tend\n\t\tend)\n\t)\n\ttable\046insert(\n\t\tself\046_topConnections,\n\t\tWorkspace\046ChildRemoved:Connect(function(item)\n\t\t\tif item == self\046_map then\n\t\t\t\tself:_clearMap()\n\t\t\tend\n\t\tend)\n\t)\n\tself\046_connection = RunS