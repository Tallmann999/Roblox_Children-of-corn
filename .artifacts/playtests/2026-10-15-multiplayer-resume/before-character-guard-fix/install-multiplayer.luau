{path="ServerScriptService/GameServer/Game/RoundParticipant",class="ModuleScript",before=nil,after="6bc7b11589efa78848ee60f19d6bd3b1b91b1fb0519b38627bb092d6db1a862e",source="--!strict\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"GameShared\"):WaitForChild(\"Game\")\nlocal Inventory = require(Shared:WaitForChild(\"Inventory\"))\nlocal Stamina = require(Shared:WaitForChild(\"Stamina\"))\nlocal SoloRound = require(script\046Parent:WaitForChild(\"SoloRound\"))\n\nlocal Participant = {}\nParticipant\046__index = Participant\n\n-- These helpers touch only this player's state or validate a world interaction\046\n-- SoloRound:Start and its shared-world lifecycle are never used by a participant\046\nfor _, name in\n\t{\n\t\t\"_livingCharacter\",\n\t\t\"_controls\",\n\t\t\"_fallbackSpawn\",\n\t\t\"_setRespawnLocation\",\n\t\t\"_moveToStart\",\n\t\t\"_promptNearby\",\n\t\t\"_canInteract\",\n\t\t\"_inventoryRequest\",\n\t\t\"_sprintRequest\",\n\t\t\"_movement\",\n\t\t\"_recordCharacterDeath\",\n\t}\ndo\n\tParticipant[name] = SoloRound[name]\nend\n\nfunction Participant\046new(team: any, player: Player): any\n\tlocal self = SoloRound\046new(team\046context)\n\tsetmetatable(self, Participant)\n\tself\046team = team\n\tself\046player = player\n\tself\046world = team\046world\n\tself\046admitted = false\n\tself\046ready = false\n\tself\046inRound = false\n\tself\046destroyed = false\n\tself\046joinedRound = 0\n\treturn self\nend\n\nfunction Participant:_send()\n\tlocal player = self\046player\n\tif self\046destroyed or not player or player\046Parent ~= Players then\n\t\treturn\n\tend\n\tlocal now = os\046clock()\n\tlocal facing = if self\046selectedSpawn\n\t\tthen self\046selectedSpawn\046CFrame\046LookVector\n\t\telse Vector3\046zAxis\n\tlocal horizontal = Vector3\046new(facing\046X, 0, facing\046Z)\n\tlocal playing = self\046inRound and (self\046phase == \"active\" or self\046phase == \"caught\")\n\tself\046snapshot:FireClient(player, {\n\t\tphase = self\046phase,\n\t\tlighting_mode = self\046lightingMode,\n\t\tminimap = self\046minimap:Snapshot(),\n\t\tinventory = Inventory\046Snapshot(self\046inventory, now),\n\t\thas_key = self\046hasKey,\n\t\tgate_open = self\046team\046gateOpen,\n\t\tevacuation = {\n\t\t\tactive = playing and self\046team\046evacuationActive,\n\t\t\tremaining = if playing and self\046team\046evacuationDeadline\n\t\t\t\tthen math\046clamp(self\046team\046evacuationDeadline - now, 0, 120)\n\t\t\t\telse 0,\n\t\t\tduration = 120,\n\t\t},\n\t\tteam = self\046team:Snapshot(self),\n\t\tsession_diamonds = self\046diamonds,\n\t\treward_diamonds = self\046reward,\n\t\telapsed_sec = if playing and self\046team\046startedAt\n\t\t\tthen now - self\046team\046startedAt\n\t\t\telse self\046elapsed,\n\t\tnotice = self\046notice,\n\t\tstamina = self\046stamina\046value,\n\t\tstamina_capacity = self\046balance\046stamina_capacity,\n\t\tis_sprinting = self\046stamina\046sprinting,\n\t\tsprint_exhausted = self\046stamina\046exhausted,\n\t\tstart_look = if horizontal\046Magnitude > 0 then horizontal\046Unit else Vector3\046new(0, 0, -1),\n\t\tcatches_remaining = math\046max(0, self\046balance\046max_catches - self\046catches),\n\t\tcapture = {\n\t\t\tid = self\046catches,\n\t\t\tremaining = if self\046phase == \"caught\"\n\t\t\t\tthen math\046clamp(self\046captureUntil - now, 0, 1)\n\t\t\t\telse 0,\n\t\t\tframe = self\046captureFrame,\n\t\t},\n\t\tmonster_state = self\046team:MonsterState(self),\n\t\tprotection_sec = math\046max(0, self\046protectedUntil - now),\n\t})\nend\n\nfunction Participant:Reset(spawn: BasePart)\n\tself\046epoch += 1\n\tself\046ready = false\n\tself\046inRound = true\n\tself\046joinedRound = self\046team\046roundId\n\tself\046phase = \"preparing\"\n\tself\046world = self\046team\046world\n\tself\046items = nil\n\tself\046selectedSpawn = spawn\n\tself:_setRespawnLocation()\n\tself\046inventory = Inven