n\nfunction TeamRound:CompleteIfDone()\n\tif\n\t\tnot self\046ending\n\t\tand (self\046state == \"active\" or self\046state == \"preparing\")\n\t\tand self:_remaining() == 0\n\tthen\n\t\tself:_cleanup(\"finished\")\n\tend\nend\n\nfunction TeamRound:_abortAll(notice: string)\n\tif self\046ending then\n\t\treturn\n\tend\n\tself\046ending = true\n\tfor _, member in self\046order do\n\t\tif member\046inRound then\n\t\t\tmember:_finish(\"aborted\", notice)\n\t\tend\n\tend\n\tself\046ending = false\n\tself:_cleanup(\"finished\")\n\tself:Broadcast()\nend\n\nfunction TeamRound:ExpireEvacuation(now: number): boolean\n\tif self\046state ~= \"active\" or not self\046evacuationDeadline or now < self\046evacuationDeadline then\n\t\treturn false\n\tend\n\tself\046ending = true\n\tfor _, member in self\046order do\n\t\tif member\046inRound and (member\046phase == \"active\" or member\046phase == \"caught\") then\n\t\t\tmember:_finish(\"caught_out\", \"corn_evacuation_expired\")\n\t\tend\n\tend\n\tself\046ending = false\n\tself:_cleanup(\"finished\")\n\tself:Broadcast()\n\treturn true\nend\n\nfunction TeamRound:_startEvacuation(now: number, root: BasePart): boolean\n\tif self\046evacuationActive then\n\t\treturn true\n\tend\n\tif not self\046hunt or self\046hunt\046destroyed then\n\t\treturn false\n\tend\n\tlocal slots = table\046clone(self\046world\046Slots)\n\ttable\046sort(slots, function(a, b)\n\t\tlocal da, db =\n\t\t\t(a\046Position - root\046Position)\046Magnitude, (b\046Position - root\046Position)\046Magnitude\n\t\treturn if math\046abs(da - db) < 0\04601 then a\046Name < b\046Name else da < db\n\tend)\n\tlocal chosen = {}\n\tfor _, slot in slots do\n\t\tlocal safe = true\n\t\tfor _, member in self\046order do\n\t\t\tlocal _, _, other = member:_livingCharacter()\n\t\t\tif\n\t\t\t\tmember\046phase == \"active\"\n\t\t\t\tand other\n\t\t\t\tand (slot\046Position - other\046Position)\046Magnitude < 48\n\t\t\tthen\n\t\t\t\tsafe = false\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tif