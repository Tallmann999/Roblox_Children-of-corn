          "End": {
            "$ignoreUnknownInstances": true,
            "$path": "scene-c/data/End.luau"
          },
          "Grass": {
            "$ignoreUnknownInstances": true,
            "$path": "scene-c/data/Grass.luau"
          },
          "Skirt": {
            "$ignoreUnknownInstances": true,
